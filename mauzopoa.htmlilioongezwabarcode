function sendMessage() {
  const input = document.getElementById('msgInput');
  if (!input) return;
  const text = input.value.trim();
  if (!text) return;
  const chatBody = document.getElementById('msgChatBody');
  if (!chatBody) return;
  if (chatBody.querySelector('.empty-s')) chatBody.innerHTML = '';
