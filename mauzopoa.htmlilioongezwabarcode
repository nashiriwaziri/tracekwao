function renderReportCharts() {
  /* Sales by day - last 14 days */
  const canvas1 = document.getElementById('reportSalesChart');
  if (canvas1) {
    if (State.charts.repSales) State.charts.repSales.destroy();
    const days = [], vals = [];
    for (let i = 13; i >= 0; i--) {
      const d = new Date(); d.setDate(d.getDate() - i);
      const ds = d.toISOString().split('T')[0];
      days.push(d.toLocaleDateString(State.lang === 'sw' ? 'sw-TZ' : 'en-GB', { day: '2-digit', month: 'short' }));
      vals.push(State.cachedSales.filter(s => s.date === ds).reduce((a, s) => a + (s.total || 0), 0));
    }
    State.charts.repSales = new Chart(canvas1, {
      type: 'bar', data: { labels: days, datasets: [{ label: 'Sales', data: vals, backgroundColor: 'rgba(108,92,231,0.6)', borderRadius: 4, borderSkipped: false }] },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { callback: v => fmt(v), color: '#9a9ab0' }, grid: { color: 'rgba(255,255,255,0.05)' } }, x: { grid: { display: false }, ticks: { color: '#9a9ab0', maxRotation: 45 } } } }
    });
  }
  /* Expense by description */
  const canvas2 = document.getElementById('reportExpChart');
  if (canvas2) {
    if (State.charts.repExp) State.charts.repExp.destroy();
    const em = {};
    State.cachedExpenses.forEach(e => { em[e.description || 'Other'] = (em[e.description || 'Other'] || 0) + (e.amount || 0); });
    const labels = Object.keys(em);
    const vals = Object.values(em);
    const colors = ['#6c5ce7', '#00b894', '#e74c3c', '#f39c12', '#0984e3', '#a29bfe', '#fd79a8', '#00cec9'];
    State.charts.repExp = new Chart(canvas2, {
      type: 'doughnut', data: { labels, datasets: [{ data: vals, backgroundColor: colors.slice(0, labels.length), borderWidth: 0 }] },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'right', labels: { color: '#9a9ab0', font: { size: 11 } } } } }
    });
  }
}

function downloadSalesPDF() {
  try {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF();
    doc.setFontSize(16);
    doc.text('BizBook - ' + t('salesReport'), 14, 20);
    doc.setFontSize(10);
    doc.text(t('date') + ': ' + today(), 14, 28);
    const rows = State.cachedSales.map(s => [fmtDate(s.date || s.createdAt), s.items?.[0]?.name || '-', s.items?.reduce((a, i) => a + (i.qty || 0), 0), fmt(s.total)]);
    doc.autoTable({ head: [[t('date'), t('name'), t('qty'), t('total')]], body: rows, startY: 34, styles: { fontSize: 9 } });
    doc.save('sales-report.pdf');
    toast(t('savedSuccessfully'), 's');
