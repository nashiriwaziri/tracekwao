/* ===== AUTH STATE LISTENER ===== */
onAuthStateChanged(auth, async (user) => {
  if(!user) {
    State.currentUserId = null;
    State.currentUserData = null;
    State.currentBizId = null;
    State.currentBizData = null;
    return;
  }
  try {
    const userDoc = await getDoc(doc(db,'users',user.uid));
    if(!userDoc.exists()) {
      console.warn('[AUTH] User profile not found for', user.uid);
      return;
    }
    const userData = userDoc.data();
    State.currentUserId = user.uid;
    State.currentUserData = userData;
    State.currentBizId = userData.businessId;
    if(userData.lang) { State.lang = userData.lang; setLang(userData.lang); }
    if(!userData.role) {
      if(userData.businessId) {
        const bizDoc = await getDoc(doc(db,'businesses',userData.businessId));
        if(bizDoc.exists()) {
          State.currentBizData = bizDoc.data();
          showScreen('roleScreen');
          document.getElementById('rsBizName').textContent = State.currentBizData.name || '';
          document.getElementById('rsBizType').textContent = t(State.currentBizData.type || 'duka');
        }
      }
      return;
    }
    await loadDashboard();
  } catch(err) {
    console.error('[AUTH STATE]', err);
    toast(t('errorOccurred'), 'e');
  }
});

