          <div class="fg"><label data-i18n="email">Barua Pepe</label><div class="iw"><i class="fas fa-envelope"></i><input class="fi" type="email" id="regEmail" required/></div></div>
          <div class="fg"><label data-i18n="phone">Simu</label><div class="iw"><i class="fas fa-phone"></i><input class="fi" type="tel" id="regPhone" required/></div></div>
          <button class="btn-auth btn-auth-p" type="button" onclick="regNext(2)" data-i18n="next">Endelea</button>
