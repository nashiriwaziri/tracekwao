          <div style="display:flex;gap:10px"><button class="btn-auth btn-auth-p" type="button" style="background:var(--bg3);color:var(--text2)" onclick="regNext(1)" data-i18n="back">Nyuma</button><button class="btn-auth btn-auth-p" type="button" onclick="regNext(3)" data-i18n="next">Endelea</button></div>
        </div>
        <div id="regStep3" class="hidden">
