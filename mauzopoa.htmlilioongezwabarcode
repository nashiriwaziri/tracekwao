function downloadSalesExcel() {
  try {
    const data = State.cachedSales.map(s => ({ [t('date')]: fmtDate(s.date || s.createdAt), [t('name')]: s.items?.[0]?.name || '-', [t('qty')]: s.items?.reduce((a, i) => a + (i.qty || 0), 0), [t('total')]: s.total }));
