/* ===== UTILITIES ===== */
function t(k) { return (i18n[State.lang] && i18n[State.lang][k]) || k; }
function fmt(n) { return new Intl.NumberFormat('en-TZ').format(Math.round(n||0)); }
function fmtDate(d) { if(!d) return '-'; return new Date(d).toLocaleDateString(State.lang==='sw'?'sw-TZ':'en-GB',{day:'2-digit',month:'short',year:'numeric'}); }
function fmtDateTime(d) { if(!d) return '-'; return new Date(d).toLocaleDateString(State.lang==='sw'?'sw-TZ':'en-GB',{day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}); }
function genId() { return Date.now().toString(36) + Math.random().toString(36).substr(2,5); }
function today() { return new Date().toISOString().split('T')[0]; }
function monthStart() { const d=new Date(); d.setDate(1); return d.toISOString().split('T')[0]; }
function getInitials(name) { if(!name) return '?'; return name.split(' ').map(w=>w[0]).join('').toUpperCase().substring(0,2); }

function toast(msg, type='s') {
  const c = document.getElementById('toastContainer');
  const el = document.createElement('div');
  el.className = 'toast ' + type;
  const icons = {s:'fa-check-circle',e:'fa-times-circle',i:'fa-info-circle',w:'fa-exclamation-triangle'};
  el.innerHTML = `<i class="fas ${icons[type]||icons.s}"></i><span>${msg}</span>`;
  c.appendChild(el);
  setTimeout(()=>{ el.style.opacity='0'; el.style.transform='translateX(40px)'; el.style.transition='all .3s'; setTimeout(()=>el.remove(),300); }, 3500);
}

function showConfirm(msg, onYes, targetName) {
  const cc = document.getElementById('confirmContainer');
  cc.innerHTML = `<div class="confirm-modal" onclick="if(event.target===this)this.remove()"><div class="confirm-card"><div class="confirm-icon danger"><i class="fas fa-exclamation-triangle"></i></div><h3>${t('confirmDelete')}</h3><p>${msg}</p>${targetName?`<div class="user-target">${targetName}</div>`:''}<div class="confirm-actions"><button class="btn btn-o" onclick="this.closest('.confirm-modal').remove()">${t('no')}</button><button class="btn btn-d" id="confirmYesBtn">${t('yes')}</button></div></div></div>`;
  document.getElementById('confirmYesBtn').onclick = ()=>{ cc.innerHTML=''; onYes(); };
}

