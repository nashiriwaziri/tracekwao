  grid.innerHTML = list.map(p=>`<div class="pos-p-card" onclick="addToCart('${p.id}')"><h5>${p.name}</h5><div class="pos-p-price">${fmt(p.sellingPrice)}</div><div class="pos-p-stock">${t('stock')}: ${p.stock}</div></div>`).join('');
}

function addToCart(productId) {
  const p = State.cachedProducts.find(x=>x.id===productId);
  if(!p) return;
  const existing = State.cart.find(c=>c.productId===productId);
  if(existing) {
    if(existing.qty >= p.stock) { toast('Stock haiitoshi','w'); return; }
    existing.qty++;
  } else {
    State.cart.push({ productId, name:p.name, price:p.sellingPrice, qty:1, maxStock:p.stock });
  }
  renderCart();
}

function updateCartQty(productId, delta) {
  const item = State.cart.find(c=>c.productId===productId);
  if(!item) return;
  item.qty += delta;
  if(item.qty <= 0) State.cart = State.cart.filter(c=>c.productId!==productId);
  else if(item.qty > item.maxStock) { item.qty = item.maxStock; toast('Stock haiitoshi','w'); }
  renderCart();
}

function removeFromCart(productId) { State.cart = State.cart.filter(c=>c.productId!==productId); renderCart(); }
function clearCart() { State.cart = []; renderCart(); }

function renderCart() {
  const body = document.getElementById('posCartBody');
  const totalEl = document.getElementById('posTotal');
  if(!body) return;
  if(!State.cart.length) { body.innerHTML=`<div class="empty-s"><p>${t('emptyCart')}</p></div>`; if(totalEl) totalEl.textContent='TZS 0'; return; }
  body.innerHTML = State.cart.map(c=>`<div class="cart-item"><div class="cart-item-info"><h6>${c.name}</h6><span>${fmt(c.price)} x ${c.qty}</span></div><div class="cart-qty"><button onclick="updateCartQty('${c.productId}',-1)">-</button><span>${c.qty}</span><button onclick="updateCartQty('${c.productId}',1)">+</button></div><div class="cart-item-price">${fmt(c.price*c.qty)}</div><button class="cart-item-rm" onclick="removeFromCart('${c.productId}')"><i class="fas fa-times"></i></button></div>`).join('');
  const total = State.cart.reduce((a,c)=>a+c.price*c.qty,0);
  if(totalEl) totalEl.textContent = 'TZS ' + fmt(total);
}

async function completeSale() {
  if(!State.cart.length) { toast(t('emptyCart'),'w'); return; }
  const total = State.cart.reduce((a,c)=>a+c.price*c.qty,0);
  try {
    const saleData = {
      businessId: State.currentBizId, userId: State.currentUserId,
      items: State.cart.map(c=>({productId:c.productId,name:c.name,price:c.price,qty:c.qty})),
      total, date: today(), createdAt: serverTimestamp()
    };
    await addDoc(collection(db,'sales'), saleData);
    for(const item of State.cart) {
      const pRef = doc(db,'products',item.productId);
      const pDoc = await getDoc(pRef);
      if(pDoc.exists()) {
        const newStock = Math.max(0, (pDoc.data().stock||0) - item.qty);
        await updateDoc(pRef, { stock: newStock });
      }
    }
    State.cart = [];
    toast(t('savedSuccessfully'),'s');
    await loadProducts(); await loadSales();
    renderPOS();
  } catch(e) { console.error('[COMPLETE SALE]',e); toast(t('errorOccurred'),'e'); }
}

