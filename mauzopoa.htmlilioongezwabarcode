/* ===== SIDEBAR WITH ROLE-BASED FILTERING — FROM CODE 2 USER FEATURE ===== */
function buildSidebar() {
  const role = State.currentUserData?.role || 'staff';
  const allowed = roleAccess[role] || roleAccess.staff;
  let html = '<div class="sb-lbl" data-i18n="mainMenu">Menu Kuu</div>';
  navConfig.forEach(item => {
    if(item.id.startsWith('_div')) { html += '<div style="height:1px;background:var(--border);margin:8px 12px"></div>'; return; }
    if(!allowed.includes(item.id)) return;
    const isActive = State.currentSection === item.id;
    html += `<div class="ni${isActive?' active':''}" onclick="navTo('${item.id}')"><i class="fas ${item.icon}"></i><span data-i18n="${item.key}">${t(item.key)}</span></div>`;
  });
  html += `<div class="ni" style="margin-top:12px;color:var(--danger)" onclick="handleLogout()"><i class="fas fa-sign-out-alt" style="color:var(--danger)"></i><span data-i18n="logout">${t('logout')}</span></div>`;
  document.getElementById('sbNav').innerHTML = html;
}

