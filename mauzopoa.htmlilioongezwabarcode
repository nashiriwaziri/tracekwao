function switchAuthTab(tab) {
  document.querySelectorAll('.auth-tab').forEach((t,i) => t.classList.toggle('active', (tab==='login'?0:1)===i));
  document.getElementById('loginForm').classList.toggle('active', tab==='login');
  document.getElementById('registerForm').classList.toggle('active', tab==='register');
  hideAuthErr();
  if(tab==='register') regNext(1);
}
function showAuthErr(msg) { document.getElementById('authErr').classList.add('show'); document.getElementById('authErrMsg').textContent=msg; }
function hideAuthErr() { document.getElementById('authErr').classList.remove('show'); }
function togPw(id, btn) {
  const inp = document.getElementById(id);
  const isP = inp.type === 'password';
  inp.type = isP ? 'text' : 'password';
  btn.innerHTML = `<i class="fas fa-eye${isP?'-slash':''}"></i>`;
}
function regNext(step) {
  [1,2,3].forEach(s => {
    document.getElementById('regStep'+s).classList.toggle('hidden', s!==step);
    document.getElementById('step'+s+'dot').classList.toggle('on', s<=step);
  });
}
function checkPwStr() {
  const pw = document.getElementById('regPass').value;
  let str = 0;
  if(pw.length>=6) str++;
  if(pw.length>=10) str++;
  if(/[A-Z]/.test(pw)) str++;
  if(/[0-9]/.test(pw)) str++;
  const bar = document.getElementById('pwBarInner');
  const colors = ['var(--danger)','var(--warning)','var(--info)','var(--success)'];
  bar.style.width = (str/4*100)+'%';
  bar.style.background = colors[str-1] || 'var(--bg3)';
}

async function handleRegister(e) {
  e.preventDefault();
  hideAuthErr();
  const name = document.getElementById('regName').value.trim();
  const email = document.getElementById('regEmail').value.trim();
  const phone = document.getElementById('regPhone').value.trim();
  const pass = document.getElementById('regPass').value;
  const passC = document.getElementById('regPassC').value;
  const bizName = document.getElementById('regBizName').value.trim();
  const bizType = document.getElementById('regBizType').value;
  const bizLoc = document.getElementById('regBizLoc').value.trim();
  if(!name||!email||!phone||!pass||!bizName) { showAuthErr(t('fillRequired')); return false; }
  if(pass!==passC) { showAuthErr(t('passwordsNoMatch')); return false; }
  const btn = document.getElementById('regBtn');
  btn.disabled = true;
  btn.innerHTML = '<div class="spinner" style="width:20px;height:20px;border-width:2px"></div>';
  try {
    const cred = await createUserWithEmailAndPassword(auth, email, pass);
    const uid = cred.user.uid;
    const bizId = genId();
    await setDoc(doc(db,'businesses',bizId), {
      name: bizName, type: bizType, location: bizLoc, ownerId: uid,
      phone: phone, email: email, logo: '', createdAt: serverTimestamp()
    });
    await setDoc(doc(db,'users',uid), {
      name, email, phone, businessId: bizId, role: null, status: 'active',
      lang: State.lang, createdAt: serverTimestamp(), lastActivity: serverTimestamp()
    });
    State.currentUserId = uid;
    State.currentBizId = bizId;
    showScreen('roleScreen');
    document.getElementById('rsBizName').textContent = bizName;
    document.getElementById('rsBizType').textContent = t(bizType);
  } catch(err) {
    console.error('[REGISTER]', err);
    if(err.code==='auth/email-already-in-use') showAuthErr(t('emailInUse'));
    else if(err.code==='auth/weak-password') showAuthErr(t('weakPassword'));
    else showAuthErr(err.message || t('errorOccurred'));
  } finally {
    btn.disabled = false;
    btn.textContent = t('createAccount');
  }
  return false;
}

async function handleLogin(e) {
  e.preventDefault();
  hideAuthErr();
  const email = document.getElementById('loginEmail').value.trim();
  const pass = document.getElementById('loginPass').value;
  if(!email||!pass) { showAuthErr(t('fillRequired')); return false; }
  const btn = document.getElementById('loginBtn');
  btn.disabled = true;
  btn.innerHTML = '<div class="spinner" style="width:20px;height:20px;border-width:2px"></div>';
  try {
    await signInWithEmailAndPassword(auth, email, pass);
  } catch(err) {
    console.error('[LOGIN]', err);
    if(err.code==='auth/invalid-credential'||err.code==='auth/wrong-password'||err.code==='auth/user-not-found') showAuthErr(t('invalidCredentials'));
    else showAuthErr(err.message || t('errorOccurred'));
    btn.disabled = false;
    btn.textContent = t('login');
  }
  return false;
}

