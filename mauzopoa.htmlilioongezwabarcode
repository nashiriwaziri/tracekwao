/* ===== NAVIGATION ===== */
function navTo(section) {
  const role = State.currentUserData?.role || 'staff';
  const allowed = roleAccess[role] || roleAccess.staff;
  if(!allowed.includes(section)) { toast(t('errorOccurred'), 'e'); return; }
  State.currentSection = section;
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  const sec = document.getElementById('sec-'+section);
  if(sec) sec.classList.add('active');
  document.querySelectorAll('.ni').forEach(n => n.classList.remove('active'));
  const navEl = document.querySelector(`.ni[onclick="navTo('${section}')"]`);
  if(navEl) navEl.classList.add('active');
  closeSidebar();
  renderSection(section);
}

