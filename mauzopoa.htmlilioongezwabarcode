function renderDashChart() {
  const canvas = document.getElementById('dashSalesChart');
  if(!canvas) return;
  if(State.charts.dashSales) State.charts.dashSales.destroy();
  const days = [];
  const vals = [];
  for(let i=6;i>=0;i--) {
    const d=new Date(); d.setDate(d.getDate()-i);
    const ds=d.toISOString().split('T')[0];
    days.push(d.toLocaleDateString(State.lang==='sw'?'sw-TZ':'en-GB',{weekday:'short'}));
    vals.push(State.cachedSales.filter(s=>s.date===ds).reduce((a,s)=>a+(s.total||0),0));
  }
  State.charts.dashSales = new Chart(canvas, {
    type:'bar', data:{labels:days,datasets:[{label:'Sales',data:vals,backgroundColor:'rgba(108,92,231,0.6)',borderRadius:6,borderSkipped:false}]},
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,ticks:{callback:v=>fmt(v),color:'#9a9ab0'},grid:{color:'rgba(255,255,255,0.05)'}},x:{grid:{display:false},ticks:{color:'#9a9ab0'}}}}
  });
}

function renderTopProducts() {
  const el = document.getElementById('topProductsList');
  if(!el) return;
  const pm = {};
  State.cachedSales.forEach(s => { (s.items||[]).forEach(i => { pm[i.name] = (pm[i.name]||0) + (i.qty||0); }); });
  const top = Object.entries(pm).sort((a,b)=>b[1]-a[1]).slice(0,5);
  if(!top.length) { el.innerHTML=`<div class="empty-s"><p>${t('noData')}</p></div>`; return; }
  const max = top[0][1];
  el.innerHTML = top.map(([name,qty],i) => `<div style="display:flex;align-items:center;gap:10px;margin-bottom:10px"><span style="font-size:12px;font-weight:700;color:var(--text3);width:20px">${i+1}</span><div style="flex:1"><p style="font-size:13px;font-weight:600">${name}</p><div style="height:4px;background:var(--bg3);border-radius:2px;margin-top:4px"><div style="height:100%;background:var(--primary);border-radius:2px;width:${Math.round(qty/max*100)}%"></div></div></div><span style="font-size:13px;font-weight:700">${qty}</span></div>`).join('');
