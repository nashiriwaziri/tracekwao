async function saveProduct(id) {
  const name = document.getElementById('pmName').value.trim();
  const category = document.getElementById('pmCat').value;
  const buyingPrice = parseFloat(document.getElementById('pmBuy').value)||0;
  const sellingPrice = parseFloat(document.getElementById('pmSell').value)||0;
  const stock = parseInt(document.getElementById('pmStock').value)||0;
  if(!name) { toast(t('fillRequired'),'e'); return; }
  try {
    const data = { name, category, buyingPrice, sellingPrice, stock, businessId: State.currentBizId, updatedAt: serverTimestamp() };
    if(id) { await updateDoc(doc(db,'products',id), data); }
    else { data.createdAt = serverTimestamp(); await addDoc(collection(db,'products'), data); }
    closeModal(); toast(t('savedSuccessfully'),'s');
    await loadProducts(); renderProducts();
  } catch(e) { console.error('[SAVE PRODUCT]',e); toast(t('errorOccurred'),'e'); }
}

