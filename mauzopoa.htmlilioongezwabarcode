async function confirmPayDebt(id) {
  const debt = State.cachedDebts.find(d => d.id === id);
  if (!debt) return;
  const paid = parseFloat(document.getElementById('payDebtAmt').value) || 0;
  if (paid <= 0) { toast(t('fillRequired'), 'e'); return; }
  const remaining = (debt.remaining || debt.amount) - paid;
  try {
    await updateDoc(doc(db, 'debts', id), {
      remaining: Math.max(0, remaining),
      status: remaining <= 0 ? 'paid' : 'partial',
      updatedAt: serverTimestamp()
    });
    closeModal(); toast(t('savedSuccessfully'), 's');
    await loadDebts(); renderDebts();
  } catch (e) { console.error('[PAY DEBT]', e); toast(t('errorOccurred'), 'e'); }
