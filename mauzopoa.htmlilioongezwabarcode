async function changePassword() {
  const curPass = document.getElementById('secCurPass').value;
  const newPass = document.getElementById('secNewPass').value;
  const confPass = document.getElementById('secConfPass').value;
  if (!curPass || !newPass || !confPass) { toast(t('fillRequired'), 'e'); return; }
  if (newPass !== confPass) { toast(t('passwordsNoMatch'), 'e'); return; }
  if (newPass.length < 6) { toast(t('weakPassword'), 'e'); return; }
  try {
    const user = auth.currentUser;
    if (!user) { toast(t('errorOccurred'), 'e'); return; }
    const credential = EmailAuthProvider.credential(user.email, curPass);
    await reauthenticateWithCredential(user, credential);
    await updatePassword(user, newPass);
    toast(t('passwordChanged'), 's');
    document.getElementById('secCurPass').value = '';
    document.getElementById('secNewPass').value = '';
    document.getElementById('secConfPass').value = '';
  } catch (e) {
    console.error('[CHANGE PASSWORD]', e);
    if (e.code === 'auth/wrong-password' || e.code === 'auth/invalid-credential') toast(t('wrongPassword'), 'e');
    else if (e.code === 'auth/weak-password') toast(t('weakPassword'), 'e');
    else toast(e.message || t('errorOccurred'), 'e');
  }
}

/* ===== SUPER ADMIN — WITH USER MANAGEMENT FROM CODE 2 ===== */
let _suUsers = [];
let _suSearch = '';
let _suStatusFilter = 'all';
let _suRoleFilter = 'all';

async function superAdminLogin() {
  const email = document.getElementById('superEmail').value.trim();
  const pass = document.getElementById('superPass').value;
  const errEl = document.getElementById('superErr');
  if (!email || !pass) { errEl.textContent = t('fillRequired'); return; }
  const btn = document.getElementById('superLoginBtn');
  btn.disabled = true;
  btn.innerHTML = '<div class="spinner" style="width:18px;height:18px;border-width:2px"></div>';
  try {
    await signInWithEmailAndPassword(auth, email, pass);
    const userDoc = await getDoc(doc(db, 'users', auth.currentUser.uid));
    if (!userDoc.exists() || userDoc.data().role !== 'superuser') {
      errEl.textContent = 'Huna ruhusa ya Super Admin.';
      await signOut(auth);
      return;
    }
    State.currentUserId = auth.currentUser.uid;
    State.currentUserData = userDoc.data();
    document.getElementById('superLogin').classList.add('hidden');
    document.getElementById('superPanel').classList.remove('hidden');
    await loadSuperData();
    renderSuperPanel();
  } catch (e) {
    console.error('[SUPER LOGIN]', e);
    if (e.code === 'auth/invalid-credential' || e.code === 'auth/wrong-password' || e.code === 'auth/user-not-found') errEl.textContent = t('invalidCredentials');
    else errEl.textContent = e.message || t('errorOccurred');
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-sign-in-alt"></i> Ingia';
  }
}

async function loadSuperData() {
  try {
    const snap = await getDocs(query(collection(db, 'users'), orderBy('createdAt', 'desc')));
    _suUsers = snap.docs.map(d => ({ id: d.id, ...d.data() }));
  } catch (e) { console.error('[SUPER LOAD USERS]', e); _suUsers = []; }
}

function renderSuperPanel() {
  const totalUsers = _suUsers.length;
  const activeUsers = _suUsers.filter(u => u.status !== 'suspended').length;
  const suspendedUsers = _suUsers.filter(u => u.status === 'suspended').length;
  const businesses = [...new Set(_suUsers.map(u => u.businessId).filter(Boolean))].length;

  document.getElementById('superBody').innerHTML = `
    <div class="super-metrics">
      <div class="sm-card"><h4>Watumiaji Wote</h4><div class="sm-val">${totalUsers}</div><div class="sm-sub">Registered users</div></div>
      <div class="sm-card"><h4>Watumiaji Hai</h4><div class="sm-val" style="color:var(--success)">${activeUsers}</div><div class="sm-sub">Active accounts</div></div>
      <div class="sm-card"><h4>Watumiaji Wamesitishwa</h4><div class="sm-val" style="color:var(--danger)">${suspendedUsers}</div><div class="sm-sub">Suspended accounts</div></div>
      <div class="sm-card"><h4>Biashara</h4><div class="sm-val" style="color:var(--primary2)">${businesses}</div><div class="sm-sub">Registered businesses</div></div>
    </div>
    <div class="super-card">
      <div class="super-toolbar">
        <div><h2>User Management</h2><p>Manage all system users</p></div>
        <div class="super-toolbar-actions">
          <input id="suSearchInput" placeholder="Tafuta mtumiaji..." oninput="_suSearch=this.value.toLowerCase();_renderSuUsers()"/>
          <select class="fi" style="width:auto" id="suRoleFilter" onchange="_suRoleFilter=this.value;_renderSuUsers()">
            <option value="all">All Roles</option>
            <option value="manager">Manager</option>
            <option value="staff">Staff</option>
            <option value="cashier">Cashier</option>
            <option value="seller">Seller</option>
            <option value="superuser">Super Admin</option>
          </select>
          <select class="fi" style="width:auto" id="suStatusFilter" onchange="_suStatusFilter=this.value;_renderSuUsers()">
            <option value="all">All Status</option>
            <option value="active">Active</option>
            <option value="suspended">Suspended</option>
          </select>
        </div>
      </div>
      <div class="super-table-card"><div class="table-scroll">
        <table class="super-table">
          <thead><tr><th>User</th><th>Email</th><th>Role</th><th>Status</th><th>Business ID</th><th>Created</th><th>Last Activity</th><th>Actions</th></tr></thead>
          <tbody id="suUsersTbody"></tbody>
        </table>
      </div></div>
    </div>`;
  _renderSuUsers();
}

function _renderSuUsers() {
  let list = [..._suUsers];
  if (_suSearch) list = list.filter(u => (u.name || '').toLowerCase().includes(_suSearch) || (u.email || '').toLowerCase().includes(_suSearch) || (u.phone || '').includes(_suSearch) || (u.id || '').includes(_suSearch));
  if (_suRoleFilter !== 'all') list = list.filter(u => u.role === _suRoleFilter);
  if (_suStatusFilter !== 'all') list = list.filter(u => u.status === _suStatusFilter);

  const tbody = document.getElementById('suUsersTbody');
  if (!tbody) return;
  if (!list.length) { tbody.innerHTML = `<tr><td colspan="8" class="empty-s"><p>${t('noData')}</p></td></tr>`; return; }

  const roleColors = { superuser: 'var(--danger)', manager: 'var(--warning)', staff: 'var(--info)', cashier: 'var(--success)', seller: 'var(--primary2)' };
  tbody.innerHTML = list.map(u => {
    const isActive = u.status !== 'suspended';
    const color = roleColors[u.role] || 'var(--text3)';
    return `<tr>
      <td><div style="display:flex;align-items:center;gap:8px"><div class="emp-av" style="background:${color};width:30px;height:30px;font-size:11px;flex-shrink:0">${getInitials(u.name)}</div><span style="font-weight:600">${u.name || '-'}</span></div></td>
      <td style="font-size:12px">${u.email || '-'}</td>
      <td><span class="emp-tag role" style="background:${color}20;color:${color}">${u.role || '-'}</span></td>
      <td><span class="status-badge ${isActive ? 'active' : 'suspended'}">${isActive ? 'Active' : 'Suspended'}</span></td>
      <td style="font-size:10px;font-family:monospace;color:var(--text3)">${u.businessId ? u.businessId.substring(0, 12) + '...' : '-'}</td>
      <td style="font-size:12px">${fmtDate(u.createdAt)}</td>
      <td style="font-size:12px">${fmtDateTime(u.lastActivity)}</td>
      <td class="actions-cell">
        <button class="btn btn-xs btn-o" onclick="suViewUser('${u.id}')" title="View"><i class="fas fa-eye"></i></button>
        <button class="btn btn-xs btn-o" onclick="suEditUser('${u.id}')" title="Edit"><i class="fas fa-edit"></i></button>
        ${u.role !== 'superuser' ? (isActive
          ? `<button class="btn btn-xs btn-w" onclick="suSuspendUser('${u.id}','${u.name}')" title="Suspend"><i class="fas fa-ban"></i></button>`
          : `<button class="btn btn-xs btn-s" onclick="suActivateUser('${u.id}','${u.name}')" title="Activate"><i class="fas fa-check"></i></button>`
        ) : ''}
        ${u.role !== 'superuser' ? `<button class="btn btn-xs btn-d" onclick="suDeleteUser('${u.id}','${u.name}')" title="Delete"><i class="fas fa-trash"></i></button>` : ''}
      </td>
    </tr>`;
  }).join('');
}

/* Super Admin: View User Details - FROM CODE 2 */
function suViewUser(userId) {
  const u = _suUsers.find(x => x.id === userId);
  if (!u) return;
  const roleColors = { superuser: 'var(--danger)', manager: 'var(--warning)', staff: 'var(--info)', cashier: 'var(--success)', seller: 'var(--primary2)' };
  const color = roleColors[u.role] || 'var(--primary)';
  openModal(`<div class="modal-head"><h3>User Details</h3><button onclick="closeModal()"><i class="fas fa-times"></i></button></div>
    <div style="text-align:center;margin-bottom:20px">
      <div class="emp-av" style="background:${color};width:64px;height:64px;font-size:24px;margin:0 auto 10px">${getInitials(u.name)}</div>
      <h3 style="font-size:18px">${u.name || '-'}</h3>
      <p style="color:var(--text2);font-size:13px">${u.email || '-'}</p>
    </div>
    <div style="display:grid;gap:10px">
      <div style="display:flex;justify-content:space-between;padding:10px;background:var(--bg3);border-radius:8px"><span style="color:var(--text2)">Phone</span><span style="font-weight:600">${u.phone || '-'}</span></div>
      <div style="display:flex;justify-content:space-between;padding:10px;background:var(--bg3);border-radius:8px"><span style="color:var(--text2)">Role</span><span class="emp-tag role" style="background:${color}20;color:${color}">${u.role || '-'}</span></div>
      <div style="display:flex;justify-content:space-between;padding:10px;background:var(--bg3);border-radius:8px"><span style="color:var(--text2)">Status</span><span class="status-badge ${u.status === 'suspended' ? 'suspended' : 'active'}">${u.status === 'suspended' ? 'Suspended' : 'Active'}</span></div>
      <div style="display:flex;justify-content:space-between;padding:10px;background:var(--bg3);border-radius:8px"><span style="color:var(--text2)">Business ID</span><span style="font-size:11px;font-family:monospace;color:var(--text3);word-break:break-all">${u.businessId || '-'}</span></div>
      <div style="display:flex;justify-content:space-between;padding:10px;background:var(--bg3);border-radius:8px"><span style="color:var(--text2)">User UID</span><span style="font-size:11px;font-family:monospace;color:var(--text3);word-break:break-all">${u.id}</span></div>
      <div style="display:flex;justify-content:space-between;padding:10px;background:var(--bg3);border-radius:8px"><span style="color:var(--text2)">Created</span><span>${fmtDateTime(u.createdAt)}</span></div>
      <div style="display:flex;justify-content:space-between;padding:10px;background:var(--bg3);border-radius:8px"><span style="color:var(--text2)">Last Activity</span><span>${fmtDateTime(u.lastActivity)}</span></div>
      <div style="display:flex;justify-content:space-between;padding:10px;background:var(--bg3);border-radius:8px"><span style="color:var(--text2)">Language</span><span>${u.lang || 'sw'}</span></div>
    </div>
    <div class="modal-actions"><button class="btn btn-o" onclick="closeModal()">${t('close')}</button></div>`, 'wide');
}

/* Super Admin: Edit User - FROM CODE 2 */
function suEditUser(userId) {
  const u = _suUsers.find(x => x.id === userId);
  if (!u) return;
  if (u.role === 'superuser') { toast('Huna ruhusa ya kuhariri Super Admin.', 'e'); return; }
  const roles = ['manager', 'staff', 'cashier', 'seller'];
  openModal(`<div class="modal-head"><h3>Edit User</h3><button onclick="closeModal()"><i class="fas fa-times"></i></button></div>
    <div class="fg"><label>${t('fullName')}</label><input class="fi" id="suEuName" value="${u.name || ''}"/></div>
    <div class="f-row c2">
      <div class="fg"><label>${t('phone')}</label><input class="fi" id="suEuPhone" value="${u.phone || ''}"/></div>
      <div class="fg"><label>${t('email')}</label><input class="fi" value="${u.email || ''}" readonly style="opacity:0.6"/></div>
    </div>
    <div class="fg"><label>Role</label><select class="fi" id="suEuRole">${roles.map(r => `<option value="${r}" ${u.role === r ? 'selected' : ''}>${r}</option>`).join('')}</select></div>
    <div class="modal-actions"><button class="btn btn-o" onclick="closeModal()">${t('cancel')}</button><button class="btn btn-p" onclick="suSaveEditUser('${userId}')">${t('save')}</button></div>`);
}

async function suSaveEditUser(userId) {
  const name = document.getElementById('suEuName').value.trim();
  const phone = document.getElementById('suEuPhone').value.trim();
  const role = document.getElementById('suEuRole').value;
  if (!name) { toast(t('fillRequired'), 'e'); return; }
  try {
    await updateDoc(doc(db, 'users', userId), { name, phone, role, updatedAt: serverTimestamp() });
    closeModal(); toast(t('savedSuccessfully'), 's');
    await loadSuperData(); renderSuperPanel();
  } catch (e) { console.error('[SU EDIT USER]', e); toast(t('errorOccurred'), 'e'); }
}

/* Super Admin: Suspend User - FROM CODE 2 */
function suSuspendUser(userId, userName) {
  showConfirm('Suspend this user account?', async () => {
    try {
      await updateDoc(doc(db, 'users', userId), { status: 'suspended', updatedAt: serverTimestamp() });
      toast(`${userName} suspended`, 'w');
      await loadSuperData(); renderSuperPanel();
    } catch (e) { console.error('[SU SUSPEND]', e); toast(t('errorOccurred'), 'e'); }
  }, userName);
}

/* Super Admin: Activate User - FROM CODE 2 */
async function suActivateUser(userId, userName) {
  try {
    await updateDoc(doc(db, 'users', userId), { status: 'active', updatedAt: serverTimestamp() });
    toast(`${userName} activated`, 's');
    await loadSuperData(); renderSuperPanel();
  } catch (e) { console.error('[SU ACTIVATE]', e); toast(t('errorOccurred'), 'e'); }
}

/* Super Admin: Delete User (Firestore profile only, NOT Auth) - FROM CODE 2 */
function suDeleteUser(userId, userName) {
  showConfirm('Delete this user profile? The Firebase Auth account will NOT be deleted from the client.', async () => {
    try {
      await deleteDoc(doc(db, 'users', userId));
      toast(`${userName} profile deleted`, 's');
      await loadSuperData(); renderSuperPanel();
    } catch (e) {
      console.error('[SU DELETE USER]', e);
      if (e.code === 'permission-denied') toast('Permission denied.', 'e');
      else toast(t('errorOccurred'), 'e');
    }
  }, userName);
}

function superLogout() {
  State.listeners.forEach(unsub => { if (typeof unsub === 'function') unsub(); });
  State.listeners = [];
  _suUsers = [];
  signOut(auth).catch(() => {});
  document.getElementById('superPanel').classList.add('hidden');
  document.getElementById('superLogin').classList.remove('hidden');
  document.getElementById('superEmail').value = '';
  document.getElementById('superPass').value = '';
  document.getElementById('superErr').textContent = '';
  showScreen('landingScreen');
}

/* ===== PUBLIC DATA ===== */
async function loadPublicData() {
  try {
    /* Public ads */
    const adsSnap = await getDocs(query(collection(db, 'ads'), where('status', 'in', ['active', 'featured']), orderBy('createdAt', 'desc'), limit(12)));
    const ads = adsSnap.docs.map(d => d.data());
    const adsGrid = document.getElementById('publicAdsGrid');
    if (adsGrid) {
      if (!ads.length) { adsGrid.innerHTML = `<div class="empty-s"><i class="fas fa-bullhorn"></i><p>${t('noAds')}</p></div>`; }
      else { adsGrid.innerHTML = ads.map(a => `<div class="pub-ad-card">${a.image ? `<img class="pub-ad-img" src="${a.image}" alt=""/>` : '<div class="pub-ad-img-placeholder"><i class="fas fa-image"></i></div>'}<div class="pub-ad-body"><h4>${a.title || ''}</h4><p>${(a.description || '').substring(0, 80)}${(a.description || '').length > 80 ? '...' : ''}</p></div></div>`).join(''); }
    }
    /* Public products */
    const prodSnap = await getDocs(query(collection(db, 'products'), orderBy('createdAt', 'desc'), limit(12)));
    const prods = prodSnap.docs.map(d => d.data());
    const prodGrid = document.getElementById('publicProductsGrid');
    if (prodGrid) {
      if (!prods.length) { prodGrid.innerHTML = `<div class="empty-s"><i class="fas fa-box-open"></i><p>${t('noProducts')}</p></div>`; }
      else { prodGrid.innerHTML = prods.map(p => `<div class="pub-prod-card">${p.image ? `<img class="pub-prod-img" src="${p.image}" alt=""/>` : '<div class="pub-prod-img-placeholder"><i class="fas fa-box"></i></div>'}<div class="pub-prod-body"><h4>${p.name || ''}</h4><div class="pub-prod-price">TZS ${fmt(p.sellingPrice)}</div></div></div>`).join(''); }
    }
  } catch (e) { console.error('[PUBLIC DATA]', e); }
}

/* ===== PRICE CALCULATOR ===== */
function openPriceCalc() { document.getElementById('priceCalcModal').classList.add('show'); }
function closePriceCalc() { document.getElementById('priceCalcModal').classList.remove('show'); }

window.calculatePrice = function () {
  const cost = parseFloat(document.getElementById('pcCost').value) || 0;
  const margin = parseFloat(document.getElementById('pcMargin').value) || 0;
  const tax = parseFloat(document.getElementById('pcTax').value) || 0;
  if (cost <= 0) { document.getElementById('pcResult').style.display = 'none'; return; }
  const base = cost * (1 + margin / 100);
  const finalPrice = base * (1 - tax / 100);
  document.getElementById('pcResultVal').textContent = 'TZS ' + fmt(Math.round(finalPrice));
  document.getElementById('pcResult').style.display = 'block';
};

