async function handleLogout() {
  closeUserDd();
  State.listeners.forEach(unsub => { if(typeof unsub==='function') unsub(); });
  State.listeners = [];
  State.cart = [];
  Object.values(State.charts).forEach(c => { if(c&&c.destroy) c.destroy(); });
