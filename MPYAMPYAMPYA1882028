function loadDashboard() {
  const totalProducts = state.products.length;
  const totalSales = state.sales.length;
  const totalRevenue = state.sales.reduce((s, x) => s + (x.total || 0), 0);
  const totalDebt = state.debts.reduce((s, x) => s + ((x.amount || 0) - (x.paid || 0)), 0);
  const totalExpenses = state.expenses.reduce((s, x) => s + (x.amount || 0), 0);
  const profit = totalRevenue - totalExpenses;

  document.getElementById('dashMetrics').innerHTML = `
    <div class="mc pu"><div class="mc-icon"><i class="fas fa-box-open"></i></div><h3>${totalProducts}</h3><p>Bidhaa</p></div>
    <div class="mc g"><div class="mc-icon"><i class="fas fa-receipt"></i></div><h3>${totalSales}</h3><p>Mauzo</p></div>
    <div class="mc a"><div class="mc-icon"><i class="fas fa-money-bill-wave"></i></div><h3>${fmt(totalRevenue)}</h3><p>Mapato (TZS)</p></div>
    <div class="mc b"><div class="mc-icon"><i class="fas fa-hand-holding-dollar"></i></div><h3>${fmt(totalDebt)}</h3><p>Madeni (TZS)</p></div>
    <div class="mc r"><div class="mc-icon"><i class="fas fa-arrow-trend-down"></i></div><h3>${fmt(totalExpenses)}</h3><p>Matumizi (TZS)</p></div>
    <div class="mc ${profit >= 0 ? 'g' : 'r'}"><div class="mc-icon"><i class="fas fa-chart-pie"></i></div><h3>${fmt(profit)}</h3><p>Faida (TZS)</p></div>`;

  // Recent sales table
  const recent = state.sales.slice(0, 8);
  document.getElementById('dashRecentSales').innerHTML = recent.length ? recent.map(s => `
    <tr><td>${fmtDateTime(s.createdAt)}</td><td>${s.customerName || '—'}</td><td style="color:var(--success);font-weight:600">${fmt(s.total)} TZS</td><td>${s.paymentMethod || 'cash'}</td></tr>`).join('')
    : '<tr><td colspan="4" class="empty-s"><p>Hakuna mauzo bado</p></td></tr>';

  // Charts
  renderDashCharts();
}

function renderDashCharts() {
  const ctx1 = document.getElementById('dashChartSales');
  const ctx2 = document.getElementById('dashChartCategory');
  if (!ctx1 || !ctx2) {
    // Create chart containers if not exist
    const cg = document.getElementById('dashCharts');
    if (!cg.querySelector('canvas')) {
      cg.innerHTML = `
        <div class="ch-c"><h4><i class="fas fa-chart-bar"></i> Mauzo ya Miezi 6</h4><div class="ch-box"><canvas id="dashChartSales"></canvas></div></div>
        <div class="ch-c"><h4><i class="fas fa-chart-pie"></i> Bidhaa kwa Category</h4><div class="ch-box"><canvas id="dashChartCategory"></canvas></div></div>`;
    }
  }
  const c1 = document.getElementById('dashChartSales');
  const c2 = document.getElementById('dashChartCategory');
  if (!c1 || !c2) return;

  destroyChart('dashSales');
  destroyChart('dashCategory');

  // Sales by month
  const monthData = {};
  const now = new Date();
  for (let i = 5; i >= 0; i--) {
    const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
    const key = d.toLocaleDateString('sw-TZ', { month: 'short' });
    monthData[key] = 0;
  }
  state.sales.forEach(s => {
    if (s.createdAt) {
      const d = s.createdAt.toDate ? s.createdAt.toDate() : new Date(s.createdAt);
      const key = d.toLocaleDateString('sw-TZ', { month: 'short' });
      if (monthData[key] !== undefined) monthData[key] += (s.total || 0);
    }
  });

  state.charts.dashSales = new Chart(c1, {
    type: 'bar',
    data: { labels: Object.keys(monthData), datasets: [{ label: 'Mauzo (TZS)', data: Object.values(monthData), backgroundColor: 'rgba(108,92,231,.6)', borderColor: '#6c5ce7', borderWidth: 1, borderRadius: 6 }] },
    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { color: '#9a9ab0' }, grid: { color: 'rgba(255,255,255,.05)' } }, x: { ticks: { color: '#9a9ab0' }, grid: { display: false } } } }
  });

  // Category distribution
  const catData = {};
  state.products.forEach(p => { const c = p.category || 'Hakuna'; catData[c] = (catData[c] || 0) + 1; });
  const catColors = ['#6c5ce7','#00b894','#e74c3c','#f39c12','#0984e3','#e84393','#00cec9','#fd79a8'];

  state.charts.dashCategory = new Chart(c2, {
    type: 'doughnut',
    data: { labels: Object.keys(catData), datasets: [{ data: Object.values(catData), backgroundColor: catColors.slice(0, Object.keys(catData).length), borderWidth: 0 }] },
    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { color: '#9a9ab0', padding: 12, font: { size: 11 } } } } }
  });
}

function destroyChart(key) {
  if (state.charts[key]) { state.charts[key].destroy(); state.charts[key] = null; }
}

