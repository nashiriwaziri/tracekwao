function buildSidebar() {
  const nav = document.getElementById('sidebarNav');
  const allowed = ROLE_SECTIONS[state.userProfile.role] || [];
  let html = '';
  let lastGroup = '';
  SIDEBAR_ITEMS.forEach(item => {
    if (!allowed.includes(item.id)) return;
    if (item.group !== lastGroup) {
      html += `<div class="sb-lbl">${item.group}</div>`;
      lastGroup = item.group;
    }
    const notifBadge = item.id === 'notifications' ? '<span class="bdg hidden" id="sidebarNotifBadge">0</span>' : '';
    html += `<div class="ni${item.id === state.currentSection ? ' active' : ''}" data-section="${item.id}" onclick="navigateTo('${item.id}')"><i class="fas ${item.icon}"></i> ${item.label}${notifBadge}</div>`;
  });
  nav.innerHTML = html;
}

