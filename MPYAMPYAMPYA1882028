function nextRegStep(step) {
  [1, 2, 3].forEach(s => {
    document.getElementById(`regStep${s}`).classList.toggle('hidden', s !== step);
    document.getElementById(`regDot${s}`).classList.toggle('on', s <= step);
  });
}

