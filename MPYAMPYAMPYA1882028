// ============================================
// UTILITY FUNCTIONS
// ============================================
function fmt(n) { return Number(n || 0).toLocaleString('sw-TZ'); }
function fmtDate(ts) {
  if (!ts) return '—';
  const d = ts.toDate ? ts.toDate() : new Date(ts);
  return d.toLocaleDateString('sw-TZ', { day: '2-digit', month: 'short', year: 'numeric' });
}
function fmtDateTime(ts) {
  if (!ts) return '—';
  const d = ts.toDate ? ts.toDate() : new Date(ts);
  return d.toLocaleDateString('sw-TZ', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
}
function genId() { return Date.now().toString(36) + Math.random().toString(36).substr(2, 6); }
function getBizId() { return state.userProfile?.businessId || state.currentUser?.uid; }
function getInitials(name) { return (name || 'U').split(' ').map(w => w[0]).join('').toUpperCase().slice(0, 2); }
const avatarColors = ['#6c5ce7','#00b894','#e74c3c','#f39c12','#0984e3','#e84393','#00cec9','#fd79a8'];
function getAvatarColor(name) { let h = 0; for (let i = 0; i < (name||'').length; i++) h = name.charCodeAt(i) + ((h << 5) - h); return avatarColors[Math.abs(h) % avatarColors.length]; }

// ============================================
// TOAST NOTIFICATIONS
// ============================================
function toast(msg, type = 'i') {
  const c = document.getElementById('toastContainer');
  const t = document.createElement('div');
  const icons = { s: 'fa-check-circle', e: 'fa-times-circle', i: 'fa-info-circle', w: 'fa-exclamation-triangle' };
  t.className = `toast ${type}`;
  t.innerHTML = `<i class="fas ${icons[type] || icons.i}"></i> ${msg}`;
  c.appendChild(t);
  setTimeout(() => { t.style.opacity = '0'; t.style.transform = 'translateX(100%)'; t.style.transition = 'all .3s'; setTimeout(() => t.remove(), 300); }, 3500);
}

