  state.currentSection = sectionId;
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  const sec = document.getElementById(`sec-${sectionId}`);
  if (sec) sec.classList.add('active');
  document.querySelectorAll('.ni').forEach(n => n.classList.toggle('active', n.dataset.section === sectionId));
  const titles = { dashboard:'Dashboard', financial:'Dashboard ya Fedha', pos:'Point of Sale', products:'Bidhaa', sales:'Mauzo', purchases:'Manunuzi', suppliers:'Wauzaji', customers:'Wateja', debts:'Madeni', expenses:'Matumizi', employees:'Wafanyakazi', notifications:'Arifa', profile:'Profaili', users:'Watumiaji' };
  document.getElementById('topbarSectionTitle').textContent = titles[sectionId] || '';
  closeSidebar();
  // Load section data
  const loaders = { dashboard: loadDashboard, financial: loadFinancialDashboard, pos: () => { renderPosProducts(); }, products: renderProducts, sales: renderSales, purchases: renderPurchases, suppliers: renderSuppliers, customers: renderCustomers, debts: renderDebts, expenses: renderExpenses, employees: renderEmployees, notifications: loadNotifications, profile: loadProfile, users: renderUsers };
