async function handleRegister(e) {
  e.preventDefault();
  hideAuthErr();
  const name = document.getElementById('regName').value.trim();
  const email = document.getElementById('regEmail').value.trim();
  const phone = document.getElementById('regPhone').value.trim();
  const bizName = document.getElementById('regBizName').value.trim();
  const bizCategory = document.getElementById('regBizCategory').value;
  const password = document.getElementById('regPassword').value;
  const confirm = document.getElementById('regConfirm').value;

  if (!name || !email || !bizName || !bizCategory || !password) {
    showAuthErr('Tafadhali jaza sehemu zote zinazohitajika.');
    nextRegStep(1);
    return;
  }
  if (password !== confirm) {
    showAuthErr('Nenosiri haifanani.');
    nextRegStep(3);
    return;
  }
  if (password.length < 6) {
    showAuthErr('Nenosiri lazima iwe na herufi 6 au zaidi.');
    nextRegStep(3);
    return;
  }

  try {
    const cred = await createUserWithEmailAndPassword(auth, email, password);
    const uid = cred.user.uid;
    await setDoc(doc(db, 'users', uid), {
      name, email, phone, businessName: bizName, businessCategory: bizCategory,
      businessLogo: '', role: '', businessId: uid, createdBy: uid,
      status: 'active', createdAt: serverTimestamp()
    });
    state.currentUser = cred.user;
    state.userProfile = { name, email, phone, businessName: bizName, businessCategory: bizCategory, businessLogo: '', role: '', businessId: uid };
    document.getElementById('rsBizName').textContent = bizName;
    document.getElementById('rsBizCategory').textContent = bizCategory;
    showScreen('roleScreen');
    toast('Akaunti imeundwa! Chagua jukumu lako.', 's');
  } catch (err) {
    console.error('Registration error:', err);
    const msgs = { 'auth/email-already-in-use': 'Barua pepe tayari inatumika.', 'auth/weak-password': 'Nenosiri ni dhaifu.', 'auth/invalid-email': 'Barua pepe si sahihi.' };
    showAuthErr(msgs[err.code] || 'Imeshindwa kusajili. Jaribu tena.');
  }
}

async function handleLogin(e) {
  e.preventDefault();
  hideAuthErr();
  const email = document.getElementById('loginEmail').value.trim();
  const password = document.getElementById('loginPassword').value;
  if (!email || !password) { showAuthErr('Jaza barua pepe na nenosiri.'); return; }
  try {
    const cred = await signInWithEmailAndPassword(auth, email, password);
    // onAuthStateChanged will handle the rest
  } catch (err) {
    console.error('Login error:', err);
    const msgs = { 'auth/user-not-found': 'Akaunti haipo.', 'auth/wrong-password': 'Nenosiri si sahihi.', 'auth/invalid-email': 'Barua pepe si sahihi.', 'auth/invalid-credential': 'Barua pepe au nenosiri si sahihi.' };
    showAuthErr(msgs[err.code] || 'Imeshindwa kuingia. Jaribu tena.');
  }
}

async function handleResetPassword() {
  const email = document.getElementById('loginEmail').value.trim();
  if (!email) { showAuthErr('Ingiza barua pepe kwanza ili kubadilisha nenosiri.'); return; }
