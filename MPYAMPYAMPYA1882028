// ============================================
// AUTH STATE OBSERVER
// ============================================
onAuthStateChanged(auth, async (user) => {
  if (!user) {
    state.currentUser = null;
    state.userProfile = null;
    return;
  }
  state.currentUser = user;
  try {
    const userDoc = await getDoc(doc(db, 'users', user.uid));
    if (userDoc.exists()) {
      const data = userDoc.data();
      state.userProfile = data;
      if (data.role === 'super_admin') {
        showScreen('superScreen');
        document.getElementById('superLoginBox').classList.add('hidden');
        document.getElementById('superPanel').classList.remove('hidden');
        loadSuperAdminData();
      } else if (data.role) {
        enterApp();
      } else {
        document.getElementById('rsBizName').textContent = data.businessName || '—';
        document.getElementById('rsBizCategory').textContent = data.businessCategory || '—';
        showScreen('roleScreen');
      }
    } else {
      showScreen('authScreen');
      switchAuthTab('login');
    }
  } catch (err) {
    console.error('Auth state error:', err);
    showScreen('authScreen');
    switchAuthTab('login');
  }
});

