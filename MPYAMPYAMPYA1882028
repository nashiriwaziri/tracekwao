// ============================================
function calcPrice() {
  const cost = parseFloat(document.getElementById('pcCost').value) || 0;
  const overhead = parseFloat(document.getElementById('pcOverhead').value) || 0;
  const margin = parseFloat(document.getElementById('pcMargin').value) || 0;
  const price = cost * (1 + overhead / 100) * (1 + margin / 100);
  document.getElementById('pcPrice').textContent = fmt(Math.round(price));
}
