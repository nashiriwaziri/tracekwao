  if (state.notifications.length === 0) {
    const empty = '<div class="empty-s"><i class="fas fa-bell-slash"></i><p>Hakuna arifa</p></div>';
    list.innerHTML = empty;
    panel.innerHTML = empty;
    return;
  }
  const icons = { info: 'fa-info-circle', success: 'fa-check-circle', warning: 'fa-exclamation-triangle', error: 'fa-times-circle' };
  const colors = { info: 'var(--info)', success: 'var(--success)', warning: 'var(--warning)', error: 'var(--danger)' };
  const html = state.notifications.map(n => `
    <div class="notif-item" style="opacity:${n.read ? 0.6 : 1}">
      <i class="fas ${icons[n.type] || icons.info}" style="color:${colors[n.type] || colors.info}"></i>
      <div><h5>${n.title}</h5><p>${n.message}</p><p style="margin-top:4px;font-size:10px">${fmtDateTime(n.createdAt)}</p></div>
    </div>`).join('');
  list.innerHTML = html;
  panel.innerHTML = html;
}

function updateNotifBadge() {
  const unread = state.notifications.filter(n => !n.read).length;
  const cnt = document.getElementById('notifCount');
  const badge = document.getElementById('sidebarNotifBadge');
  if (unread > 0) {
    cnt.textContent = unread; cnt.classList.remove('hidden');
    if (badge) { badge.textContent = unread; badge.classList.remove('hidden'); }
  } else {
    cnt.classList.add('hidden');
    if (badge) badge.classList.add('hidden');
  }
}

