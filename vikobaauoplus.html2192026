<!DOCTYPE html>
<html lang="sw">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>CSCMS Pro V3 — International Vikoba & Microfinance</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<style>
:root{--bg:#07111f;--panel:#0d1929;--panel2:#122238;--line:#21344d;--text:#e8f0f8;--muted:#8ea3b9;--p:#16a979;--p2:#35d39b;--blue:#3b82f6;--red:#ef4444;--yellow:#f59e0b;--purple:#8b5cf6;--radius:12px}*{box-sizing:border-box}body{margin:0;background:linear-gradient(135deg,#06101c,#0a1423);color:var(--text);font-family:Inter,Arial,sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer}.hidden{display:none!important}.landing{min-height:100vh}.hero{text-align:center;padding:65px 20px 30px}.logo{width:72px;height:72px;border-radius:18px;background:linear-gradient(135deg,var(--p),#07563f);display:grid;place-items:center;margin:auto;font-size:30px}.brand{font-size:40px;font-weight:800;margin:12px 0 5px}.tag{color:var(--muted);font-size:14px}.hero-actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:25px}.btn{border:0;border-radius:9px;padding:10px 15px;font-weight:600;font-size:12px}.primary{background:var(--p);color:#fff}.outline{background:transparent;color:var(--p2);border:1px solid var(--p)}.danger{background:var(--red);color:#fff}.info{background:var(--blue);color:#fff}.warning{background:var(--yellow);color:#111}.mutedbtn{background:var(--panel2);color:var(--text);border:1px solid var(--line)}.container{max-width:1200px;margin:auto;padding:20px}.public-grid,.metrics,.grid{display:grid;gap:14px}.public-grid{grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}.card{background:rgba(13,25,41,.96);border:1px solid var(--line);border-radius:var(--radius);padding:18px}.ad{min-height:150px}.ad img{max-width:100%;max-height:170px;border-radius:9px;object-fit:cover}.auth{min-height:100vh;display:grid;place-items:center;padding:20px}.auth-card{width:min(520px,100%);background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:25px}.tabs{display:flex;background:var(--panel2);padding:4px;border-radius:10px;margin-bottom:18px}.tab{flex:1;background:none;color:var(--muted);border:0;padding:10px;border-radius:7px}.tab.active{background:var(--p);color:#fff}.field{margin:11px 0}.field label{display:block;font-size:11px;color:var(--muted);margin-bottom:5px}.field input,.field select,.field textarea{width:100%;padding:11px;border:1px solid var(--line);background:#091625;color:var(--text);border-radius:8px}.row{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.small{font-size:11px;color:var(--muted)}.app{min-height:100vh}.sidebar{position:fixed;left:0;top:0;bottom:0;width:270px;background:#091625;border-right:1px solid var(--line);overflow:auto;z-index:20}.side-head{padding:18px;border-bottom:1px solid var(--line);font-weight:800}.nav{padding:10px}.nav-title{font-size:10px;color:#61758d;text-transform:uppercase;margin:14px 9px 5px;font-weight:700}.nav button{width:100%;text-align:left;background:none;color:var(--muted);border:0;padding:10px;border-radius:8px}.nav button:hover,.nav button.active{background:#10243a;color:var(--p2)}.nav i{width:22px}.main{margin-left:270px;min-height:100vh}.top{height:62px;position:sticky;top:0;z-index:15;background:rgba(9,22,37,.96);border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;padding:0 20px}.content{padding:22px}.metrics{grid-template-columns:repeat(auto-fit,minmax(160px,1fr));margin-bottom:18px}.metric h3{font-size:24px;margin:5px 0}.metric p{font-size:11px;color:var(--muted);margin:0}.grid2{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}.grid3{grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}.section{display:none}.section.active{display:block}.section-head{display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:18px}.section-head h2{margin:0}.actions{display:flex;gap:7px;flex-wrap:wrap}.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:10px}.table{width:100%;border-collapse:collapse;font-size:12px}.table th,.table td{padding:10px;border-bottom:1px solid var(--line);text-align:left;white-space:nowrap}.table th{background:#101f33;color:var(--muted);font-size:10px;text-transform:uppercase}.badge{padding:4px 7px;border-radius:20px;font-size:9px;background:#18304a}.ok{background:#0b3a2c;color:#55e1ae}.warn{background:#3c2b08;color:#ffc857}.bad{background:#40151a;color:#ff7b85}.modal{position:fixed;inset:0;background:#000b;display:none;align-items:center;justify-content:center;z-index:100;padding:15px}.modal.show{display:flex}.modal-card{width:min(720px,100%);max-height:92vh;overflow:auto;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:20px}.modal-head{display:flex;justify-content:space-between;align-items:center}.close{background:none;border:0;color:var(--muted);font-size:20px}.toast{position:fixed;right:18px;bottom:18px;z-index:200;background:#10243a;border:1px solid var(--line);padding:12px 15px;border-radius:9px;display:none}.toast.show{display:block}.super{min-height:100vh}.super-top{padding:16px 22px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between}.super-body{padding:22px;max-width:1400px;margin:auto}.chip{font-size:10px;color:var(--muted)}@media(max-width:850px){.sidebar{transform:translateX(-100%)}.sidebar.open{transform:translateX(0)}.main{margin-left:0}.row{grid-template-columns:1fr}.top{padding:0 12px}.content{padding:14px}}
</style>
</head>
<body>
<div id="landing" class="landing">
  <section class="hero"><div class="logo"><i class="fa-solid fa-people-group"></i></div><div class="brand">CSCMS Pro</div><div class="tag">Vikoba • Microfinance • Savings • Shares • Loans • Governance</div><div class="hero-actions"><button class="btn primary" onclick="openAuth('member')"><i class="fa-solid fa-right-to-bracket"></i> Ingia Kikundi</button><button class="btn outline" onclick="openAuth('chair')"><i class="fa-solid fa-user-tie"></i> Sajili Kikundi</button><button class="btn mutedbtn" onclick="openSuper()"><i class="fa-solid fa-shield-halved"></i> Super Admin</button></div></section>
  <div class="container"><div class="section-head"><h2>Matangazo ya Mfumo</h2><span class="small">Yanaonekana kwa wageni na watumiaji wote</span></div><div id="publicAds" class="public-grid"></div></div>
</div>

<div id="auth" class="auth hidden"><div class="auth-card"><div class="section-head"><div><h2 id="authTitle">Ingia Kikundi</h2><div class="small">Taarifa za kifedha zinaonyeshwa ndani ya kikundi husika pekee.</div></div><button class="close" onclick="backLanding()">×</button></div><div id="authMsg" class="small"></div>
<div class="tabs"><button id="memberTab" class="tab active" onclick="authMode('member')">Mwanachama</button><button id="chairTab" class="tab" onclick="authMode('chair')">Chairperson</button></div>
<form id="memberLogin"><div class="field"><label>Group Username</label><input id="loginGroupUsername" required placeholder="mfano: kikundichaamani"></div><div class="field"><label>Namba ya Simu</label><input id="loginPhone" required placeholder="07XXXXXXXX"></div><div id="recaptcha-container"></div><button class="btn primary" style="width:100%" type="submit">Tuma OTP / Ingia</button></form>
<form id="chairLogin" class="hidden"><div class="field"><label>Email ya Chairperson</label><input id="chairEmail" type="email" required></div><div class="field"><label>Password</label><input id="chairPassword" type="password" required></div><button class="btn primary" style="width:100%">Ingia</button></form>
<hr style="border-color:var(--line);margin:22px 0"><form id="chairRegister" class="hidden"><h3>Sajili Kikundi Kipya</h3><div class="row"><div class="field"><label>Jina la Kikundi</label><input id="regGroupName"></div><div class="field"><label>Group Username</label><input id="regGroupUsername"></div></div><div class="row"><div class="field"><label>Jina la Chairperson</label><input id="regChairName"></div><div class="field"><label>Simu</label><input id="regChairPhone"></div></div><div class="field"><label>Email</label><input id="regChairEmail" type="email"></div><div class="field"><label>Password</label><input id="regChairPassword" type="password" minlength="8"></div><button class="btn outline" type="submit">Sajili Kikundi</button></form>
</div></div>

<div id="super" class="super hidden"><div class="super-top"><div><b>CSCMS SUPER ADMIN</b><div class="small">Global system administration</div></div><button class="btn outline" onclick="superLogout()">Logout</button></div><div class="super-body"><div class="metrics" id="superMetrics"></div><div class="grid grid2"><div class="card"><div class="section-head"><h3>Vikundi Vilivyojiunga</h3><button class="btn primary" onclick="openModal('globalAdModal')">+ Global Ad</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Kikundi</th><th>Username</th><th>Wanachama</th><th>Status</th><th>Created</th></tr></thead><tbody id="superGroups"></tbody></table></div></div><div class="card"><div class="section-head"><h3>Matangazo ya Mfumo</h3></div><div id="superAds"></div></div></div></div></div>

<div id="app" class="app hidden"><aside id="sidebar" class="sidebar"><div class="side-head"><i class="fa-solid fa-people-group"></i> <span id="sideGroup">CSCMS</span><div class="small" id="sideRole"></div></div><nav class="nav" id="nav"></nav></aside><main class="main"><header class="top"><div><button class="btn mutedbtn" onclick="toggleSidebar()">☰</button> <b id="pageTitle">Dashibodi</b></div><div><span class="small" id="topUser"></span> <button class="btn outline" onclick="logout()">Toka</button></div></header><div class="content">
<section id="dashboard" class="section active"><div class="section-head"><div><h2>Dashibodi ya Kikundi</h2><div class="small" id="dashboardScope"></div></div><div class="actions"><button class="btn info" onclick="exportCurrentReport()">PDF/Print</button></div></div><div class="metrics" id="metrics"></div><div class="grid grid2"><div class="card"><h3>Muhtasari wa Fedha</h3><div id="financialSummary"></div></div><div class="card"><h3>Matangazo & Taarifa</h3><div id="dashboardAds"></div></div></div></section>
<section id="members" class="section"><div class="section-head"><div><h2>Wanachama</h2><div class="small">Wanachama wa kikundi hiki tu</div></div><div class="actions"><button class="btn primary chair-only" onclick="openModal('memberModal')">+ Ongeza Mwanachama</button><button class="btn outline" onclick="loadMembers()">Refresh</button></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Jina</th><th>Simu</th><th>Hisa</th><th>Akiba</th><th>Mkopo</th><th>Status</th><th>Actions</th></tr></thead><tbody id="membersBody"></tbody></table></div></section>
<section id="group" class="section"><div class="section-head"><div><h2>Kikundi</h2><div class="small">Taarifa za msingi, sera na mipangilio</div></div></div><div class="card"><form id="groupForm"><div class="row"><div class="field"><label>Jina</label><input id="gName"></div><div class="field"><label>Registration Number</label><input id="gReg"></div></div><div class="row"><div class="field"><label>Bei ya Hisa</label><input id="gSharePrice" type="number" min="0"></div><div class="field"><label>Maximum Shares per Member</label><input id="gMaxShares" type="number" min="0"></div></div><div class="row"><div class="field"><label>Meeting Day</label><input id="gMeetingDay"></div><div class="field"><label>Loan Interest %</label><input id="gInterest" type="number" step="0.01"></div></div><button class="btn primary chair-only">Hifadhi</button></form></div></section>
<section id="announcements" class="section"><div class="section-head"><div><h2>Matangazo ya Kikundi</h2><div class="small">Yanaonekana kwa wanachama wa kikundi hiki tu; hayaendi public landing.</div></div><button class="btn primary chair-only" onclick="openModal('groupAdModal')">+ Tangazo</button></div><div id="groupAds" class="public-grid"></div></section>
<section id="meetings" class="section"><div class="section-head"><div><h2>Vikao & Dakika</h2><div class="small">Taarifa wazi kwa kila mwanachama wa kikundi</div></div><button class="btn primary chair-only" onclick="openModal('meetingModal')">+ Kikao</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Tarehe</th><th>Mada</th><th>Maamuzi/Dakika</th><th>Action</th></tr></thead><tbody id="meetingsBody"></tbody></table></div></section>
<section id="savings" class="section"><div class="section-head"><div><h2>Akiba</h2><div class="small">Deposits, withdrawals, balances</div></div><div class="actions"><button class="btn primary chair-only" onclick="openModal('transactionModal');setTx('DEPOSIT')">+ Weka Akiba</button><button class="btn warning chair-only" onclick="openModal('transactionModal');setTx('WITHDRAWAL')">- Toa Akiba</button></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Member</th><th>Type</th><th>Amount</th><th>Reference</th></tr></thead><tbody id="savingsBody"></tbody></table></div></section>
<section id="shares" class="section"><div class="section-head"><div><h2>Hisa</h2><div class="small">Nunua, uza kwa kikundi, hamisha, dividend</div></div><div class="actions"><button class="btn primary" onclick="openModal('shareModal');setShareMode('BUY')">Nunua Hisa</button><button class="btn warning chair-only" onclick="openModal('shareModal');setShareMode('SELL')">Uza Hisa kwa Kikundi</button><button class="btn outline" onclick="openModal('shareModal');setShareMode('TRANSFER')">Hamisha Hisa</button></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Member</th><th>Action</th><th>Qty</th><th>Value</th><th>Status</th></tr></thead><tbody id="sharesBody"></tbody></table></div></section>
<section id="loans" class="section"><div class="section-head"><div><h2>Mikopo</h2><div class="small">Application, approval, disbursement, repayment, penalties, guarantors</div></div><div class="actions"><button class="btn primary" onclick="openModal('loanModal')">+ Omba Mkopo</button><button class="btn outline chair-only" onclick="openModal('loanProductModal')">Loan Products</button></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Member</th><th>Principal</th><th>Balance</th><th>Interest</th><th>Status</th><th>Action</th></tr></thead><tbody id="loansBody"></tbody></table></div></section>
<section id="repayments" class="section"><div class="section-head"><div><h2>Marejesho</h2><div class="small">Principal, interest, penalty and repayment history</div></div><button class="btn primary chair-only" onclick="openModal('repaymentModal')">+ Rekodi Marejesho</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Loan</th><th>Member</th><th>Amount</th><th>Type</th></tr></thead><tbody id="repaymentsBody"></tbody></table></div></section>
<section id="expenses" class="section"><div class="section-head"><div><h2>Mapato & Matumizi</h2><div class="small">Income, expenses and supporting references</div></div><button class="btn primary chair-only" onclick="openModal('cashModal')">+ Rekodi</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Type</th><th>Description</th><th>Amount</th></tr></thead><tbody id="cashBody"></tbody></table></div></section>
<section id="cashbook" class="section"><div class="section-head"><div><h2>Cashbook</h2><div class="small">Movement ya fedha ya kikundi</div></div></div><div id="cashbookSummary" class="metrics"></div><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Ref</th><th>Debit</th><th>Credit</th><th>Balance</th></tr></thead><tbody id="cashbookBody"></tbody></table></div></section>
<section id="ledger" class="section"><div class="section-head"><div><h2>General Ledger</h2><div class="small">Double-entry journal ya kikundi</div></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Description</th><th>Debit</th><th>Credit</th><th>Amount</th></tr></thead><tbody id="ledgerBody"></tbody></table></div></section>
<section id="welfare" class="section"><div class="section-head"><div><h2>Ustawi / Welfare Fund</h2><div class="small">Michango, misaada na matumizi ya ustawi</div></div><button class="btn primary chair-only" onclick="openModal('welfareModal')">+ Rekodi</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Member</th><th>Type</th><th>Amount</th><th>Description</th></tr></thead><tbody id="welfareBody"></tbody></table></div></section>
<section id="guarantors" class="section"><div class="section-head"><div><h2>Wadhamini</h2><div class="small">Guarantor commitments per loan</div></div><button class="btn primary chair-only" onclick="openModal('guarantorModal')">+ Mdhamini</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Loan</th><th>Guarantor</th><th>Amount</th><th>Status</th></tr></thead><tbody id="guarantorsBody"></tbody></table></div></section>
<section id="dividends" class="section"><div class="section-head"><div><h2>Dividends / Mgawanyo wa Faida</h2><div class="small">Distribution records based on approved policy</div></div><button class="btn primary chair-only" onclick="openModal('dividendModal')">+ Dividend</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Member</th><th>Shares</th><th>Rate</th><th>Amount</th></tr></thead><tbody id="dividendsBody"></tbody></table></div></section>
<section id="reports" class="section"><div class="section-head"><div><h2>Ripoti</h2><div class="small">Mchanganuo wa kikundi hiki tu</div></div></div><div class="grid grid3"><div class="card"><h3>Portfolio</h3><div id="reportPortfolio"></div></div><div class="card"><h3>Loan Aging / PAR</h3><div id="reportPAR"></div></div><div class="card"><h3>Member Balances</h3><div id="reportMembers"></div></div></div></section>
<section id="audit" class="section"><div class="section-head"><div><h2>Audit Trail</h2><div class="small">Mabadiliko muhimu ya mfumo</div></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>User</th><th>Action</th><th>Entity</th><th>Reference</th></tr></thead><tbody id="auditBody"></tbody></table></div></section>
<section id="control" class="section"><div class="section-head"><div><h2>Control Panel ya Mwenyekiti</h2><div class="small">Usimamizi wa kila kitengo: Edit, Delete, Restore, Confirm, Approve na kumbukumbu za miamala.</div></div></div><div id="controlMetrics" class="metrics"></div><div class="card"><div class="section-head"><h3 id="controlTitle">Wanachama</h3><div class="actions"><select id="controlEntity" onchange="loadControlEntity(this.value)"><option value="members">Wanachama</option><option value="loanApplications">Maombi ya Mikopo</option><option value="loans">Mikopo Hai/Kumbukumbu</option><option value="repayments">Marejesho</option><option value="shares">Hisa</option><option value="shareRequests">Maombi ya Kununua Hisa</option><option value="savings">Akiba</option><option value="meetings">Vikao</option><option value="announcements">Matangazo</option><option value="expenses">Mapato/Matumizi</option><option value="welfare">Welfare</option><option value="guarantors">Wadhamini</option><option value="dividends">Dividends</option></select><button class="btn primary chair-only" onclick="openControlCreate()">+ Ongeza</button></div></div><div class="table-wrap"><table class="table"><thead id="controlHead"></thead><tbody id="controlBody"></tbody></table></div></div></section><section id="profile" class="section"><div class="section-head"><h2>Profaili</h2></div><div class="card" id="profileBox"></div></section>
</div></main></div>

<!-- MODALS -->
<div id="memberModal" class="modal"><div class="modal-card"><div class="modal-head"><h3>Ongeza Mwanachama</h3><button class="close" onclick="closeModal('memberModal')">×</button></div><form id="memberForm"><div class="row"><div class="field"><label>Jina</label><input id="mName" required></div><div class="field"><label>Simu</label><input id="mPhone" required></div></div><div class="row"><div class="field"><label>Member No</label><input id="mNo"></div><div class="field"><label>Initial Shares</label><input id="mShares" type="number" min="0" value="0"></div></div><div class="field"><label>Initial Savings</label><input id="mSavings" type="number" min="0" value="0"></div><button class="btn primary">Hifadhi Mwanachama</button></form></div></div>
<div id="groupAdModal" class="modal"><div class="modal-card"><div class="modal-head"><h3>Tangazo la Kikundi</h3><button class="close" onclick="closeModal('groupAdModal')">×</button></div><form id="groupAdForm"><div class="field"><label>Aina</label><select id="adType"><option value="ANNOUNCEMENT">Taarifa/Announcement</option><option value="PRODUCT">Bidhaa ya Mwanachama</option></select></div><div class="field"><label>Kichwa</label><input id="adTitle" required></div><div class="field"><label>Maelezo</label><textarea id="adDesc" rows="4" required></textarea></div><div class="row"><div class="field"><label>Bei (optional)</label><input id="adPrice" type="number"></div><div class="field"><label>Simu ya Mawasiliano</label><input id="adPhone"></div></div><div class="field"><label>Image URL (optional)</label><input id="adImage"></div><button class="btn primary">Chapisha ndani ya Kikundi</button></form></div></div>
<div id="globalAdModal" class="modal"><div class="modal-card"><div class="modal-head"><h3>Global System Advertisement</h3><button class="close" onclick="closeModal('globalAdModal')">×</button></div><form id="globalAdForm"><div class="field"><label>Title</label><input id="gaTitle" required></div><div class="field"><label>Description</label><textarea id="gaDesc" rows="4" required></textarea></div><div class="row"><div class="field"><label>Scope</label><select id="gaScope"><option value="GLOBAL">Mfumo Wote</option><option value="GROUP">Kikundi Maalum</option></select></div><div class="field"><label>Group ID (ikiwa GROUP)</label><input id="gaGroupId"></div></div><div class="field"><label>Image URL</label><input id="gaImage"></div><button class="btn primary">Chapisha</button></form></div></div>
<div id="meetingModal" class="modal"><div class="modal-card"><div class="modal-head"><h3>Kikao / Minutes</h3><button class="close" onclick="closeModal('meetingModal')">×</button></div><form id="meetingForm"><div class="row"><div class="field"><label>Tarehe</label><input id="meetDate" type="date" required></div><div class="field"><label>Mada</label><input id="meetTopic" required></div></div><div class="field"><label>Mahudhurio</label><input id="meetAttendance"></div><div class="field"><label>Dakika / Maamuzi</label><textarea id="meetMinutes" rows="6" required></textarea></div><button class="btn primary">Hifadhi Kikao</button></form></div></div>
<div id="transactionModal" class="modal"><div class="modal-card"><div class="modal-head"><h3 id="txTitle">Transaction</h3><button class="close" onclick="closeModal('transactionModal')">×</button></div><form id="txForm"><input type="hidden" id="txType"><div class="field"><label>Mwanachama</label><select id="txMember" required></select></div><div class="field"><label>Kiasi</label><input id="txAmount" type="number" min="1" required></div><div class="field"><label>Reference / Maelezo</label><input id="txRef"></div><button class="btn primary">Hifadhi</button></form></div></div>
<div id="shareModal" class="modal"><div class="modal-card"><div class="modal-head"><h3 id="shareTitle">Hisa</h3><button class="close" onclick="closeModal('shareModal')">×</button></div><form id="shareForm"><input type="hidden" id="shareMode"><div class="field"><label>Mwanachama</label><select id="shareMember" required></select></div><div class="field"><label>Idadi ya Hisa</label><input id="shareQty" type="number" min="1" required></div><div id="transferToWrap" class="field hidden"><label>Hamishia kwa</label><select id="shareTo"></select></div><button class="btn primary">Tekeleza</button></form></div></div>
<div id="loanModal" class="modal"><div class="modal-card"><div class="modal-head"><h3>Omba Mkopo</h3><button class="close" onclick="closeModal('loanModal')">×</button></div><form id="loanForm"><div class="field"><label>Mwanachama</label><select id="loanMember" required></select></div><div class="row"><div class="field"><label>Principal</label><input id="loanPrincipal" type="number" min="1" required></div><div class="field"><label>Interest %</label><input id="loanInterest" type="number" step="0.01" required></div></div><div class="row"><div class="field"><label>Term (months)</label><input id="loanTerm" type="number" min="1" required></div><div class="field"><label>Purpose</label><input id="loanPurpose"></div></div><button class="btn primary">Wasilisha Ombi</button></form></div></div>
<div id="repaymentModal" class="modal"><div class="modal-card"><div class="modal-head"><h3>Rekodi Marejesho</h3><button class="close" onclick="closeModal('repaymentModal')">×</button></div><form id="repayForm"><div class="field"><label>Loan</label><select id="repayLoan"></select></div><div class="field"><label>Amount</label><input id="repayAmount" type="number" min="1" required></div><div class="field"><label>Type</label><select id="repayType"><option>REGULAR</option><option>PENALTY</option><option>EARLY_SETTLEMENT</option></select></div><button class="btn primary">Hifadhi Marejesho</button></form></div></div>
<div id="cashModal" class="modal"><div class="modal-card"><div class="modal-head"><h3>Mapato / Matumizi</h3><button class="close" onclick="closeModal('cashModal')">×</button></div><form id="cashForm"><div class="row"><div class="field"><label>Type</label><select id="cashType"><option>INCOME</option><option>EXPENSE</option></select></div><div class="field"><label>Amount</label><input id="cashAmount" type="number" min="1" required></div></div><div class="field"><label>Description</label><input id="cashDesc" required></div><button class="btn primary">Hifadhi</button></form></div></div>
<div id="welfareModal" class="modal"><div class="modal-card"><div class="modal-head"><h3>Welfare</h3><button class="close" onclick="closeModal('welfareModal')">×</button></div><form id="welfareForm"><div class="row"><div class="field"><label>Member</label><select id="wMember"></select></div><div class="field"><label>Type</label><select id="wType"><option>CONTRIBUTION</option><option>ASSISTANCE</option></select></div></div><div class="field"><label>Amount</label><input id="wAmount" type="number" min="1" required></div><div class="field"><label>Description</label><textarea id="wDesc"></textarea></div><button class="btn primary">Hifadhi</button></form></div></div>
<div id="guarantorModal" class="modal"><div class="modal-card"><div class="modal-head"><h3>Mdhamini</h3><button class="close" onclick="closeModal('guarantorModal')">×</button></div><form id="guarantorForm"><div class="field"><label>Loan</label><select id="gLoan"></select></div><div class="row"><div class="field"><label>Guarantor</label><select id="gMember"></select></div><div class="field"><label>Amount Guaranteed</label><input id="gAmount" type="number" min="1"></div></div><button class="btn primary">Hifadhi</button></form></div></div>
<div id="dividendModal" class="modal"><div class="modal-card"><div class="modal-head"><h3>Dividend</h3><button class="close" onclick="closeModal('dividendModal')">×</button></div><form id="dividendForm"><div class="field"><label>Member</label><select id="dMember"></select></div><div class="row"><div class="field"><label>Shares</label><input id="dShares" type="number" min="0"></div><div class="field"><label>Rate %</label><input id="dRate" type="number" step="0.01"></div></div><div class="field"><label>Amount</label><input id="dAmount" type="number" min="0"></div><button class="btn primary">Hifadhi Dividend</button></form></div></div>
<div id="loanProductModal" class="modal"><div class="modal-card"><div class="modal-head"><h3>Loan Product</h3><button class="close" onclick="closeModal('loanProductModal')">×</button></div><form id="loanProductForm"><div class="field"><label>Name</label><input id="lpName" required></div><div class="row"><div class="field"><label>Interest %</label><input id="lpInterest" type="number" step="0.01"></div><div class="field"><label>Max Term</label><input id="lpTerm" type="number"></div></div><div class="field"><label>Max Amount</label><input id="lpMax" type="number"></div><button class="btn primary">Hifadhi Product</button></form></div></div>
<div id="memberViewModal" class="modal"><div class="modal-card"><div class="modal-head"><h3>Taarifa za Mwanachama</h3><button class="close" onclick="closeModal('memberViewModal')">×</button></div><div id="memberView"></div></div></div>
<div id="memberFinanceModal" class="modal"><div class="modal-card"><div class="modal-head"><h3>Taarifa Kamili za Mwanachama</h3><button class="close" onclick="closeModal('memberFinanceModal')">×</button></div><div id="memberFinanceBody"></div></div></div>
<div id="toast" class="toast"></div>

<script type="module">
import {initializeApp, getApps, getApp} from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js';
import {getAuth, onAuthStateChanged, signInWithEmailAndPassword, createUserWithEmailAndPassword, signOut, RecaptchaVerifier, signInWithPhoneNumber} from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js';
import {getFirestore, collection, doc, getDoc, getDocs, addDoc, setDoc, updateDoc, deleteDoc, query, where, orderBy, limit, serverTimestamp, runTransaction, writeBatch} from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js';

const firebaseConfig={apiKey:'AIzaSyBrtkRulxflRFp2ZfcnUuGHcmo57tkcRNI',authDomain:'ncrs-aeb43.firebaseapp.com',projectId:'ncrs-aeb43',storageBucket:'ncrs-aeb43.firebasestorage.app',messagingSenderId:'786434442929',measurementId:'G-ZYB71RY8J5'};
const app=initializeApp(firebaseConfig); const auth=getAuth(app); const db=getFirestore(app);
const $=id=>document.getElementById(id); const money=n=>new Intl.NumberFormat('en-TZ',{style:'currency',currency:'TZS',maximumFractionDigits:0}).format(Number(n||0));
const esc=s=>String(s??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
const uid=()=>auth.currentUser?.uid||null; const now=()=>new Date().toISOString(); let pendingMemberLogin=null;
let state={groupId:null,group:null,user:null,role:null,members:[],loans:[],section:'dashboard',super:false};
const roleCan=perm=>state.role==='CHAIRPERSON'||state.role==='SYSTEM_ADMIN'||(state.user?.permissions||[]).includes(perm);
function toast(m){$('toast').textContent=m;$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),3500)}
function openModal(id){if(id==='memberModal'&&!roleCan('manageMembers'))return toast('Chairperson pekee anaweza kuongeza mwanachama.'); if(['groupAdModal','meetingModal','transactionModal','cashModal','welfareModal','guarantorModal','dividendModal','loanProductModal'].includes(id)&&!roleCan('manageGroup'))return toast('Huruhusiwi.'); if(id==='globalAdModal'&&state.role!=='SYSTEM_ADMIN')return toast('Super Admin pekee.'); if(id==='shareModal'&&$('shareMode').value==='SELL'&&!roleCan('manageShares'))return toast('Chairperson pekee.'); $(''+id).classList.add('show'); populateSelects()}
function closeModal(id){$(id).classList.remove('show')}; window.openModal=openModal;window.closeModal=closeModal;
window.toggleSidebar=()=> $('sidebar').classList.toggle('open');
window.backLanding=()=>{ $('auth').classList.add('hidden');$('landing').classList.remove('hidden')};
window.openAuth=m=>{ $('landing').classList.add('hidden');$('auth').classList.remove('hidden');authMode(m==='chair'?'chair':'member')};
window.authMode=m=>{ $('memberTab').classList.toggle('active',m==='member');$('chairTab').classList.toggle('active',m==='chair');$('memberLogin').classList.toggle('hidden',m!=='member');$('chairLogin').classList.toggle('hidden',m!=='chair');$('chairRegister').classList.toggle('hidden',m!=='chair');$('authTitle').textContent=m==='member'?'Ingia Kikundi':'Chairperson / Sajili Kikundi'};
function normalizePhone(p){p=(p||'').replace(/\D/g,'');return p.startsWith('255')?'+'+p:p.startsWith('0')?'+255'+p.slice(1):'+'+p}
function username(u){return String(u||'').trim().toLowerCase().replace(/\s+/g,'')}
async function audit(action,entity,ref,data={}){if(!state.groupId||!uid())return;await addDoc(collection(db,'groups',state.groupId,'audit'),{action,entity,ref,userId:uid(),userName:state.user?.name||auth.currentUser?.email||'',createdAt:serverTimestamp(),data})}
async function getGroupByUsername(u){const s=await getDoc(doc(db,'groupUsernames',username(u)));if(!s.exists())throw Error('Group Username haipo.');return s.data()}
async function resolveMember(groupId,phone){const q=query(collection(db,'groups',groupId,'members'),where('phone','==',normalizePhone(phone)),limit(1));const s=await getDocs(q);return s.empty?null:{id:s.docs[0].id,...s.docs[0].data()}}
let recaptcha=null,confirmation=null;
$('memberLogin').addEventListener('submit',async e=>{e.preventDefault();try{const u=await getGroupByUsername($('loginGroupUsername').value);const p=normalizePhone($('loginPhone').value);pendingMemberLogin={groupId:u.groupId,groupUsername:u.username,phone:p};if(!recaptcha)recaptcha=new RecaptchaVerifier(auth,'recaptcha-container',{size:'invisible'});confirmation=await signInWithPhoneNumber(auth,p,recaptcha);const code=prompt('Weka OTP iliyotumwa kwenye simu yako:');if(!code)return;await confirmation.confirm(code);const m=await resolveMember(u.groupId,p);if(!m)throw Error('Namba hii haijasajiliwa katika kikundi hicho.');await setDoc(doc(db,'users',auth.currentUser.uid),{uid:auth.currentUser.uid,groupId:u.groupId,role:m.role||'MEMBER',name:m.name,phone:p,memberId:m.id,permissions:[],linkedAt:serverTimestamp()},{merge:true});await updateDoc(doc(db,'groups',u.groupId,'members',m.id),{authUid:auth.currentUser.uid,lastLoginAt:serverTimestamp()});pendingMemberLogin=null;}catch(err){$('authMsg').textContent=err.message;toast(err.message)}});
$('chairLogin').addEventListener('submit',async e=>{e.preventDefault();try{await signInWithEmailAndPassword(auth,$('chairEmail').value,$('chairPassword').value)}catch(err){toast(err.message)}});
$('chairRegister').addEventListener('submit',async e=>{e.preventDefault();try{const gname=$('regGroupName').value.trim(),gu=username($('regGroupUsername').value),email=$('regChairEmail').value.trim(),phone=normalizePhone($('regChairPhone').value);if(!gname||!gu||!email||!phone)throw Error('Jaza taarifa zote.');const taken=await getDoc(doc(db,'groupUsernames',gu));if(taken.exists())throw Error('Group Username tayari ipo.');const cr=await createUserWithEmailAndPassword(auth,email,$('regChairPassword').value);const gid=doc(collection(db,'groups')).id;const group={name:gname,username:gu,registrationNumber:'',sharePrice:10000,maxSharesPerMember:1000,meetingDay:'',loanInterest:10,chairpersonId:cr.user.uid,chairpersonName:$('regChairName').value,chairpersonPhone:phone,status:'ACTIVE',createdAt:serverTimestamp()};await setDoc(doc(db,'groups',gid),group);await setDoc(doc(db,'groupUsernames',gu),{groupId:gid,username:gu,status:'ACTIVE',createdAt:serverTimestamp()});await setDoc(doc(db,'groups',gid,'members',cr.user.uid),{groupId:gid,name:$('regChairName').value,phone,email,role:'CHAIRPERSON',status:'ACTIVE',shares:0,savings:0,loanBalance:0,createdAt:serverTimestamp()});await setDoc(doc(db,'users',cr.user.uid),{uid:cr.user.uid,groupId:gid,role:'CHAIRPERSON',name:$('regChairName').value,phone,permissions:['manageMembers','manageGroup','manageShares','manageLoans','manageFinance','manageAds'],createdAt:serverTimestamp()});toast('Kikundi kimesajiliwa.');}catch(err){toast(err.message)}});
function nav(){const items=[['dashboard','Dashibodi','gauge-high'],['members','Wanachama','users'],['group','Kikundi','sitemap'],['announcements','Matangazo ya Kikundi','bullhorn'],['meetings','Vikao & Dakika','calendar-check'],['savings','Akiba','piggy-bank'],['shares','Hisa','certificate'],['loans','Mikopo','hand-holding-dollar'],['repayments','Marejesho','money-bill-transfer'],['expenses','Mapato & Matumizi','wallet'],['cashbook','Cashbook','book'],['ledger','General Ledger','file-invoice-dollar'],['welfare','Welfare Fund','hand-holding-heart'],['guarantors','Wadhamini','user-shield'],['dividends','Dividends','coins'],['reports','Ripoti','chart-pie'],['audit','Audit Trail','clipboard-check'],['profile','Profaili','user']];$('nav').innerHTML=items.map(x=>`<button data-sec="${x[0]}" onclick="showSection('${x[0]}',this)"><i class="fa-solid fa-${x[2]}"></i>${x[1]}</button>`).join('')}
window.showSection=(id,el)=>{if(!state.groupId)return;document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));$(id).classList.add('active');document.querySelectorAll('.nav button').forEach(b=>b.classList.remove('active'));if(el)el.classList.add('active');else document.querySelector(`.nav button[data-sec="${id}"]`)?.classList.add('active');$('pageTitle').textContent=document.querySelector(`button[data-sec="${id}"]`)?.innerText||id;state.section=id;loadSection(id)};
async function bootUser(u){const ud=await getDoc(doc(db,'users',u.uid));if(!ud.exists())throw Error('User profile haipo.');state.user={id:u.uid,...ud.data()};state.role=state.user.role;state.groupId=state.user.groupId;state.group=(await getDoc(doc(db,'groups',state.groupId))).data();if(!state.group)throw Error('Kikundi hakipo.');$('landing').classList.add('hidden');$('auth').classList.add('hidden');$('app').classList.remove('hidden');$('sideGroup').textContent=state.group.name;$('sideRole').textContent=state.role;$('topUser').textContent=`${state.user.name||u.phoneNumber||u.email} • ${state.role}`;nav();document.querySelectorAll('.chair-only').forEach(x=>x.style.display=state.role==='CHAIRPERSON'?'':'none');await loadMembers();showSection('dashboard');}
onAuthStateChanged(auth,async u=>{if(!u)return;if(state.super)return;try{await bootUser(u)}catch(e){toast(e.message);await signOut(auth)}});
window.logout=async()=>{state={groupId:null,group:null,user:null,role:null,members:[],loans:[],section:'dashboard',super:false};await signOut(auth);location.reload()};
async function loadMembers(){
 if(!state.groupId)return;
 let s;
 if(isChair()) s=await getDocs(groupCol('members'));
 else {const mid=myMemberId(); if(!mid){state.members=[];return} const d=await getDoc(groupDoc('members',mid)); s={docs:d.exists()?[d]:[]};}
 state.members=s.docs.map(d=>({id:d.id,...d.data()}));
 const visible=state.members;
 $('membersBody').innerHTML=visible.map(m=>`<tr><td>${esc(m.name)}</td><td>${esc(m.phone||'')}</td><td>${Number(m.shares||0)}</td><td>${money(m.savings)}</td><td>${money(m.loanBalance)}</td><td><span class="badge ${m.status==='ACTIVE'?'ok':m.status==='DELETED'?'bad':'warn'}">${esc(m.status||'ACTIVE')}</span></td><td>${actionBtns(`<button class="btn outline" onclick="viewMember('${m.id}')">View</button>${isChair()?`<button class="btn info" onclick="editMemberV3('${m.id}')">Edit</button><button class="btn danger" onclick="deleteMemberV3('${m.id}')">Delete</button>`:''}`)}</td></tr>`).join('')||'<tr><td colspan="7">Hakuna taarifa.</td></tr>';
 populateSelects();
}

window.viewMember=async id=>{
 const m=memberById(id); if(!m||!canSeeMemberData(id))return toast('Huruhusiwi kuona taarifa za mwanachama huyu.');
 const [ss,ls,rs,ws,ds]=await Promise.all([
  getDocs(query(groupCol('shares'),where('memberId','==',id),orderBy('createdAt','desc'),limit(100))),
  getDocs(query(groupCol('loans'),where('memberId','==',id),orderBy('createdAt','desc'),limit(100))),
  getDocs(query(groupCol('repayments'),where('memberId','==',id),orderBy('createdAt','desc'),limit(100))),
  getDocs(query(groupCol('savings'),where('memberId','==',id),orderBy('createdAt','desc'),limit(100))),
  getDocs(query(groupCol('dividends'),where('memberId','==',id),orderBy('createdAt','desc'),limit(100)))
 ]);
 const shares=ss.docs.map(d=>({id:d.id,...d.data()})), loans=ls.docs.map(d=>({id:d.id,...d.data()})), reps=rs.docs.map(d=>d.data()), sav=ws.docs.map(d=>d.data()), div=ds.docs.map(d=>d.data());
 $('memberFinanceBody').innerHTML=`<div class="grid grid3"><div class="card metric"><p>Akiba</p><h3>${money(m.savings)}</h3></div><div class="card metric"><p>Hisa</p><h3>${m.shares||0}</h3></div><div class="card metric"><p>Mkopo Salio</p><h3>${money(m.loanBalance)}</h3></div></div><div class="card"><h3>${esc(m.name)}</h3><p class="small">${esc(m.phone||'')} • ${esc(m.role||'MEMBER')} • ${esc(m.status||'ACTIVE')}</p></div><div class="card"><h4>Mikopo</h4><div class="table-wrap"><table class="table"><tr><th>Ref</th><th>Principal</th><th>Balance</th><th>Status</th></tr>${loans.map(x=>`<tr><td>${esc(x.id)}</td><td>${money(x.principal)}</td><td>${money(x.balance)}</td><td>${esc(x.status)}</td></tr>`).join('')||'<tr><td colspan="4">Hakuna</td></tr>'}</table></div></div><div class="card"><h4>Hisa</h4><div class="table-wrap"><table class="table"><tr><th>Tarehe</th><th>Aina</th><th>Idadi</th><th>Thamani</th><th>Status</th></tr>${shares.map(x=>`<tr><td>${fmtDate(x.createdAt)}</td><td>${esc(x.type)}</td><td>${x.quantity||0}</td><td>${money(x.value)}</td><td>${esc(x.status||'POSTED')}</td></tr>`).join('')||'<tr><td colspan="5">Hakuna</td></tr>'}</table></div></div><div class="card"><h4>Akiba</h4><div class="table-wrap"><table class="table"><tr><th>Tarehe</th><th>Aina</th><th>Kiasi</th><th>Ref</th></tr>${sav.map(x=>`<tr><td>${fmtDate(x.createdAt)}</td><td>${esc(x.type||'DEPOSIT')}</td><td>${money(x.amount)}</td><td>${esc(x.ref||'')}</td></tr>`).join('')||'<tr><td colspan="4">Hakuna</td></tr>'}</table></div></div><div class="card"><h4>Marejesho</h4><div class="table-wrap"><table class="table"><tr><th>Tarehe</th><th>Mkopo</th><th>Kiasi</th><th>Aina</th></tr>${reps.map(x=>`<tr><td>${fmtDate(x.createdAt)}</td><td>${esc(x.loanId)}</td><td>${money(x.amount)}</td><td>${esc(x.type)}</td></tr>`).join('')||'<tr><td colspan="4">Hakuna</td></tr>'}</table></div></div><div class="card"><h4>Dividends</h4>${div.map(x=>`<p>${fmtDate(x.createdAt)} — ${money(x.amount)}</p>`).join('')||'Hakuna'}</div>`;
 openModal('memberFinanceModal');
};

window.editMemberV3=async id=>{if(!requireChair())return;const m=memberById(id);if(!m)return;const name=prompt('Jina la mwanachama:',m.name||'');if(name===null)return;const phone=prompt('Namba ya simu:',m.phone||'');if(phone===null)return;const status=prompt('Status (ACTIVE/SUSPENDED/DELETED):',m.status||'ACTIVE');if(status===null)return;await updateDoc(groupDoc('members',id),{name:name.trim(),phone:normalizePhone(phone),status:status.trim().toUpperCase(),updatedAt:serverTimestamp(),updatedBy:uid()});await safeAudit('EDIT_MEMBER','member',id,{name,status});await loadMembers();toast('Mwanachama amesasishwa.');};
window.deleteMemberV3=async id=>{if(!requireChair())return;const m=memberById(id);if(!m)return;if(!confirm(`Futa mwanachama ${m.name}? Data zake za kihistoria hazitafutwa; atawekwa DELETED.`))return;await updateDoc(groupDoc('members',id),{status:'DELETED',deletedAt:serverTimestamp(),deletedBy:uid(),updatedAt:serverTimestamp()});await safeAudit('DELETE_MEMBER','member',id);await loadMembers();toast('Mwanachama amewekwa DELETED. Kumbukumbu zimehifadhiwa.');};

// Savings: every deposit/withdrawal updates the member balance atomically.
window.saveSavingsV3=async({memberId,amount,type='DEPOSIT',ref=''})=>{if(!requireChair())return;amount=Number(amount);if(!memberId||amount<=0)throw Error('Kiasi si sahihi.');await runTransaction(db,async tx=>{const mr=groupDoc('members',memberId),ms=await tx.get(mr);if(!ms.exists())throw Error('Mwanachama hayupo.');const m=ms.data(),old=Number(m.savings||0),next=type==='WITHDRAWAL'?old-amount:old+amount;if(next<0)throw Error('Akiba haitoshi.');tx.update(mr,{savings:next,updatedAt:serverTimestamp()});const r=doc(groupCol('savings'));tx.set(r,{memberId,amount,type,ref,createdBy:uid(),createdAt:serverTimestamp()});});await safeAudit('SAVE_SAVINGS',type,memberId,{amount});await loadMembers();await loadSavings();await loadDashboard();};

// Shares: immutable transaction + member share balance updated in same transaction.
window.buySharesV3=async(memberId,qty)=>{if(!requireChair())return;qty=Number(qty);const price=Number(state.group.sharePrice||0);if(qty<=0)throw Error('Idadi ya hisa si sahihi.');await runTransaction(db,async tx=>{const mr=groupDoc('members',memberId),ms=await tx.get(mr);if(!ms.exists())throw Error('Mwanachama hayupo.');const m=ms.data(),newQty=Number(m.shares||0)+qty;if(newQty>Number(state.group.maxSharesPerMember||999999))throw Error('Kikomo cha hisa kimefikiwa.');tx.update(mr,{shares:newQty,updatedAt:serverTimestamp()});const r=doc(groupCol('shares'));tx.set(r,{memberId,type:'BUY',quantity:qty,value:qty*price,status:'POSTED',createdBy:uid(),createdAt:serverTimestamp()});});await safeAudit('BUY_SHARES','share',memberId,{qty});await loadMembers();await loadShares();};
window.sellSharesV3=async(memberId,qty)=>{if(!requireChair())return;qty=Number(qty);const price=Number(state.group.sharePrice||0);await runTransaction(db,async tx=>{const mr=groupDoc('members',memberId),ms=await tx.get(mr);if(!ms.exists())throw Error('Mwanachama hayupo.');const m=ms.data(),old=Number(m.shares||0);if(qty<=0||qty>old)throw Error('Hisa za kuuza hazitoshi.');tx.update(mr,{shares:old-qty,updatedAt:serverTimestamp()});const r=doc(groupCol('shares'));tx.set(r,{memberId,type:'SELL',quantity:qty,value:qty*price,status:'POSTED',createdBy:uid(),createdAt:serverTimestamp()});});await safeAudit('SELL_SHARES','share',memberId,{qty});await loadMembers();await loadShares();};

// Loan lifecycle: INCOMPLETE -> PENDING -> APPROVED/ACTIVE -> COMPLETED, with full history.
window.editLoanApplicationV3=async id=>{if(!requireChair())return;const r=groupDoc('loans',id),s=await getDoc(r);if(!s.exists())return;const l=s.data();const principal=prompt('Principal:',l.principal||0);if(principal===null)return;const interest=prompt('Interest %:',l.interestRate||0);if(interest===null)return;const term=prompt('Term months:',l.termMonths||1);if(term===null)return;const purpose=prompt('Purpose:',l.purpose||'');if(purpose===null)return;await updateDoc(r,{principal:Number(principal),interestRate:Number(interest),termMonths:Number(term),purpose,status:l.status==='INCOMPLETE'?'INCOMPLETE':l.status||'PENDING',updatedAt:serverTimestamp(),updatedBy:uid()});await safeAudit('EDIT_LOAN','loan',id);await loadLoans();await loadControlEntity('loanApplications');toast('Ombi la mkopo limehaririwa.');};
window.restoreLoanApplicationV3=async id=>{if(!requireChair())return;await updateDoc(groupDoc('loans',id),{status:'PENDING',restoredAt:serverTimestamp(),restoredBy:uid(),updatedAt:serverTimestamp()});await safeAudit('RESTORE_LOAN_APPLICATION','loan',id);await loadLoans();await loadControlEntity('loanApplications');toast('Ombi limerejeshwa kwenye PENDING.');};
window.rejectLoanV3=async id=>{if(!requireChair())return;await updateDoc(groupDoc('loans',id),{status:'REJECTED',rejectedAt:serverTimestamp(),rejectedBy:uid(),updatedAt:serverTimestamp()});await safeAudit('REJECT_LOAN','loan',id);await loadLoans();};
window.confirmCompletedLoanV3=async id=>{if(!requireChair())return;const r=groupDoc('loans',id),s=await getDoc(r);if(!s.exists())return;const l=s.data();if(Number(l.balance||0)>0)return toast('Mkopo bado una salio.');await updateDoc(r,{status:'COMPLETED',confirmedCompleted:true,completedConfirmedBy:uid(),completedConfirmedAt:serverTimestamp(),updatedAt:serverTimestamp()});await safeAudit('CONFIRM_COMPLETED_LOAN','loan',id);await loadLoans();await loadMembers();toast('Mkopo umethibitishwa kuwa COMPLETED.');};
window.approveLoan=async id=>{if(!requireChair())return;await runTransaction(db,async tx=>{const r=groupDoc('loans',id),s=await tx.get(r);if(!s.exists())throw Error('Mkopo haupo.');const l=s.data();if(!['PENDING','INCOMPLETE'].includes(l.status))throw Error('Mkopo huu hauko tayari kuidhinishwa.');const principal=Number(l.principal||0),interestRate=Number(l.interestRate||0),interestAmount=principal*interestRate/100,total=Number(l.totalPayable||principal+interestAmount);tx.update(r,{status:'ACTIVE',interestAmount,totalPayable:total,balance:total,approvedBy:uid(),approvedAt:serverTimestamp(),updatedAt:serverTimestamp()});const mr=groupDoc('members',l.memberId),ms=await tx.get(mr);if(ms.exists())tx.update(mr,{loanBalance:total,updatedAt:serverTimestamp()});});await safeAudit('APPROVE_LOAN','loan',id);await loadLoans();await loadMembers();toast('Mkopo umeidhinishwa na salio limeanzishwa.');};
window.recordRepaymentV3=async(loanId,amount,type='REGULAR')=>{if(!requireChair())return;amount=Number(amount);if(amount<=0)throw Error('Kiasi cha marejesho si sahihi.');await runTransaction(db,async tx=>{const lr=groupDoc('loans',loanId),ls=await tx.get(lr);if(!ls.exists())throw Error('Mkopo haupo.');const l=ls.data();const old=Math.max(0,Number(l.balance||0));if(amount>old)throw Error(`Marejesho yanazidi salio ${money(old)}.`);const next=old-amount,status=next===0?'PAID':'ACTIVE';tx.update(lr,{balance:next,status,updatedAt:serverTimestamp(),lastRepaymentAt:serverTimestamp()});const mr=groupDoc('members',l.memberId),ms=await tx.get(mr);if(ms.exists())tx.update(mr,{loanBalance:next,updatedAt:serverTimestamp()});const rr=doc(groupCol('repayments'));tx.set(rr,{loanId,memberId:l.memberId,amount,type,status:'POSTED',createdBy:uid(),createdAt:serverTimestamp()});});await safeAudit('RECORD_REPAYMENT','repayment',loanId,{amount,type});await loadLoans();await loadRepayments();await loadMembers();await loadDashboard();toast('Marejesho yamehifadhiwa na salio limepunguzwa automatic.');};

// Override repayment form to use the safe atomic function.
const repayForm=$('repayForm'); if(repayForm){repayForm.onsubmit=async e=>{e.preventDefault();try{await recordRepaymentV3($('repayLoan').value,$('repayAmount').value,$('repayType').value);closeModal('repaymentModal');e.target.reset()}catch(err){toast(err.message)}}}

async function loadLoans(){
 if(!state.groupId)return; const s=await getDocs(query(groupCol('loans'),orderBy('createdAt','desc'),limit(300))); state.loans=s.docs.map(d=>({id:d.id,...d.data()}));
 const visible=isChair()?state.loans:state.loans.filter(l=>canSeeMemberData(l.memberId));
 $('loansBody').innerHTML=visible.map(l=>{const actions=isChair()?`${l.status==='PENDING'||l.status==='INCOMPLETE'?`<button class="btn primary" onclick="approveLoan('${l.id}')">Confirm/Approve</button><button class="btn info" onclick="editLoanApplicationV3('${l.id}')">Edit</button><button class="btn warning" onclick="restoreLoanApplicationV3('${l.id}')">Restore</button><button class="btn mutedbtn" onclick="markLoanIncompleteV3('${l.id}')">Incomplete</button><button class="btn danger" onclick="rejectLoanV3('${l.id}')">Reject</button>`:''}${(l.status==='PAID'||l.balance===0)&&!l.confirmedCompleted?`<button class="btn primary" onclick="confirmCompletedLoanV3('${l.id}')">Confirm Completed</button>`:''}<button class="btn danger" onclick="deleteRecordV3('loans','${l.id}')">Delete</button>`:'';return `<tr><td>${esc(memberName(l.memberId))}</td><td>${money(l.principal)}</td><td>${money(l.balance)}</td><td>${l.interestRate||0}%</td><td><span class="badge ${['ACTIVE','PAID','COMPLETED'].includes(l.status)?'ok':l.status==='REJECTED'?'bad':'warn'}">${esc(l.status||'PENDING')}</span></td><td>${actions}</td></tr>`}).join('')||'<tr><td colspan="6">Hakuna mikopo.</td></tr>';
 populateSelects();
}

// Generic safe deletion: never removes financial history; marks deleted/voided when possible.
window.deleteRecordV3=async(entity,id)=>{if(!requireChair())return;if(!confirm(`Una uhakika unataka kufuta rekodi hii ya ${entity}?`))return;const r=groupDoc(entity,id);const s=await getDoc(r);if(!s.exists())return;const d=s.data();if(['loans','repayments','shares','savings','cashbook','ledger'].includes(entity)){await updateDoc(r,{status:'VOIDED',voided:true,voidedBy:uid(),voidedAt:serverTimestamp(),updatedAt:serverTimestamp()});}else{await deleteDoc(r)}await safeAudit('DELETE_RECORD',entity,id,{previous:d});toast('Rekodi imefutwa/voided na audit imehifadhiwa.');await loadControlEntity(entity==='loans'?'loans':entity);await loadSection(state.section);};
window.editRecordV3=async(entity,id)=>{if(!requireChair())return;const r=groupDoc(entity,id),s=await getDoc(r);if(!s.exists())return;const d=s.data();const title=prompt('Title/Name:',d.title||d.name||d.description||'');if(title===null)return;const amount=prompt('Amount:',d.amount??d.value??'');if(amount===null)return;await updateDoc(r,{title:title.trim(),name:d.name?title.trim():d.name,description:d.description!==undefined?title.trim():d.description,amount:amount===''?d.amount:Number(amount),updatedBy:uid(),updatedAt:serverTimestamp()});await safeAudit('EDIT_RECORD',entity,id);await loadSection(state.section);toast('Rekodi imehaririwa.');};

// Control panel renderers for all major modules.
window.loadControlEntity=async entity=>{if(!isChair())return toast('Control Panel ni ya Mwenyekiti.');$('controlTitle').textContent=document.querySelector(`#controlEntity option[value="${entity}"]`)?.textContent||entity;const h=$('controlHead'),b=$('controlBody');
 const q=async col=>getDocs(query(groupCol(col),orderBy('createdAt','desc'),limit(300)));
 let docs=[];
 if(entity==='members')docs=state.members.map(x=>({id:x.id,data:()=>x})); else docs=(await q(entity==='loanApplications'||entity==='loans'?'loans':entity==='expenses'?'cash':entity==='announcements'?'ads':entity==='shareRequests'?'shareRequests':entity)).docs;
 if(entity==='loanApplications')docs=docs.filter(d=>['PENDING','INCOMPLETE','REJECTED'].includes(d.data().status));
 if(entity==='loans')docs=docs.filter(d=>['ACTIVE','PAID','COMPLETED','REJECTED'].includes(d.data().status));
 const headers={members:['Mwanachama','Simu','Akiba','Hisa','Mkopo','Status','Actions'],shareRequests:['Mwanachama','Qty','Value','Status','Actions'],loanApplications:['Mwanachama','Principal','Balance','Status','Actions'],loans:['Mwanachama','Principal','Balance','Status','Actions'],repayments:['Tarehe','Mwanachama','Mkopo','Amount','Type','Actions'],shares:['Tarehe','Mwanachama','Aina','Qty','Value','Actions'],savings:['Tarehe','Mwanachama','Aina','Amount','Actions'],meetings:['Tarehe','Title','Status','Actions'],announcements:['Tarehe','Title','Type','Status','Actions'],expenses:['Tarehe','Type','Amount','Description','Actions'],welfare:['Tarehe','Mwanachama','Type','Amount','Actions'],guarantors:['Loan','Mdhamini','Amount','Status','Actions'],dividends:['Tarehe','Mwanachama','Shares','Rate','Amount','Actions']};h.innerHTML=(headers[entity]||['ID','Data','Actions']).map(x=>`<th>${x}</th>`).join('');
 if(entity==='members'){
  b.innerHTML=docs.map(d=>{const x=d.data();return `<tr><td>${esc(x.name)}</td><td>${esc(x.phone||'')}</td><td>${money(x.savings)}</td><td>${x.shares||0}</td><td>${money(x.loanBalance)}</td><td>${esc(x.status||'ACTIVE')}</td><td>${actionBtns(`<button class="btn outline" onclick="viewMember('${d.id}')">View</button><button class="btn info" onclick="editMemberV3('${d.id}')">Edit</button><button class="btn danger" onclick="deleteMemberV3('${d.id}')">Delete</button>`)}</td></tr>`}).join('')||'<tr><td colspan="7">Hakuna.</td></tr>';
 }else if(entity==='loanApplications'||entity==='loans'){
  b.innerHTML=docs.map(d=>{const x=d.data();let a=`<button class="btn info" onclick="editLoanApplicationV3('${d.id}')">Edit</button><button class="btn danger" onclick="deleteRecordV3('loans','${d.id}')">Delete</button>`;if(['PENDING','INCOMPLETE'].includes(x.status))a+=`<button class="btn primary" onclick="approveLoan('${d.id}')">Approve</button>`;if(x.status==='INCOMPLETE'||x.status==='REJECTED')a+=`<button class="btn warning" onclick="restoreLoanApplicationV3('${d.id}')">Restore</button><button class="btn mutedbtn" onclick="markLoanIncompleteV3('${d.id}')">Incomplete</button>`;if((x.status==='PAID'||Number(x.balance||0)===0)&&!x.confirmedCompleted)a+=`<button class="btn primary" onclick="confirmCompletedLoanV3('${d.id}')">Confirm Completed</button>`;return `<tr><td>${esc(memberName(x.memberId))}</td><td>${money(x.principal)}</td><td>${money(x.balance)}</td><td>${esc(x.status)}</td><td>${actionBtns(a)}</td></tr>`}).join('')||'<tr><td colspan="5">Hakuna.</td></tr>';
 }else if(entity==='shareRequests'){
  b.innerHTML=docs.map(d=>{const x=d.data();return `<tr><td>${esc(memberName(x.memberId))}</td><td>${x.quantity||0}</td><td>${money(x.value)}</td><td>${esc(x.status||'PENDING')}</td><td>${actionBtns(`${x.status==='PENDING'?`<button class="btn primary" onclick="approveShareRequestV3('${d.id}')">Confirm & Add Hisa</button><button class="btn warning" onclick="rejectShareRequestV3('${d.id}')">Reject</button>`:''}<button class="btn danger" onclick="deleteRecordV3('shareRequests','${d.id}')">Delete</button>`)}</td></tr>`}).join('')||'<tr><td colspan="5">Hakuna maombi ya hisa.</td></tr>';
  }else if(entity==='repayments'){
  b.innerHTML=docs.map(d=>{const x=d.data();return `<tr><td>${fmtDate(x.createdAt)}</td><td>${esc(memberName(x.memberId))}</td><td>${esc(x.loanId)}</td><td>${money(x.amount)}</td><td>${esc(x.type)}</td><td>${actionBtns(`<button class="btn danger" onclick="deleteRecordV3('repayments','${d.id}')">Void</button>`)}</td></tr>`}).join('')||'<tr><td colspan="6">Hakuna.</td></tr>';
 }else if(entity==='shares'){
  b.innerHTML=docs.map(d=>{const x=d.data();return `<tr><td>${fmtDate(x.createdAt)}</td><td>${esc(memberName(x.memberId))}</td><td>${esc(x.type)}</td><td>${x.quantity||0}</td><td>${money(x.value)}</td><td>${actionBtns(`<button class="btn danger" onclick="deleteRecordV3('shares','${d.id}')">Void</button>`)}</td></tr>`}).join('')||'<tr><td colspan="6">Hakuna.</td></tr>';
 }else{
  b.innerHTML=docs.map(d=>{const x=d.data();const member=x.memberId?memberName(x.memberId):'';const title=x.title||x.name||x.description||x.type||d.id;return `<tr><td>${fmtDate(x.createdAt)}</td><td>${esc(member||title)}</td><td>${esc(x.type||x.status||'')}</td><td>${money(x.amount||x.value||0)}</td><td>${actionBtns(`<button class="btn info" onclick="editRecordV3('${entity}','${d.id}')">Edit</button><button class="btn danger" onclick="deleteRecordV3('${entity}','${d.id}')">Delete</button>`)}</td></tr>`}).join('')||'<tr><td colspan="5">Hakuna.</td></tr>';
 }
};

window.openControlCreate=()=>{if(!requireChair())return;const entity=$('controlEntity').value;if(entity==='members')openModal('memberModal');else if(entity==='loanApplications'||entity==='loans')openModal('loanModal');else if(entity==='repayments')openModal('repaymentModal');else if(entity==='shares'){ $('shareMode').value='BUY';openModal('shareModal');}else if(entity==='announcements')openModal('groupAdModal');else if(entity==='meetings')openModal('meetingModal');else if(entity==='savings')openModal('transactionModal');else if(entity==='expenses')openModal('cashModal');else if(entity==='welfare')openModal('welfareModal');else if(entity==='guarantors')openModal('guarantorModal');else if(entity==='dividends')openModal('dividendModal');};

// Control metrics.
async function loadControl(){if(!isChair()){ $('control').innerHTML='<div class="card"><h3>Control Panel</h3><p>Sehemu hii ni ya Mwenyekiti pekee.</p></div>';return}const pending=state.loans.filter(l=>['PENDING','INCOMPLETE'].includes(l.status)).length,active=state.loans.filter(l=>l.status==='ACTIVE').length,paid=state.loans.filter(l=>['PAID','COMPLETED'].includes(l.status)).length;$('controlMetrics').innerHTML=`<div class="card metric"><p>Wanachama</p><h3>${activeMembers().length}</h3></div><div class="card metric"><p>Maombi Pending/Incomplete</p><h3>${pending}</h3></div><div class="card metric"><p>Mikopo Hai</p><h3>${active}</h3></div><div class="card metric"><p>Imekamilika</p><h3>${paid}</h3></div>`;await loadControlEntity($('controlEntity').value)}

// Member-specific dashboard. Chair sees group KPIs; member sees personal wallet/portfolio and group announcements/meetings.
async function loadDashboard(){
 if(!state.groupId)return; const own=isChair()?null:memberById(myMemberId());
 if(own){const [ls,ss,rs]=await Promise.all([getDocs(query(groupCol('loans'),where('memberId','==',own.id),orderBy('createdAt','desc'),limit(100))),getDocs(query(groupCol('shares'),where('memberId','==',own.id),orderBy('createdAt','desc'),limit(100))),getDocs(query(groupCol('repayments'),where('memberId','==',own.id),orderBy('createdAt','desc'),limit(100)))]);const outstanding=ls.docs.reduce((a,d)=>a+Number(d.data().balance||0),0);const purchased=ss.docs.filter(d=>d.data().type==='BUY').reduce((a,d)=>a+Number(d.data().quantity||0),0),sold=ss.docs.filter(d=>d.data().type==='SELL').reduce((a,d)=>a+Number(d.data().quantity||0),0),paid=rs.docs.reduce((a,d)=>a+Number(d.data().amount||0),0);$('metrics').innerHTML=`<div class="card metric"><p>Akiba Yangu</p><h3>${money(own.savings)}</h3></div><div class="card metric"><p>Hisa Zangu</p><h3>${own.shares||purchased-sold}</h3></div><div class="card metric"><p>Salio la Mkopo</p><h3>${money(own.loanBalance||outstanding)}</h3></div><div class="card metric"><p>Marejesho Yangu</p><h3>${money(paid)}</h3></div>`;$('dashboardScope').textContent=`Kikundi: ${state.group.name} • Taarifa binafsi za ${own.name}`;$('financialSummary').innerHTML=`<p>Akiba: <b>${money(own.savings)}</b></p><p>Hisa: <b>${own.shares||0}</b> × ${money(state.group.sharePrice||0)}</p><p>Mkopo uliobaki: <b>${money(own.loanBalance||outstanding)}</b></p><p>Marejesho yaliyofanyika: <b>${money(paid)}</b></p>`;return}
 let savings=0,shares=0,loans=0;activeMembers().forEach(m=>{savings+=Number(m.savings||0);shares+=Number(m.shares||0)*Number(state.group.sharePrice||0);loans+=Number(m.loanBalance||0)});$('metrics').innerHTML=`<div class="card metric"><p>Wanachama</p><h3>${activeMembers().length}</h3></div><div class="card metric"><p>Akiba</p><h3>${money(savings)}</h3></div><div class="card metric"><p>Thamani ya Hisa</p><h3>${money(shares)}</h3></div><div class="card metric"><p>Mikopo Hai</p><h3>${money(loans)}</h3></div><div class="card metric"><p>Bei ya Hisa</p><h3>${money(state.group.sharePrice)}</h3></div>`;$('dashboardScope').textContent=`Kikundi: ${state.group.name} • Group Username: ${state.group.username}`;$('financialSummary').innerHTML=`<p>Akiba ya kikundi: <b>${money(savings)}</b></p><p>Thamani ya hisa: <b>${money(shares)}</b></p><p>Mikopo hai: <b>${money(loans)}</b></p>`;
}

// Ensure member cannot manipulate other members by changing selects through UI.
function populateSelects(){
 const mem=isChair()?state.members.filter(m=>m.status!=='DELETED'):state.members.filter(m=>canSeeMemberData(m.id));
 ['txMember','shareMember','shareTo','loanMember','wMember','gMember','dMember'].forEach(id=>{if($(id))populateSelect(id,mem,'name')});
 if($('repayLoan')){const loans=isChair()?state.loans:state.loans.filter(l=>canSeeMemberData(l.memberId));populateSelect('repayLoan',loans,'id');}
 if($('gLoan'))populateSelect('gLoan',state.loans,'id');
}

// Add module action buttons to existing renders through a periodic safe refresh hook.
async function refreshAllV3(){await loadMembers();await loadLoans();await loadDashboard();if(state.section==='control')await loadControlEntity($('controlEntity').value);}

// Extend loadSection for Control Panel and preserve all existing modules.
const originalLoadSection=loadSection;
loadSection=async function(id){if(id==='control'){await loadControl();return}return originalLoadSection(id)};

// Expose explicit module controls for chairperson.
window.refreshAllV3=refreshAllV3;window.loadControl=loadControl;

// Create a compact chair-only toolbar on each module.
function injectModuleToolbar(){if(!isChair())return;const map={members:'members',savings:'savings',shares:'shares',loans:'loans',repayments:'repayments',announcements:'announcements',meetings:'meetings',expenses:'expenses',welfare:'welfare',guarantors:'guarantors',dividends:'dividends'};Object.entries(map).forEach(([id,entity])=>{const sec=$(id);if(!sec||sec.querySelector('.v3-toolbar'))return;const head=sec.querySelector('.section-head');if(!head)return;const bar=document.createElement('div');bar.className='actions v3-toolbar';bar.innerHTML=`<button class="btn mutedbtn" onclick="loadControlEntity('${entity}') ; showSection('control')">Control Panel</button>`;head.appendChild(bar)})}

// After boot, inject toolbar. Wrapped showSection refreshes the active module safely.
const originalShowSection=window.showSection;
window.showSection=async(id,el)=>{await originalShowSection(id,el);injectModuleToolbar();if(id==='control'&&isChair())await loadControl()};

// Keep loan/member state synchronized after writes.
setInterval(()=>{if(state.groupId&&!state.super){loadMembers().catch(()=>{});loadLoans().catch(()=>{})}},30000);

// Member dashboard refresh and controls.
const originalOpenModal=window.openModal;
window.openModal=(id)=>{if(id==='memberModal'||id==='shareModal'||id==='loanModal'||id==='repaymentModal'||id==='transactionModal'||id==='cashModal'||id==='welfareModal'||id==='guarantorModal'||id==='dividendModal'||id==='meetingModal'||id==='groupAdModal'||id==='loanProductModal'){if(!isChair())return toast('Mwenyekiti pekee anaweza kutumia control hii.')}return originalOpenModal(id)};


// V3 member-safe financial renderers and module-specific CRUD.
async function loadShares(){
 if(!state.groupId)return;const base=groupCol('shares');const s=isChair()?await getDocs(query(base,orderBy('createdAt','desc'),limit(300))):await getDocs(query(base,where('memberId','==',myMemberId()),orderBy('createdAt','desc'),limit(300)));const rows=s.docs.map(d=>({id:d.id,...d.data()}));$('sharesBody').innerHTML=rows.map(x=>`<tr><td>${fmtDate(x.createdAt)}</td><td>${esc(memberName(x.memberId))}</td><td>${esc(x.type)}</td><td>${x.quantity||0}</td><td>${money(x.value)}</td><td><span class="badge ${x.status==='VOIDED'?'bad':'ok'}">${esc(x.status||'POSTED')}</span></td></tr>`).join('')||'<tr><td colspan="6">Hakuna miamala ya hisa.</td></tr>';
}
async function loadRepayments(){
 if(!state.groupId)return;const base=groupCol('repayments');const s=isChair()?await getDocs(query(base,orderBy('createdAt','desc'),limit(300))):await getDocs(query(base,where('memberId','==',myMemberId()),orderBy('createdAt','desc'),limit(300)));const rows=s.docs.map(d=>({id:d.id,...d.data()}));$('repaymentsBody').innerHTML=rows.map(x=>`<tr><td>${fmtDate(x.createdAt)}</td><td>${esc(x.loanId)}</td><td>${esc(memberName(x.memberId))}</td><td>${money(x.amount)}</td><td>${esc(x.type||'REGULAR')}</td></tr>`).join('')||'<tr><td colspan="5">Hakuna marejesho.</td></tr>';
}
async function loadSavings(){
 if(!state.groupId)return;const base=groupCol('savings');const s=isChair()?await getDocs(query(base,orderBy('createdAt','desc'),limit(300))):await getDocs(query(base,where('memberId','==',myMemberId()),orderBy('createdAt','desc'),limit(300)));const rows=s.docs.map(d=>({id:d.id,...d.data()}));$('savingsBody').innerHTML=rows.map(x=>`<tr><td>${fmtDate(x.createdAt)}</td><td>${esc(memberName(x.memberId))}</td><td>${esc(x.type||'DEPOSIT')}</td><td>${money(x.amount)}</td><td>${esc(x.ref||'')}</td></tr>`).join('')||'<tr><td colspan="5">Hakuna miamala ya akiba.</td></tr>';
}
async function loadWelfare(){if(!state.groupId)return;const base=groupCol('welfare');const s=isChair()?await getDocs(query(base,orderBy('createdAt','desc'),limit(300))):await getDocs(query(base,where('memberId','==',myMemberId()),orderBy('createdAt','desc'),limit(300)));const rows=s.docs.map(d=>({id:d.id,...d.data()}));$('welfareBody').innerHTML=rows.map(x=>`<tr><td>${fmtDate(x.createdAt)}</td><td>${esc(memberName(x.memberId))}</td><td>${esc(x.type)}</td><td>${money(x.amount)}</td><td>${esc(x.description||'')}</td></tr>`).join('')||'<tr><td colspan="5">Hakuna.</td></tr>'}
async function loadDividends(){if(!state.groupId)return;const base=groupCol('dividends');const s=isChair()?await getDocs(query(base,orderBy('createdAt','desc'),limit(300))):await getDocs(query(base,where('memberId','==',myMemberId()),orderBy('createdAt','desc'),limit(300)));const rows=s.docs.map(d=>({id:d.id,...d.data()}));$('dividendsBody').innerHTML=rows.map(x=>`<tr><td>${fmtDate(x.createdAt)}</td><td>${esc(memberName(x.memberId))}</td><td>${x.shares||0}</td><td>${x.rate||0}%</td><td>${money(x.amount)}</td></tr>`).join('')||'<tr><td colspan="5">Hakuna dividends.</td></tr>'}
async function loadGuarantors(){if(!state.groupId)return;const base=groupCol('guarantors');const s=isChair()?await getDocs(query(base,orderBy('createdAt','desc'),limit(300))):await getDocs(query(base,where('memberId','==',myMemberId()),orderBy('createdAt','desc'),limit(300)));const rows=s.docs.map(d=>({id:d.id,...d.data()}));$('guarantorsBody').innerHTML=rows.map(x=>`<tr><td>${esc(x.loanId)}</td><td>${esc(memberName(x.memberId))}</td><td>${money(x.amount)}</td><td>${esc(x.status||'ACTIVE')}</td></tr>`).join('')||'<tr><td colspan="4">Hakuna wadhamini.</td></tr>'}

// Module-specific editing.
window.editMeetingV3=async id=>{if(!requireChair())return;const r=groupDoc('meetings',id),s=await getDoc(r);if(!s.exists())return;const x=s.data();const topic=prompt('Mada ya kikao:',x.topic||'');if(topic===null)return;const date=prompt('Tarehe (YYYY-MM-DD):',x.date||'');if(date===null)return;const minutes=prompt('Dakika/Maamuzi:',x.minutes||'');if(minutes===null)return;await updateDoc(r,{topic,date,minutes,updatedBy:uid(),updatedAt:serverTimestamp()});await safeAudit('EDIT_MEETING','meeting',id);await loadMeetings();await loadControlEntity('meetings');toast('Kikao kimehaririwa.')};
window.editAnnouncementV3=async id=>{if(!requireChair())return;const r=groupDoc('ads',id),s=await getDoc(r);if(!s.exists())return;const x=s.data();const title=prompt('Kichwa:',x.title||'');if(title===null)return;const desc=prompt('Maelezo:',x.description||'');if(desc===null)return;await updateDoc(r,{title,description:desc,updatedBy:uid(),updatedAt:serverTimestamp()});await safeAudit('EDIT_GROUP_AD','ad',id);await loadGroupAds();await loadControlEntity('announcements');toast('Tangazo limehaririwa.')};
window.deleteGroupAdV3=async id=>{if(!requireChair())return;if(!confirm('Futa tangazo hili?'))return;await deleteDoc(groupDoc('ads',id));await safeAudit('DELETE_GROUP_AD','ad',id);await loadGroupAds();await loadControlEntity('announcements');toast('Tangazo limefutwa.')};
window.deleteMeetingV3=async id=>{if(!requireChair())return;if(!confirm('Futa kikao hiki?'))return;await deleteDoc(groupDoc('meetings',id));await safeAudit('DELETE_MEETING','meeting',id);await loadMeetings();await loadControlEntity('meetings');toast('Kikao kimefutwa.')};

// Correct collection mapping for control-panel CRUD.
const entityCollection=e=>e==='expenses'?'cashbook':e==='announcements'?'ads':e;
const oldDeleteRecordV3=window.deleteRecordV3;
window.deleteRecordV3=async(entity,id)=>{if(!requireChair())return;if(!confirm(`Una uhakika unataka kufuta rekodi hii ya ${entity}?`))return;const col=entityCollection(entity),r=groupDoc(col,id),s=await getDoc(r);if(!s.exists())return;const d=s.data();if(['loans','repayments','shares','savings','cashbook','ledger'].includes(col)){await updateDoc(r,{status:'VOIDED',voided:true,voidedBy:uid(),voidedAt:serverTimestamp(),updatedAt:serverTimestamp()});}else await deleteDoc(r);await safeAudit('DELETE_RECORD',entity,id,{previous:d});toast('Rekodi imefutwa/voided; historia ya audit imehifadhiwa.');await loadControlEntity(entity);await loadSection(state.section)};

// Better generic edit for financial/group records.
window.editRecordV3=async(entity,id)=>{if(!requireChair())return;const col=entityCollection(entity),r=groupDoc(col,id),s=await getDoc(r);if(!s.exists())return;const d=s.data();
 if(entity==='meetings')return editMeetingV3(id); if(entity==='announcements')return editAnnouncementV3(id);
 if(entity==='welfare'){const amount=prompt('Kiasi:',d.amount||0);if(amount===null)return;const desc=prompt('Maelezo:',d.description||'');if(desc===null)return;await updateDoc(r,{amount:Number(amount),description:desc,updatedBy:uid(),updatedAt:serverTimestamp()});}
 else if(entity==='dividends'){const rate=prompt('Rate %:',d.rate||0);if(rate===null)return;const amount=prompt('Amount:',d.amount||0);if(amount===null)return;await updateDoc(r,{rate:Number(rate),amount:Number(amount),updatedBy:uid(),updatedAt:serverTimestamp()});}
 else if(entity==='guarantors'){const amount=prompt('Amount:',d.amount||0);if(amount===null)return;await updateDoc(r,{amount:Number(amount),updatedBy:uid(),updatedAt:serverTimestamp()});}
 else if(entity==='expenses'){const amount=prompt('Amount:',d.amount||0);if(amount===null)return;const desc=prompt('Description:',d.description||'');if(desc===null)return;await updateDoc(r,{amount:Number(amount),description:desc,updatedBy:uid(),updatedAt:serverTimestamp()});}
 else if(entity==='savings'){toast('Miamala ya akiba haibadilishwi moja kwa moja; tumia VOID kisha ingiza marekebisho mapya.');return;}
 else {const amount=prompt('Amount/Value:',d.amount??d.value??0);if(amount===null)return;await updateDoc(r,{amount:Number(amount),value:d.value!==undefined?Number(amount):d.value,updatedBy:uid(),updatedAt:serverTimestamp()});}
 await safeAudit('EDIT_RECORD',entity,id);await loadControlEntity(entity);await loadSection(state.section);toast('Rekodi imesasishwa.')};

// Make group-only announcements visible to every member, while edit/delete stays chair-only.
async function loadGroupAds(){if(!state.groupId)return;const s=await getDocs(query(groupCol('ads'),where('status','==','PUBLISHED'),orderBy('createdAt','desc'),limit(100)));$('groupAds').innerHTML=s.docs.map(d=>{const a=d.data();return `<div class="card ad">${a.imageUrl?`<img src="${esc(a.imageUrl)}">`:''}<h3>${esc(a.title)}</h3><p>${esc(a.description)}</p>${a.price?`<p><b>${money(a.price)}</b></p>`:''}<span class="badge">${esc(a.type||'ANNOUNCEMENT')}</span>${isChair()?`<div class="actions"><button class="btn info" onclick="editAnnouncementV3('${d.id}')">Edit</button><button class="btn danger" onclick="deleteGroupAdV3('${d.id}')">Delete</button></div>`:''}</div>`}).join('')||'<div class="card">Hakuna matangazo.</div>'}

// Add an explicit member portfolio shortcut to the dashboard for members.
function injectMemberPortfolioCard(){if(isChair())return;const dash=$('dashboard');if(!dash||dash.querySelector('.member-portfolio-v3'))return;const c=document.createElement('div');c.className='card member-portfolio-v3';c.innerHTML='<div class="section-head"><h3>Portfolio Yangu</h3><button class="btn outline" onclick="viewMember(myMemberId())">Taarifa Kamili</button></div><p class="small">Hapa utaona akiba, hisa, mikopo, marejesho na dividends zako pekee.</p>';dash.appendChild(c)}

// Allow member self-service only for own loan application and share purchase. Chair controls all administrative operations.
const previousOpenModalV3=window.openModal;
window.openModal=(id)=>{
 if(id==='memberModal'||id==='groupAdModal'||id==='meetingModal'||id==='transactionModal'||id==='cashModal'||id==='welfareModal'||id==='guarantorModal'||id==='dividendModal'||id==='loanProductModal')return isChair()?previousOpenModalV3(id):toast('Mwenyekiti pekee anaweza kutumia control hii.');
 if(id==='shareModal'){
   const mode=$('shareMode').value||'BUY';
   if(mode==='SELL'||mode==='TRANSFER')return isChair()?previousOpenModalV3(id):toast('Uuzaji/uhamishaji wa hisa unasimamiwa na Mwenyekiti.');
   return previousOpenModalV3(id);
 }
 if(id==='loanModal'){ if(!isChair() && myMemberId()) { $('loanMember').value=myMemberId(); } return previousOpenModalV3(id); }
 return previousOpenModalV3(id);
};

// When a member opens share/loan form, lock selectors to self.
function lockMemberForms(){if(isChair())return;const me=myMemberId();if($('shareMember')){$('shareMember').value=me; $('shareMember').disabled=true}if($('loanMember')){$('loanMember').value=me; $('loanMember').disabled=true}if($('repayLoan'))$('repayLoan').disabled=true}
const originalPopulateV3=populateSelects;
populateSelects=function(){originalPopulateV3();lockMemberForms()};

// Chair loan completion confirmation appears as an explicit action in loans/control panel.


// Secure member share purchase workflow: members create a request; Chairperson confirms and posts the share balance.
function installSecureShareForm(){const old=$('shareForm');if(!old)return;const f=old.cloneNode(true);old.replaceWith(f);f.addEventListener('submit',async e=>{e.preventDefault();const mode=$('shareMode').value||'BUY',mid=$('shareMember').value,qty=Number($('shareQty').value),price=Number(state.group.sharePrice||0);try{if(!mid||qty<=0)throw Error('Jaza idadi ya hisa.');if(!isChair()){if(mode!=='BUY'||mid!==myMemberId())throw Error('Mwanachama anaweza kuomba KUNUNUA hisa zake pekee.');const ref=doc(groupCol('shareRequests'));await setDoc(ref,{memberId:mid,quantity:qty,value:qty*price,price,status:'PENDING',createdBy:uid(),createdAt:serverTimestamp()});await safeAudit('REQUEST_SHARE_PURCHASE','shareRequest',ref.id,{qty});toast('Ombi la kununua hisa limetumwa kwa Mwenyekiti kwa uthibitisho.');closeModal('shareModal');f.reset();return;}if(mode==='BUY')await buySharesV3(mid,qty);else if(mode==='SELL')await sellSharesV3(mid,qty);else{const to=$('shareTo').value;if(!to||to===mid)throw Error('Chagua mwanachama mwingine.');await runTransaction(db,async tx=>{const a=groupDoc('members',mid),b=groupDoc('members',to),as=await tx.get(a),bs=await tx.get(b);if(!as.exists()||!bs.exists())throw Error('Mwanachama hayupo.');const aq=Number(as.data().shares||0);if(aq<qty)throw Error('Hisa hazitoshi.');tx.update(a,{shares:aq-qty,updatedAt:serverTimestamp()});tx.update(b,{shares:Number(bs.data().shares||0)+qty,updatedAt:serverTimestamp()});const r=doc(groupCol('shares'));tx.set(r,{memberId:mid,toMemberId:to,type:'TRANSFER',quantity:qty,value:qty*price,status:'POSTED',createdBy:uid(),createdAt:serverTimestamp()})});await safeAudit('TRANSFER_SHARES','share',mid,{to,qty});await loadMembers();await loadShares();}closeModal('shareModal');f.reset();}catch(err){toast(err.message)}})}
installSecureShareForm();
window.approveShareRequestV3=async id=>{if(!requireChair())return;await runTransaction(db,async tx=>{const rr=groupDoc('shareRequests',id),rs=await tx.get(rr);if(!rs.exists())throw Error('Ombi halipo.');const x=rs.data();if(x.status!=='PENDING')throw Error('Ombi hili tayari limechakata.');const mr=groupDoc('members',x.memberId),ms=await tx.get(mr);if(!ms.exists())throw Error('Mwanachama hayupo.');const m=ms.data(),newQty=Number(m.shares||0)+Number(x.quantity||0);if(newQty>Number(state.group.maxSharesPerMember||999999))throw Error('Kikomo cha hisa kimefikiwa.');tx.update(mr,{shares:newQty,updatedAt:serverTimestamp()});const sh=doc(groupCol('shares'));tx.set(sh,{memberId:x.memberId,type:'BUY',quantity:Number(x.quantity),value:Number(x.value),price:Number(x.price||state.group.sharePrice||0),status:'POSTED',requestId:id,createdBy:uid(),createdAt:serverTimestamp()});tx.update(rr,{status:'APPROVED',approvedBy:uid(),approvedAt:serverTimestamp(),updatedAt:serverTimestamp()})});await safeAudit('APPROVE_SHARE_REQUEST','shareRequest',id);await loadMembers();await loadShares();await loadControlEntity('shares');toast('Ununuzi wa hisa umeidhinishwa na umeongezwa kwenye akaunti ya mwanachama.');};
window.rejectShareRequestV3=async id=>{if(!requireChair())return;await updateDoc(groupDoc('shareRequests',id),{status:'REJECTED',rejectedBy:uid(),rejectedAt:serverTimestamp(),updatedAt:serverTimestamp()});await safeAudit('REJECT_SHARE_REQUEST','shareRequest',id);await loadControlEntity('shares');};


// Super Admin targeted advertisements: GLOBAL => public landing; GROUP => only the selected group.
function installSecureGlobalAdForm(){const old=$('globalAdForm');if(!old)return;const f=old.cloneNode(true);old.replaceWith(f);f.addEventListener('submit',async e=>{e.preventDefault();if(state.role!=='SYSTEM_ADMIN')return toast('Super Admin pekee.');try{const scope=$('gaScope').value||'GLOBAL',gid=$('gaGroupId').value||null;const data={title:$('gaTitle').value.trim(),description:$('gaDesc').value.trim(),scope,groupId:scope==='GROUP'?gid:null,imageUrl:$('gaImage').value.trim(),status:'PUBLISHED',createdBy:uid(),createdAt:serverTimestamp()};if(scope==='GROUP'){if(!gid)throw Error('Chagua kikundi kwa tangazo la GROUP.');await addDoc(collection(db,'groups',gid,'ads'),{...data,type:'SYSTEM_ADMIN_TARGETED',createdByName:'SYSTEM ADMIN'});}else await addDoc(collection(db,'systemAds'),data);closeModal('globalAdModal');f.reset();await renderSuper();await loadPublicAds();toast(scope==='GROUP'?'Tangazo limepelekwa kwenye kikundi kilichochaguliwa.':'Tangazo la mfumo limechapishwa public.')}catch(err){toast(err.message)}})}
installSecureGlobalAdForm();
async function loadPublicAds(){try{const s=await getDocs(query(collection(db,'systemAds'),where('status','==','PUBLISHED'),limit(100)));const rows=s.docs.map(d=>({id:d.id,...d.data()})).filter(a=>(a.scope||'GLOBAL')==='GLOBAL');$('publicAds').innerHTML=rows.map(a=>`<div class="card ad">${a.imageUrl?`<img src="${esc(a.imageUrl)}">`:''}<h3>${esc(a.title)}</h3><p>${esc(a.description)}</p><span class="badge">GLOBAL</span></div>`).join('')||'<div class="card">Hakuna tangazo la mfumo kwa sasa.</div>'}catch(e){$('publicAds').innerHTML='<div class="card">Matangazo yatapatikana baada ya Firestore Rules kuwekwa.</div>'}}
// Include targeted Super Admin ads in the current group announcement feed.
const baseLoadGroupAdsV3=loadGroupAds;
loadGroupAds=async function(){if(!state.groupId)return;try{const [gAds,sAds]=await Promise.all([getDocs(query(groupCol('ads'),where('status','==','PUBLISHED'),orderBy('createdAt','desc'),limit(100))),getDocs(query(collection(db,'systemAds'),where('status','==','PUBLISHED'),limit(100)))]);const rows=[...gAds.docs.map(d=>({id:d.id,source:'GROUP',...d.data()})),...sAds.docs.map(d=>({id:d.id,source:'SYSTEM',...d.data()})).filter(x=>x.scope==='GROUP'&&x.groupId===state.groupId)];rows.sort((a,b)=>{const aa=a.createdAt?.toMillis?.()||0,bb=b.createdAt?.toMillis?.()||0;return bb-aa});$('groupAds').innerHTML=rows.map(a=>`<div class="card ad">${a.imageUrl?`<img src="${esc(a.imageUrl)}">`:''}<h3>${esc(a.title)}</h3><p>${esc(a.description)}</p>${a.price?`<p><b>${money(a.price)}</b></p>`:''}<span class="badge">${esc(a.type||'ANNOUNCEMENT')}</span>${isChair()&&a.source==='GROUP'?`<div class="actions"><button class="btn info" onclick="editAnnouncementV3('${a.id}')">Edit</button><button class="btn danger" onclick="deleteGroupAdV3('${a.id}')">Delete</button></div>`:''}</div>`).join('')||'<div class="card">Hakuna matangazo.</div>'}catch(e){toast(e.message)}};


window.markLoanIncompleteV3=async id=>{if(!requireChair())return;await updateDoc(groupDoc('loans',id),{status:'INCOMPLETE',incompleteReason:prompt('Sababu ya kurejesha ombi kwa mwanachama:','Taarifa haijakamilika')||'Taarifa haijakamilika',markedIncompleteBy:uid(),markedIncompleteAt:serverTimestamp(),updatedAt:serverTimestamp()});await safeAudit('MARK_LOAN_INCOMPLETE','loan',id);await loadLoans();await loadControlEntity('loanApplications');toast('Ombi limewekwa INCOMPLETE na linaweza kurejeshwa kwa mwanachama.');};

</script></body></html>
