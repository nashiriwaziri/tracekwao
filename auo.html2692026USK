function openTxModal(type){
  document.getElementById('txType').value=type;
  document.getElementById('txTitle').textContent=type==='DEPOSIT'?'Deposit':'Withdrawal';
  const sel=document.getElementById('txMember');
  sel.innerHTML=(DB.members||[]).map(m=>`<option value="${m.id||m.docId}">${m.name}</option>`).join('');
  document.getElementById('txAmount').value='';
  openModal('txModal');
}

function saveTx(event){
  event.preventDefault();
  const type=document.getElementById('txType').value;
  const memberId=document.getElementById('txMember').value;
  const amount=Number(document.getElementById('txAmount').value);
  if(!memberId||!amount){toast('Fill all fields','error');return false;}

  (async()=>{
    try{
      const ref=fdb.collection('savings').doc();
      const data={groupId:currentGroup.id,memberId,type,amount,createdAt:firebase.firestore.FieldValue.serverTimestamp()};
      await ref.set(data);
      DB.savings.push({id:ref.id,...data,createdAt:new Date().toISOString()});

      /* Update member savings balance */
      const memberIdx=DB.members.findIndex(m=>(m.id||m.docId)===memberId);
      if(memberIdx>=0){
        const delta=type==='DEPOSIT'?amount:-amount;
        DB.members[memberIdx].savings=(Number(DB.members[memberIdx].savings)||0)+delta;
        await fdb.collection('members').doc(memberId).update({savings:DB.members[memberIdx].savings});
      }

      /* Cashbook entry */
      const cbRef=fdb.collection('cashbook').doc();
      const cbData={groupId:currentGroup.id,ref:'SAV-'+ref.id.slice(0,8),date:firebase.firestore.FieldValue.serverTimestamp(),type:type==='DEPOSIT'?'CREDIT':'DEBIT',amount,description:type+' by '+(DB.members[memberIdx]?.name||'Member'),balance:0};
      await cbRef.set(cbData);

      /* Audit */
      const auRef=fdb.collection('audit').doc();
      await auRef.set({groupId:currentGroup.id,user:currentUser?.name||'',action:type,entity:'savings',createdAt:firebase.firestore.FieldValue.serverTimestamp()});

      saveLocal();closeModal('txModal');renderSavingsTable();toast(type+' saved','success');
    }catch(e){toast('Error: '+e.message,'error');}
  })();
  return false;
}

