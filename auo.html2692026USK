   MEMBER CRUD
   ================================================================ */
function saveMember(event){
  event.preventDefault();
  const editId=document.getElementById('mEditId').value;
  const name=document.getElementById('mName').value.trim();
  const phone=document.getElementById('mPhone').value.trim();
  const nida=document.getElementById('mNida').value.trim();
  const email=document.getElementById('mEmail').value.trim();
  const shares=Number(document.getElementById('mShares').value||0);
  const savings=Number(document.getElementById('mSavings').value||0);
  const password=document.getElementById('mPassword').value;
  const confirm=document.getElementById('mConfirmPassword').value;

  if(!name||!phone){toast('Name and Phone required','error');return false;}
  if(!editId&&password!==confirm){toast('Passwords do not match','error');return false;}

  (async()=>{
    try{
      if(editId){
        const data={name,phone,nida:nida||'',email:email||'',shares,savings};
        await fdb.collection('members').doc(editId).update(data);
        const idx=DB.members.findIndex(m=>m.id===editId);
        if(idx>=0)Object.assign(DB.members[idx],data);
      } else {
        const ref=fdb.collection('members').doc();
        const regId=await ensureUniqueRegId();
        const data={firstName:name,lastName:'',name,phone,nida:nida||'',email:email||'',shares,savings,groupId:currentGroup.id,groupName:currentGroup.name,regId,role:'member',status:'active',createdAt:firebase.firestore.FieldValue.serverTimestamp(),password};
        await ref.set(data);
        DB.members.push({id:ref.id,...data,createdAt:new Date().toISOString()});
        await fdb.collection('groups').doc(currentGroup.id).update({memberCount:firebase.firestore.FieldValue.increment(1)});
        showIdReminder(regId);
      }
      saveLocal();closeModal('memberModal');renderMembers();toast('Member saved','success');
    }catch(e){toast('Error: '+e.message,'error');}
  })();
  return false;
}

function editMember(id){
  const m=DB.members.find(x=>x.id===id);
  if(!m)return;
  document.getElementById('mEditId').value=id;
  document.getElementById('mName').value=m.name||'';
  document.getElementById('mPhone').value=m.phone||'';
  document.getElementById('mNida').value=m.nida||'';
  document.getElementById('mEmail').value=m.email||'';
  document.getElementById('mShares').value=m.shares||0;
  document.getElementById('mSavings').value=m.savings||0;
  document.getElementById('mPasswordRow').style.display='none';
  document.getElementById('memberModalTitle').textContent='Edit Member';
  openModal('memberModal');
}

