/* ================================================================
   GROUP SUGGESTIONS
   ================================================================ */
let allGroupsCache=[];
let mjGroupDebounce=null;

function loadGroupsForSuggestions(){
  fdb.collection('groups').get().then(snap=>{
    allGroupsCache=[];
    snap.forEach(doc=>{const d=doc.data();allGroupsCache.push({id:doc.id,name:d.name||'',type:d.type||''});});
    if(DB.groups&&DB.groups.length){
      DB.groups.forEach(g=>{if(!allGroupsCache.find(x=>x.id===g.id))allGroupsCache.push({id:g.id,name:g.name||'',type:g.type||''});});
    }
  }).catch(()=>{
    allGroupsCache=(DB.groups||[]).map(g=>({id:g.id,name:g.name||'',type:g.type||''}));
  });
}

function setupGroupSuggestions(){
  const input=document.getElementById('mjGroup');
  const sugBox=document.getElementById('mjGroupSuggestions');
  const hintEl=document.getElementById('mjGroupHint');
  const hiddenId=document.getElementById('mjGroupId');
  if(!input||!sugBox)return;

  input.addEventListener('input',function(){
    const val=this.value.trim();
    hiddenId.value='';
    clearTimeout(mjGroupDebounce);
    if(val.length<1){sugBox.classList.remove('open');sugBox.innerHTML='';if(hintEl){hintEl.textContent='Start typing to search existing groups, or enter a new name';hintEl.classList.remove('error');}return;}
    mjGroupDebounce=setTimeout(()=>{
      const matches=allGroupsCache.filter(g=>g.name.toLowerCase().includes(val.toLowerCase())).slice(0,8);
      if(matches.length>0){
        sugBox.innerHTML=matches.map(g=>`<div class="group-suggestion" data-id="${g.id}" data-name="${g.name}" onclick="selectGroupSuggestion(this)"><i class="fa-solid fa-people-group"></i><span>${highlightMatch(g.name,val)}</span><span class="gs-type">${g.type||'Group'}</span></div>`).join('');
        sugBox.classList.add('open');
      } else {
        sugBox.innerHTML='<div class="group-suggestion" style="color:var(--muted);cursor:default"><i class="fa-solid fa-circle-info"></i><span>No existing group found. A new group will be created.</span></div>';
        sugBox.classList.add('open');
      }
      if(hintEl){hintEl.textContent=matches.length+' group(s) found. Click to select or type a new name.';hintEl.classList.remove('error');}
    },200);
  });

  input.addEventListener('focus',function(){if(this.value.trim().length>=1)this.dispatchEvent(new Event('input'));});
  document.addEventListener('click',function(e){if(!e.target.closest('#mjGroup')&&!e.target.closest('#mjGroupSuggestions'))sugBox.classList.remove('open');});
  input.addEventListener('blur',function(){validateGroupNameInput(this.value.trim());});
}

function highlightMatch(name,query){
  const idx=name.toLowerCase().indexOf(query.toLowerCase());
  if(idx===-1)return name;
  return name.substring(0,idx)+'<strong style="color:var(--p2)">'+name.substring(idx,idx+query.length)+'</strong>'+name.substring(idx+query.length);
}

function selectGroupSuggestion(el){
  const input=document.getElementById('mjGroup');
  const sugBox=document.getElementById('mjGroupSuggestions');
  const hiddenId=document.getElementById('mjGroupId');
  const hintEl=document.getElementById('mjGroupHint');
  input.value=el.dataset.name;
  hiddenId.value=el.dataset.id;
  sugBox.classList.remove('open');
  if(hintEl){hintEl.textContent='Selected: '+el.dataset.name;hintEl.classList.remove('error');}
  input.classList.remove('invalid');input.classList.add('valid');
}

function validateGroupNameInput(val){
  const hintEl=document.getElementById('mjGroupHint');
  const input=document.getElementById('mjGroup');
  if(!val||val.length===0){if(hintEl){hintEl.textContent='Group name is required';hintEl.classList.add('error');}input&&input.classList.add('invalid');return false;}
  if(val.length<2){if(hintEl){hintEl.textContent='Group name must be at least 2 characters';hintEl.classList.add('error');}input&&input.classList.add('invalid');return false;}
  input&&input.classList.remove('invalid');input&&input.classList.add('valid');
  return true;
}

/* ================================================================
   PASSWORD STRENGTH
   ================================================================ */
function setupPasswordStrength(inputId,barId,labelId){
  const input=document.getElementById(inputId);if(!input)return;
  const bar=document.getElementById(barId);
  const label=document.getElementById(labelId);
  input.addEventListener('input',function(){
    const val=this.value;let score=0;
    if(val.length>=6)score++;if(val.length>=8)score++;if(/[A-Z]/.test(val))score++;if(/[0-9]/.test(val))score++;if(/[^A-Za-z0-9]/.test(val))score++;
    const pct=Math.min((score/5)*100,100);
    const colors=['var(--red)','var(--red)','var(--yellow)','var(--yellow)','var(--p)','var(--p)'];
    const labels=['','Weak','Fair','Good','Strong','Very Strong'];
    if(bar){bar.style.width=pct+'%';bar.style.background=colors[score];}
    if(label){label.textContent=val.length>0?labels[score]:'';label.style.color=colors[score];}
  });
}

