function handleMemberJoin(event){
  event.preventDefault();
  const errEl=document.getElementById('mjErr');
  errEl.classList.remove('show');

  const fname=document.getElementById('mjFname').value.trim();
  const lname=document.getElementById('mjLname').value.trim();
  const phone=document.getElementById('mjPhone').value.trim();
  const email=document.getElementById('mjEmail').value.trim();
  const nida=document.getElementById('mjNida').value.trim();
  const gender=document.getElementById('mjGender').value;
  const groupName=document.getElementById('mjGroup').value.trim();
  const groupId=document.getElementById('mjGroupId').value;
  const password=document.getElementById('mjPass').value;

  if(!fname||!lname||!phone||!groupName||!password){
    errEl.textContent='Please fill all required fields.';errEl.classList.add('show');return false;
  }
  if(!validateGroupNameInput(groupName))return false;
  if(password.length<6){
    errEl.textContent='Password must be at least 6 characters.';errEl.classList.add('show');return false;
  }

  (async()=>{
    try{
      let resolvedGroupId=groupId;
      let resolvedGroupData=null;

      if(resolvedGroupId){
        const groupDoc=await fdb.collection('groups').doc(resolvedGroupId).get();
        if(groupDoc.exists)resolvedGroupData=groupDoc.data();
      } else {
        const snap=await fdb.collection('groups').where('nameLower','==',groupName.toLowerCase()).limit(1).get();
        if(!snap.empty){
          snap.forEach(doc=>{resolvedGroupId=doc.id;resolvedGroupData=doc.data();});
        } else {
          const newGroupRef=fdb.collection('groups').doc();
          resolvedGroupId=newGroupRef.id;
          resolvedGroupData={name:groupName,nameLower:groupName.toLowerCase(),type:'vsla',country:'TZ',currency:'TZS',createdAt:firebase.firestore.FieldValue.serverTimestamp(),memberCount:0,status:'active',package:'free'};
          await newGroupRef.set(resolvedGroupData);
          DB.groups.push({id:resolvedGroupId,...resolvedGroupData,createdAt:new Date().toISOString()});
          saveLocal();
        }
      }

      const memberRef=fdb.collection('members').doc();
      const memberId=memberRef.id;
      const regId=await ensureUniqueRegId();

      const memberData={
        firstName:fname,lastName:lname,name:fname+' '+lname,phone,email:email||'',nida:nida||'',gender:gender||'',
        groupId:resolvedGroupId,groupName:groupName,regId:regId,role:'member',status:'active',
        shares:0,savings:0,createdAt:firebase.firestore.FieldValue.serverTimestamp(),password:password
      };

      await memberRef.set(memberData);
      await fdb.collection('groups').doc(resolvedGroupId).update({memberCount:firebase.firestore.FieldValue.increment(1)});

      DB.members.push({id:memberId,...memberData,createdAt:new Date().toISOString()});
      saveLocal();

      document.getElementById('memberJoinForm').reset();
      document.getElementById('mjGroupId').value='';

      showIdReminder(regId,resolvedGroupId,groupName);

      const successBox=document.getElementById('signupSuccessBox');
      if(successBox){
        successBox.classList.remove('hidden');
        successBox.innerHTML='<div class="success-box"><i class="fa-solid fa-circle-check" style="font-size:32px;display:block;margin-bottom:10px"></i><strong>Registration Successful!</strong><br>Your ID: <strong style="letter-spacing:2px;font-size:18px;color:var(--p2)">'+regId+'</strong><br><span class="small">Save this ID — you need it to sign in.</span></div>';
      }

    } catch(err){
      console.error('Member join error:',err);
      errEl.textContent='Registration failed: '+err.message;errEl.classList.add('show');
    }
  })();

  return false;
}

/* ================================================================
   GROUP REGISTER HANDLER
   ================================================================ */
function handleGroupRegister(event){
  event.preventDefault();
  const errEl=document.getElementById('grErr');
  errEl.classList.remove('show');

  const pass=document.getElementById('grPass').value;
  const confirm=document.getElementById('grConfirmPass').value;
  const passkey=document.getElementById('grPasskey').value;

  if(pass!==confirm){errEl.textContent='Passwords do not match.';errEl.classList.add('show');return false;}
  if(passkey!==CHAIR_PASSKEY){errEl.textContent='Invalid Chairperson Passkey.';errEl.classList.add('show');return false;}

  const fname=document.getElementById('grFname').value.trim();
  const mname=document.getElementById('grMname').value.trim();
  const lname=document.getElementById('grLname').value.trim();
  const phone=document.getElementById('grPhone').value.trim();
  const email=document.getElementById('grEmail').value.trim();
  const nida=document.getElementById('grNida').value.trim();
  const gender=document.getElementById('grGender').value;
  const groupName=document.getElementById('grGroupName').value.trim();
  const groupType=document.getElementById('grGroupType').value;
  const country=document.getElementById('grCountry').value;
  const currency=document.getElementById('grCurrency').value;
  const regNo=document.getElementById('grRegNo').value.trim();
  const meetingDay=document.getElementById('grMeetingDay').value;

  if(!fname||!lname||!phone||!email||!nida||!gender||!groupName||!groupType||!country){
    errEl.textContent='Please fill all required fields.';errEl.classList.add('show');return false;
  }

  (async()=>{
    try{
      const existingSnap=await fdb.collection('groups').where('nameLower','==',groupName.toLowerCase()).limit(1).get();
      if(!existingSnap.empty){errEl.textContent='A group with this name already exists. Use "Join Group" instead.';errEl.classList.add('show');return;}

      const groupRef=fdb.collection('groups').doc();
      const groupId=groupRef.id;

      const groupData={
        name:groupName,nameLower:groupName.toLowerCase(),type:groupType,country:country,currency:currency,
        regNo:regNo||'',meetingDay:meetingDay||'',interestRate:10,sharePrice:10000,maxShares:50,
        status:'active',package:'free',memberCount:1,createdAt:firebase.firestore.FieldValue.serverTimestamp()
      };
      await groupRef.set(groupData);

      const memberRef=fdb.collection('members').doc();
      const memberId=memberRef.id;
      const regId=await ensureUniqueRegId();

      const memberData={
        firstName:fname,middleName:mname||'',lastName:lname,name:fname+(mname?' '+mname+' ':' ')+lname,
        phone,email,nida,gender,groupId:groupId,groupName:groupName,regId:regId,role:'chair',status:'active',
        shares:0,savings:0,createdAt:firebase.firestore.FieldValue.serverTimestamp(),password:pass
      };
      await memberRef.set(memberData);

      DB.groups.push({id:groupId,...groupData,createdAt:new Date().toISOString()});
      DB.members.push({id:memberId,...memberData,createdAt:new Date().toISOString()});
      saveLocal();

      document.getElementById('groupRegForm').reset();

      showIdReminder(regId,groupId,groupName);

      const successBox=document.getElementById('grSignupSuccessBox');
      if(successBox){
        successBox.classList.remove('hidden');
        successBox.innerHTML='<div class="success-box"><i class="fa-solid fa-circle-check" style="font-size:32px;display:block;margin-bottom:10px"></i><strong>Group Registration Successful!</strong><br>Your ID: <strong style="letter-spacing:2px;font-size:18px;color:var(--p2)">'+regId+'</strong><br>Group ID: <strong style="letter-spacing:1px;font-size:14px;color:var(--blue)">'+groupId+'</strong><br><span class="small">Save both IDs — you need them to sign in.</span></div>';
      }

    } catch(err){
      console.error('Group register error:',err);
      errEl.textContent='Registration failed: '+err.message;errEl.classList.add('show');
    }
  })();

  return false;
}

/* ================================================================
   SIGN IN HANDLER
   ================================================================ */
function handleSignIn(event,type){
  event.preventDefault();
  const errEl=document.getElementById('authErr');
  errEl.classList.remove('show');

  if(type==='member'){
    const groupId=document.getElementById('siMemberGroupId').value.trim();
    const memberId=document.getElementById('siMemberId').value.trim();
    const pass=document.getElementById('siMemberPass').value;

    if(!groupId||!memberId||!pass){errEl.textContent='Please fill all fields.';errEl.classList.add('show');return false;}

    (async()=>{
      try{
        let memberDoc=null;
        let memberData=null;
        let memberDocId=null;

        /* Try by phone */
        let snap=await fdb.collection('members').where('groupId','==',groupId).where('phone','==',memberId).limit(1).get();
        if(!snap.empty){snap.forEach(doc=>{memberDoc=doc;memberData=doc.data();memberDocId=doc.id;});}

        /* Try by regId */
        if(!memberDoc){
          snap=await fdb.collection('members').where('groupId','==',groupId).where('regId','==',memberId).limit(1).get();
          if(!snap.empty){snap.forEach(doc=>{memberDoc=doc;memberData=doc.data();memberDocId=doc.id;});}
        }

        /* Try by nida */
        if(!memberDoc){
          snap=await fdb.collection('members').where('groupId','==',groupId).where('nida','==',memberId).limit(1).get();
          if(!snap.empty){snap.forEach(doc=>{memberDoc=doc;memberData=doc.data();memberDocId=doc.id;});}
        }

        if(!memberDoc){errEl.textContent='Member not found in this group.';errEl.classList.add('show');return;}
        if(memberData.password!==pass){errEl.textContent='Incorrect password.';errEl.classList.add('show');return;}

        /* Load group */
        const groupDoc=await fdb.collection('groups').doc(groupId).get();
        const groupData=groupDoc.exists?groupDoc.data():{name:memberData.groupName||'Group',currency:'TZS'};

        enterApp(memberData,groupData,groupId,memberDocId);

      } catch(err){
        console.error('Sign in error:',err);
        errEl.textContent='Sign in failed: '+err.message;errEl.classList.add('show');
      }
    })();

  } else {
    const groupId=document.getElementById('siChairGroupId').value.trim();
    const chairId=document.getElementById('siChairId').value.trim();
    const passkey=document.getElementById('siChairPasskey').value;

    if(!groupId||!chairId||!passkey){errEl.textContent='Please fill all fields.';errEl.classList.add('show');return false;}
    if(passkey!==CHAIR_PASSKEY){errEl.textContent='Invalid Chairperson Passkey.';errEl.classList.add('show');return false;}

    (async()=>{
      try{
        let snap=await fdb.collection('members').where('groupId','==',groupId).where('role','==','chair').where('email','==',chairId).limit(1).get();
        let memberDoc=null;let memberData=null;let memberDocId=null;

        if(!snap.empty){snap.forEach(doc=>{memberDoc=doc;memberData=doc.data();memberDocId=doc.id;});}
        else{
          snap=await fdb.collection('members').where('groupId','==',groupId).where('role','==','chair').where('phone','==',chairId).limit(1).get();
          if(!snap.empty){snap.forEach(doc=>{memberDoc=doc;memberData=doc.data();memberDocId=doc.id;});}
        }

        if(!memberDoc){errEl.textContent='Chairperson not found for this group.';errEl.classList.add('show');return;}

        const groupDoc=await fdb.collection('groups').doc(groupId).get();
        const groupData=groupDoc.exists?groupDoc.data():{name:memberData.groupName||'Group',currency:'TZS'};

        enterApp(memberData,groupData,groupId,memberDocId);

      } catch(err){
        console.error('Chair sign in error:',err);
        errEl.textContent='Sign in failed: '+err.message;errEl.classList.add('show');
      }
    })();
  }

  return false;
}

/* ================================================================
   ENTER APP
   ================================================================ */
function enterApp(memberData,groupData,groupId,memberDocId){
  currentUser={...memberData,docId:memberDocId};
  currentGroup={...groupData,id:groupId};

  /* Cache regId in session */
  if(memberData.regId) sessionStorage.setItem('cscms_current_regId',memberData.regId);

  showScreen('app');
  document.getElementById('sideGroup').textContent=groupData.name||'CSCMS';
  document.getElementById('sideRole').textContent=memberData.role==='chair'?'Chairperson':'Member';
  document.getElementById('topUser').textContent=memberData.name;

  role=memberData.role||'member';
  document.getElementById('roleSwitch').value=role;
  switchRole(role);

  /* Populate settings */
  document.getElementById('gName').value=groupData.name||'';
  document.getElementById('gCurrency').value=groupData.currency||'TZS';
  document.getElementById('gInterest').value=groupData.interestRate||10;
  document.getElementById('gSharePrice').value=groupData.sharePrice||10000;
  document.getElementById('gMaxShares').value=groupData.maxShares||50;
  document.getElementById('gType').value=groupData.type||'vsla';

  renderDashboard();
  updateSyncUI();
  toast('Welcome, '+memberData.name+'!','success');
}

/* ================================================================
