   ================================================================ */
async function loadGroupData(){
  if(!currentGroup)return;
  const gid=currentGroup.id;

  try{
    const mSnap=await fdb.collection('members').where('groupId','==',gid).get();
    DB.members=[];mSnap.forEach(doc=>DB.members.push({id:doc.id,...doc.data()}));

    const txSnap=await fdb.collection('savings').where('groupId','==',gid).get();
    DB.savings=[];txSnap.forEach(doc=>DB.savings.push({id:doc.id,...doc.data()}));

    const shSnap=await fdb.collection('shares').where('groupId','==',gid).get();
    DB.shares=[];shSnap.forEach(doc=>DB.shares.push({id:doc.id,...doc.data()}));

    const lSnap=await fdb.collection('loans').where('groupId','==',gid).get();
    DB.loans=[];lSnap.forEach(doc=>DB.loans.push({id:doc.id,...doc.data()}));

    const rSnap=await fdb.collection('repayments').where('groupId','==',gid).get();
    DB.repayments=[];rSnap.forEach(doc=>DB.repayments.push({id:doc.id,...doc.data()}));

    const wSnap=await fdb.collection('welfare').where('groupId','==',gid).get();
    DB.welfare=[];wSnap.forEach(doc=>DB.welfare.push({id:doc.id,...doc.data()}));

    const eSnap=await fdb.collection('expenses').where('groupId','==',gid).get();
    DB.expenses=[];eSnap.forEach(doc=>DB.expenses.push({id:doc.id,...doc.data()}));

    const mtSnap=await fdb.collection('meetings').where('groupId','==',gid).get();
    DB.meetings=[];mtSnap.forEach(doc=>DB.meetings.push({id:doc.id,...doc.data()}));

    const aSnap=await fdb.collection('announcements').where('groupId','==',gid).get();
    DB.announcements=[];aSnap.forEach(doc=>DB.announcements.push({id:doc.id,...doc.data()}));

    const cbSnap=await fdb.collection('cashbook').where('groupId','==',gid).get();
    DB.cashbook=[];cbSnap.forEach(doc=>DB.cashbook.push({id:doc.id,...doc.data()}));

    const auSnap=await fdb.collection('audit').where('groupId','==',gid).get();
    DB.audit=[];auSnap.forEach(doc=>DB.audit.push({id:doc.id,...doc.data()}));

    saveLocal();
    updateSyncUI();
  }catch(e){console.warn('Firestore sync error:',e);}
}

/* ================================================================
   RENDER: DASHBOARD
   ================================================================ */
function renderDashboard(){
  if(!currentGroup)return;
  const members=DB.members||[];
  const savings=DB.savings||[];
  const loans=DB.loans||[];
  const shares=DB.shares||[];
  const cur=currentGroup.currency||'TZS';

  const totalSavings=savings.filter(s=>s.type==='DEPOSIT').reduce((a,s)=>a+Number(s.amount||0),0) - savings.filter(s=>s.type==='WITHDRAWAL').reduce((a,s)=>a+Number(s.amount||0),0);
  const totalLoans=loans.reduce((a,l)=>a+Number(l.balance||l.principal||0),0);
  const totalShares=shares.filter(s=>s.action==='BUY').reduce((a,s)=>a+Number(s.value||0),0);
  const activeLoans=loans.filter(l=>l.status==='ACTIVE'||l.status==='active').length;

  document.getElementById('metrics').innerHTML=`
    <div class="card metric"><div class="icon" style="background:#0b3a2c;color:#55e1ae"><i class="fa-solid fa-users"></i></div><div><p>Members</p><h3>${members.length}</h3></div></div>
    <div class="card metric"><div class="icon" style="background:#0b2a4a;color:var(--blue)"><i class="fa-solid fa-piggy-bank"></i></div><div><p>Total Savings</p><h3>${fmt(totalSavings,cur)}</h3></div></div>
    <div class="card metric"><div class="icon" style="background:#3c2b08;color:#ffc857"><i class="fa-solid fa-hand-holding-dollar"></i></div><div><p>Outstanding Loans</p><h3>${fmt(totalLoans,cur)}</h3></div></div>
    <div class="card metric"><div class="icon" style="background:#2d1a44;color:var(--purple)"><i class="fa-solid fa-chart-pie"></i></div><div><p>Total Shares</p><h3>${fmt(totalShares,cur)}</h3></div></div>
    <div class="card metric"><div class="icon" style="background:#40151a;color:#ff7b85"><i class="fa-solid fa-circle-exclamation"></i></div><div><p>Active Loans</p><h3>${activeLoans}</h3></div></div>
  `;

  /* Summary */
  const totalDep=savings.filter(s=>s.type==='DEPOSIT').reduce((a,s)=>a+Number(s.amount||0),0);
  const totalWith=savings.filter(s=>s.type==='WITHDRAWAL').reduce((a,s)=>a+Number(s.amount||0),0);
  document.getElementById('financialSummary').innerHTML=`
    <div class="lc-row"><span class="lc-l">Total Deposits</span><span class="lc-v">${fmt(totalDep,cur)}</span></div>
    <div class="lc-row"><span class="lc-l">Total Withdrawals</span><span class="lc-v">${fmt(totalWith,cur)}</span></div>
    <div class="lc-row"><span class="lc-l">Net Savings</span><span class="lc-v">${fmt(totalSavings,cur)}</span></div>
    <div class="lc-row"><span class="lc-l">Loan Portfolio</span><span class="lc-v">${fmt(totalLoans,cur)}</span></div>
    <div class="lc-row"><span class="lc-l">Share Capital</span><span class="lc-v">${fmt(totalShares,cur)}</span></div>
  `;

  /* Alerts */
  const ads=DB.announcements||[];
  document.getElementById('dashSystemAds').innerHTML=ads.length?ads.slice(0,3).map(a=>`<div style="padding:8px 0;border-bottom:1px solid var(--line);font-size:12px"><strong>${a.title||''}</strong><br><span class="small">${a.description||''}</span></div>`).join(''):'<p class="small">No announcements</p>';

  /* Charts */
  renderDashCharts();
}

let chartPortfolio=null;let chartTrend=null;
function renderDashCharts(){
  const loans=DB.loans||[];
  const savings=DB.savings||[];
  const cur=currentGroup?.currency||'TZS';

  const activeLoans=loans.filter(l=>l.status==='ACTIVE'||l.status==='active').reduce((a,l)=>a+Number(l.balance||l.principal||0),0);
  const paidLoans=loans.filter(l=>l.status==='PAID'||l.status==='paid').reduce((a,l)=>a+Number(l.principal||0),0);
  const defaultLoans=loans.filter(l=>l.status==='DEFAULT'||l.status==='default').reduce((a,l)=>a+Number(l.balance||l.principal||0),0);

  if(chartPortfolio)chartPortfolio.destroy();
  const ctx1=document.getElementById('dashChartPortfolio');
  if(ctx1){
    chartPortfolio=new Chart(ctx1,{type:'doughnut',data:{labels:['Active','Paid','Default'],datasets:[{data:[activeLoans,paidLoans,defaultLoans],backgroundColor:['#3b82f6','#16a979','#ef4444']}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{color:'#8ea3b9',font:{size:10}}}}}});
  }

  const deposits=savings.filter(s=>s.type==='DEPOSIT');
  const months={};
  deposits.forEach(d=>{const dt=d.createdAt?(d.createdAt.toDate?d.createdAt.toDate():new Date(d.createdAt)):new Date();const key=dt.toLocaleDateString('en',{month:'short'});months[key]=(months[key]||0)+Number(d.amount||0);});

  if(chartTrend)chartTrend.destroy();
  const ctx2=document.getElementById('dashChartTrend');
  if(ctx2){
    chartTrend=new Chart(ctx2,{type:'line',data:{labels:Object.keys(months),datasets:[{label:'Deposits',data:Object.values(months),borderColor:'#16a979',backgroundColor:'rgba(22,169,121,.1)',fill:true,tension:.3}]},options:{responsive:true,maintainAspectRatio:false,scales:{x:{ticks:{color:'#8ea3b9'}},y:{ticks:{color:'#8ea3b9'}}},plugins:{legend:{labels:{color:'#8ea3b9'}}}}});
  }
}

