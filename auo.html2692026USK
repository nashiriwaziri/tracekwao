    <div class="card"><h4>${a.title||''}</h4><p class="small">${a.description||''}</p>
    <button class="btn danger sm" style="margin-top:8px" onclick="deleteSuperAd('${a.id||''}')"><i class="fa-solid fa-trash"></i></button></div>
  `).join('');
}

function saveSystemAd(event){
  event.preventDefault();
  const editId=document.getElementById('saEditId').value;
  const title=document.getElementById('saTitle').value;
  const desc=document.getElementById('saDesc').value;

  (async()=>{
    try{
      if(editId){
        await fdb.collection('superAds').doc(editId).update({title,description:desc});
        const idx=DB.superAds.findIndex(a=>a.id===editId);
        if(idx>=0){DB.superAds[idx].title=title;DB.superAds[idx].description=desc;}
      } else {
        const ref=fdb.collection('superAds').doc();
        const data={title,description:desc,createdAt:firebase.firestore.FieldValue.serverTimestamp()};
        await ref.set(data);
        DB.superAds.push({id:ref.id,...data,createdAt:new Date().toISOString()});
      }
      saveLocal();closeModal('superAdModal');renderSuperAds();renderPublicAds();toast('Ad saved','success');
    }catch(e){toast('Error: '+e.message,'error');}
  })();
  return false;
}

function deleteSuperAd(id){
  (async()=>{
    try{await fdb.collection('superAds').doc(id).delete();}catch(e){}
    DB.superAds=DB.superAds.filter(a=>a.id!==id);saveLocal();renderSuperAds();renderPublicAds();toast('Ad deleted','success');
  })();
}

function logoutSuper(){showScreen('landing');}

/* ================================================================
   LOGOUT
   ================================================================ */
function logout(){
  currentUser=null;currentGroup=null;role='member';
  showScreen('landing');
  toast('Logged out','success');
}

/* ================================================================
   PRICING
   ================================================================ */
let billingYearly=false;
const plans=[
  {id:'free',name:'Free',price_m:0,price_y:0,featured:false,pop:'',features:['Up to 15 members','Basic savings & loans','1 group','Community support'],disabled:['Advanced reports','API access','Custom branding']},
  {id:'starter',name:'Starter',price_m:4999,price_y:47990,featured:false,pop:'',features:['Up to 50 members','Savings, loans & shares','5 groups','Email support','Basic reports'],disabled:['API access','Custom branding']},
  {id:'pro',name:'Pro',price_m:14999,price_y:143990,featured:true,pop:'Most Popular',features:['Unlimited members','Full financial suite','Unlimited groups','Priority support','Advanced reports','API access','Custom branding'],disabled:[]},
  {id:'enterprise',name:'Enterprise',price_m:49999,price_y:479990,featured:false,pop:'',features:['Everything in Pro','Dedicated account manager','Custom integrations','SLA guarantee','On-premise option','Training sessions'],disabled:[]}
];

function setBillingCycle(c){billingYearly=c==='yearly';document.getElementById('toggleMonthly').classList.toggle('active',!billingYearly);document.getElementById('toggleYearly').classList.toggle('active',billingYearly);document.getElementById('billingToggle').classList.toggle('on',billingYearly);renderPricing();}
function toggleBilling(){billingYearly=!billingYearly;setBillingCycle(billingYearly?'yearly':'monthly');}

function renderPricing(){
  document.getElementById('pricingGrid').innerHTML=plans.map(p=>{
    const price=billingYearly?p.price_y:p.price_m;
    const period=billingYearly?'/year':'/month';
    return`<div class="price-card${p.featured?' featured':''}">
      ${p.pop?'<div class="badge-pop">'+p.pop+'</div>':''}
      <div class="price-header"><h3><i class="fa-solid fa-${p.id==='free'?'gift':p.id==='starter'?'rocket':p.id==='pro'?'crown':'building'}"></i> ${p.name}</h3>
      <div class="price-amount">${price===0?'Free':fmt(price)} <span>${price>0?period:''}</span></div></div>
      <ul class="price-features">${p.features.map(f=>'<li><i class="fa-solid fa-check"></i> '+f+'</li>').join('')}${(p.disabled||[]).map(f=>'<li class="disabled"><i class="fa-solid fa-xmark"></i> '+f+'</li>').join('')}</ul>
      <button class="btn ${p.featured?'primary':'outline'}" style="width:100%" onclick="startPayment('${p.id}')">${price===0?'Get Started':'Subscribe'}</button>
    </div>`;}).join('');
}

function startPayment(planId){
  const plan=plans.find(p=>p.id===planId);
  if(!plan)return;
  if(plan.price_m===0){toast('Free plan activated!','success');return;}
  const price=billingYearly?plan.price_y:plan.price_m;
  const period=billingYearly?'Yearly':'Monthly';

  document.getElementById('payStep1').className='pay-step active';
  document.getElementById('payStep2').className='pay-step';
  document.getElementById('payStep3').className='pay-step';
  document.getElementById('payPage1').classList.remove('hidden');
  document.getElementById('payPage2').classList.add('hidden');
  document.getElementById('payPage3').classList.add('hidden');

  document.getElementById('paySummaryBox').innerHTML=`
    <div class="pay-summary-row"><span>Plan</span><span>${plan.name}</span></div>
    <div class="pay-summary-row"><span>Billing</span><span>${period}</span></div>
    <div class="pay-summary-row total"><span>Total</span><span>${fmt(price)}</span></div>
  `;
  openModal('paymentModal');
}

let selectedPayMethod='';
function selectPayMethod(method){
  selectedPayMethod=method;
  document.querySelectorAll('.pay-method').forEach(el=>el.classList.toggle('selected',el.dataset.method===method));
  document.getElementById('payMpesa').classList.toggle('hidden',method!=='mpesa');
  document.getElementById('payAirtel').classList.toggle('hidden',method!=='airtel');
  document.getElementById('payBank').classList.toggle('hidden',method!=='bank');
  document.getElementById('payCard').classList.toggle('hidden',method!=='card');
}

function goPayStep(n){
  document.getElementById('payPage1').classList.toggle('hidden',n!==1);
  document.getElementById('payPage2').classList.toggle('hidden',n!==2);
  document.getElementById('payPage3').classList.toggle('hidden',n!==3);
  document.getElementById('payStep1').className='pay-step'+(n===1?' active':n>1?' done':'');
  document.getElementById('payStep2').className='pay-step'+(n===2?' active':n>2?' done':'');
  document.getElementById('payStep3').className='pay-step'+(n===3?' active':'');
}

function processPayment(){
  if(!selectedPayMethod){toast('Select a payment method','error');return;}
  /* Simulate payment */
  document.getElementById('paySubmitBtn').disabled=true;
  setTimeout(()=>{
    document.getElementById('paySubmitBtn').disabled=false;
    goPayStep(3);
    document.getElementById('payReceipt').innerHTML=document.getElementById('paySummaryBox').innerHTML;
  },2000);
}

function finishPayment(){closeModal('paymentModal');toast('Subscription activated!','success');}

/* ================================================================
   PUBLIC ADS & LOCALE
   ================================================================ */
function renderPublicAds(){
  const ads=DB.superAds||[];
  document.getElementById('publicAds').innerHTML=ads.length?ads.map(a=>`<div class="card"><h4>${a.title||''}</h4><p class="small">${a.description||''}</p></div>`).join(''):'<p class="small" style="grid-column:1/-1">No announcements yet.</p>';
}

let currentLang='en';
const langs={en:{},sw:{},fr:{}};
function setLang(l){
  currentLang=l;
  document.querySelectorAll('.locale-btn').forEach(b=>b.classList.toggle('active',b.textContent.toLowerCase().includes({en:'english',sw:'kiswahili',fr:'fran'}[l])));
}

/* ================================================================
   REPAY MODAL — populate loans
   ================================================================ */
const origOpenModal=openModal;
openModal=function(id){
  origOpenModal(id);
  if(id==='repayModal'){
    const sel=document.getElementById('repayLoan');
    sel.innerHTML=(DB.loans||[]).filter(l=>(l.status||'').toLowerCase()==='active').map(l=>{
      const m=(DB.members||[]).find(x=>x.id===l.memberId||x.docId===l.memberId);
      return`<option value="${l.id}">${m?m.name:'—'} — ${fmt(l.balance||l.principal)}</option>`;
    }).join('');
  }
  if(id==='welfareModal'){
    const sel=document.getElementById('wMember');
    sel.innerHTML=(DB.members||[]).map(m=>`<option value="${m.id||m.docId}">${m.name}</option>`).join('');
  }
  if(id==='memberModal'&&!document.getElementById('mEditId').value){
    document.getElementById('mPasswordRow').style.display='';
    document.getElementById('memberModalTitle').textContent='Add Member';
  }
};

/* ================================================================
   INIT
   ================================================================ */
function init(){
  renderPricing();
  renderPublicAds();
  loadGroupsForSuggestions();
  setupGroupSuggestions();
  setupPasswordStrength('mjPass','mjPassBar','mjPassLabel');
  setupPasswordStrength('grPass','grPassBar','grPassLabel');
  addPasswordToggles();
  updateSyncUI();

  /* Load public ads from Firestore */
  fdb.collection('superAds').get().then(snap=>{
    DB.superAds=[];snap.forEach(doc=>DB.superAds.push({id:doc.id,...doc.data()}));
    saveLocal();renderPublicAds();
  }).catch(()=>{});

  /* Also load groups list for suggestions */
  fdb.collection('groups').get().then(snap=>{
    allGroupsCache=[];
    snap.forEach(doc=>{const d=doc.data();allGroupsCache.push({id:doc.id,name:d.name||'',type:d.type||''});});
  }).catch(()=>{});

  window.addEventListener('online',updateSyncUI);
  window.addEventListener('offline',updateSyncUI);
}

if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',init);}
else{init();}
</script>
