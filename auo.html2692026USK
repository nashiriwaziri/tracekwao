function renderCashbook(){
  const cb=DB.cashbook||[];
  const cur=currentGroup?.currency||'TZS';
  let running=0;
  const rows=cb.sort((a,b)=>new Date(a.createdAt||a.date)-new Date(b.createdAt||b.date));
  document.getElementById('cashbookBody').innerHTML=rows.map(r=>{
    if(r.type==='CREDIT'||r.type==='INCOME')running+=Number(r.amount||0);
    else running-=Number(r.amount||0);
    return`<tr>
      <td>${dateStr(r.createdAt||r.date)}</td>
      <td>${r.ref||'—'}</td>
      <td>${r.type==='DEBIT'||r.type==='EXPENSE'?fmt(r.amount||0,cur):'—'}</td>
      <td>${r.type==='CREDIT'||r.type==='INCOME'?fmt(r.amount||0,cur):'—'}</td>
      <td>${fmt(running,cur)}</td>
    </tr>`;}).join('');

  const totalCredits=rows.filter(r=>r.type==='CREDIT'||r.type==='INCOME').reduce((a,r)=>a+Number(r.amount||0),0);
  const totalDebits=rows.filter(r=>r.type==='DEBIT'||r.type==='EXPENSE').reduce((a,r)=>a+Number(r.amount||0),0);
  document.getElementById('cashbookSummary').innerHTML=`
    <div class="card metric"><div class="icon" style="background:#0b3a2c;color:#55e1ae"><i class="fa-solid fa-arrow-down"></i></div><div><p>Total Credits</p><h3>${fmt(totalCredits,cur)}</h3></div></div>
    <div class="card metric"><div class="icon" style="background:#40151a;color:#ff7b85"><i class="fa-solid fa-arrow-up"></i></div><div><p>Total Debits</p><h3>${fmt(totalDebits,cur)}</h3></div></div>
    <div class="card metric"><div class="icon" style="background:#0b2a4a;color:var(--blue)"><i class="fa-solid fa-scale-balanced"></i></div><div><p>Balance</p><h3>${fmt(totalCredits-totalDebits,cur)}</h3></div></div>
  `;
}

