<div id="welfareModal" class="modal"><div class="modal-card"><div class="modal-head"><h3>Welfare</h3><button class="close" onclick="closeModal('welfareModal')">×</button></div><form id="welfareForm"><div class="row"><div class="field"><label>Member</label><select id="wMember"></select></div><div class="field"><label>Type</label><select id="wType"><option>CONTRIBUTION</option><option>ASSISTANCE</option></select></div></div><div class="field"><label>Amount</label><input id="wAmount" type="number" min="1" required></div><div class="field"><label>Description</label><textarea id="wDesc"></textarea></div><button class="btn primary">Hifadhi</button></form></div></div>
<div id="guarantorModal" class="modal"><div class="modal-card"><div class="modal-head"><h3>Mdhamini</h3><button class="close" onclick="closeModal('guarantorModal')">×</button></div><form id="guarantorForm"><div class="field"><label>Loan</label><select id="gLoan"></select></div><div class="row"><div class="field"><label>Guarantor</label><select id="gMember"></select></div><div class="field"><label>Amount Guaranteed</label><input id="gAmount" type="number" min="1"></div></div><button class="btn primary">Hifadhi</button></form></div></div>
<div id="dividendModal" class="modal"><div class="modal-card"><div class="modal-head"><h3>Dividend</h3><button class="close" onclick="closeModal('dividendModal')">×</button></div><form id="dividendForm"><div class="field"><label>Member</label><select id="dMember"></select></div><div class="row"><div class="field"><label>Shares</label><input id="dShares" type="number" min="0"></div><div class="field"><label>Rate %</label><input id="dRate" type="number" step="0.01"></div></div><div class="field"><label>Amount</label><input id="dAmount" type="number" min="0"></div><button class="btn primary">Hifadhi Dividend</button></form></div></div>
<div id="loanProductModal" class="modal"><div class="modal-card"><div class="modal-head"><h3>Loan Product</h3><button class="close" onclick="closeModal('loanProductModal')">×</button></div><form id="loanProductForm"><div class="field"><label>Name</label><input id="lpName" required></div><div class="row"><div class="field"><label>Interest %</label><input id="lpInterest" type="number" step="0.01"></div><div class="field"><label>Max Term</label><input id="lpTerm" type="number"></div></div><div class="field"><label>Max Amount</label><input id="lpMax" type="number"></div><button class="btn primary">Hifadhi Product</button></form></div></div>
<div id="memberViewModal" class="modal"><div class="modal-card"><div class="modal-head"><h3>Taarifa za Mwanachama</h3><button class="close" onclick="closeModal('memberViewModal')">×</button></div><div id="memberView"></div></div></div>
<div id="toast" class="toast"></div>

<script type="module">
import {initializeApp, getApps, getApp} from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js';
import {getAuth, onAuthStateChanged, signInWithEmailAndPassword, createUserWithEmailAndPassword, signOut, RecaptchaVerifier, signInWithPhoneNumber} from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js';
import {getFirestore, collection, doc, getDoc, getDocs, addDoc, setDoc, updateDoc, deleteDoc, query, where, orderBy, limit, serverTimestamp, runTransaction, writeBatch} from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js';

const firebaseConfig={apiKey:'AIzaSyBrtkRulxflRFp2ZfcnUuGHcmo57tkcRNI',authDomain:'ncrs-aeb43.firebaseapp.com',projectId:'ncrs-aeb43',storageBucket:'ncrs-aeb43.firebasestorage.app',messagingSenderId:'786434442929',measurementId:'G-ZYB71RY8J5'};
const app=initializeApp(firebaseConfig); const auth=getAuth(app); const db=getFirestore(app);
const $=id=>document.getElementById(id); const money=n=>new Intl.NumberFormat('en-TZ',{style:'currency',currency:'TZS',maximumFractionDigits:0}).format(Number(n||0));
const esc=s=>String(s??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
const uid=()=>auth.currentUser?.uid||null; const now=()=>new Date().toISOString(); let pendingMemberLogin=null;
let state={groupId:null,group:null,user:null,role:null,members:[],loans:[],section:'dashboard',super:false};
const roleCan=perm=>state.role==='CHAIRPERSON'||state.role==='SYSTEM_ADMIN'||(state.user?.permissions||[]).includes(perm);
function toast(m){$('toast').textContent=m;$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),3500)}
function openModal(id){if(id==='memberModal'&&!roleCan('manageMembers'))return toast('Chairperson pekee anaweza kuongeza mwanachama.'); if(['groupAdModal','meetingModal','transactionModal','cashModal','welfareModal','guarantorModal','dividendModal','loanProductModal'].includes(id)&&!roleCan('manageGroup'))return toast('Huruhusiwi.'); if(id==='globalAdModal'&&state.role!=='SYSTEM_ADMIN')return toast('Super Admin pekee.'); if(id==='shareModal'&&$('shareMode').value==='SELL'&&!roleCan('manageShares'))return toast('Chairperson pekee.'); $(''+id).classList.add('show'); populateSelects()}
function closeModal(id){$(id).classList.remove('show')}; window.openModal=openModal;window.closeModal=closeModal;
window.toggleSidebar=()=> $('sidebar').classList.toggle('open');
window.backLanding=()=>{ $('auth').classList.add('hidden');$('landing').classList.remove('hidden')};
window.openAuth=m=>{ $('landing').classList.add('hidden');$('auth').classList.remove('hidden');authMode(m==='chair'?'chair':'member')};
window.authMode=m=>{ $('memberTab').classList.toggle('active',m==='member');$('chairTab').classList.toggle('active',m==='chair');$('memberLogin').classList.toggle('hidden',m!=='member');$('chairLogin').classList.toggle('hidden',m!=='chair');$('chairRegister').classList.toggle('hidden',m!=='chair');$('authTitle').textContent=m==='member'?'Ingia Kikundi':'Chairperson / Sajili Kikundi'};
function normalizePhone(p){p=(p||'').replace(/\D/g,'');return p.startsWith('255')?'+'+p:p.startsWith('0')?'+255'+p.slice(1):'+'+p}
function username(u){return String(u||'').trim().toLowerCase().replace(/\s+/g,'')}
async function audit(action,entity,ref,data={}){if(!state.groupId||!uid())return;await addDoc(collection(db,'groups',state.groupId,'audit'),{action,entity,ref,userId:uid(),userName:state.user?.name||auth.currentUser?.email||'',createdAt:serverTimestamp(),data})}
async function getGroupByUsername(u){const s=await getDoc(doc(db,'groupUsernames',username(u)));if(!s.exists())throw Error('Group Username haipo.');return s.data()}
async function resolveMember(groupId,phone){const q=query(collection(db,'groups',groupId,'members'),where('phone','==',normalizePhone(phone)),limit(1));const s=await getDocs(q);return s.empty?null:{id:s.docs[0].id,...s.docs[0].data()}}
let recaptcha=null,confirmation=null;
$('memberLogin').addEventListener('submit',async e=>{e.preventDefault();try{const u=await getGroupByUsername($('loginGroupUsername').value);const p=normalizePhone($('loginPhone').value);pendingMemberLogin={groupId:u.groupId,groupUsername:u.username,phone:p};if(!recaptcha)recaptcha=new RecaptchaVerifier(auth,'recaptcha-container',{size:'invisible'});confirmation=await signInWithPhoneNumber(auth,p,recaptcha);const code=prompt('Weka OTP iliyotumwa kwenye simu yako:');if(!code)return;await confirmation.confirm(code);const m=await resolveMember(u.groupId,p);if(!m)throw Error('Namba hii haijasajiliwa katika kikundi hicho.');await setDoc(doc(db,'users',auth.currentUser.uid),{uid:auth.currentUser.uid,groupId:u.groupId,role:m.role||'MEMBER',name:m.name,phone:p,memberId:m.id,permissions:[],linkedAt:serverTimestamp()},{merge:true});await updateDoc(doc(db,'groups',u.groupId,'members',m.id),{authUid:auth.currentUser.uid,lastLoginAt:serverTimestamp()});pendingMemberLogin=null;}catch(err){$('authMsg').textContent=err.message;toast(err.message)}});
$('chairLogin').addEventListener('submit',async e=>{e.preventDefault();try{await signInWithEmailAndPassword(auth,$('chairEmail').value,$('chairPassword').value)}catch(err){toast(err.message)}});
$('chairRegister').addEventListener('submit',async e=>{e.preventDefault();try{const gname=$('regGroupName').value.trim(),gu=username($('regGroupUsername').value),email=$('regChairEmail').value.trim(),phone=normalizePhone($('regChairPhone').value);if(!gname||!gu||!email||!phone)throw Error('Jaza taarifa zote.');const taken=await getDoc(doc(db,'groupUsernames',gu));if(taken.exists())throw Error('Group Username tayari ipo.');const cr=await createUserWithEmailAndPassword(auth,email,$('regChairPassword').value);const gid=doc(collection(db,'groups')).id;const group={name:gname,username:gu,registrationNumber:'',sharePrice:10000,maxSharesPerMember:1000,meetingDay:'',loanInterest:10,chairpersonId:cr.user.uid,chairpersonName:$('regChairName').value,chairpersonPhone:phone,status:'ACTIVE',createdAt:serverTimestamp()};await setDoc(doc(db,'groups',gid),group);await setDoc(doc(db,'groupUsernames',gu),{groupId:gid,username:gu,status:'ACTIVE',createdAt:serverTimestamp()});await setDoc(doc(db,'groups',gid,'members',cr.user.uid),{groupId:gid,name:$('regChairName').value,phone,email,role:'CHAIRPERSON',status:'ACTIVE',shares:0,savings:0,loanBalance:0,createdAt:serverTimestamp()});await setDoc(doc(db,'users',cr.user.uid),{uid:cr.user.uid,groupId:gid,role:'CHAIRPERSON',name:$('regChairName').value,phone,permissions:['manageMembers','manageGroup','manageShares','manageLoans','manageFinance','manageAds'],createdAt:serverTimestamp()});toast('Kikundi kimesajiliwa.');}catch(err){toast(err.message)}});
function nav(){const items=[['dashboard','Dashibodi','gauge-high'],['members','Wanachama','users'],['group','Kikundi','sitemap'],['announcements','Matangazo ya Kikundi','bullhorn'],['meetings','Vikao & Dakika','calendar-check'],['savings','Akiba','piggy-bank'],['shares','Hisa','certificate'],['loans','Mikopo','hand-holding-dollar'],['repayments','Marejesho','money-bill-transfer'],['expenses','Mapato & Matumizi','wallet'],['cashbook','Cashbook','book'],['ledger','General Ledger','file-invoice-dollar'],['welfare','Welfare Fund','hand-holding-heart'],['guarantors','Wadhamini','user-shield'],['dividends','Dividends','coins'],['reports','Ripoti','chart-pie'],['audit','Audit Trail','clipboard-check'],['profile','Profaili','user']];$('nav').innerHTML=items.map(x=>`<button data-sec="${x[0]}" onclick="showSection('${x[0]}',this)"><i class="fa-solid fa-${x[2]}"></i>${x[1]}</button>`).join('')}
window.showSection=(id,el)=>{if(!state.groupId)return;document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));$(id).classList.add('active');document.querySelectorAll('.nav button').forEach(b=>b.classList.remove('active'));if(el)el.classList.add('active');else document.querySelector(`.nav button[data-sec="${id}"]`)?.classList.add('active');$('pageTitle').textContent=document.querySelector(`button[data-sec="${id}"]`)?.innerText||id;state.section=id;loadSection(id)};
async function bootUser(u){const ud=await getDoc(doc(db,'users',u.uid));if(!ud.exists())throw Error('User profile haipo.');state.user={id:u.uid,...ud.data()};state.role=state.user.role;state.groupId=state.user.groupId;state.group=(await getDoc(doc(db,'groups',state.groupId))).data();if(!state.group)throw Error('Kikundi hakipo.');$('landing').classList.add('hidden');$('auth').classList.add('hidden');$('app').classList.remove('hidden');$('sideGroup').textContent=state.group.name;$('sideRole').textContent=state.role;$('topUser').textContent=`${state.user.name||u.phoneNumber||u.email} • ${state.role}`;nav();document.querySelectorAll('.chair-only').forEach(x=>x.style.display=state.role==='CHAIRPERSON'?'':'none');await loadMembers();showSection('dashboard');}
onAuthStateChanged(auth,async u=>{if(!u)return;if(state.super)return;try{await bootUser(u)}catch(e){toast(e.message);await signOut(auth)}});
window.logout=async()=>{state={groupId:null,group:null,user:null,role:null,members:[],loans:[],section:'dashboard',super:false};await signOut(auth);location.reload()};
async function loadMembers(){if(!state.groupId)return;const s=await getDocs(collection(db,'groups',state.groupId,'members'));state.members=s.docs.map(d=>({id:d.id,...d.data()}));const visible=state.role==='CHAIRPERSON'||state.role==='SYSTEM_ADMIN'?state.members:state.members.filter(m=>m.authUid===uid()||m.id===state.user?.memberId);$('membersBody').innerHTML=visible.map(m=>`<tr><td>${esc(m.name)}</td><td>${esc(m.phone)}</td><td>${m.shares||0}</td><td>${money(m.savings)}</td><td>${money(m.loanBalance)}</td><td><span class="badge ${m.status==='ACTIVE'?'ok':'bad'}">${esc(m.status||'ACTIVE')}</span></td><td><button class="btn outline" onclick="viewMember('${m.id}')">View</button> ${state.role==='CHAIRPERSON'?`<button class="btn danger" onclick="deleteMember('${m.id}')">Delete</button>`:''}</td></tr>`).join('')||'<tr><td colspan="7">Hakuna taarifa za kuonyesha.</td></tr>';}
window.viewMember=async id=>{const m=state.members.find(x=>x.id===id);if(state.role!=='CHAIRPERSON'&&m?.authUid!==uid()&&m?.id!==state.user?.memberId)return toast('Unaweza kuona taarifa zako binafsi tu.');$('memberView').innerHTML=`<div class="metrics"><div class="card"><b>Akiba</b><h3>${money(m.savings)}</h3></div><div class="card"><b>Hisa</b><h3>${m.shares||0}</h3></div><div class="card"><b>Mkopo</b><h3>${money(m.loanBalance)}</h3></div></div><p><b>Jina:</b> ${esc(m.name)}<br><b>Simu:</b> ${esc(m.phone)}<br><b>Member No:</b> ${esc(m.memberNo||'')}</p>`;openModal('memberViewModal')};
window.deleteMember=async id=>{if(state.role!=='CHAIRPERSON')return toast('Chairperson pekee.');const m=state.members.find(x=>x.id===id);if(!confirm(`Futa ${m.name}?`))return;try{await updateDoc(doc(db,'groups',state.groupId,'members',id),{status:'DELETED',deletedAt:serverTimestamp(),deletedBy:uid()});await audit('DELETE_MEMBER','member',id,{name:m.name});await loadMembers();await loadDashboard();toast('Mwanachama amewekwa DELETED.');}catch(e){toast(e.message)}};
$('memberForm').addEventListener('submit',async e=>{e.preventDefault();if(!roleCan('manageMembers'))return;try{const phone=normalizePhone($('mPhone').value);const ref=doc(collection(db,'groups',state.groupId,'members'));await setDoc(ref,{groupId:state.groupId,name:$('mName').value.trim(),phone,memberNo:$('mNo').value.trim(),role:'MEMBER',status:'ACTIVE',shares:Number($('mShares').value||0),savings:Number($('mSavings').value||0),loanBalance:0,createdAt:serverTimestamp(),createdBy:uid()});await audit('ADD_MEMBER','member',ref.id);closeModal('memberModal');e.target.reset();await loadMembers();toast('Mwanachama ameongezwa. Atatumia Group Username + simu + OTP kuingia.');}catch(err){toast(err.message)}});
$('groupForm').addEventListener('submit',async e=>{e.preventDefault();if(!roleCan('manageGroup'))return;await updateDoc(doc(db,'groups',state.groupId),{name:$('gName').value,registrationNumber:$('gReg').value,sharePrice:Number($('gSharePrice').value||0),maxSharesPerMember:Number($('gMaxShares').value||0),meetingDay:$('gMeetingDay').value,loanInterest:Number($('gInterest').value||0),updatedAt:serverTimestamp()});state.group=(await getDoc(doc(db,'groups',state.groupId))).data();toast('Taarifa za kikundi zimesasishwa.')});
async function loadGroup(){if(!state.group)return;$('gName').value=state.group.name||'';$('gReg').value=state.group.registrationNumber||'';$('gSharePrice').value=state.group.sharePrice||0;$('gMaxShares').value=state.group.maxSharesPerMember||0;$('gMeetingDay').value=state.group.meetingDay||'';$('gInterest').value=state.group.loanInterest||0}
$('groupAdForm').addEventListener('submit',async e=>{e.preventDefault();if(!roleCan('manageGroup'))return;await addDoc(collection(db,'groups',state.groupId,'ads'),{type:$('adType').value,title:$('adTitle').value,description:$('adDesc').value,price:Number($('adPrice').value||0),phone:$('adPhone').value,imageUrl:$('adImage').value,status:'PUBLISHED',createdBy:uid(),createdByName:state.user.name,createdAt:serverTimestamp()});closeModal('groupAdModal');e.target.reset();loadGroupAds();toast('Tangazo limechapishwa ndani ya kikundi.')});
async function loadGroupAds(){const s=await getDocs(query(collection(db,'groups',state.groupId,'ads'),orderBy('createdAt','desc'),limit(50)));$('groupAds').innerHTML=s.docs.map(d=>{const a=d.data();return `<div class="card ad">${a.imageUrl?`<img src="${esc(a.imageUrl)}">`:''}<h3>${esc(a.title)}</h3><p>${esc(a.description)}</p>${a.price?`<b>${money(a.price)}</b>`:''}<div class="small">${esc(a.phone||'')}</div>${state.role==='CHAIRPERSON'?`<button class="btn danger" onclick="deleteGroupAd('${d.id}')">Delete</button>`:''}</div>`}).join('')||'<div class="card">Hakuna matangazo.</div>';$('dashboardAds').innerHTML=$('groupAds').innerHTML;}
window.deleteGroupAd=async id=>{if(state.role!=='CHAIRPERSON')return;await deleteDoc(doc(db,'groups',state.groupId,'ads',id));await audit('DELETE_GROUP_AD','ad',id);loadGroupAds()};
$('meetingForm').addEventListener('submit',async e=>{e.preventDefault();await addDoc(collection(db,'groups',state.groupId,'meetings'),{date:$('meetDate').value,topic:$('meetTopic').value,attendance:$('meetAttendance').value,minutes:$('meetMinutes').value,createdBy:uid(),createdAt:serverTimestamp()});closeModal('meetingModal');e.target.reset();loadMeetings()});
async function loadMeetings(){const s=await getDocs(query(collection(db,'groups',state.groupId,'meetings'),orderBy('date','desc'),limit(100)));$('meetingsBody').innerHTML=s.docs.map(d=>{const x=d.data();return `<tr><td>${esc(x.date)}</td><td>${esc(x.topic)}</td><td>${esc(x.minutes)}</td><td>${state.role==='CHAIRPERSON'?`<button class="btn danger" onclick="deleteMeeting('${d.id}')">Delete</button>`:''}</td></tr>`}).join('')}
window.deleteMeeting=async id=>{if(state.role!=='CHAIRPERSON')return;await deleteDoc(doc(db,'groups',state.groupId,'meetings',id));loadMeetings()};
window.setTx=t=>{$('txType').value=t;$('txTitle').textContent=t==='DEPOSIT'?'Weka Akiba':'Toa Akiba'};
$('txForm').addEventListener('submit',async e=>{e.preventDefault();const mid=$('txMember').value,amt=Number($('txAmount').value);if(!roleCan('manageFinance'))return;try{await runTransaction(db,async tx=>{const mref=doc(db,'groups',state.groupId,'members',mid);const ms=await tx.get(mref);if(!ms.exists())throw Error('Member not found');const m=ms.data();const bal=Number(m.savings||0);if($('txType').value==='WITHDRAWAL'&&bal<amt)throw Error('Akiba haitoshi.');tx.update(mref,{savings:$('txType').value==='DEPOSIT'?bal+amt:bal-amt,updatedAt:serverTimestamp()});const tr=doc(collection(db,'groups',state.groupId,'savings'));tx.set(tr,{memberId:mid,type:$('txType').value,amount:amt,reference:$('txRef').value,createdBy:uid(),createdAt:serverTimestamp()})});await audit('SAVINGS_TRANSACTION','savings',mid,{type:$('txType').value,amount:amt});closeModal('transactionModal');e.target.reset();await loadMembers();await loadSavings();await loadDashboard();toast('Transaction imehifadhiwa.')}catch(err){toast(err.message)}});
async function loadSavings(){const s=await getDocs(query(collection(db,'groups',state.groupId,'savings'),orderBy('createdAt','desc'),limit(100)));$('savingsBody').innerHTML=s.docs.map(d=>{const x=d.data(),m=state.members.find(z=>z.id===x.memberId);return `<tr><td>${x.createdAt?.toDate?.().toLocaleString()||''}</td><td>${esc(m?.name||'')}</td><td>${x.type}</td><td>${money(x.amount)}</td><td>${esc(x.reference||'')}</td></tr>`}).join('')}
window.setShareMode=m=>{$('shareMode').value=m;$('shareTitle').textContent=m==='BUY'?'Nunua Hisa':m==='SELL'?'Uza Hisa kwa Kikundi':'Hamisha Hisa';$('transferToWrap').classList.toggle('hidden',m!=='TRANSFER')};
$('shareForm').addEventListener('submit',async e=>{e.preventDefault();const mode=$('shareMode').value,mid=$('shareMember').value,qty=Number($('shareQty').value),price=Number(state.group.sharePrice||0);try{await runTransaction(db,async tx=>{const mref=doc(db,'groups',state.groupId,'members',mid);const ms=await tx.get(mref);const m=ms.data();let from=Number(m.shares||0);if(mode==='BUY'){if(from+qty>Number(state.group.maxSharesPerMember||Infinity))throw Error('Inazidi kikomo cha hisa.');tx.update(mref,{shares:from+qty});}else if(mode==='SELL'){if(state.role!=='CHAIRPERSON')throw Error('Chairperson pekee.');if(from<qty)throw Error('Hisa hazitoshi.');tx.update(mref,{shares:from-qty});}else{const to=$('shareTo').value;if(to===mid)throw Error('Chagua mwanachama mwingine.');if(from<qty)throw Error('Hisa hazitoshi.');const tref=doc(db,'groups',state.groupId,'members',to);const ts=await tx.get(tref);tx.update(mref,{shares:from-qty});tx.update(tref,{shares:Number(ts.data().shares||0)+qty});}const tr=doc(collection(db,'groups',state.groupId,'shares'));tx.set(tr,{memberId:mid,type:mode,quantity:qty,value:qty*price,toMemberId:mode==='TRANSFER'?$('shareTo').value:null,createdBy:uid(),createdAt:serverTimestamp()})});closeModal('shareModal');e.target.reset();await loadMembers();await loadShares();await loadDashboard();toast('Hisa transaction imehifadhiwa.')}catch(err){toast(err.message)}});
async function loadShares(){const s=await getDocs(query(collection(db,'groups',state.groupId,'shares'),orderBy('createdAt','desc'),limit(100)));$('sharesBody').innerHTML=s.docs.map(d=>{const x=d.data(),m=state.members.find(z=>z.id===x.memberId);return `<tr><td>${x.createdAt?.toDate?.().toLocaleString()||''}</td><td>${esc(m?.name||'')}</td><td>${x.type}</td><td>${x.quantity}</td><td>${money(x.value)}</td><td><span class="badge ok">POSTED</span></td></tr>`}).join('')}
$('loanForm').addEventListener('submit',async e=>{e.preventDefault();const ref=await addDoc(collection(db,'groups',state.groupId,'loans'),{memberId:$('loanMember').value,principal:Number($('loanPrincipal').value),interestRate:Number($('loanInterest').value),termMonths:Number($('loanTerm').value),purpose:$('loanPurpose').value,status:'PENDING',balance:Number($('loanPrincipal').value),createdBy:uid(),createdAt:serverTimestamp()});await audit('CREATE_LOAN','loan',ref.id);closeModal('loanModal');e.target.reset();loadLoans();toast('Ombi la mkopo limehifadhiwa.')});
async function loadLoans(){const s=await getDocs(query(collection(db,'groups',state.groupId,'loans'),orderBy('createdAt','desc'),limit(100)));state.loans=s.docs.map(d=>({id:d.id,...d.data()}));$('loansBody').innerHTML=state.loans.map(l=>{const m=state.members.find(z=>z.id===l.memberId);let a='';if(state.role==='CHAIRPERSON'&&l.status==='PENDING')a=`<button class="btn primary" onclick="approveLoan('${l.id}')">Approve</button>`;return `<tr><td>${esc(m?.name||'')}</td><td>${money(l.principal)}</td><td>${money(l.balance)}</td><td>${l.interestRate}%</td><td><span class="badge ${l.status==='ACTIVE'?'ok':'warn'}">${l.status}</span></td><td>${a}</td></tr>`}).join('')}
window.approveLoan=async id=>{if(state.role!=='CHAIRPERSON')return;await updateDoc(doc(db,'groups',state.groupId,'loans',id),{status:'ACTIVE',approvedBy:uid(),approvedAt:serverTimestamp()});await audit('APPROVE_LOAN','loan',id);loadLoans();toast('Mkopo umeidhinishwa.')};
$('repayForm').addEventListener('submit',async e=>{e.preventDefault();const id=$('repayLoan').value,amt=Number($('repayAmount').value);try{await runTransaction(db,async tx=>{const lref=doc(db,'groups',state.groupId,'loans',id),ls=await tx.get(lref);const l=ls.data();const bal=Number(l.balance||0);if(amt>bal)throw Error('Marejesho yanazidi salio.');tx.update(lref,{balance:bal-amt,status:bal-amt===0?'COMPLETED':'ACTIVE'});const r=doc(collection(db,'groups',state.groupId,'repayments'));tx.set(r,{loanId:id,memberId:l.memberId,amount:amt,type:$('repayType').value,createdBy:uid(),createdAt:serverTimestamp()})});closeModal('repaymentModal');e.target.reset();loadLoans();loadRepayments();loadMembers();toast('Marejesho yamehifadhiwa.')}catch(err){toast(err.message)}});
async function loadRepayments(){const s=await getDocs(query(collection(db,'groups',state.groupId,'repayments'),orderBy('createdAt','desc'),limit(100)));$('repaymentsBody').innerHTML=s.docs.map(d=>{const x=d.data(),m=state.members.find(z=>z.id===x.memberId);return `<tr><td>${x.createdAt?.toDate?.().toLocaleString()||''}</td><td>${x.loanId}</td><td>${esc(m?.name||'')}</td><td>${money(x.amount)}</td><td>${x.type}</td></tr>`}).join('')}
$('cashForm').addEventListener('submit',async e=>{e.preventDefault();await addDoc(collection(db,'groups',state.groupId,'cash'),{type:$('cashType').value,amount:Number($('cashAmount').value),description:$('cashDesc').value,createdBy:uid(),createdAt:serverTimestamp()});closeModal('cashModal');e.target.reset();loadCash();loadCashbook();loadLedger();loadDashboard()});
async function loadCash(){const s=await getDocs(query(collection(db,'groups',state.groupId,'cash'),orderBy('createdAt','desc'),limit(100)));$('cashBody').innerHTML=s.docs.map(d=>{const x=d.data();return `<tr><td>${x.createdAt?.toDate?.().toLocaleString()||''}</td><td>${x.type}</td><td>${esc(x.description)}</td><td>${money(x.amount)}</td></tr>`}).join('')}
async function loadCashbook(){const s=await getDocs(query(collection(db,'groups',state.groupId,'cash'),orderBy('createdAt','asc'),limit(500)));let bal=0,inn=0,out=0;let rows='';s.forEach(d=>{const x=d.data();if(x.type==='INCOME'){bal+=Number(x.amount);inn+=Number(x.amount)}else{bal-=Number(x.amount);out+=Number(x.amount)}rows=`<tr><td>${x.createdAt?.toDate?.().toLocaleDateString()||''}</td><td>${esc(x.description)}</td><td>${x.type==='INCOME'?money(x.amount):'-'}</td><td>${x.type==='EXPENSE'?money(x.amount):'-'}</td><td>${money(bal)}</td></tr>`+rows});$('cashbookBody').innerHTML=rows;$('cashbookSummary').innerHTML=`<div class="card metric"><p>Mapato</p><h3>${money(inn)}</h3></div><div class="card metric"><p>Matumizi</p><h3>${money(out)}</h3></div><div class="card metric"><p>Balance</p><h3>${money(bal)}</h3></div>`}
async function loadLedger(){const s=await getDocs(query(collection(db,'groups',state.groupId,'ledger'),orderBy('createdAt','desc'),limit(100)));$('ledgerBody').innerHTML=s.docs.map(d=>{const x=d.data();return `<tr><td>${x.createdAt?.toDate?.().toLocaleString()||''}</td><td>${esc(x.description)}</td><td>${x.debit||''}</td><td>${x.credit||''}</td><td>${money(x.amount)}</td></tr>`}).join('')}
$('welfareForm').addEventListener('submit',async e=>{e.preventDefault();await addDoc(collection(db,'groups',state.groupId,'welfare'),{memberId:$('wMember').value,type:$('wType').value,amount:Number($('wAmount').value),description:$('wDesc').value,createdBy:uid(),createdAt:serverTimestamp()});closeModal('welfareModal');e.target.reset();loadWelfare()});
async function loadWelfare(){const s=await getDocs(query(collection(db,'groups',state.groupId,'welfare'),orderBy('createdAt','desc'),limit(100)));$('welfareBody').innerHTML=s.docs.map(d=>{const x=d.data(),m=state.members.find(z=>z.id===x.memberId);return `<tr><td>${x.createdAt?.toDate?.().toLocaleString()||''}</td><td>${esc(m?.name||'')}</td><td>${x.type}</td><td>${money(x.amount)}</td><td>${esc(x.description||'')}</td></tr>`}).join('')}
$('guarantorForm').addEventListener('submit',async e=>{e.preventDefault();await addDoc(collection(db,'groups',state.groupId,'guarantors'),{loanId:$('gLoan').value,memberId:$('gMember').value,amount:Number($('gAmount').value),status:'ACTIVE',createdBy:uid(),createdAt:serverTimestamp()});closeModal('guarantorModal');e.target.reset();loadGuarantors()});
async function loadGuarantors(){const s=await getDocs(query(collection(db,'groups',state.groupId,'guarantors'),orderBy('createdAt','desc'),limit(100)));$('guarantorsBody').innerHTML=s.docs.map(d=>{const x=d.data(),m=state.members.find(z=>z.id===x.memberId);return `<tr><td>${x.loanId}</td><td>${esc(m?.name||'')}</td><td>${money(x.amount)}</td><td>${x.status}</td></tr>`}).join('')}
$('dividendForm').addEventListener('submit',async e=>{e.preventDefault();await addDoc(collection(db,'groups',state.groupId,'dividends'),{memberId:$('dMember').value,shares:Number($('dShares').value),rate:Number($('dRate').value),amount:Number($('dAmount').value),createdBy:uid(),createdAt:serverTimestamp()});closeModal('dividendModal');e.target.reset();loadDividends()});
async function loadDividends(){const s=await getDocs(query(collection(db,'groups',state.groupId,'dividends'),orderBy('createdAt','desc'),limit(100)));$('dividendsBody').innerHTML=s.docs.map(d=>{const x=d.data(),m=state.members.find(z=>z.id===x.memberId);return `<tr><td>${x.createdAt?.toDate?.().toLocaleDateString()||''}</td><td>${esc(m?.name||'')}</td><td>${x.shares}</td><td>${x.rate}%</td><td>${money(x.amount)}</td></tr>`}).join('')}
$('loanProductForm').addEventListener('submit',async e=>{e.preventDefault();await addDoc(collection(db,'groups',state.groupId,'loanProducts'),{name:$('lpName').value,interest:Number($('lpInterest').value),maxTerm:Number($('lpTerm').value),maxAmount:Number($('lpMax').value),createdBy:uid(),createdAt:serverTimestamp()});closeModal('loanProductModal');e.target.reset();toast('Loan product imehifadhiwa.')});
function populateSelect(id,items,label){$(id).innerHTML=items.map(x=>`<option value="${x.id}">${esc(x[label]||x.name)}</option>`).join('')}
function populateSelects(){populateSelect('txMember',state.members,'name');populateSelect('shareMember',state.members,'name');populateSelect('shareTo',state.members,'name');populateSelect('loanMember',state.members,'name');populateSelect('wMember',state.members,'name');populateSelect('gMember',state.members,'name');populateSelect('dMember',state.members,'name');populateSelect('repayLoan',state.loans,'id');populateSelect('gLoan',state.loans,'id')}
async function loadDashboard(){if(!state.groupId)return;let savings=0,shares=0,loans=0;state.members.forEach(m=>{savings+=Number(m.savings||0);shares+=Number(m.shares||0)*Number(state.group.sharePrice||0);loans+=Number(m.loanBalance||0)});$('metrics').innerHTML=`<div class="card metric"><p>Wanachama</p><h3>${state.members.filter(m=>m.status!=='DELETED').length}</h3></div><div class="card metric"><p>Akiba</p><h3>${money(savings)}</h3></div><div class="card metric"><p>Hisa</p><h3>${money(shares)}</h3></div><div class="card metric"><p>Mikopo Hai</p><h3>${money(loans)}</h3></div><div class="card metric"><p>Bei ya Hisa</p><h3>${money(state.group.sharePrice)}</h3></div>`;$('dashboardScope').textContent=`Kikundi: ${state.group.name} • Group Username: ${state.group.username}`;$('financialSummary').innerHTML=`<p>Akiba: <b>${money(savings)}</b></p><p>Thamani ya Hisa: <b>${money(shares)}</b></p><p>Mikopo Hai: <b>${money(loans)}</b></p>`}
async function loadReports(){const active=state.members.filter(m=>m.status!=='DELETED');const loans=state.loans.filter(l=>l.status==='ACTIVE');$('reportPortfolio').innerHTML=`Akiba: <b>${money(active.reduce((a,m)=>a+Number(m.savings||0),0))}</b><br>Hisa: <b>${active.reduce((a,m)=>a+Number(m.shares||0),0)}</b><br>Mikopo Active: <b>${money(loans.reduce((a,l)=>a+Number(l.balance||0),0))}</b>`;$('reportPAR').innerHTML=`Active loans: ${loans.length}<br>Outstanding: ${money(loans.reduce((a,l)=>a+Number(l.balance||0),0))}`;$('reportMembers').innerHTML=active.map(m=>`${esc(m.name)} — ${money(m.savings)} / ${m.shares||0} shares`).join('<br>')||'Hakuna';}
async function loadAudit(){const s=await getDocs(query(collection(db,'groups',state.groupId,'audit'),orderBy('createdAt','desc'),limit(100)));$('auditBody').innerHTML=s.docs.map(d=>{const x=d.data();return `<tr><td>${x.createdAt?.toDate?.().toLocaleString()||''}</td><td>${esc(x.userName)}</td><td>${esc(x.action)}</td><td>${esc(x.entity)}</td><td>${esc(x.ref)}</td></tr>`}).join('')}
async function loadProfile(){const u=state.user;$('profileBox').innerHTML=`<h3>${esc(u.name||'')}</h3><p>Role: ${esc(u.role)}<br>Phone: ${esc(u.phone||auth.currentUser?.phoneNumber||'')}<br>Email: ${esc(auth.currentUser?.email||'')}<br>Group: ${esc(state.group.name)}</p>`}
async function loadSection(id){switch(id){case'dashboard':await loadDashboard();break;case'members':await loadMembers();break;case'group':await loadGroup();break;case'announcements':await loadGroupAds();break;case'meetings':await loadMeetings();break;case'savings':await loadSavings();break;case'shares':await loadShares();break;case'loans':await loadLoans();break;case'repayments':await loadRepayments();break;case'expenses':await loadCash();break;case'cashbook':await loadCashbook();break;case'ledger':await loadLedger();break;case'welfare':await loadWelfare();break;case'guarantors':await loadGuarantors();break;case'dividends':await loadDividends();break;case'reports':await loadReports();break;case'audit':await loadAudit();break;case'profile':await loadProfile();break}}
async function exportCurrentReport(){window.print()}
window.exportCurrentReport=exportCurrentReport;
async function loadPublicAds(){try{const s=await getDocs(query(collection(db,'systemAds'),where('status','==','PUBLISHED'),limit(30)));$('publicAds').innerHTML=s.docs.map(d=>{const a=d.data();return `<div class="card ad">${a.imageUrl?`<img src="${esc(a.imageUrl)}">`:''}<h3>${esc(a.title)}</h3><p>${esc(a.description)}</p><span class="badge">${a.scope||'GLOBAL'}</span></div>`}).join('')||'<div class="card">Hakuna tangazo la mfumo kwa sasa.</div>'}catch(e){$('publicAds').innerHTML='<div class="card">Matangazo yatapatikana baada ya Firestore Rules kuwekwa.</div>'}}
window.openSuper=async()=>{$('landing').classList.add('hidden');$('super').classList.remove('hidden');state.super=true;const email=prompt('Super Admin Email');const pass=prompt('Super Admin Password');try{await signInWithEmailAndPassword(auth,email,pass);const u=auth.currentUser;const ud=await getDoc(doc(db,'users',u.uid));if(!ud.exists()||ud.data().role!=='SYSTEM_ADMIN')throw Error('Account si SYSTEM_ADMIN');await renderSuper()}catch(e){toast(e.message);$('super').classList.add('hidden');$('landing').classList.remove('hidden');state.super=false}};
window.superLogout=async()=>{await signOut(auth);location.reload()};
async function renderSuper(){const gs=await getDocs(collection(db,'groups'));let total=0;let rows='';for(const d of gs.docs){const m=await getDocs(collection(db,'groups',d.id,'members'));const active=m.docs.filter(x=>x.data().status!=='DELETED').length;total+=active;const g=d.data();rows+=`<tr><td>${esc(g.name)}</td><td>${esc(g.username)}</td><td>${active}</td><td>${esc(g.status||'ACTIVE')}</td><td>${g.createdAt?.toDate?.().toLocaleDateString()||''}</td></tr>`}$('superGroups').innerHTML=rows||'<tr><td colspan="5">Hakuna vikundi.</td></tr>';$('superMetrics').innerHTML=`<div class="card metric"><p>Vikundi</p><h3>${gs.size}</h3></div><div class="card metric"><p>Wanachama</p><h3>${total}</h3></div>`;const a=await getDocs(query(collection(db,'systemAds'),orderBy('createdAt','desc'),limit(30)));$('superAds').innerHTML=a.docs.map(d=>{const x=d.data();return `<div class="card" style="margin-bottom:8px"><b>${esc(x.title)}</b><p class="small">${esc(x.description)}</p><button class="btn danger" onclick="deleteGlobalAd('${d.id}')">Delete</button></div>`}).join('')||'Hakuna';}
$('globalAdForm').addEventListener('submit',async e=>{e.preventDefault();if(state.role!=='SYSTEM_ADMIN')return toast('Super Admin pekee.');await addDoc(collection(db,'systemAds'),{title:$('gaTitle').value,description:$('gaDesc').value,scope:$('gaScope').value,groupId:$('gaGroupId').value||null,imageUrl:$('gaImage').value,status:'PUBLISHED',createdBy:uid(),createdAt:serverTimestamp()});closeModal('globalAdModal');e.target.reset();renderSuper();loadPublicAds()});
window.deleteGlobalAd=async id=>{if(state.role!=='SYSTEM_ADMIN')return;await deleteDoc(doc(db,'systemAds',id));renderSuper();loadPublicAds()};
loadPublicAds();
</script></body></html>
