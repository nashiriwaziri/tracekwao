<!DOCTYPE html>
<html lang="sw">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>CSCMS Pro V2 — Vikoba & Microfinance</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<style>
:root{--bg:#07111f;--panel:#0d1929;--panel2:#122238;--line:#21344d;--text:#e8f0f8;--muted:#8ea3b9;--p:#16a979;--p2:#35d39b;--blue:#3b82f6;--red:#ef4444;--yellow:#f59e0b;--purple:#8b5cf6;--radius:12px}*{box-sizing:border-box}body{margin:0;background:linear-gradient(135deg,#06101c,#0a1423);color:var(--text);font-family:Inter,Arial,sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer}.hidden{display:none!important}.landing{min-height:100vh}.hero{text-align:center;padding:65px 20px 30px}.logo{width:72px;height:72px;border-radius:18px;background:linear-gradient(135deg,var(--p),#07563f);display:grid;place-items:center;margin:auto;font-size:30px}.brand{font-size:40px;font-weight:800;margin:12px 0 5px}.tag{color:var(--muted);font-size:14px}.hero-actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:25px}.btn{border:0;border-radius:9px;padding:10px 15px;font-weight:600;font-size:12px}.primary{background:var(--p);color:#fff}.outline{background:transparent;color:var(--p2);border:1px solid var(--p)}.danger{background:var(--red);color:#fff}.info{background:var(--blue);color:#fff}.warning{background:var(--yellow);color:#111}.mutedbtn{background:var(--panel2);color:var(--text);border:1px solid var(--line)}.container{max-width:1200px;margin:auto;padding:20px}.public-grid,.metrics,.grid{display:grid;gap:14px}.public-grid{grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}.card{background:rgba(13,25,41,.96);border:1px solid var(--line);border-radius:var(--radius);padding:18px}.ad{min-height:150px}.ad img{max-width:100%;max-height:170px;border-radius:9px;object-fit:cover}.auth{min-height:100vh;display:grid;place-items:center;padding:20px}.auth-card{width:min(520px,100%);background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:25px}.tabs{display:flex;background:var(--panel2);padding:4px;border-radius:10px;margin-bottom:18px}.tab{flex:1;background:none;color:var(--muted);border:0;padding:10px;border-radius:7px}.tab.active{background:var(--p);color:#fff}.field{margin:11px 0}.field label{display:block;font-size:11px;color:var(--muted);margin-bottom:5px}.field input,.field select,.field textarea{width:100%;padding:11px;border:1px solid var(--line);background:#091625;color:var(--text);border-radius:8px}.row{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.small{font-size:11px;color:var(--muted)}.app{min-height:100vh}.sidebar{position:fixed;left:0;top:0;bottom:0;width:270px;background:#091625;border-right:1px solid var(--line);overflow:auto;z-index:20}.side-head{padding:18px;border-bottom:1px solid var(--line);font-weight:800}.nav{padding:10px}.nav-title{font-size:10px;color:#61758d;text-transform:uppercase;margin:14px 9px 5px;font-weight:700}.nav button{width:100%;text-align:left;background:none;color:var(--muted);border:0;padding:10px;border-radius:8px}.nav button:hover,.nav button.active{background:#10243a;color:var(--p2)}.nav i{width:22px}.main{margin-left:270px;min-height:100vh}.top{height:62px;position:sticky;top:0;z-index:15;background:rgba(9,22,37,.96);border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;padding:0 20px}.content{padding:22px}.metrics{grid-template-columns:repeat(auto-fit,minmax(160px,1fr));margin-bottom:18px}.metric h3{font-size:24px;margin:5px 0}.metric p{font-size:11px;color:var(--muted);margin:0}.grid2{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}.grid3{grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}.section{display:none}.section.active{display:block}.section-head{display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:18px}.section-head h2{margin:0}.actions{display:flex;gap:7px;flex-wrap:wrap}.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:10px}.table{width:100%;border-collapse:collapse;font-size:12px}.table th,.table td{padding:10px;border-bottom:1px solid var(--line);text-align:left;white-space:nowrap}.table th{background:#101f33;color:var(--muted);font-size:10px;text-transform:uppercase}.badge{padding:4px 7px;border-radius:20px;font-size:9px;background:#18304a}.ok{background:#0b3a2c;color:#55e1ae}.warn{background:#3c2b08;color:#ffc857}.bad{background:#40151a;color:#ff7b85}.modal{position:fixed;inset:0;background:#000b;display:none;align-items:center;justify-content:center;z-index:100;padding:15px}.modal.show{display:flex}.modal-card{width:min(720px,100%);max-height:92vh;overflow:auto;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:20px}.modal-head{display:flex;justify-content:space-between;align-items:center}.close{background:none;border:0;color:var(--muted);font-size:20px}.toast{position:fixed;right:18px;bottom:18px;z-index:200;background:#10243a;border:1px solid var(--line);padding:12px 15px;border-radius:9px;display:none}.toast.show{display:block}.super{min-height:100vh}.super-top{padding:16px 22px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between}.super-body{padding:22px;max-width:1400px;margin:auto}.chip{font-size:10px;color:var(--muted)}@media(max-width:850px){.sidebar{transform:translateX(-100%)}.sidebar.open{transform:translateX(0)}.main{margin-left:0}.row{grid-template-columns:1fr}.top{padding:0 12px}.content{padding:14px}}
</style>
</head>
<body>
<div id="landing" class="landing">
  <section class="hero"><div class="logo"><i class="fa-solid fa-people-group"></i></div><div class="brand">CSCMS Pro</div><div class="tag">Vikoba • Microfinance • Savings • Shares • Loans • Governance</div><div class="hero-actions"><button class="btn primary" onclick="openAuth('member')"><i class="fa-solid fa-right-to-bracket"></i> Ingia Kikundi</button><button class="btn outline" onclick="openAuth('chair')"><i class="fa-solid fa-user-tie"></i> Sajili Kikundi</button><button class="btn mutedbtn" onclick="openSuper()"><i class="fa-solid fa-shield-halved"></i> Super Admin</button></div></section>
  <div class="container"><div class="section-head"><h2>Matangazo ya Mfumo</h2><span class="small">Yanaonekana kwa wageni na watumiaji wote</span></div><div id="publicAds" class="public-grid"></div></div>
</div>

<div id="auth" class="auth hidden"><div class="auth-card"><div class="section-head"><div><h2 id="authTitle">Ingia Kikundi</h2><div class="small">Taarifa za kifedha zinaonyeshwa ndani ya kikundi husika pekee.</div></div><button class="close" onclick="backLanding()">×</button></div><div id="authMsg" class="small"></div>
<div class="tabs"><button id="memberTab" class="tab active" onclick="authMode('member')">Mwanachama</button><button id="chairTab" class="tab" onclick="authMode('chair')">Chairperson</button></div>
<form id="memberLogin"><div class="field"><label>Group Username</label><input id="loginGroupUsername" required placeholder="mfano: kikundichaamani"></div><div class="field"><label>Namba ya Simu</label><input id="loginPhone" required placeholder="07XXXXXXXX"></div><div id="recaptcha-container"></div><button class="btn primary" style="width:100%" type="submit">Tuma OTP / Ingia</button></form>
<form id="chairLogin" class="hidden"><div class="field"><label>Email ya Chairperson</label><input id="chairEmail" type="email" required></div><div class="field"><label>Password</label><input id="chairPassword" type="password" required></div><button class="btn primary" style="width:100%">Ingia</button></form>
<hr style="border-color:var(--line);margin:22px 0"><form id="chairRegister" class="hidden"><h3>Sajili Kikundi Kipya</h3><div class="row"><div class="field"><label>Jina la Kikundi</label><input id="regGroupName"></div><div class="field"><label>Group Username</label><input id="regGroupUsername"></div></div><div class="row"><div class="field"><label>Jina la Chairperson</label><input id="regChairName"></div><div class="field"><label>Simu</label><input id="regChairPhone"></div></div><div class="field"><label>Email</label><input id="regChairEmail" type="email"></div><div class="field"><label>Password</label><input id="regChairPassword" type="password" minlength="8"></div><button class="btn outline" type="submit">Sajili Kikundi</button></form>
</div></div>

<div id="super" class="super hidden"><div class="super-top"><div><b>CSCMS SUPER ADMIN</b><div class="small">Global system administration</div></div><button class="btn outline" onclick="superLogout()">Logout</button></div><div class="super-body"><div class="metrics" id="superMetrics"></div><div class="grid grid2"><div class="card"><div class="section-head"><h3>Vikundi Vilivyojiunga</h3><button class="btn primary" onclick="openModal('globalAdModal')">+ Global Ad</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Kikundi</th><th>Username</th><th>Wanachama</th><th>Status</th><th>Created</th></tr></thead><tbody id="superGroups"></tbody></table></div></div><div class="card"><div class="section-head"><h3>Matangazo ya Mfumo</h3></div><div id="superAds"></div></div></div></div></div>

<div id="app" class="app hidden"><aside id="sidebar" class="sidebar"><div class="side-head"><i class="fa-solid fa-people-group"></i> <span id="sideGroup">CSCMS</span><div class="small" id="sideRole"></div></div><nav class="nav" id="nav"></nav></aside><main class="main"><header class="top"><div><button class="btn mutedbtn" onclick="toggleSidebar()">☰</button> <b id="pageTitle">Dashibodi</b></div><div><span class="small" id="topUser"></span> <button class="btn outline" onclick="logout()">Toka</button></div></header><div class="content">
<section id="dashboard" class="section active"><div class="section-head"><div><h2>Dashibodi ya Kikundi</h2><div class="small" id="dashboardScope"></div></div><div class="actions"><button class="btn info" onclick="exportCurrentReport()">PDF/Print</button></div></div><div class="metrics" id="metrics"></div><div class="grid grid2"><div class="card"><h3>Muhtasari wa Fedha</h3><div id="financialSummary"></div></div><div class="card"><h3>Matangazo & Taarifa</h3><div id="dashboardAds"></div></div></div></section>
<section id="members" class="section"><div class="section-head"><div><h2>Wanachama</h2><div class="small">Wanachama wa kikundi hiki tu</div></div><div class="actions"><button class="btn primary chair-only" onclick="openModal('memberModal')">+ Ongeza Mwanachama</button><button class="btn outline" onclick="loadMembers()">Refresh</button></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Jina</th><th>Simu</th><th>Hisa</th><th>Akiba</th><th>Mkopo</th><th>Status</th><th>Actions</th></tr></thead><tbody id="membersBody"></tbody></table></div></section>
<section id="group" class="section"><div class="section-head"><div><h2>Kikundi</h2><div class="small">Taarifa za msingi, sera na mipangilio</div></div></div><div class="card"><form id="groupForm"><div class="row"><div class="field"><label>Jina</label><input id="gName"></div><div class="field"><label>Registration Number</label><input id="gReg"></div></div><div class="row"><div class="field"><label>Bei ya Hisa</label><input id="gSharePrice" type="number" min="0"></div><div class="field"><label>Maximum Shares per Member</label><input id="gMaxShares" type="number" min="0"></div></div><div class="row"><div class="field"><label>Meeting Day</label><input id="gMeetingDay"></div><div class="field"><label>Loan Interest %</label><input id="gInterest" type="number" step="0.01"></div></div><button class="btn primary chair-only">Hifadhi</button></form></div></section>
<section id="announcements" class="section"><div class="section-head"><div><h2>Matangazo ya Kikundi</h2><div class="small">Yanaonekana kwa wanachama wa kikundi hiki tu; hayaendi public landing.</div></div><button class="btn primary chair-only" onclick="openModal('groupAdModal')">+ Tangazo</button></div><div id="groupAds" class="public-grid"></div></section>
<section id="meetings" class="section"><div class="section-head"><div><h2>Vikao & Dakika</h2><div class="small">Taarifa wazi kwa kila mwanachama wa kikundi</div></div><button class="btn primary chair-only" onclick="openModal('meetingModal')">+ Kikao</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Tarehe</th><th>Mada</th><th>Maamuzi/Dakika</th><th>Action</th></tr></thead><tbody id="meetingsBody"></tbody></table></div></section>
<section id="savings" class="section"><div class="section-head"><div><h2>Akiba</h2><div class="small">Deposits, withdrawals, balances</div></div><div class="actions"><button class="btn primary chair-only" onclick="openModal('transactionModal');setTx('DEPOSIT')">+ Weka Akiba</button><button class="btn warning chair-only" onclick="openModal('transactionModal');setTx('WITHDRAWAL')">- Toa Akiba</button></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Member</th><th>Type</th><th>Amount</th><th>Reference</th></tr></thead><tbody id="savingsBody"></tbody></table></div></section>
<section id="shares" class="section"><div class="section-head"><div><h2>Hisa</h2><div class="small">Nunua, uza kwa kikundi, hamisha, dividend</div></div><div class="actions"><button class="btn primary" onclick="openModal('shareModal');setShareMode('BUY')">Nunua Hisa</button><button class="btn warning chair-only" onclick="openModal('shareModal');setShareMode('SELL')">Uza Hisa kwa Kikundi</button><button class="btn outline" onclick="openModal('shareModal');setShareMode('TRANSFER')">Hamisha Hisa</button></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Member</th><th>Action</th><th>Qty</th><th>Value</th><th>Status</th></tr></thead><tbody id="sharesBody"></tbody></table></div></section>
<section id="loans" class="section"><div class="section-head"><div><h2>Mikopo</h2><div class="small">Application, approval, disbursement, repayment, penalties, guarantors</div></div><div class="actions"><button class="btn primary" onclick="openModal('loanModal')">+ Omba Mkopo</button><button class="btn outline chair-only" onclick="openModal('loanProductModal')">Loan Products</button></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Member</th><th>Principal</th><th>Balance</th><th>Interest</th><th>Status</th><th>Action</th></tr></thead><tbody id="loansBody"></tbody></table></div></section>
<section id="repayments" class="section"><div class="section-head"><div><h2>Marejesho</h2><div class="small">Principal, interest, penalty and repayment history</div></div><button class="btn primary chair-only" onclick="openModal('repaymentModal')">+ Rekodi Marejesho</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Loan</th><th>Member</th><th>Amount</th><th>Type</th></tr></thead><tbody id="repaymentsBody"></tbody></table></div></section>
<section id="expenses" class="section"><div class="section-head"><div><h2>Mapato & Matumizi</h2><div class="small">Income, expenses and supporting references</div></div><button class="btn primary chair-only" onclick="openModal('cashModal')">+ Rekodi</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Type</th><th>Description</th><th>Amount</th></tr></thead><tbody id="cashBody"></tbody></table></div></section>
<section id="cashbook" class="section"><div class="section-head"><div><h2>Cashbook</h2><div class="small">Movement ya fedha ya kikundi</div></div></div><div id="cashbookSummary" class="metrics"></div><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Ref</th><th>Debit</th><th>Credit</th><th>Balance</th></tr></thead><tbody id="cashbookBody"></tbody></table></div></section>
<section id="ledger" class="section"><div class="section-head"><div><h2>General Ledger</h2><div class="small">Double-entry journal ya kikundi</div></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Description</th><th>Debit</th><th>Credit</th><th>Amount</th></tr></thead><tbody id="ledgerBody"></tbody></table></div></section>
<section id="welfare" class="section"><div class="section-head"><div><h2>Ustawi / Welfare Fund</h2><div class="small">Michango, misaada na matumizi ya ustawi</div></div><button class="btn primary chair-only" onclick="openModal('welfareModal')">+ Rekodi</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Member</th><th>Type</th><th>Amount</th><th>Description</th></tr></thead><tbody id="welfareBody"></tbody></table></div></section>
<section id="guarantors" class="section"><div class="section-head"><div><h2>Wadhamini</h2><div class="small">Guarantor commitments per loan</div></div><button class="btn primary chair-only" onclick="openModal('guarantorModal')">+ Mdhamini</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Loan</th><th>Guarantor</th><th>Amount</th><th>Status</th></tr></thead><tbody id="guarantorsBody"></tbody></table></div></section>
<section id="dividends" class="section"><div class="section-head"><div><h2>Dividends / Mgawanyo wa Faida</h2><div class="small">Distribution records based on approved policy</div></div><button class="btn primary chair-only" onclick="openModal('dividendModal')">+ Dividend</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Member</th><th>Shares</th><th>Rate</th><th>Amount</th></tr></thead><tbody id="dividendsBody"></tbody></table></div></section>
<section id="reports" class="section"><div class="section-head"><div><h2>Ripoti</h2><div class="small">Mchanganuo wa kikundi hiki tu</div></div></div><div class="grid grid3"><div class="card"><h3>Portfolio</h3><div id="reportPortfolio"></div></div><div class="card"><h3>Loan Aging / PAR</h3><div id="reportPAR"></div></div><div class="card"><h3>Member Balances</h3><div id="reportMembers"></div></div></div></section>
<section id="audit" class="section"><div class="section-head"><div><h2>Audit Trail</h2><div class="small">Mabadiliko muhimu ya mfumo</div></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>User</th><th>Action</th><th>Entity</th><th>Reference</th></tr></thead><tbody id="auditBody"></tbody></table></div></section>
<section id="profile" class="section"><div class="section-head"><h2>Profaili</h2></div><div class="card" id="profileBox"></div></section>
</div></main></div>

<!-- MODALS -->
<div id="memberModal" class="modal"><div class="modal-card"><div class="modal-head"><h3>Ongeza Mwanachama</h3><button class="close" onclick="closeModal('memberModal')">×</button></div><form id="memberForm"><div class="row"><div class="field"><label>Jina</label><input id="mName" required></div><div class="field"><label>Simu</label><input id="mPhone" required></div></div><div class="row"><div class="field"><label>Member No</label><input id="mNo"></div><div class="field"><label>Initial Shares</label><input id="mShares" type="number" min="0" value="0"></div></div><div class="field"><label>Initial Savings</label><input id="mSavings" type="number" min="0" value="0"></div><button class="btn primary">Hifadhi Mwanachama</button></form></div></div>
<div id="groupAdModal" class="modal"><div class="modal-card"><div class="modal-head"><h3>Tangazo la Kikundi</h3><button class="close" onclick="closeModal('groupAdModal')">×</button></div><form id="groupAdForm"><div class="field"><label>Aina</label><select id="adType"><option value="ANNOUNCEMENT">Taarifa/Announcement</option><option value="PRODUCT">Bidhaa ya Mwanachama</option></select></div><div class="field"><label>Kichwa</label><input id="adTitle" required></div><div class="field"><label>Maelezo</label><textarea id="adDesc" rows="4" required></textarea></div><div class="row"><div class="field"><label>Bei (optional)</label><input id="adPrice" type="number"></div><div class="field"><label>Simu ya Mawasiliano</label><input id="adPhone"></div></div><div class="field"><label>Image URL (optional)</label><input id="adImage"></div><button class="btn primary">Chapisha ndani ya Kikundi</button></form></div></div>
<div id="globalAdModal" class="modal"><div class="modal-card"><div class="modal-head"><h3>Global System Advertisement</h3><button class="close" onclick="closeModal('globalAdModal')">×</button></div><form id="globalAdForm"><div class="field"><label>Title</label><input id="gaTitle" required></div><div class="field"><label>Description</label><textarea id="gaDesc" rows="4" required></textarea></div><div class="row"><div class="field"><label>Scope</label><select id="gaScope"><option value="GLOBAL">Mfumo Wote</option><option value="GROUP">Kikundi Maalum</option></select></div><div class="field"><label>Group ID (ikiwa GROUP)</label><input id="gaGroupId"></div></div><div class="field"><label>Image URL</label><input id="gaImage"></div><button class="btn primary">Chapisha</button></form></div></div>
<div id="meetingModal" class="modal"><div class="modal-card"><div class="modal-head"><h3>Kikao / Minutes</h3><button class="close" onclick="closeModal('meetingModal')">×</button></div><form id="meetingForm"><div class="row"><div class="field"><label>Tarehe</label><input id="meetDate" type="date" required></div><div class="field"><label>Mada</label><input id="meetTopic" required></div></div><div class="field"><label>Mahudhurio</label><input id="meetAttendance"></div><div class="field"><label>Dakika / Maamuzi</label><textarea id="meetMinutes" rows="6" required></textarea></div><button class="btn primary">Hifadhi Kikao</button></form></div></div>
<div id="transactionModal" class="modal"><div class="modal-card"><div class="modal-head"><h3 id="txTitle">Transaction</h3><button class="close" onclick="closeModal('transactionModal')">×</button></div><form id="txForm"><input type="hidden" id="txType"><div class="field"><label>Mwanachama</label><select id="txMember" required></select></div><div class="field"><label>Kiasi</label><input id="txAmount" type="number" min="1" required></div><div class="field"><label>Reference / Maelezo</label><input id="txRef"></div><button class="btn primary">Hifadhi</button></form></div></div>
<div id="shareModal" class="modal"><div class="modal-card"><div class="modal-head"><h3 id="shareTitle">Hisa</h3><button class="close" onclick="closeModal('shareModal')">×</button></div><form id="shareForm"><input type="hidden" id="shareMode"><div class="field"><label>Mwanachama</label><select id="shareMember" required></select></div><div class="field"><label>Idadi ya Hisa</label><input id="shareQty" type="number" min="1" required></div><div id="transferToWrap" class="field hidden"><label>Hamishia kwa</label><select id="shareTo"></select></div><button class="btn primary">Tekeleza</button></form></div></div>
<div id="loanModal" class="modal"><div class="modal-card"><div class="modal-head"><h3>Omba Mkopo</h3><button class="close" onclick="closeModal('loanModal')">×</button></div><form id="loanForm"><div class="field"><label>Mwanachama</label><select id="loanMember" required></select></div><div class="row"><div class="field"><label>Principal</label><input id="loanPrincipal" type="number" min="1" required></div><div class="field"><label>Interest %</label><input id="loanInterest" type="number" step="0.01" required></div></div><div class="row"><div class="field"><label>Term (months)</label><input id="loanTerm" type="number" min="1" required></div><div class="field"><label>Purpose</label><input id="loanPurpose"></div></div><button class="btn primary">Wasilisha Ombi</button></form></div></div>
<div id="repaymentModal" class="modal"><div class="modal-card"><div class="modal-head"><h3>Rekodi Marejesho</h3><button class="close" onclick="closeModal('repaymentModal')">×</button></div><form id="repayForm"><div class="field"><label>Loan</label><select id="repayLoan"></select></div><div class="field"><label>Amount</label><input id="repayAmount" type="number" min="1" required></div><div class="field"><label>Type</label><select id="repayType"><option>REGULAR</option><option>PENALTY</option><option>EARLY_SETTLEMENT</option></select></div><button class="btn primary">Hifadhi Marejesho</button></form></div></div>
