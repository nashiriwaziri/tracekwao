function toggleSuspendGroup(id){const g=DB.groups.find(x=>x.id===id);if(!g)return;g.status=g.status==='SUSPENDED'?'ACTIVE':'SUSPENDED';save();renderSuperAdmin();toast(`Group ${g.status}`);}
function deleteGroup(id){if(!confirm('Delete this group permanently?'))return;DB.groups=DB.groups.filter(g=>g.id!==id);save();renderSuperAdmin();toast('Group deleted');}

function viewGroupPanel(id){
  const g=DB.groups.find(x=>x.id===id);if(!g)return;
  $('sgTitle').textContent=`Manage: ${g.name} (${g.package})`;
  const totalSav=g.members.reduce((a,m)=>a+m.savings,0);const totalLoan=g.loans.filter(l=>l.status==='ACTIVE').reduce((a,l)=>a+l.balance,0);
  $('sgContent').innerHTML=`
    <div class="cards" style="margin-bottom:15px">
       <div class="stat"><strong>${g.members.length}</strong><div class="muted">Members</div></div>
       <div class="stat"><strong>${fmt(totalSav, g.currency)}</strong><div class="muted">Savings</div></div>
       <div class="stat"><strong>${fmt(totalLoan, g.currency)}</strong><div class="muted">Loans</div></div>
    </div>
    <div class="panel"><h3>Members</h3><div class="table-wrap"><table><thead><tr><th>Name</th><th>NIDA</th><th>Savings</th><th>Role</th></tr></thead><tbody>${g.members.map(m=>`<tr><td>${m.name}</td><td>${m.nida}</td><td>${fmt(m.savings, g.currency)}</td><td>${m.role}</td></tr>`).join('')}</tbody></table></div></div>
    <div class="panel"><h3>Recent Loans</h3><div class="table-wrap"><table><thead><tr><th>Member</th><th>Amount</th><th>Balance</th><th>Status</th></tr></thead><tbody>${g.loans.slice(-5).map(l=>`<tr><td>${g.members.find(m=>m.id===l.memberId)?.name||'N/A'}</td><td>${fmt(l.principal, g.currency)}</td><td>${fmt(l.balance, g.currency)}</td><td>${l.status}</td></tr>`).join('')}</tbody></table></div></div>
  `;
  openModal('superGroupDetailModal');
}

function openSuperAdModal(editId=''){$('saEditId').value=editId;if(editId){const a=DB.superAds.find(x=>x.id===editId);$('saTitle').value=a.title;$('saDesc').value=a.desc;}else{$('superAdForm').reset();}openModal('superAdModal');}
 $('superAdForm').onsubmit=e=>{e.preventDefault();const id=$('saEditId').value||uid();const data={id,title:$('saTitle').value,desc:$('saDesc').value};if($('saEditId').value){const idx=DB.superAds.findIndex(x=>x.id===id);DB.superAds[idx]=data;}else DB.superAds.push(data);save();renderSuperAds();closeModal('superAdModal');toast('Ad saved');};
function renderSuperAds(){$('superAdsList').innerHTML=DB.superAds.map(a=>`<div class="announce-card" style="background:white;border:1px solid var(--border)"><h4>${a.title}</h4><p>${a.desc}</p><div style="margin-top:8px"><button class="btn btn-light" onclick="openSuperAdModal('${a.id}')"><i class="fa-solid fa-pen"></i></button> <button class="btn btn-danger" onclick="deleteSuperAd('${a.id}')"><i class="fa-solid fa-trash"></i></button></div></div>`).join('');}
function deleteSuperAd(id){DB.superAds=DB.superAds.filter(a=>a.id!==id);save();renderSuperAds();}

/* ======== APP INIT ======== */
function initApp(){$('sideGroup').textContent=G.name;$('topUser').textContent=U.name;switchRole(role);renderNav();navigate('sec-dashboard');if(navigator.onLine) pullFromFirebase();}

function renderSection(id){ if(id==='sec-dashboard')renderDashboard();else if(id==='sec-members')renderMembers();else if(id==='sec-savings')renderSavings();else if(id==='sec-loans')renderLoans();else if(id==='sec-cashbook')renderCashbook();else if(id==='sec-audit')renderAudit();else if(id==='sec-group')renderSettings(); }

/* Dashboard */
let chartP, chartT;
function renderDashboard(){ const totalSav=G.members.reduce((a,m)=>a+m.savings,0);const totalLoan=G.loans.filter(l=>l.status==='ACTIVE').reduce((a,l)=>a+l.balance,0);const totalShares=G.members.reduce((a,m)=>a+m.shares,0); $('metrics').innerHTML=`<div class="stat"><strong>${G.members.length}</strong><div class="muted">Members</div></div><div class="stat"><strong>${fmt(totalSav)}</strong><div class="muted">Total Savings</div></div><div class="stat"><strong>${fmt(totalLoan)}</strong><div class="muted">Active Loans</div></div><div class="stat"><strong>${fmt(totalShares*G.sharePrice)}</strong><div class="muted">Shares Value</div></div>`; if(chartP)chartP.destroy();if(chartT)chartT.destroy(); chartP=new Chart($('dashChartPortfolio'),{type:'doughnut',data:{labels:['Savings','Loans','Shares'],datasets:[{data:[totalSav,totalLoan,totalShares*G.sharePrice],backgroundColor:['#1769aa','#d6a642','#16845b']}]},options:{responsive:true,maintainAspectRatio:false}}); chartT=new Chart($('dashChartTrend'),{type:'line',data:{labels:G.savings.slice(-10).map(s=>s.date),datasets:[{label:'Savings',data:G.savings.slice(-10).map(s=>s.amount),borderColor:'#1769aa',fill:true,backgroundColor:'#1769aa22'}]},options:{responsive:true,maintainAspectRatio:false}}); }

/* Members */
function renderMembers(){$('membersBody').innerHTML=G.members.map(m=>`<tr><td>${m.name}</td><td>${m.nida}</td><td>${m.phone}</td><td>${m.shares}</td><td>${fmt(m.savings)}</td><td><span class="badge ${m.status==='ACTIVE'?'':'inactive'}">${m.status}</span></td><td>${actBtns(m.id,'deleteMember')}</td></tr>`).join('');}
function openMemberModal(id=''){$('mEditId').value=id;if(id){const m=G.members.find(x=>x.id===id);$('mName').value=m.name;$('mNida').value=m.nida;$('mPhone').value=m.phone;$('mShares').value=m.shares;$('mSavings').value=m.savings;$('mPassword').value=m.password;}else{$('memberForm').reset();}openModal('memberModal');}
 $('memberForm').onsubmit=e=>{e.preventDefault();const id=$('mEditId').value||uid();const data={id,name:$('mName').value,nida:$('mNida').value,phone:$('mPhone').value,shares:Number($('mShares').value),savings:Number($('mSavings').value),status:'ACTIVE',password:$('mPassword').value,role:'member',joinDate:today()};if($('mEditId').value){const idx=G.members.findIndex(x=>x.id===id);G.members[idx]={...G.members[idx],...data};}else G.members.push(data);audit('SAVE','Member');save();renderMembers();closeModal('memberModal');toast('Member saved');};
function deleteMember(id){G.members=G.members.filter(m=>m.id!==id);audit('DELETE','Member');save();renderMembers();}
function editItem(id){const sec=document.querySelector('.section.active')?.id;if(sec==='sec-members')openMemberModal(id);}

/* Savings */
function renderSavings(){$('savingsBody').innerHTML=G.savings.map(t=>`<tr><td>${t.date}</td><td>${getMemberName(t.memberId)}</td><td><span class="badge ${t.type==='DEPOSIT'?'':'pending'}">${t.type}</span></td><td>${fmt(t.amount)}</td></tr>`).join('');}
function openTxModal(type){$('txType').value=type;$('txTitle').textContent=type;$('txMember').innerHTML=memberOpts();$('txAmount').value='';openModal('transactionModal');}
 $('txForm').onsubmit=e=>{e.preventDefault();const type=$('txType').value;const mid=$('txMember').value;const amt=Number($('txAmount').value);const m=G.members.find(x=>x.id===mid);if(type==='WITHDRAWAL'&&m.savings<amt)return toast('Insufficient savings','error');m.savings+=type==='DEPOSIT'?amt:-amt;G.savings.push({id:uid(),date:today(),memberId:mid,type,amount:amt});audit('CREATE',type);save();renderSavings();closeModal('transactionModal');toast(type+' successful');};

/* Loans */
function renderLoans(){$('loansBody').innerHTML=G.loans.map(l=>`<tr><td>${getMemberName(l.memberId)}</td><td>${fmt(l.principal)}</td><td>${fmt(l.balance)}</td><td>${l.interest}%</td><td><span class="badge ${l.status==='ACTIVE'?'':l.status==='PENDING'?'pending':'inactive'}">${l.status}</span></td><td><div class="actions">${l.status==='PENDING'?`<button class="btn btn-success" onclick="approveLoan('${l.id}')"><i class="fa-solid fa-check"></i></button>`:''} <button class="btn btn-danger" onclick="deleteLoan('${l.id}')"><i class="fa-solid fa-trash"></i></button></div></td></tr>`).join('');}
function openLoanModal(){$('lMember').innerHTML=memberOpts();$('lInterest').value=G.interest;$('loanForm').reset();$('lInterest').value=G.interest;openModal('loanModal');}
 $('loanForm').onsubmit=e=>{e.preventDefault();const p=Number($('lPrincipal').value);const i=Number($('lInterest').value);G.loans.push({id:uid(),date:today(),memberId:$('lMember').value,principal:p,balance:p+(p*i/100),interest:i,term:Number($('lTerm').value),status:'PENDING'});audit('CREATE','Loan');save();renderLoans();closeModal('loanModal');toast('Loan applied');};
function approveLoan(id){const l=G.loans.find(x=>x.id===id);l.status='ACTIVE';audit('UPDATE','Loan Approved');save();renderLoans();toast('Loan approved');}
function deleteLoan(id){G.loans=G.loans.filter(l=>l.id!==id);audit('DELETE','Loan');save();renderLoans();}

/* Cashbook */
function getCashbookEntries(){ let entries=[];G.savings.forEach(t=>entries.push({date:t.date,ref:`SAV-${t.id.substr(-4)}`,desc:`${t.type} - ${getMemberName(t.memberId)}`,debit:t.type==='WITHDRAWAL'?t.amount:0,credit:t.type==='DEPOSIT'?t.amount:0}));G.loans.filter(l=>l.status==='ACTIVE').forEach(l=>entries.push({date:l.date,ref:`LOAN-${l.id.substr(-4)}`,desc:`Disbursement - ${getMemberName(l.memberId)}`,debit:l.principal,credit:0}));G.repayments.forEach(r=>entries.push({date:r.date,ref:`REPAY-${r.id.substr(-4)}`,desc:`Repayment - ${getMemberName(r.memberId)}`,debit:0,credit:r.amount}));G.expenses.forEach(e=>entries.push({date:e.date,ref:`EXP-${e.id.substr(-4)}`,desc:e.desc,debit:e.type==='EXPENSE'?e.amount:0,credit:e.type==='INCOME'?e.amount:0}));entries.sort((a,b)=>new Date(a.date)-new Date(b.date));let bal=0;return entries.map(e=>{bal+=e.credit-e.debit;return{...e,balance:bal};}); }
function renderCashbook(){const data=getCashbookEntries();const totalD=data.reduce((a,e)=>a+e.debit,0);const totalC=data.reduce((a,e)=>a+e.credit,0);$('cashbookMetrics').innerHTML=`<div class="stat"><strong>${fmt(totalC)}</strong><div class="muted">Total In</div></div><div class="stat"><strong>${fmt(totalD)}</strong><div class="muted">Total Out</div></div><div class="stat"><strong>${fmt(totalC-totalD)}</strong><div class="muted">Balance</div></div>`;$('cashbookBody').innerHTML=data.map(e=>`<tr><td>${e.date}</td><td>${e.ref}</td><td>${e.debit?fmt(e.debit):'-'}</td><td>${e.credit?fmt(e.credit):'-'}</td><td>${fmt(e.balance)}</td></tr>`).join('');}

/* Audit */
function renderAudit(){$('auditBody').innerHTML=G.audit.slice().reverse().map(a=>`<tr><td>${a.date}</td><td>${a.user}</td><td>${a.action}</td><td>${a.entity}</td></tr>`).join('');}

/* Settings */
function renderSettings(){$('gName').value=G.name;$('gCurrency').value=G.currency;$('gInterest').value=G.interest;$('gSharePrice').value=G.sharePrice;}
 $('groupForm').onsubmit=e=>{e.preventDefault();G.name=$('gName').value;G.currency=$('gCurrency').value;G.interest=Number($('gInterest').value);G.sharePrice=Number($('gSharePrice').value);audit('UPDATE','Settings');save();toast('Settings saved');$('sideGroup').textContent=G.name;};

window.onload=()=>{initSetup();renderLanding();};
</script>
</body>
