<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>CSCMS Pro V4 — International Community Savings & Microfinance</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore-compat.js"></script>
<style>
:root{--primary:#123b70;--secondary:#1769aa;--gold:#d6a642;--bg:#f3f6fb;--white:#fff;--text:#1c2b40;--muted:#718096;--border:#e3e9f1;--danger:#dc3545;--success:#16845b}
*{box-sizing:border-box}body{margin:0;font-family:Inter,Arial,sans-serif;background:var(--bg);color:var(--text)}button,input,select,textarea{font:inherit}button{cursor:pointer}.hidden{display:none!important}.app{display:flex;min-height:100vh}
.sidebar{width:260px;background:var(--primary);color:white;padding:22px 14px;flex-shrink:0;overflow-y:auto;transition:width .3s}
.brand{padding:10px 12px 25px;border-bottom:1px solid #ffffff25}.brand h2{margin:0;font-size:21px}.brand small{color:#c7d9f0}
.nav-title{font-size:10px;color:#9fb8d6;margin:25px 12px 10px;text-transform:uppercase;letter-spacing:1.4px}
.nav button{display:flex;align-items:center;gap:13px;width:100%;border:0;background:transparent;color:#d8e5f5;text-align:left;padding:12px;border-radius:8px;margin:3px 0;font-size:13px;transition:all .15s}
.nav button:hover,.nav button.active{background:#ffffff20;color:white}.nav i{width:19px}
.main{flex:1;min-width:0}.topbar{background:white;padding:17px 25px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border);gap:12px;position:sticky;top:0;z-index:15}.topbar h3{margin:0;font-size:17px}
.user-info{font-size:12px;color:var(--muted);text-align:right}.content{padding:25px;max-width:1600px;margin:auto}
.page-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:20px;flex-wrap:wrap}.page-head h1{font-size:23px;margin:0 0 7px}.muted{color:var(--muted);font-size:12px}
.btn{border:0;padding:10px 15px;border-radius:7px;font-weight:600;font-size:12px;display:inline-flex;align-items:center;gap:8px;transition:all .2s;white-space:nowrap}.btn:hover{filter:brightness(1.08);transform:translateY(-1px)}.btn:active{transform:translateY(0)}
.btn-primary{background:var(--secondary);color:white}.btn-gold{background:var(--gold);color:#17263b}.btn-danger{background:#fff0f0;color:var(--danger)}.btn-light{background:#edf2f8;color:var(--text)}.btn-success{background:#e5f7ed;color:var(--success)}.btn-outline{background:transparent;color:var(--secondary);border:1px solid var(--secondary)}.btn-white{background:white;color:var(--primary)}
.cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:22px}.stat{background:white;border:1px solid var(--border);border-radius:12px;padding:19px}.stat-top{display:flex;justify-content:space-between;align-items:center}.stat-icon{width:40px;height:40px;display:grid;place-items:center;border-radius:10px}.stat strong{font-size:25px;display:block;margin:15px 0 5px;overflow-wrap:anywhere}
.panel{background:white;border:1px solid var(--border);border-radius:12px;padding:20px;margin-bottom:20px;min-width:0}.panel h3{font-size:15px;margin:0 0 17px}
.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:15px}.toolbar input{flex:1;min-width:180px}
input,select,textarea{width:100%;border:1px solid #dce3ed;border-radius:7px;padding:11px;background:white;color:var(--text);font-size:13px;outline:none}input:focus,select:focus,textarea:focus{border-color:var(--secondary)}
label{font-size:12px;font-weight:600;display:block;margin-bottom:7px}.field{margin-bottom:15px}
.table-wrap{overflow:auto;border:1px solid var(--border);border-radius:10px}table{width:100%;border-collapse:collapse;white-space:nowrap;font-size:12px}th,td{padding:13px 12px;text-align:left;border-bottom:1px solid var(--border)}th{background:#f8fafc;color:#627187;font-weight:700;font-size:11px;text-transform:uppercase;letter-spacing:.5px}tr:hover td{background:#f8fafc}
.actions{display:flex;gap:6px}.actions button{border:0;padding:7px 9px;border-radius:5px;cursor:pointer;font-size:11px}
.badge{padding:5px 8px;border-radius:20px;background:#e9f7ef;color:#16845b;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px}.badge.pending{background:#fff4d9;color:#936500}.badge.inactive{background:#ffeded;color:#c33737}.badge.info{background:#edf5ff;color:#244c7c}
.notice{padding:12px 14px;border-radius:8px;background:#edf5ff;color:#244c7c;font-size:12px;margin-bottom:15px}.empty{text-align:center;padding:30px;color:var(--muted)}
.section{display:none}.section.active{display:block}.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}.row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 14px}.span-2{grid-column:span 2}.divider{border:0;border-top:1px solid var(--border);margin:16px 0}
.chart-box{height:220px;position:relative}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px}.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px}
.lc-row{display:flex;justify-content:space-between;padding:8px 0;font-size:13px;border-bottom:1px solid var(--border)}.lc-row:last-child{border-bottom:none}.lc-row .lc-l{color:var(--muted)}.lc-row .lc-v{font-weight:700}
.chair-only{display:none}
.sync-indicator{display:inline-flex;align-items:center;gap:5px;font-size:10px;padding:4px 10px;border-radius:12px;font-weight:600;transition: all 0.3s;}
.sync-indicator.online{background:#e5f7ed;color:var(--success)}.sync-indicator.offline{background:#fff0f0;color:var(--danger)}.sync-indicator.syncing{background:#fff4d9;color:#936500}
.landing{min-height:100vh;background:linear-gradient(135deg,#0c2850,#1769aa);color:white;text-align:center;padding:60px 20px}.landing .logo-box{width:72px;height:72px;background:var(--gold);color:var(--primary);display:grid;place-items:center;border-radius:18px;font-size:30px;margin:0 auto 18px}.landing h1{font-size:42px;font-weight:800;margin:0 0 8px}.landing .tag{color:#c7d9f0;font-size:15px;margin-bottom:30px}.landing .hero-btns{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-bottom:50px}
.locale-bar{display:flex;justify-content:center;gap:8px;margin-bottom:30px;flex-wrap:wrap}.locale-btn{padding:6px 14px;border-radius:20px;font-size:11px;font-weight:600;border:1px solid #ffffff40;background:transparent;color:#c7d9f0;transition:all .2s}.locale-btn.active{background:var(--gold);color:var(--primary);border-color:var(--gold)}.locale-btn:hover:not(.active){border-color:white;color:white}
.pricing{padding:40px 20px 60px;max-width:1100px;margin:0 auto}.pricing h2{font-size:32px;margin-bottom:10px}.pricing .sub{color:#c7d9f0;margin-bottom:40px;font-size:15px}.pricing-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px}.price-card{background:#ffffff10;border:1px solid #ffffff20;border-radius:12px;padding:28px;text-align:left;backdrop-filter:blur(10px);transition:all .3s}.price-card:hover{transform:translateY(-5px);border-color:var(--gold)}.price-card.featured{border-color:var(--gold);box-shadow:0 10px 30px #d6a64233}.price-card h3{font-size:20px;margin:0 0 10px}.price-amount{font-size:36px;font-weight:800;margin-bottom:20px}.price-amount span{font-size:14px;color:#c7d9f0;font-weight:400}.price-features{list-style:none;padding:0;margin:0 0 25px}.price-features li{font-size:13px;padding:9px 0;border-bottom:1px solid #ffffff15;display:flex;justify-content:space-between;color:#c7d9f0}.price-features li strong{color:white;font-weight:600}
.announce-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px;max-width:1100px;margin:0 auto;padding:0 20px 40px}.announce-card{background:#ffffff10;border:1px solid #ffffff20;border-radius:10px;padding:16px;text-align:left;backdrop-filter:blur(10px)}.announce-card img{max-height:150px;border-radius:8px;object-fit:cover;margin-bottom:10px;width:100%}.announce-card h4{margin:0 0 6px;font-size:14px}.announce-card p{font-size:12px;color:#c7d9f0;margin:0}
.login-screen{min-height:100vh;display:grid;place-items:center;padding:20px;background:linear-gradient(135deg,#0c2850,#1769aa)}.login-card{width:100%;max-width:520px;background:white;padding:32px;border-radius:16px;box-shadow:0 20px 60px #001b4533}.login-card h1{font-size:24px;margin:0 0 8px;color:var(--primary)}.login-card p{font-size:13px;color:var(--muted);line-height:1.7}.login-card .btn{width:100%;justify-content:center;padding:13px}.login-logo{width:55px;height:55px;background:var(--primary);color:var(--gold);display:grid;place-items:center;border-radius:14px;font-size:25px;margin-bottom:20px}
.reg-card{width:100%;max-width:640px;background:white;padding:32px;border-radius:16px;box-shadow:0 20px 60px #001b4533;position:relative}.reg-back{position:absolute;top:15px;left:15px;color:var(--muted);font-size:14px;display:flex;align-items:center;gap:5px;cursor:pointer}.reg-back:hover{color:var(--secondary)}.reg-card h2{text-align:center;color:var(--primary);margin:0 0 5px}.reg-card h3{font-size:14px;color:var(--secondary);margin:12px 0}
.super{min-height:100vh;background:var(--bg)}.super-top{padding:16px 22px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;background:white}.super-body{padding:22px;max-width:1400px;margin:0 auto}
.modal{position:fixed;inset:0;background:#06172c99;z-index:100;display:none;align-items:center;justify-content:center;padding:15px}.modal.show{display:flex}.modal-card{width:100%;max-width:900px;max-height:92vh;overflow:auto;background:white;border-radius:13px;padding:24px;animation:modalIn .25s ease}@keyframes modalIn{from{opacity:0;transform:translateY(20px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.modal-head h3{margin:0}.close{border:0;background:#edf2f8;border-radius:50%;width:32px;height:32px;font-size:16px;cursor:pointer;color:var(--muted);display:grid;place-items:center;transition:all .15s}.close:hover{background:var(--danger);color:white}
.toast-container{position:fixed;right:18px;bottom:18px;z-index:200;display:flex;flex-direction:column;gap:8px;max-width:360px}.toast{background:#142d4d;color:white;padding:14px 20px;border-radius:8px;font-size:13px;display:flex;align-items:center;gap:10px;animation:toastIn .3s ease;box-shadow:0 8px 24px rgba(0,0,0,.2)}.toast.error{background:var(--danger)}.toast.success{background:var(--success)}@keyframes toastIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.img-drop{border:2px dashed var(--border);border-radius:10px;padding:30px 20px;text-align:center;cursor:pointer;transition:all .2s;position:relative;overflow:hidden}.img-drop:hover{border-color:var(--secondary);background:#edf5ff}.img-drop input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer}.img-drop .preview{max-width:100%;max-height:200px;border-radius:8px;object-fit:cover;margin-top:10px}.img-drop .drop-text{color:var(--muted);font-size:13px}
.success-box{text-align:center; padding: 20px; background: #e5f7ed; border: 1px solid var(--success); color: #065f46; border-radius: 12px; margin-top: 20px;}
footer{text-align:center;padding:20px;color:var(--muted);font-size:11px}
@media(max-width:1000px){.cards{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:700px){.sidebar{width:65px;padding:15px 7px}.brand{padding:10px 4px 20px;text-align:center}.brand h2{font-size:0}.brand h2:first-letter{font-size:21px}.brand small,.nav-title,.nav button span{display:none}.nav button{justify-content:center;padding:14px 5px}.nav i{width:auto}.content{padding:14px}.topbar{padding:14px}.cards{gap:10px}.stat{padding:13px}.stat strong{font-size:20px}.form-grid,.row,.row3{grid-template-columns:1fr}.span-2{grid-column:span 1}.grid2,.grid3{grid-template-columns:1fr}.landing h1{font-size:28px}}
</style>
</head>
<body>

<!-- LANDING PAGE -->
<div id="landing" class="landing">
  <div class="logo-box"><i class="fa-solid fa-people-group"></i></div>
  <h1>CSCMS Pro V4</h1>
  <div class="tag">Community Savings &bull; Microfinance &bull; Shares &bull; Loans &bull; Governance</div>
  <div class="hero-btns">
    <button class="btn btn-gold" onclick="showScreen('auth')"><i class="fa-solid fa-right-to-bracket"></i> Sign In</button>
    <button class="btn btn-white" onclick="showScreen('memberRegScreen')"><i class="fa-solid fa-user-plus"></i> Sign Up</button>
    <button class="btn btn-light" style="color:white;border:1px solid #ffffff40" onclick="openModal('superLoginModal')"><i class="fa-solid fa-shield-halved"></i> Super Admin</button>
  </div>
  <div class="pricing"><h2>Plans & Pricing</h2><div class="sub">Choose the right plan for your group</div><div class="pricing-grid" id="pricingGrid"></div></div>
</div>

<!-- SIGN UP -->
<div id="memberRegScreen" class="login-screen hidden">
  <div class="reg-card">
    <button class="reg-back" onclick="showScreen('landing')"><i class="fa-solid fa-arrow-left"></i> Back</button>
    <h2>Register Group</h2>
    <form id="signUpForm">
      <h3><i class="fa-solid fa-user-tie"></i> Chairperson Information</h3>
      <div class="row3"><div class="field"><label>First Name *</label><input id="suFname" required></div><div class="field"><label>Middle Name</label><input id="suMname"></div><div class="field"><label>Last Name *</label><input id="suLname" required></div></div>
      <div class="row"><div class="field"><label>National ID *</label><input id="suNida" required></div><div class="field"><label>Phone *</label><input id="suPhone" type="tel" required></div></div>
      <hr class="divider">
      <h3><i class="fa-solid fa-sitemap"></i> Group Information</h3>
      <div class="row"><div class="field"><label>Group Type *</label><select id="suGroupType" required><option value="">--</option><option value="rosca">ROSCA</option><option value="asca">ASCA</option><option value="vsla">VSLA</option><option value="sacco">SACCO</option><option value="welfare">Welfare</option><option value="investment">Investment</option></select></div><div class="field"><label>Group Name *</label><input id="suGroupName" required></div></div>
      <div class="row"><div class="field"><label>Country *</label><select id="suCountry" required></select></div><div class="field"><label>Currency</label><select id="suCurrency"></select></div></div>
      <div class="field"><label>Select Package *</label><select id="suPackage" required><option value="Starter">Starter (Free - Max 25 Members)</option><option value="Growth">Growth ($9.99/m - Max 100 Members)</option><option value="Enterprise">Enterprise ($29.99/m - Unlimited)</option></select></div>
      <hr class="divider">
      <h3><i class="fa-solid fa-lock"></i> Security</h3>
      <div class="row"><div class="field"><label>Password *</label><input id="suPassword" type="password" minlength="6" required></div><div class="field"><label>Confirm Password *</label><input id="suConfirmPassword" type="password" minlength="6" required></div></div>
      <button class="btn btn-primary" type="submit" style="width:100%;margin-top:16px"><i class="fa-solid fa-user-plus"></i> Sign Up</button>
    </form>
    <div id="signupSuccessBox" class="hidden"></div>
  </div>
</div>

<!-- SIGN IN -->
<div id="auth" class="login-screen hidden">
  <div class="login-card">
    <div class="login-logo"><i class="fa-solid fa-people-group"></i></div>
    <h1>Sign In</h1>
    <p>Enter your credentials to access your group dashboard</p>
    <form id="signInForm" style="margin-top:20px">
      <div class="field"><label>Group ID *</label><input id="loginGroupId" required></div>
      <div class="field"><label>National ID or Phone *</label><input id="loginNida" required></div>
      <div class="field"><label>Password *</label><input id="loginPassword" type="password" required></div>
      <button class="btn btn-primary" type="submit" style="margin-top:8px"><i class="fa-solid fa-right-to-bracket"></i> Sign In</button>
    </form>
    <div style="text-align:center;margin-top:14px"><button class="btn btn-light" onclick="showScreen('landing')" style="font-size:11px"><i class="fa-solid fa-arrow-left"></i> Back to Home</button></div>
  </div>
</div>

<!-- SUPER ADMIN -->
<div id="super" class="super hidden">
  <div class="super-top">
    <div style="display:flex;align-items:center;gap:10px"><i class="fa-solid fa-shield-halved" style="color:var(--danger);font-size:18px"></i><b style="font-size:15px">SUPER ADMIN CONTROL PANEL</b></div>
    <button class="btn btn-outline" onclick="logoutSuper()">Logout</button>
  </div>
  <div class="super-body">
    <div class="cards" id="superMetrics" style="margin-bottom:20px"></div>
    <div class="grid2">
      <div class="panel" style="grid-column:span 2">
        <div class="page-head" style="margin-bottom:10px"><h3 style="margin:0">All Groups & Control</h3></div>
        <div class="table-wrap"><table><thead><tr><th>Name</th><th>ID</th><th>Package</th><th>Type</th><th>Members</th><th>Status</th><th>Created</th><th>Actions</th></tr></thead><tbody id="superGroupsBody"></tbody></table></div>
      </div>
    </div>
    <div class="panel">
      <div class="page-head" style="margin-bottom:10px"><h3 style="margin:0">System Announcements</h3><button class="btn btn-primary" onclick="openSuperAdModal()"><i class="fa-solid fa-plus"></i> Add</button></div>
      <div id="superAdsList" class="announce-grid"></div>
    </div>
  </div>
</div>

<!-- MAIN APP -->
<div id="app" class="app hidden">
  <aside id="sidebar" class="sidebar"><div class="brand"><h2 id="sideGroup">CSCMS</h2><small id="sideRole">Chairperson</small></div><nav class="nav" id="navContainer"></nav></aside>
  <main class="main">
    <header class="topbar">
      <div style="display:flex;align-items:center;gap:14px"><button class="btn btn-light" onclick="toggleSidebar()" style="padding:8px 12px">&#9776;</button><h3 id="pageTitle">Dashboard</h3><span id="syncStatus" class="sync-indicator offline"><i class="fa-solid fa-hard-drive"></i> Local</span></div>
      <div style="display:flex;align-items:center;gap:12px">
        <select id="roleSwitch" onchange="switchRole(this.value)" style="width:auto;padding:6px 10px;border-radius:6px;font-size:11px"><option value="chair">Chairperson</option><option value="member">Member</option></select>
        <span class="user-info" id="topUser"></span>
        <button class="btn btn-danger" onclick="logout()" style="padding:6px 12px"><i class="fa-solid fa-right-from-bracket"></i></button>
      </div>
    </header>
    <div class="content">
      <section id="sec-dashboard" class="section active"><div class="page-head"><h1>Dashboard</h1></div><div class="cards" id="metrics"></div><div class="grid2"><div class="panel"><h3>Portfolio Distribution</h3><div class="chart-box"><canvas id="dashChartPortfolio"></canvas></div></div><div class="panel"><h3>Savings Trend</h3><div class="chart-box"><canvas id="dashChartTrend"></canvas></div></div></div></section>
      <section id="sec-members" class="section"><div class="page-head"><h1>Members</h1><div class="actions"><button class="btn btn-primary chair-only" onclick="openMemberModal()"><i class="fa-solid fa-plus"></i> Add</button></div></div><div class="table-wrap"><table><thead><tr><th>Name</th><th>NIDA</th><th>Phone</th><th>Shares</th><th>Savings</th><th>Status</th><th>Actions</th></tr></thead><tbody id="membersBody"></tbody></table></div></section>
      <section id="sec-savings" class="section"><div class="page-head"><h1>Savings</h1><div class="actions"><button class="btn btn-primary chair-only" onclick="openTxModal('DEPOSIT')"><i class="fa-solid fa-plus"></i> Deposit</button><button class="btn btn-gold chair-only" onclick="openTxModal('WITHDRAWAL')"><i class="fa-solid fa-minus"></i> Withdraw</button></div></div><div class="table-wrap"><table><thead><tr><th>Date</th><th>Member</th><th>Type</th><th>Amount</th></tr></thead><tbody id="savingsBody"></tbody></table></div></section>
      <section id="sec-loans" class="section"><div class="page-head"><h1>Loans</h1><div class="actions"><button class="btn btn-primary" onclick="openLoanModal()"><i class="fa-solid fa-plus"></i> Apply</button></div></div><div class="table-wrap"><table><thead><tr><th>Member</th><th>Principal</th><th>Balance</th><th>Interest</th><th>Status</th><th>Actions</th></tr></thead><tbody id="loansBody"></tbody></table></div></section>
      <section id="sec-cashbook" class="section"><div class="page-head"><h1>Cashbook</h1></div><div id="cashbookMetrics" class="cards"></div><div class="table-wrap"><table><thead><tr><th>Date</th><th>Ref</th><th>Debit</th><th>Credit</th><th>Balance</th></tr></thead><tbody id="cashbookBody"></tbody></table></div></section>
      <section id="sec-audit" class="section"><div class="page-head"><h1>Audit Trail</h1></div><div class="table-wrap"><table><thead><tr><th>Date</th><th>User</th><th>Action</th><th>Entity</th></tr></thead><tbody id="auditBody"></tbody></table></div></section>
      <section id="sec-group" class="section"><div class="page-head"><h1>Settings</h1></div><div class="panel"><form id="groupForm"><div class="row"><div class="field"><label>Group Name</label><input id="gName" required></div><div class="field"><label>Currency</label><select id="gCurrency"></select></div></div><div class="row"><div class="field"><label>Interest %</label><input id="gInterest" type="number" value="10" min="0" max="100" step="0.1"></div><div class="field"><label>Share Price</label><input id="gSharePrice" type="number" value="10000" min="0"></div></div><button class="btn btn-primary" type="submit" style="margin-top:12px"><i class="fa-solid fa-floppy-disk"></i> Save</button></form></div></section>
    </div>
  </main>
</div>

<!-- MODALS -->
