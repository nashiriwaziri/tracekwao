<script>
/* ======== FIREBASE & SYNC CONFIGURATION ======== */
const firebaseConfig = { apiKey: "AIzaSyDSUs6uUjQTPQOkUPcIp2u8Rw9NJVnQOfo", authDomain: "ncrs2-f8da9.firebaseapp.com", projectId: "ncrs2-f8da9", storageBucket: "ncrs2-f8da9.firebasestorage.app", messagingSenderId: "436069918682", appId: "1:436069918682:web:70b56c627315bc782102e3" };
if(!firebase.apps.length) firebase.initializeApp(firebaseConfig);
const db = firebase.firestore();

/* ======== CORE STATE ======== */
const $=id=>document.getElementById(id);
const uid=()=>'id_'+Date.now().toString(36)+'_'+Math.random().toString(36).substr(2,6);
const today=()=>new Date().toISOString().split('T')[0];
const fmt=(n,c)=>{const v=Number(n||0);return(c||G?.currency||'TZS')+' '+v.toLocaleString()};

const DB = JSON.parse(localStorage.getItem('cscms_db')||'null')||{groups:[],superAds:[]};
const save = (skipSync = false) => { localStorage.setItem('cscms_db', JSON.stringify(DB)); if(navigator.onLine && !skipSync) pushToFirebase(); };

/* ======== SYNC LOGIC ======== */
function updateSyncUI() { const ind = $('syncStatus'); if(!ind) return; if(navigator.onLine){ ind.className = 'sync-indicator online'; ind.innerHTML = '<i class="fa-solid fa-cloud-arrow-up"></i> Synced'; } else { ind.className = 'sync-indicator offline'; ind.innerHTML = '<i class="fa-solid fa-hard-drive"></i> Local'; } }
async function pushToFirebase() { if(!navigator.onLine) return; try { const ind = $('syncStatus'); if(ind){ ind.className = 'sync-indicator syncing'; ind.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Syncing'; } const batch = db.batch(); for(const g of DB.groups) { batch.set(db.collection('groups').doc(g.id), g, {merge:true}); } for(const a of DB.superAds) { batch.set(db.collection('superAds').doc(a.id), a, {merge:true}); } await batch.commit(); updateSyncUI(); } catch(e) { console.error("Push Error:", e); } }
async function pullFromFirebase() { if(!navigator.onLine) return; try { const groupSnap = await db.collection('groups').get(); groupSnap.forEach(doc => { const remoteG = doc.data(); const localIdx = DB.groups.findIndex(g => g.id === remoteG.id); if(localIdx === -1) DB.groups.push(remoteG); else DB.groups[localIdx] = remoteG; }); const adsSnap = await db.collection('superAds').get(); adsSnap.forEach(doc => { const remoteA = doc.data(); const localIdx = DB.superAds.findIndex(a => a.id === remoteA.id); if(localIdx === -1) DB.superAds.push(remoteA); else DB.superAds[localIdx] = remoteA; }); localStorage.setItem('cscms_db', JSON.stringify(DB)); if(G) { G = DB.groups.find(g => g.id === G.id); const activeSec = document.querySelector('.section.active')?.id; if(activeSec) renderSection(activeSec); } } catch(e) { console.error("Pull Error:", e); } }
window.addEventListener('online', async () => { updateSyncUI(); await pullFromFirebase(); await pushToFirebase(); });
window.addEventListener('offline', updateSyncUI);

let G,U,role='chair',section='dashboard', signupTimer;

/* Toast & Modal */
function toast(msg,type='success'){const t=document.createElement('div');t.className='toast '+type;t.innerHTML=`<i class="fa-solid fa-${type==='error'?'circle-exclamation':'circle-check'}"></i> ${msg}`;$('toastContainer').appendChild(t);setTimeout(()=>t.remove(),4000);}
function openModal(id){$(id).classList.add('show');}
function closeModal(id){$(id).classList.remove('show');}

/* Screen */
function showScreen(id){['landing','auth','memberRegScreen','super','app'].forEach(s=>$(s).classList.toggle('hidden',s!==id));if(id==='app')initApp();if(id==='landing')renderLanding(); clearTimeout(signupTimer);}
function toggleSidebar(){$('sidebar').style.width=$('sidebar').style.width==='65px'?'260px':'65px';}
function switchRole(r){role=r;document.querySelectorAll('.chair-only').forEach(el=>el.style.display=r==='chair'?'inline-flex':'none');$('sideRole').textContent=r==='chair'?'Chairperson':'Member';}

/* Helpers */
function getMemberName(id){const m=G.members.find(x=>x.id===id);return m?m.name:'Unknown';}
function memberOpts(){return G.members.map(m=>`<option value="${m.id}">${m.name}</option>`).join('');}
function loanOpts(){return G.loans.filter(l=>l.status==='ACTIVE').map(l=>`<option value="${l.id}">LN-${l.id.substr(-4)} (${getMemberName(l.memberId)}) - ${fmt(l.balance)}</option>`).join('');}
function actBtns(id,delFn){return `<div class="actions"><button class="btn btn-light" onclick="editItem('${id}')"><i class="fa-solid fa-pen"></i></button><button class="btn btn-danger" onclick="${delFn}('${id}')"><i class="fa-solid fa-trash"></i></button></div>`;}
function audit(action,entity){G.audit.push({id:uid(),date:today()+' '+new Date().toLocaleTimeString(),user:U?.name||'System',action,entity});save();}

const COUNTRIES=[{n:'Tanzania',c:'TZS'},{n:'Kenya',c:'KES'},{n:'Uganda',c:'UGX'},{n:'Rwanda',c:'RWF'},{n:'Nigeria',c:'NGN'},{n:'USA',c:'USD'}];
const ALL_CURRENCIES=[...new Set(COUNTRIES.map(c=>c.c))].sort();

function initSetup(){ $('suCountry').innerHTML=COUNTRIES.map(c=>`<option value="${c.n}">${c.n}</option>`).join(''); $('suCurrency').innerHTML=ALL_CURRENCIES.map(c=>`<option value="${c}">${c}</option>`).join(''); $('suCountry').onchange=()=>{const c=COUNTRIES.find(x=>x.n===$('suCountry').value);if(c)$('suCurrency').value=c.c;}; $('gCurrency').innerHTML=ALL_CURRENCIES.map(c=>`<option value="${c}">${c}</option>`).join(''); updateSyncUI(); }

const PLANS=[{name:'Starter',price:0,period:'Free'},{name:'Growth',price:9.99,period:'/mo'},{name:'Enterprise',price:29.99,period:'/mo'}];
function renderLanding(){ $('pricingGrid').innerHTML=PLANS.map(p=>`<div class="price-card"><h3>${p.name}</h3><div class="price-amount">$${p.price}<span> ${p.period}</span></div><button class="btn btn-white" onclick="showScreen('memberRegScreen')">Get Started</button></div>`).join(''); }

/* ======== NAV ======== */
const NAV_ITEMS=[{t:'Main',items:[{id:'dashboard',icon:'fa-gauge-high',label:'Dashboard'},{id:'members',icon:'fa-users',label:'Members'},{id:'savings',icon:'fa-piggy-bank',label:'Savings'},{id:'loans',icon:'fa-hand-holding-dollar',label:'Loans'}]},{t:'Finance',items:[{id:'cashbook',icon:'fa-book',label:'Cashbook'},{id:'audit',icon:'fa-fingerprint',label:'Audit Trail'}]},{t:'System',items:[{id:'group',icon:'fa-gear',label:'Settings'}]}];
function renderNav(){$('navContainer').innerHTML=NAV_ITEMS.map(g=>`<div class="nav-title">${g.t}</div>${g.items.map(i=>`<button id="nav-${i.id}" onclick="navigate('sec-${i.id}')"><i class="fa-solid ${i.icon}"></i> <span>${i.label}</span></button>`).join('')}`).join('');}
function navigate(id){document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));$(id).classList.add('active');document.querySelectorAll('.nav button').forEach(b=>b.classList.remove('active'));const navBtn=$('nav-'+id.replace('sec-',''));if(navBtn)navBtn.classList.add('active');const item=NAV_ITEMS.flatMap(n=>n.items).find(i=>'sec-'+i.id===id);$('pageTitle').textContent=item?item.label:'Dashboard';renderSection(id);}

/* ======== AUTH & SIGNUP TIMER ======== */
 $('signUpForm').onsubmit=e=>{e.preventDefault();if($('suPassword').value!==$('suConfirmPassword').value)return toast('Passwords do not match','error');const gid=uid();const chair={id:uid(),name:$('suFname').value+' '+$('suLname').value,nida:$('suNida').value,phone:$('suPhone').value,password:$('suPassword').value,shares:0,savings:0,status:'ACTIVE',role:'chair',joinDate:today()};const group={id:gid,name:$('suGroupName').value,type:$('suGroupType').value,country:$('suCountry').value,currency:$('suCurrency').value,package:$('suPackage').value,status:'ACTIVE',createdDate:today(),interest:10,sharePrice:10000,members:[chair],savings:[],loans:[],repayments:[],expenses:[],audit:[]};DB.groups.push(group);save();

 $('signUpForm').classList.add('hidden');
 $('signupSuccessBox').classList.remove('hidden');
 $('signupSuccessBox').innerHTML=`<div class="success-box"><h3><i class="fa-solid fa-circle-check"></i> Registration Successful!</h3><p>Your Group ID is:</p><h2 style="color:var(--primary); letter-spacing:2px; margin:10px 0">${gid}</h2><p class="muted">Please save this ID securely. It will disappear from this screen in <strong id="countdownTimer">5:00</strong> minutes for security reasons.</p><button class="btn btn-primary" style="margin-top:15px" onclick="showScreen('auth')"><i class="fa-solid fa-right-to-bracket"></i> Proceed to Sign In</button></div>`;

let timeLeft = 300; // 5 minutes
clearTimeout(signupTimer);
const countdown = () => {
  timeLeft--;
  const m = Math.floor(timeLeft / 60); const s = timeLeft % 60;
  const timerEl = $('countdownTimer');
  if(timerEl) timerEl.textContent = `${m}:${s < 10 ? '0'+s : s}`;
  if(timeLeft <= 0){ clearTimeout(signupTimer); $('signupSuccessBox').innerHTML=`<div class="success-box"><h3>Time Expired</h3><p class="muted">For security, the Group ID is no longer visible. If you lost it, please contact the System Super Admin.</p><button class="btn btn-primary" onclick="showScreen('auth')">Proceed to Sign In</button></div>`; }
  else { signupTimer = setTimeout(countdown, 1000); }
};
signupTimer = setTimeout(countdown, 1000);
};

 $('signInForm').onsubmit=e=>{e.preventDefault();G=DB.groups.find(g=>g.id===$('loginGroupId').value);if(!G)return toast('Invalid Group ID','error');if(G.status==='SUSPENDED')return toast('This account has been suspended by Super Admin.','error');U=G.members.find(m=>(m.nida===$('loginNida').value||m.phone===$('loginNida').value)&&m.password===$('loginPassword').value);if(!U)return toast('Invalid credentials','error');showScreen('app');};
function logout(){G=null;U=null;showScreen('landing');}

/* Super Admin */
 $('superLoginForm').onsubmit=e=>{e.preventDefault();if($('superEmail').value==='super@vikoba.app'&&$('superPass').value==='WAZIRI2015'){showScreen('super');renderSuperAdmin();}else toast('Invalid super admin credentials','error');};
function logoutSuper(){showScreen('landing');}

function renderSuperAdmin(){
  const totalGroups=DB.groups.length;const activeGroups=DB.groups.filter(g=>g.status==='ACTIVE').length;const suspendedGroups=DB.groups.filter(g=>g.status==='SUSPENDED').length;
  const starterPkg=DB.groups.filter(g=>g.package==='Starter').length;const growthPkg=DB.groups.filter(g=>g.package==='Growth').length;const entPkg=DB.groups.filter(g=>g.package==='Enterprise').length;
  
  $('superMetrics').innerHTML=`
    <div class="stat"><div class="stat-top"><div class="stat-icon" style="background:#edf5ff;color:var(--secondary)"><i class="fa-solid fa-layer-group"></i></div></div><strong>${totalGroups}</strong><div class="muted">Total Groups</div></div>
    <div class="stat"><div class="stat-top"><div class="stat-icon" style="background:#e5f7ed;color:var(--success)"><i class="fa-solid fa-circle-check"></i></div></div><strong>${activeGroups}</strong><div class="muted">Active Groups</div></div>
    <div class="stat"><div class="stat-top"><div class="stat-icon" style="background:#ffeded;color:var(--danger)"><i class="fa-solid fa-circle-xmark"></i></div></div><strong>${suspendedGroups}</strong><div class="muted">Suspended Groups</div></div>
    <div class="stat"><div class="stat-top"><div class="stat-icon" style="background:#fff4d9;color:#936500"><i class="fa-solid fa-boxes-stacked"></i></div></div><strong>St:${starterPkg} | Gr:${growthPkg} | En:${entPkg}</strong><div class="muted">Package Distribution</div></div>`;
    
  $('superGroupsBody').innerHTML=DB.groups.map(g=>`<tr><td><b>${g.name}</b></td><td style="font-family:monospace; font-size:11px">${g.id}</td><td><span class="badge info">${g.package||'Starter'}</span></td><td>${g.type}</td><td>${g.members.length}</td><td><span class="badge ${g.status==='ACTIVE'?'':'inactive'}">${g.status||'ACTIVE'}</span></td><td>${g.createdDate||'N/A'}</td><td><div class="actions"><button class="btn btn-light" onclick="viewGroupPanel('${g.id}')"><i class="fa-solid fa-eye"></i> Manage</button><button class="btn ${g.status==='SUSPENDED'?'btn-success':'btn-gold'}" onclick="toggleSuspendGroup('${g.id}')"><i class="fa-solid fa-${g.status==='SUSPENDED'?'circle-check':'ban'}"></i> ${g.status==='SUSPENDED'?'Activate':'Suspend'}</button><button class="btn btn-danger" onclick="deleteGroup('${g.id}')"><i class="fa-solid fa-trash"></i></button></div></td></tr>`).join('');
  renderSuperAds();
