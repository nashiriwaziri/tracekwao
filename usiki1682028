<div class="tc" id="toastContainer"></div>

<script>
/* ======================================================================
   DATA LAYER - localStorage
   ====================================================================== */
const SUPER_CREDS = { email: 'admin@bizbook.com', password: 'admin123' };
let CU = null; // Current user session
let CART = []; // POS cart
let chartInstances = {};

function getDB() {
  try { return JSON.parse(localStorage.getItem('bizbook_db')) || initDB(); }
  catch(e) { return initDB(); }
}
function saveDB(db) { localStorage.setItem('bizbook_db', JSON.stringify(db)); }
function initDB() {
  const db = { users:[], products:[], sales:[], purchases:[], customers:[], sellers:[], debts:[], expenses:[], employees:[], notifications:[], superAds:[] };
  saveDB(db);
  return db;
}
function uid() { return Date.now().toString(36) + Math.random().toString(36).substr(2,5); }
function fmt(n) { return Number(n||0).toLocaleString('en-US'); }
function fmtDate(d) { return new Date(d).toLocaleDateString('sw-TZ',{day:'2-digit',month:'short',year:'numeric'}); }
function getUserItems(arr) { return (getDB()[arr]||[]).filter(i => i.userId === (CU?.id)); }
function getUserItem(arr, id) { return getUserItems(arr).find(i => i.id === id); }
function saveItem(arr, item) { const db=getDB(); const idx=db[arr].findIndex(i=>i.id===item.id); if(idx>=0) db[arr][idx]=item; else db[arr].push(item); saveDB(db); }
function deleteItem(arr, id) { const db=getDB(); db[arr]=db[arr].filter(i=>i.id!==id); saveDB(db); }

/* ======================================================================
   NAVIGATION
   ====================================================================== */
function hideAll() {
  ['landingPage','superScreen','authScreen','roleScreen','mainApp'].forEach(id=>document.getElementById(id).classList.add('hidden'));
}
function showLanding() { hideAll(); document.getElementById('landingPage').classList.remove('hidden'); renderPublicShowcase(); }
function showAuth(tab) {
  hideAll(); document.getElementById('authScreen').classList.remove('hidden');
  switchAuthTab(tab||'login');
  document.getElementById('authErr').classList.remove('show');
}
function showSuperAdmin() {
  hideAll(); document.getElementById('superScreen').classList.remove('hidden');
  document.getElementById('superLoginBox').classList.remove('hidden');
  document.getElementById('superPanel').classList.add('hidden');
  document.getElementById('superErr').textContent='';
}
function showRoleScreen() {
  hideAll(); document.getElementById('roleScreen').classList.remove('hidden');
  const u = getUserItem('users', CU.id);
  document.getElementById('rsBizName').textContent = u?.businessName || 'Biashara';
  document.getElementById('rsBizCat').textContent = u?.businessCategory || '';
}
function showMainApp() {
  hideAll(); document.getElementById('mainApp').classList.remove('hidden');
  updateBranding(); buildSidebar(); navigateTo('dashboard');
}

/* ======================================================================
   AUTH
   ====================================================================== */
function switchAuthTab(tab) {
  document.getElementById('tabLogin').classList.toggle('active', tab==='login');
  document.getElementById('tabSignup').classList.toggle('active', tab==='signup');
  document.getElementById('loginForm').classList.toggle('active', tab==='login');
  document.getElementById('signupForm').classList.toggle('active', tab==='signup');
  document.getElementById('authErr').classList.remove('show');
}
function showAuthErr(msg) {
  document.getElementById('authErrMsg').textContent = msg;
  document.getElementById('authErr').classList.add('show');
}
function checkPwStr() {
  const p = document.getElementById('signupPass').value;
  let s = 0;
  if(p.length>=6) s++; if(p.length>=10) s++; if(/[A-Z]/.test(p)) s++; if(/[0-9]/.test(p)) s++; if(/[^A-Za-z0-9]/.test(p)) s++;
  const bar = document.getElementById('pwStrBar');
  const colors = ['var(--danger)','var(--danger)','var(--warning)','var(--warning)','var(--success)','var(--success)'];
  bar.style.width = (s*20)+'%';
  bar.style.background = colors[s];
}
function signupNext() {
  const n=document.getElementById('signupName').value, e=document.getElementById('signupEmail').value, p=document.getElementById('signupPass').value, p2=document.getElementById('signupPass2').value;
  if(!n||!e||!p) return showAuthErr('Jaza sehemu zote zilizohitajika.');
  if(p.length<6) return showAuthErr('Password lazima iwe na herufi 6 au zaidi.');
  if(p!==p2) return showAuthErr('Password hazilingani.');
  const db=getDB();
  if(db.users.find(u=>u.email===e.toLowerCase())) return showAuthErr('Email hii imesajiliwa tayari.');
  document.getElementById('signupStep1').style.display='none';
  document.getElementById('signupStep2').style.display='block';
  document.getElementById('sd1').classList.remove('on');
  document.getElementById('sd2').classList.add('on');
}
function signupBack() {
  document.getElementById('signupStep1').style.display='block';
  document.getElementById('signupStep2').style.display='none';
  document.getElementById('sd1').classList.add('on');
  document.getElementById('sd2').classList.remove('on');
}
function handleSignup(e) {
  e.preventDefault();
  const db=getDB();
  const email=document.getElementById('signupEmail').value.toLowerCase();
  const biz=document.getElementById('signupBiz').value, cat=document.getElementById('signupCat').value;
  if(!biz||!cat) return showAuthErr('Jaza jina na aina ya biashara.');
  const user = {
    id:uid(), name:document.getElementById('signupName').value, email, password:document.getElementById('signupPass').value,
    businessName:biz, businessCategory:cat, phone:document.getElementById('signupPhone').value,
    address:document.getElementById('signupAddr').value, logo:'', role:'', status:'active', createdAt:new Date().toISOString()
  };
  db.users.push(user); saveDB(db);
  CU = { id:user.id, role:'' };
  localStorage.setItem('bizbook_session', JSON.stringify(CU));
  addSampleData(user.id);
  toast('Akaunti imeundwa kwa mafanikio!','s');
  showRoleScreen();
}
function handleLogin(e) {
  e.preventDefault();
  const db=getDB();
  const email=document.getElementById('loginEmail').value.toLowerCase();
  const pass=document.getElementById('loginPass').value;
  const user=db.users.find(u=>u.email===email&&u.password===pass);
  if(!user) return showAuthErr('Email au password si sahihi.');
  if(user.status==='suspended') return showAuthErr('Akaunti yako imefungwa. Wasiliana na Meneja.');
  CU = { id:user.id, role:user.role||'' };
  localStorage.setItem('bizbook_session', JSON.stringify(CU));
  toast('Karibu, '+user.name.split(' ')[0]+'!','s');
  if(!user.role) showRoleScreen(); else showMainApp();
}
function handlePasswordReset() {
  const email=document.getElementById('loginEmail').value;
  if(!email) return showAuthErr('Andika email yako kwanza.');
  toast('Maelezo ya kubadilisha password yametumwa kwako.','i');
}
function selectRole(role) {
  const db=getDB(); const user=getUserItem('users',CU.id);
  if(!user) return;
  user.role=role; saveItem('users',user);
  CU.role=role; localStorage.setItem('bizbook_session',JSON.stringify(CU));
  showMainApp();
}
function logout() {
  CU=null; CART=[]; localStorage.removeItem('bizbook_session');
  Object.values(chartInstances).forEach(c=>{try{c.destroy()}catch(e){}}); chartInstances={};
  showLanding();
}

/* ======================================================================
   SUPER ADMIN
   ====================================================================== */
function superLogin(e) {
  e.preventDefault();
  const u=document.getElementById('superUser').value, p=document.getElementById('superPass').value;
  if(u===SUPER_CREDS.email && p===SUPER_CREDS.password) {
    document.getElementById('superLoginBox').classList.add('hidden');
    document.getElementById('superPanel').classList.remove('hidden');
    renderSuperPanel();
  } else { document.getElementById('superErr').textContent='Email au password si sahihi.'; }
}
function superLogout() { showLanding(); }
function returnToSuperPanel() {
  document.getElementById('superBodyMain').classList.remove('hidden');
  document.getElementById('superBodyDetail').classList.add('hidden');
  document.getElementById('superBackBtn').style.display='none';
  renderSuperPanel();
}
function renderSuperPanel() {
  const db=getDB(); const users=db.users;
  document.getElementById('superMetrics').innerHTML=`
    <div class="sm-card"><h4>Jumla ya Watumiaji</h4><div class="sm-val">${users.length}</div><div class="sm-sub">Waliyosajiliwa</div></div>
    <div class="sm-card"><h4>Bidhaa Zote</h4><div class="sm-val">${db.products.length}</div><div class="sm-sub">Katika mfumo</div></div>
    <div class="sm-card"><h4>Mauzo Yote</h4><div class="sm-val">${db.sales.length}</div><div class="sm-sub">Kwa jumla</div></div>
    <div class="sm-card"><h4>Matangazo</h4><div class="sm-val">${db.superAds.length}</div><div class="sm-sub">Global ads</div></div>`;
  renderSuperUsers(); renderSuperAds(); renderSuperPublicProducts(); renderSuperCharts();
}
function renderSuperUsers() {
  const db=getDB(); const q=(document.getElementById('superUserSearch')?.value||'').toLowerCase();
  const users=db.users.filter(u=>!q||u.name.toLowerCase().includes(q)||u.email.toLowerCase().includes(q)||(u.businessName||'').toLowerCase().includes(q));
  document.getElementById('superUsersBody').innerHTML=users.length?users.map(u=>`<tr>
    <td><strong>${u.name}</strong></td><td>${u.email}</td><td>${u.businessName||'-'}</td><td>${u.businessCategory||'-'}</td>
    <td>${u.role||'-'}</td><td><span class="status-badge ${u.status||'active'}">${u.status||'active'}</span></td>
    <td>${fmtDate(u.createdAt)}</td>
    <td><button class="btn btn-i btn-xs" onclick="viewSuperUser('${u.id}')"><i class="fa-solid fa-eye"></i></button>
    <button class="btn btn-w btn-xs" onclick="toggleSuperUserStatus('${u.id}')"><i class="fa-solid fa-ban"></i></button></td></tr>`).join(''):'<tr><td colspan="8" class="empty-s"><i class="fa-solid fa-users"></i><p>Hakuna watumiaji</p></td></tr>';
}
function viewSuperUser(id) {
  const db=getDB(); const u=db.users.find(x=>x.id===id); if(!u) return;
  const prods=db.products.filter(p=>p.userId===id);
  const sales=db.sales.filter(s=>s.userId===id);
  const totalSales=sales.reduce((a,s)=>a+(s.total||0),0);
  document.getElementById('superBodyMain').classList.add('hidden');
  document.getElementById('superBodyDetail').classList.remove('hidden');
  document.getElementById('superBackBtn').style.display='inline-flex';
