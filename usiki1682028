      <div class="pos-cart"><div class="pos-cart-head"><i class="fa-solid fa-cart-shopping"></i> Garika (<span id="cartCount">0</span>)</div>
      <div class="pos-cart-body" id="cartBody"></div>
      <div class="pos-cart-foot">
        <div class="pos-total"><span>Jumla:</span><span id="cartTotal">0 TZS</span></div>
        <div class="fg"><label>Mteja (si lazima)</label><input class="fi" id="posCustomer" placeholder="Jina la mteja"/></div>
        <div class="fg"><label>Njia ya Malipo</label><select class="fi" id="posPayment"><option>Cash</option><option>Card</option><option>Mobile Money</option></select></div>
        <button class="btn-auth btn-auth-p" onclick="completeSale()"><i class="fa-solid fa-check"></i> Maliza Mauzo</button>
      </div></div>
    </div>`;
  renderCart();
}
function filterPOSProducts() {
  const q=document.getElementById('posSearch').value.toLowerCase();
  const products=getUserItems('products').filter(p=>p.stock>0&&p.name.toLowerCase().includes(q));
  document.getElementById('posProductGrid').innerHTML=products.map(p=>`<div class="pos-p-card" onclick="addToCart('${p.id}')"><h5>${p.name}</h5><div class="pos-p-price">${fmt(p.price)}</div><div class="pos-p-stock">Stock: ${p.stock}</div></div>`).join('')||'<div class="empty-s"><p>Hakuna matokeo</p></div>';
}
function addToCart(pid) {
  const p=getUserItem('products',pid); if(!p) return;
  const existing=CART.find(c=>c.productId===pid);
  if(existing){if(existing.qty>=p.stock){toast('Stock haizitoshi!','w');return;}existing.qty++;existing.subtotal=existing.qty*existing.price;}
  else CART.push({productId:pid,name:p.name,price:p.price,qty:1,subtotal:p.price});
  renderCart();
}
function updateCartQty(pid,delta) {
  const item=CART.find(c=>c.productId===pid); if(!item) return;
  const p=getUserItem('products',pid);
  item.qty+=delta;
  if(item.qty<=0) CART=CART.filter(c=>c.productId!==pid);
  else if(p&&item.qty>p.stock){item.qty=p.stock;toast('Stock haizitoshi!','w');}
  item.subtotal=item.qty*item.price;
  renderCart();
}
function removeFromCart(pid){CART=CART.filter(c=>c.productId!==pid);renderCart();}
function renderCart() {
  document.getElementById('cartCount').textContent=CART.length;
  document.getElementById('cartTotal').textContent=fmt(CART.reduce((a,c)=>a+c.subtotal,0))+' TZS';
  document.getElementById('cartBody').innerHTML=CART.length?CART.map(c=>`<div class="cart-item"><div class="cart-item-info"><h6>${c.name}</h6><span>${fmt(c.price)}/ea</span></div><div class="cart-qty"><button onclick="updateCartQty('${c.productId}',-1)">-</button><span>${c.qty}</span><button onclick="updateCartQty('${c.productId}',1)">+</button></div><div class="cart-item-price">${fmt(c.subtotal)}</div><button class="cart-item-rm" onclick="removeFromCart('${c.productId}')"><i class="fa-solid fa-trash"></i></button></div>`).join(''):'<div class="empty-s" style="padding:20px"><p>Garika ni tupu</p></div>';
}
function completeSale() {
  if(!CART.length) return toast('Garika ni tupu!','w');
  const total=CART.reduce((a,c)=>a+c.subtotal,0);
  const sale={id:uid(),userId:CU.id,items:[...CART],total,customerName:document.getElementById('posCustomer').value,paymentMethod:document.getElementById('posPayment').value,date:new Date().toISOString()};
  // Update stock
  CART.forEach(c=>{const p=getUserItem('products',c.productId);if(p){p.stock-=c.qty;saveItem('products',p);}});
  saveItem('sales',sale);
  addNotification('Mauzo mpya','Mauzo ya '+fmt(total)+' TZS yamekamilika.','success');
  showReceipt(sale);
  CART=[]; renderPOS();
  toast('Mauzo yamekamilika!','s');
}
function showReceipt(sale) {
  const u=getUserItem('users',CU.id);
  document.getElementById('receiptBody').innerHTML=`<div class="receipt-content" id="receiptContent">
    ${u&&u.logo?`<div style="text-align:center;margin-bottom:8px"><img src="${u.logo}" style="width:60px;height:60px;object-fit:contain;border-radius:8px"/></div>`:''}
    <h3>${u?u.businessName:'BizBook'}</h3>
    ${u&&u.phone?`<p style="text-align:center;font-size:11px">${u.phone}</p>`:''}
    <div class="rc-divider"></div>
    <div class="rc-line"><span>Tarehe</span><span>${new Date(sale.date).toLocaleString('sw-TZ')}</span></div>
    <div class="rc-line"><span>Namba</span><span>#${sale.id.slice(-5).toUpperCase()}</span></div>
    <div class="rc-line"><span>Mteja</span><span>${sale.customerName||'Walk-in'}</span></div>
    <div class="rc-line"><span>Njia</span><span>${sale.paymentMethod}</span></div>
    <div class="rc-divider"></div>
    ${(sale.items||[]).map(it=>`<div class="rc-line"><span>${it.name} x${it.qty}</span><span>${fmt(it.subtotal)}</span></div>`).join('')}
    <div class="rc-divider"></div>
    <div class="rc-line rc-total"><span>JUMLA</span><span>${fmt(sale.total)} TZS</span></div>
    <div class="rc-divider"></div>
    <p style="text-align:center;font-size:10px">Asante kwa kununua!</p>
  </div>`;
  document.getElementById('receiptModal').classList.add('show');
}
