/* ======================================================================
   EXPORT HELPERS
   ====================================================================== */
function getTableData(tableId) {
  const table=document.getElementById(tableId); if(!table) return {headers:[],rows:[]};
  const headers=Array.from(table.querySelectorAll('thead th')).map(th=>th.textContent.trim());
  const rows=Array.from(table.querySelectorAll('tbody tr')).map(tr=>Array.from(tr.querySelectorAll('td')).map(td=>td.textContent.trim()));
  return {headers,rows};
}
function exportPDF(title, headers, rows, filename) {
  const {jsPDF}=window.jspdf; const doc=new jsPDF();
  doc.setFontSize(16); doc.text(title,14,20);
  doc.setFontSize(9); doc.text('Imetengenezwa: '+new Date().toLocaleString('sw-TZ')+' | BizBook',14,27);
  if(rows.length) doc.autoTable({head:[headers],body:rows,startY:33,styles:{fontSize:8},headStyles:{fillColor:[108,92,231]}});
  else doc.text('Hakuna data.',14,40);
  doc.save(filename+'.pdf');
}
function exportWord(title, headers, rows, filename) {
  let tbl=`<table border="1" cellpadding="5" cellspacing="0" style="border-collapse:collapse;width:100%;font-family:Calibri,sans-serif;font-size:11px">`;
  tbl+=`<tr>${headers.map(h=>`<th style="background:#6c5ce7;color:white;padding:6px">${h}</th>`).join('')}</tr>`;
  rows.forEach(r=>{tbl+=`<tr>${r.map(c=>`<td style="padding:5px">${c}</td>`).join('')}</tr>`;});
  tbl+=`</table>`;
  const html=`<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word'><head><meta charset='utf-8'><title>${title}</title></head><body><h2 style="color:#6c5ce7">${title}</h2><p style="font-size:10px;color:#666">Imetengenezwa: ${new Date().toLocaleString('sw-TZ')} | BizBook</p>${tbl}</body></html>`;
  const blob=new Blob(['\ufeff',html],{type:'application/msword'});
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=filename+'.doc';a.click();URL.revokeObjectURL(a.href);
}
function exportExcel(title, headers, rows, filename) {
  const data=rows.map(r=>{const o={};headers.forEach((h,i)=>o[h]=r[i]);return o;});
  const ws=XLSX.utils.json_to_sheet(data);
  const wb=XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb,ws,title);
  XLSX.writeFile(wb,filename+'.xlsx');
}
function exportTablePDF(tid,title,fn){const{headers,rows}=getTableData(tid);exportPDF(title,headers,rows,fn);}
function exportTableWord(tid,title,fn){const{headers,rows}=getTableData(tid);exportWord(title,headers,rows,fn);}
function exportTableExcel(tid,title,fn){const{headers,rows}=getTableData(tid);exportExcel(title,headers,rows,fn);}
function exportBar(sec) {
  return `<button class="btn btn-d btn-sm" onclick="exportTablePDF('tbl-${sec}','${secTitles[sec]}','bizbook_${sec}')"><i class="fa-solid fa-file-pdf"></i> PDF</button>
  <button class="btn btn-i btn-sm" onclick="exportTableWord('tbl-${sec}','${secTitles[sec]}','bizbook_${sec}')"><i class="fa-solid fa-file-word"></i> Word</button>
  <button class="btn btn-s btn-sm" onclick="exportTableExcel('tbl-${sec}','${secTitles[sec]}','bizbook_${sec}')"><i class="fa-solid fa-file-excel"></i> Excel</button>`;
}

