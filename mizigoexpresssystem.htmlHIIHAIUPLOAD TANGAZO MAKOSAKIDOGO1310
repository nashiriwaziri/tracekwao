  <div class="sb-bd" id="sbBd" onclick="toggleSidebar()"></div>
  <aside class="sidebar" id="sidebar">
    <div class="sb-brand"><i class="fa-solid fa-truck-fast" style="font-size:20px;color:var(--gold)"></i><span>Mizigo Express</span></div>
    <nav class="sb-nav" id="sidebarNav">
