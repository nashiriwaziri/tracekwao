          if(col==="payments")payments=payments.concat(arr);if(col==="hubs")hubs=hubs.concat(arr);
          if(col==="audit")audit=audit.concat(arr);if(col==="routes")routeRecords=routeRecords.concat(arr);
          if(col==="documents")shippingDocuments=shippingDocuments.concat(arr);if(col==="claims")claims=claims.concat(arr);
          if(col==="notifications")notifications=notifications.concat(arr);if(col==="quotes")quotes=quotes.concat(arr);
        }catch(err){console.warn(`Could not read ${col} from company ${cid}:`,err.message)}
