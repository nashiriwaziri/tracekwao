      <div class="ni" data-s="dispatch" onclick="go('dispatch')"><i class="fa-solid fa-clipboard-list"></i><span data-t="nav_dispatch">Usafirishaji</span></div>
      <div class="ni" data-s="fleet" onclick="go('fleet')"><i class="fa-solid fa-truck"></i><span data-t="nav_fleet">Fleet & GPS</span></div>
      <div class="ni" data-s="delivery" onclick="go('delivery')"><i class="fa-solid fa-location-dot"></i><span data-t="nav_delivery">Utoaji & POD</span></div>
      <div class="ni" data-s="tracking" onclick="go('tracking')"><i class="fa-solid fa-magnifying-glass-location"></i><span data-t="nav_tracking">Fuatilia</span></div>
      <div class="ni" data-s="calculator" onclick="go('calculator')"><i class="fa-solid fa-calculator"></i><span data-t="nav_calculator">Kalkuleta</span></div>
