async function deleteCompanyRecord(cid){
 if(!isSuperAdmin||!fb)return;
 const company=allCompanies.find(c=>c.id===cid);if(!company)return;
 const confirmation=prompt(`HATUA HII NI YA KUDUMU. Itaondoa rekodi za Firestore za kampuni “${company.name||cid}”. Haifuti Firebase Authentication user. Andika DELETE ${cid} kuthibitisha:`);
 if(confirmation!==`DELETE ${cid}`) {toast('Ufutaji umeghairiwa.','i');return}
 const cols=['cargo','vehicles','trips','customers','payments','users','hubs','audit','routes','documents','claims','notifications','quotes','branches'];
 try{
  for(const col of cols){
   const snap=await fb.getDocs(fb.collection(fb.db,'companies',cid,col));
   for(let i=0;i<snap.docs.length;i+=400){const batch=fb.writeBatch(fb.db);snap.docs.slice(i,i+400).forEach(d=>batch.delete(d.ref));await batch.commit()}
  }
  await fb.deleteDoc(fb.doc(fb.db,'companies',cid));
  allCompanies=allCompanies.filter(c=>c.id!==cid);renderSuperAdmin();toast('Data za kampuni zimefutwa. Utambulisho wa Firebase Authentication unahitaji kufutwa na Cloud Function/Admin SDK.','s');
 }catch(e){toast('Ufutaji haujakamilika: '+friendlyError(e),'e')}
}
