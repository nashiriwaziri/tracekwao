async function loadSuperAdminData(){
  if(!fb)return;
  try{
    const companiesSnap=await fb.getDocs(fb.collection(fb.db,"companies"));
    allCompanies=companiesSnap.docs.map(d=>({id:d.id,...d.data()}));
    cargo=[];vehicles=[];trips=[];customers=[];payments=[];hubs=[];audit=[];routeRecords=[];shippingDocuments=[];claims=[];notifications=[];quotes=[];branches=[];
    for(const compDoc of companiesSnap.docs){
      const cid=compDoc.id;
      const cols=["cargo","vehicles","trips","customers","payments","users","hubs","audit","routes","documents","claims","notifications","quotes"];
      for(const col of cols){
        try{
          const snap=await fb.getDocs(fb.collection(fb.db,"companies",cid,col));
          const arr=snap.docs.map(d=>({id:d.id,...d.data(),_company:compDoc.data().name||cid}));
          if(col==="cargo")cargo=cargo.concat(arr);if(col==="vehicles")vehicles=vehicles.concat(arr);
