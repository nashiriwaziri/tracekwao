async function refreshCloudData(){
  if(isDemo||!fb||!activeCompanyId)return;
  const collections=["cargo","vehicles","trips","customers","payments","users","hubs","audit","routes","documents","claims","notifications","branches","quotes"];
  for(const u of unsubs)try{u()}catch{}unsubs=[];
  for(const name of collections){
    const unsub=fb.onSnapshot(fb.collection(fb.db,"companies",activeCompanyId,name),snap=>{
      const arr=snap.docs.map(d=>({id:d.id,...d.data()}));
      if(name==="cargo")cargo=arr;if(name==="vehicles")vehicles=arr;if(name==="trips")trips=arr;
      if(name==="customers")customers=arr;if(name==="payments")payments=arr;
      if(name==="hubs")hubs=arr;
      if(name==="audit")audit=arr.sort((a,b)=>String(b.at).localeCompare(String(a.at)));
      if(name==="routes")routeRecords=arr;if(name==="documents")shippingDocuments=arr;
      if(name==="claims")claims=arr;if(name==="notifications")notifications=arr;
      if(name==="branches")branches=arr;if(name==="quotes")quotes=arr;
      if(!$('appScreen').classList.contains('hidden'))render();
    },err=>console.error(name,err));
    unsubs.push(unsub);
  }
}

