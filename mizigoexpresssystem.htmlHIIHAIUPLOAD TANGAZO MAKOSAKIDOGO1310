<!-- ═══ AUTH ═══ -->
<div class="auth-screen hidden" id="authScreen">
  <div class="auth-left">
    <i class="fa-solid fa-truck-fast" style="font-size:40px;color:var(--gold);margin-bottom:12px"></i>
    <div class="auth-brand">Mizigo Express</div>
    <div class="auth-tagline">Poka. Fuatilia. Safirisha. Wasilisha.</div>
    <div class="auth-feats">
      <div class="auth-ft"><i class="fa-solid fa-inbox"></i> Kupokea na kusajili mizigo</div>
      <div class="auth-ft"><i class="fa-solid fa-warehouse"></i> Usimamizi wa ghala</div>
      <div class="auth-ft"><i class="fa-solid fa-truck"></i> Fleet, dispatch & GPS</div>
      <div class="auth-ft"><i class="fa-solid fa-location-dot"></i> POD, OTP & e-signature</div>
      <div class="auth-ft"><i class="fa-solid fa-mobile-screen"></i> M-Pesa · Tigo · Airtel · Card</div>
      <div class="auth-ft"><i class="fa-solid fa-globe"></i> Sarafu 6 & Nchi 12+</div>
    </div>
  </div>
  <div class="auth-right">
    <div class="auth-wrap">
      <div style="display:flex;justify-content:flex-end;gap:6px;margin-bottom:10px;flex-wrap:wrap">
        <select id="authCurr" style="padding:5px 8px;background:var(--bg3);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:11px" onchange="activeCurr=this.value"><option value="TZS">🇹🇿 TZS</option><option value="KES">🇰🇪 KES</option><option value="UGX">🇺🇬 UGX</option><option value="RWF">🇷🇼 RWF</option><option value="USD">🇺🇸 USD</option><option value="EUR">🇪🇺 EUR</option></select>
        <select id="authLang" style="padding:5px 8px;background:var(--bg3);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:11px" onchange="setLang(this.value)"><option value="sw">🇹🇿 Kiswahili</option><option value="en">🇬🇧 English</option><option value="zh">🇨🇳 中文</option><option value="fr">🇫🇷 Français</option></select>
      </div>
      <div class="auth-tabs">
        <button class="auth-tab active" onclick="switchAuthTab('login')">Ingia</button>
        <button class="auth-tab" onclick="switchAuthTab('signup')">Jisajili</button>
      </div>
      <div class="auth-err" id="authErr"><i class="fa-solid fa-circle-exclamation"></i><span id="authErrMsg"></span></div>
      <form class="auth-form active" id="loginForm" onsubmit="handleLogin(event)">
        <div class="fg"><label data-t="email">Barua pepe <span class="req">*</span></label><div class="iw"><i class="fa-solid fa-envelope"></i><input class="fi" type="email" id="loginEmail" required placeholder="you@company.com"></div></div>
        <div class="fg"><label data-t="password">Nenosiri <span class="req">*</span></label><div class="iw"><i class="fa-solid fa-lock"></i><input class="fi" type="password" id="loginPw" required placeholder="••••••••"><button type="button" class="tog-pw" onclick="togglePw('loginPw',this)"><i class="fa-solid fa-eye"></i></button></div></div>
        <button class="btn-auth" type="submit"><i class="fa-solid fa-right-to-bracket"></i> Ingia</button>
        <div style="text-align:right;margin-top:10px"><a href="#forgot-password" onclick="event.preventDefault();forgotPassword('loginEmail')" style="color:var(--gold);font-size:12px;font-weight:700;text-decoration:none"><i class="fa-solid fa-key"></i> Umesahau nenosiri? / Forgot password</a></div>
      </form>
      <form class="auth-form" id="signupForm" onsubmit="handleSignup(event)"><p id="selectedPlanLabel" style="margin-bottom:12px;color:var(--gold);font-size:12px">Mpango uliochaguliwa: Starter — $29/mo</p>
        <div class="fg"><label data-t="company">Jina la Kampuni <span class="req">*</span></label><div class="iw"><i class="fa-solid fa-building"></i><input class="fi" type="text" id="signupBiz" required placeholder="Mizigo Express Ltd"></div></div>
        <div class="fg"><label data-t="fullname">Jina lako <span class="req">*</span></label><div class="iw"><i class="fa-solid fa-user"></i><input class="fi" type="text" id="signupName" required placeholder="Juma Hassan"></div></div>
        <div class="fg"><label data-t="email">Barua pepe <span class="req">*</span></label><div class="iw"><i class="fa-solid fa-envelope"></i><input class="fi" type="email" id="signupEmail" required placeholder="you@company.com"></div></div>
        <div class="fg"><label data-t="password">Nenosiri <span class="req">*</span></label><div class="iw"><i class="fa-solid fa-lock"></i><input class="fi" type="password" id="signupPw" required placeholder="Angalau herufi 8" minlength="8"><button type="button" class="tog-pw" onclick="togglePw('signupPw',this)"><i class="fa-solid fa-eye"></i></button></div></div>
        <div class="fg"><label data-t="phone">Namba ya simu</label><div class="iw"><i class="fa-solid fa-phone"></i><input class="fi" type="tel" id="signupPhone" placeholder="+255 700 000 000"></div></div>
        <div class="fg"><label data-t="country">Nchi</label><div class="iw"><i class="fa-solid fa-globe"></i><select class="fi" id="signupCountry"><option>Tanzania</option><option>Kenya</option><option>Uganda</option><option>Rwanda</option><option>Burundi</option><option>DRC</option><option>Nigeria</option><option>Ghana</option><option>South Africa</option><option>Egypt</option><option>Dubai</option><option>China</option></select></div></div>
        <button class="btn-auth" type="submit"><i class="fa-solid fa-user-plus"></i> Unda Akaunti</button>
      </form>
      <button class="btn btn-o btn-sm" style="width:100%;margin-top:10px" onclick="startDemo()"><i class="fa-solid fa-play"></i> Jaribu Demo</button>
      <div class="auth-ft-link">Rudi <a onclick="showLanding()">ukurasa wa mwanzo</a></div>
    </div>
  </div>
</div>

