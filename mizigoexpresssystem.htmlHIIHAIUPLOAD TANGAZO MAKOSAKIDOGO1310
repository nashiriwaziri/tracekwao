function doCalc(){
  const w=Number($('calcW').value)||0,type=$('calcType').value;
  const rates={road:1200,air:8500,rail:800};
  const base=w*(rates[type]||rates.road);
  const fuel=Math.round(base*0.15),handling=Math.round(base*0.08),total=base+fuel+handling;
  $('calcResult').innerHTML=`<div class="calc-result"><p>${t('calc_result')}</p><span>${money(total)}</span></div>
  <div style="margin-top:12px;display:grid;gap:6px;font-size:12px;color:var(--text2)">
    <div style="display:flex;justify-content:space-between"><span>Usafiri msingi</span><span>${money(base)}</span></div>
    <div style="display:flex;justify-content:space-between"><span>Mafuta (${(0.15*100).toFixed(0)}%)</span><span>${money(fuel)}</span></div>
    <div style="display:flex;justify-content:space-between"><span>Ushughulikiaji (${(0.08*100).toFixed(0)}%)</span><span>${money(handling)}</span></div>
    <div style="display:flex;justify-content:space-between;border-top:1px solid var(--border);padding-top:6px;color:var(--text);font-weight:700"><span>JUMLA</span><span>${money(total)}</span></div>
  </div>`;
}

