  await fb.setDoc(fb.doc(fb.db,'systemAds',ad.id),ad);toast('Tangazo limechapishwa.','s');$('sysAdForm').reset();$('sysAdPreview').classList.add('hidden');renderSystemAdList();renderPublicShowcase()
 }catch(err){console.error('System ad upload failed',err);toast('Upload imeshindikana: '+friendlyError(err),'e')}
 finally{if(btn){btn.disabled=false;btn.innerHTML='<i class="fa-solid fa-cloud-arrow-up"></i> Pakia na Chapisha'}}
}
async function renderSystemAdList(){const el=$('sysAdList');if(!el||!fb)return;try{const snap=await fb.getDocs(fb.collection(fb.db,'systemAds'));el.innerHTML=snap.docs.map(d=>{const a=d.data();return `<div class="sa-ad-item"><img src="${esc(a.imageUrl||'')}" style="width:76px;height:54px;object-fit:cover;border-radius:8px" alt=""><div class="sa-ad-info"><h5>${esc(a.title||'Tangazo')}</h5><p>${esc(a.status||'Published')} · ${df(a.createdAt)}</p><p>${esc(a.description||'')}</p></div><button class="btn btn-d btn-xs" onclick="deleteSystemAd('${esc(d.id)}','${esc(a.storagePath||'')}')">Futa</button></div>`}).join('')||'<p style="color:var(--text2);font-size:12px">Hakuna matangazo yaliyoundwa.</p>'}catch(e){console.error(e);el.textContent='Imeshindikana kusoma matangazo. Kagua Firestore Rules.'}}
async function deleteSystemAd(id,path){if(!isSuperAdmin||!fb||!confirm('Futa tangazo hili kabisa?'))return;try{await fb.deleteDoc(fb.doc(fb.db,'systemAds',id));if(path)try{await fb.deleteObject(fb.ref(fb.storage,path))}catch(e){console.warn('Storage object could not be removed',e)}renderSystemAdList();renderPublicShowcase();toast('Tangazo limefutwa.','s')}catch(e){toast(friendlyError(e),'e')}}
const renderPublicShowcaseBase=renderPublicShowcase;
renderPublicShowcase=async function(){const g=$('pubAdsGrid');if(!g)return;try{if(fb){const snap=await fb.getDocs(fb.query(fb.collection(fb.db,'systemAds'),fb.where('status','==','Published')));const ads=snap.docs.map(d=>d.data());if(ads.length){g.innerHTML=ads.map(a=>`<div class="pub-card">${a.imageUrl?`<img class="pub-img" src="${esc(a.imageUrl)}" alt="${esc(a.title)}">`:'<div class="pub-ph"><i class="fa-solid fa-bullhorn"></i></div>'}<div class="pub-body"><h4>${esc(a.title)}</h4><p>${esc(a.description||'')}</p>${a.price?`<span class="pub-price">${esc(a.price)}</span>`:''}</div></div>`).join('');return}}}catch(err){console.warn(err)}renderPublicShowcaseBase()};

/* ═══ INIT ═══ */
window.onload=async()=>{
  plantLogos();
  renderFeatureGrid();
  renderPublicShowcase();
  applyTranslations();
  await initFirebase();
};
</script>
