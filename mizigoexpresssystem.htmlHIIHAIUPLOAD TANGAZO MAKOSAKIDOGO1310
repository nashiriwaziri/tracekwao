async function initFirebase(){
  if(!FIREBASE_ENABLED){console.log("Firebase config contains placeholders — Demo mode only.");$('fbText').textContent=t('toast_demo');return}
  try{
    const appMod=await import("https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js");
    const authMod=await import("https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js");
    const dbMod=await import("https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js");
    const storageMod=await import("https://www.gstatic.com/firebasejs/10.12.0/firebase-storage.js");
    const app=appMod.initializeApp(FIREBASE_CONFIG);
    const auth=authMod.getAuth(app);
    const db=dbMod.getFirestore(app);
    const storage=storageMod.getStorage(app);
    fb={...authMod,...dbMod,...storageMod,auth,db,storage};

    fb.onAuthStateChanged(auth,async user=>{
      if(user){
        // Avoid an auth-observer race while company records are being created.
        if(accountProvisioning) return;
        CU={uid:user.uid,email:user.email,name:user.displayName||user.email,displayName:user.displayName||user.email};
        if([SUPER_ADMIN_EMAIL,"developer@mizgox.app"].includes(String(user.email||'').toLowerCase())){
          isSuperAdmin=true;isDemo=false;CR='superadmin';
          BD={id:"super-admin-workspace",name:"MIZIGO EXPRESS · SYSTEM CONTROL",country:"Tanzania",plan:"Enterprise",status:"Active",createdAt:ts()};
          activeCompanyId="super-admin-workspace";
          $('fbText').textContent="Firebase · Super Administrator";$('fbDot').style.background='var(--danger)';
          // Show a usable control panel immediately; cloud data loads after the shell is visible.
          hideAll();$('superScreen').classList.remove('hidden');$('superLogin').classList.add('hidden');$('superPanel').classList.remove('hidden');
          $('superBody').innerHTML='<div class="super-card"><h3><i class="fa-solid fa-spinner fa-spin"></i> Inafungua Control Panel...</h3><p>Inapakia taarifa za mfumo. Tafadhali subiri.</p></div>';
          plantLogos();
          try{renderSuperAdmin()}catch(renderErr){console.error('Initial Super Admin panel render failed:',renderErr)}
          loadSuperAdminData().then(()=>{if(isSuperAdmin){renderSuperAdmin();toast('Control Panel ya Super Administrator iko tayari.','s')}}).catch(err=>{console.error('Super Admin dashboard loading failed:',err);if(isSuperAdmin)toast('Panel imefunguka, lakini baadhi ya data hazikupatikana. Kagua Firebase Rules.','e')});
          return;
        }
        isSuperAdmin=false;
        await loadCloudWorkspace(user);
      }else if(!isDemo){CU=null;isSuperAdmin=false;showLanding();plantLogos()}
    });
    $('fbText').textContent=t('toast_firebase');$('fbDot').style.background='var(--success)';
    console.log("Firebase initialized — project:",FIREBASE_CONFIG.projectId);
  }catch(e){console.error("Firebase init error:",e);showAuthErr("Firebase could not initialize: "+e.message)}
}

