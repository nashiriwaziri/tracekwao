window.submitAddRepayment=async e=>{
  e.preventDefault();
  const lid=$('arLoan').value,loan=LC.find(l=>l.id===lid);if(!loan)return showToast('Select loan','error');
  const amt=Number($('arAmount').value),bal=getLoanBalance(loan);
  if(amt>bal+1)return showToast(`Amount exceeds balance of ${fmt(bal)}`,'error');
  const m=MC.find(x=>x.id===loan.memberId);
  try{
    /* Record repayment */
    await fsAdd(['groups',CGI,'repayments'],{loanId:loan.id,memberId:loan.memberId,memberName:loan.memberName||memberName(m),nida:loan.nida||m?.nida||'',amount:amt,date:$('arDate').value,method:$('arMethod').value,notes:$('arNotes').value,createdAt:serverTimestamp()});
    /* Update loan: repaid increases, status may change to PAID */
    const newRep=(Number(loan.repaid)||0)+amt;
    const loanTot=(Number(loan.amount)||0)+(Number(loan.interestAmount)||0);
    const newStatus=newRep>=loanTot?'PAID':'PARTIALLY_PAID';
    await fsUpdate(['groups',CGI,'loans',loan.id],{repaid:newRep,lastPaymentDate:$('arDate').value,status:newStatus});
    closeModal('formModal');
    if(m){const tl=trafficStatus(m);showToast(`Repayment recorded! Status: ${tl.label}`,'success');}else showToast('Repayment recorded!','success');
    renderTab(currentTab);
  }catch(err){showToast('Failed: '+err.message,'error');}
};

