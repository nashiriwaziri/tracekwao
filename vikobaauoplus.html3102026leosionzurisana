};

/* Overlays & outside-click close sidebar */
document.addEventListener('DOMContentLoaded',()=>{
  const ov=$('sidebarOverlay');
  if(ov){ov.addEventListener('click',closeSidebar);ov.addEventListener('touchstart',e=>{e.preventDefault();closeSidebar();},{passive:false});}
