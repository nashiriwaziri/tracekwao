/* ===== FIRESTORE HELPERS ===== */
async function fsSet(p,d){await setDoc(doc(db,...p),{...d},{merge:true});}
async function fsAdd(c,d){return await addDoc(collection(db,...c),{...d,createdAt:serverTimestamp()});}
async function fsUpdate(p,d){await updateDoc(doc(db,...p),d);}
