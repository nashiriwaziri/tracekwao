window.submitAddMember=async e=>{
  e.preventDefault();
  const fname=$('amFname').value.trim(),mname=$('amMname').value.trim(),lname=$('amLname').value.trim();
  const nida=$('amNida').value.trim(),phone=$('amPhone').value.trim();
  const mid=$('amMemberId').value.trim(),pw=$('amPassword').value,role=$('amRole').value;
  if(!fname||!lname||!nida||!phone||!pw)return showToast('Fill required fields','error');
  if(MC.find(m=>m.nida===nida))return showToast('NIDA already exists in this group','error');
  try{
    const nid=uid();
    await fsSet(['groups',CGI,'members',nid],{id:nid,firstName:fname,middleName:mname||'',lastName:lname,nida:nida,phone:phone,role:role,password:pw,memberId:mid,status:'active',entranceFeePaid:false,totalSavings:0,joinDate:today(),createdAt:serverTimestamp()});
    $('mcMemberId').innerText=mid;$('mcGroupId').innerText=CGI;$('mcNida').innerText=nida;$('mcPassword').innerText=pw;
    closeModal('formModal');openModal('memberCreatedModal');showToast('Member registered!','success');renderTab(currentTab);
  }catch(err){showToast('Failed: '+err.message,'error');}
};

