};
window.openModal=id=>{const e=$(id);if(e)e.classList.add('show');};
window.closeModal=id=>{const e=$(id);if(e)e.classList.remove('show');};

function closeSidebar(){const s=$('sidebar'),o=$('sidebarOverlay');if(s)s.classList.remove('open');if(o)o.classList.remove('show');}
window.toggleSidebar=()=>{
  const s=$('sidebar'),o=$('sidebarOverlay');if(!s)return;
  if(s.classList.contains('open')){s.classList.remove('open');if(o)o.classList.remove('show');}
