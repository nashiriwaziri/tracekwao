  h+=`<button class="nav-btn active" data-tab="dashboard" onclick="switchTab('dashboard',this)"><i class="fa-solid fa-gauge-high"></i> Dashboard</button>`;
  h+='<div class="nav-label">Group</div>';
  h+=`<button class="nav-btn" data-tab="members" onclick="switchTab('members',this)"><i class="fa-solid fa-users"></i> Members</button>`;
  h+=`<button class="nav-btn" data-tab="savings" onclick="switchTab('savings',this)"><i class="fa-solid fa-piggy-bank"></i> Savings</button>`;
  h+=`<button class="nav-btn" data-tab="shares" onclick="switchTab('shares',this)"><i class="fa-solid fa-chart-pie"></i> Shares</button>`;
  h+='<div class="nav-label">Finance</div>';
  h+=`<button class="nav-btn" data-tab="loans" onclick="switchTab('loans',this)"><i class="fa-solid fa-hand-holding-dollar"></i> Loans</button>`;
  h+=`<button class="nav-btn" data-tab="repayments" onclick="switchTab('repayments',this)"><i class="fa-solid fa-money-bill-transfer"></i> Repayments</button>`;
  h+=`<button class="nav-btn" data-tab="traffic" onclick="switchTab('traffic',this)"><i class="fa-solid fa-traffic-light"></i> Traffic Light</button>`;
