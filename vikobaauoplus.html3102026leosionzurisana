/* ===== SIGN UP (Group Registration) ===== */
 $('signUpForm').addEventListener('submit',async e=>{
  e.preventDefault();
  const fname=$('suFname').value.trim(),mname=$('suMname').value.trim(),lname=$('suLname').value.trim();
  const nida=$('suNida').value.trim(),phone=$('suPhone').value.trim();
  const groupType=$('suGroupType').value,groupName=$('suGroupName').value.trim();
  const country=$('suCountry').value,password=$('suPassword').value;
  if(!fname||!lname||!nida||!phone||!groupType||!groupName||!country||!password)return showToast('Fill all required fields','error');
  if(password.length<6)return showToast('Password must be at least 6 characters','error');
  const btn=$('suSubmitBtn');btn.disabled=true;btn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Creating...';
  try{
    const email=`${nida}@cscms.local`;
    const userCred=await createUserWithEmailAndPassword(secAuth,email,password);
    const gid=userCred.user.uid;
    const chairMid=`${gid}_chair`;
    await fsSet(['groups',gid],{uid:gid,groupName,groupType,country,currency:country==='Tanzania'?'TZS':country==='Kenya'?'KES':'USD',chairFirstName:fname,chairMiddleName:mname,chairLastName:lname,chairNida:nida,chairPhone:phone,status:'trial',plan:'free',planExpires:Timestamp.fromDate(new Date(Date.now()+30*86400000)),memberCount:1,maxMembers:PLAN_LIMITS.free,createdAt:serverTimestamp(),shareValue:10000,sharePrice:10000,entranceFee:5000,maxLoanMultiplier:3,interestRate:10,latePaymentPenalty:5,meetingDay:'Thursday'});
    await fsSet(['groups',gid,'members',chairMid],{id:chairMid,firstName:fname,middleName:mname||'',lastName:lname,nida:nida,phone:phone,role:'chair',password:password,memberId:generateMemberId(groupName),status:'active',entranceFeePaid:false,totalSavings:0,joinDate:today(),createdAt:serverTimestamp()});
    $('displayedUserId').innerText=gid;openModal('idReminderModal');showToast('Group registered!','success');
  }catch(err){
    let msg='Registration failed';
    if(err.code==='auth/email-already-in-use')msg='This NIDA is already registered';
    else if(err.code==='auth/weak-password')msg='Password too weak';
    showToast(msg,'error');
  }finally{btn.disabled=false;btn.innerHTML='<i class="fa-solid fa-user-plus"></i> Sign Up';}
});

/* ===== SIGN IN (Group ID + NIDA + Password) ===== */
 $('signInForm').addEventListener('submit',async e=>{
  e.preventDefault();
  const groupId=$('loginGroupId').value.trim(),nida=$('loginNida').value.trim(),password=$('loginPassword').value;
  if(!groupId||!nida||!password)return showToast('Fill all fields','error');
  const btn=$('siSubmitBtn');btn.disabled=true;btn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Signing in...';
  try{
    const gSnap=await getDoc(doc(db,'groups',groupId));
    if(!gSnap.exists())throw new Error('Group ID not found');
    CG=gSnap.data();CGI=groupId;
    const mSnap=await getDocs(collection(db,'groups',groupId,'members'));
    const members=mSnap.docs.map(d=>({id:d.id,...d.data()}));
    const found=members.find(m=>m.nida===nida);
    if(!found)throw new Error('NIDA not found in this group');
    if(found.password!==password)throw new Error('Incorrect password');
    CU=found;MC=members;CR=found.role||'member';
    try{await signInWithEmailAndPassword(auth,`${nida}@cscms.local`,password);}catch(ae){console.warn('Auth note:',ae.message);}
    setupAppNav();showScreen('app');showToast(`Welcome, ${memberName(found)}!`,'success');
    startListeners(groupId);
  }catch(err){showToast(err.message||'Sign in failed','error');}
  finally{btn.disabled=false;btn.innerHTML='<i class="fa-solid fa-right-to-bracket"></i> Sign In';}
});

