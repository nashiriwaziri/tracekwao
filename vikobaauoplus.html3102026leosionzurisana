  n.innerHTML=h;switchTab('dashboard',n.querySelector('.nav-btn'));
}

/* ===== REAL-TIME LISTENERS ===== */
function startListeners(gid){
  unsubFns.forEach(fn=>{try{fn();}catch(e){}});unsubFns=[];
  unsubFns.push(onSnapshot(collection(db,'groups',gid,'members'),s=>{MC=s.docs.map(d=>({id:d.id,...d.data()}));}));
  unsubFns.push(onSnapshot(query(collection(db,'groups',gid,'savings'),orderBy('date','desc')),s=>{SC=s.docs.map(d=>({id:d.id,...d.data()}));}));
  unsubFns.push(onSnapshot(query(collection(db,'groups',gid,'shares'),orderBy('date','desc')),s=>{SHC=s.docs.map(d=>({id:d.id,...d.data()}));}));
  unsubFns.push(onSnapshot(query(collection(db,'groups',gid,'loans'),orderBy('date','desc')),s=>{
    LC=s.docs.map(d=>({id:d.id,...d.data()}));
    LC.forEach(l=>{if(getLoanBalance(l)<=0&&l.status!=='PAID'){fsUpdate(['groups',gid,'loans',l.id],{status:'PAID'}).catch(()=>{});}});
  }));
  /* Repayments listener - auto-update debt & traffic */
  unsubFns.push(onSnapshot(query(collection(db,'groups',gid,'repayments'),orderBy('date','desc')),s=>{
    RC=s.docs.map(d=>({id:d.id,...d.data()}));
    renderTab(currentTab);
  }));
  unsubFns.push(onSnapshot(query(collection(db,'groups',gid,'withdrawals'),orderBy('date','desc')),s=>{WC=s.docs.map(d=>({id:d.id,...d.data()}));}));
  unsubFns.push(onSnapshot(query(collection(db,'groups',gid,'charges'),orderBy('date','desc')),s=>{CC=s.docs.map(d=>({id:d.id,...d.data()}));}));
}

/* ===== TAB SWITCHING ===== */
window.switchTab=(tab,btn)=>{
  currentTab=tab;
  document.querySelectorAll('.nav-btn').forEach(b=>b.classList.remove('active'));
  if(btn)btn.classList.add('active');
  const titles={dashboard:'Dashboard',members:'Members',savings:'Savings',shares:'Shares',loans:'Loans',repayments:'Repayments',traffic:'Traffic Light',settings:'Settings',reports:'Reports'};
  $('pageTitle').innerText=titles[tab]||'Dashboard';
  renderTab(tab);closeSidebar();
};

function renderTab(tab){
  const a=$('contentArea');
  switch(tab){
    case 'dashboard':a.innerHTML=rDashboard();break;
    case 'members':a.innerHTML=rMembers();break;
    case 'savings':a.innerHTML=rSavings();break;
    case 'shares':a.innerHTML=rShares();break;
    case 'loans':a.innerHTML=rLoans();break;
    case 'repayments':a.innerHTML=rRepayments();break;
    case 'traffic':a.innerHTML=rTraffic();break;
    case 'settings':a.innerHTML=CR==='chair'?rSettings():'<p class="small">Access denied</p>';break;
    case 'reports':a.innerHTML=CR==='chair'?rReports():'<p class="small">Access denied</p>';break;
    default:a.innerHTML=rDashboard();
  }
}

/* ===== RENDER: DASHBOARD ===== */
function rDashboard(){
  const tSav=SC.filter(s=>s.type==='DEPOSIT').reduce((a,s)=>a+Number(s.amount||0),0)-SC.filter(s=>s.type==='WITHDRAWAL').reduce((a,s)=>a+Number(s.amount||0),0);
  const tShares=calcShares_All();
  const tLoans=LC.filter(l=>['DISBURSED','PARTIALLY_PAID'].includes(l.status)).reduce((a,l)=>a+Number(l.amount||0),0);
  const tOut=MC.reduce((s,m)=>s+getMemberOutstanding(m.id),0);
  const tRep=RC.reduce((a,r)=>a+Number(r.amount||0),0);
  const tlC={green:0,yellow:0,orange:0,red:0};
  MC.forEach(m=>{const t=trafficStatus(m);if(tlC.hasOwnProperty(t.key))tlC[t.key]++;});
  return`
  <div class="metrics-grid">
    <div class="card metric-card"><div class="metric-icon" style="background:rgba(22,169,121,.12);color:var(--p2)"><i class="fa-solid fa-users"></i></div><div><h3>${MC.length}</h3><p>Members</p></div></div>
    <div class="card metric-card"><div class="metric-icon" style="background:rgba(59,130,246,.12);color:#60a5fa"><i class="fa-solid fa-piggy-bank"></i></div><div><h3>${fmt(tSav)}</h3><p>Total Savings</p></div></div>
    <div class="card metric-card"><div class="metric-icon" style="background:rgba(139,92,246,.12);color:#c084fc"><i class="fa-solid fa-chart-pie"></i></div><div><h3>${fmt(tShares)}</h3><p>Total Shares</p></div></div>
    <div class="card metric-card"><div class="metric-icon" style="background:rgba(245,158,11,.12);color:#ffc857"><i class="fa-solid fa-hand-holding-dollar"></i></div><div><h3>${fmt(tLoans)}</h3><p>Loan Portfolio</p></div></div>
    <div class="card metric-card"><div class="metric-icon" style="background:rgba(239,68,68,.12);color:#ff7b85"><i class="fa-solid fa-scale-unbalanced"></i></div><div><h3>${fmt(tOut)}</h3><p>Outstanding Debt</p></div></div>
    <div class="card metric-card"><div class="metric-icon" style="background:rgba(34,197,94,.12);color:#55e1ae"><i class="fa-solid fa-money-bill-transfer"></i></div><div><h3>${fmt(tRep)}</h3><p>Total Repaid</p></div></div>
  </div>
  <div class="card" style="margin-bottom:18px">
    <div class="section-head"><h3><i class="fa-solid fa-traffic-light" style="color:var(--p2)"></i> Traffic Light Summary</h3><button class="btn outline btn-sm" onclick="switchTab('traffic',document.querySelector('[data-tab=traffic]'))"><i class="fa-solid fa-arrow-right"></i> Full Dashboard</button></div>
    <div class="tl-summary">
      <div class="tl-summary-card tl-green-card"><h3 style="color:#22c55e">${tlC.green}</h3><p>On Time</p></div>
      <div class="tl-summary-card tl-yellow-card"><h3 style="color:#eab308">${tlC.yellow}</h3><p>Late</p></div>
      <div class="tl-summary-card tl-orange-card"><h3 style="color:#f97316">${tlC.orange}</h3><p>Prev Chronic</p></div>
      <div class="tl-summary-card tl-red-card"><h3 style="color:#ef4444">${tlC.red}</h3><p>Chronic</p></div>
    </div>
  </div>`;
}
function calcShares_All(){return SHC.filter(s=>(s.type||'BUY')!=='SELL').reduce((a,s)=>a+Number(s.amount||0),0)-SHC.filter(s=>(s.type||'BUY')==='SELL').reduce((a,s)=>a+Number(s.amount||0),0);}

/* ===== RENDER: MEMBERS ===== */
function rMembers(){
  const isC=CR==='chair';
  const rows=MC.map(m=>{
    const sav=memberSavings(m.id),sh=calcShares(m.id),debt=getMemberOutstanding(m.id);
    const tl=trafficStatus(m);
    return`<tr><td>${m.memberId||m.id.substring(0,10)}</td><td>${memberName(m)}</td><td>${m.nida||'N/A'}</td><td>${fmt(sav)}</td><td>${fmt(sh)}</td><td style="color:${debt>0?'var(--red)':'var(--p2)'}">${fmt(debt)}</td><td><span class="${tl.cls}"></span> <span class="tiny">${tl.label}</span></td><td>${sb(m.role||'member')}</td><td>${isC?`<button class="btn outline btn-sm" onclick="editMember('${m.id}')"><i class="fa-solid fa-pen"></i></button> <button class="btn danger btn-sm" onclick="deleteMember('${m.id}')"><i class="fa-solid fa-trash"></i></button>`:''}</td></tr>`;
  }).join('');
  return`<div class="section-head"><h2>Members (${MC.length})</h2>${isC?`<button class="btn primary" onclick="openAddMemberModal()"><i class="fa-solid fa-user-plus"></i> Add Member</button>`:''}</div><div class="table-wrap"><table class="table"><thead><tr><th>Member ID</th><th>Name</th><th>NIDA</th><th>Savings</th><th>Shares</th><th>Debt</th><th>Status</th><th>Role</th><th>Actions</th></tr></thead><tbody>${rows||'<tr><td colspan="9" style="text-align:center;color:var(--muted)">No members</td></tr>'}</tbody></table></div>`;
}

