window.updateRepayInfo=()=>{
  const lid=$('arLoan')?.value;if(lid&&$('arInfo')){const l=LC.find(x=>x.id===lid);if(l)$('arInfo').innerText=`Current balance: ${fmt(getLoanBalance(l))}`;}
