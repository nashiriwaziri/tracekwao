/* ===== PDF ===== */
async function genPDF(ti,h,ro){
  const{jsPDF}=window.jspdf;const doc=new jsPDF();
  doc.setFontSize(18);doc.setTextColor(22,169,121);doc.text(ti,14,22);
  doc.setFontSize(9);doc.setTextColor(140,160,180);doc.text(`${CG?.groupName||'Group'} | ${today()}`,14,30);
  doc.setDrawColor(33,52,77);doc.line(14,36,196,36);
  if(h)h(doc);
  if(ro&&ro.length)doc.autoTable({startY:42,head:ro[0],body:ro.slice(1),theme:'grid',headStyles:{fillColor:[13,25,41],textColor:[140,160,180]},styles:{fontSize:8,cellPadding:3}});
  doc.save(`${ti.replace(/\s+/g,'_')}_${today()}.pdf`);
}

