<script type="module">
import{initializeApp}from"https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
import{getAuth,createUserWithEmailAndPassword,signInWithEmailAndPassword,signOut}from"https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";
import{getFirestore,enableMultiTabIndexedDbPersistence,collection,doc,setDoc,addDoc,getDoc,getDocs,updateDoc,deleteDoc,onSnapshot,query,orderBy,serverTimestamp,Timestamp}from"https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";

const firebaseConfig={apiKey:"AIzaSyDSUs6uUjQTPQOkUPcIp2u8Rw9NJVnQOfo",authDomain:"ncrs2-f8da9.firebaseapp.com",projectId:"ncrs2-f8da9",storageBucket:"ncrs2-f8da9.firebasestorage.app",messagingSenderId:"436069918682",appId:"1:436069918682:web:70b56c627315bc782102e3"};
const fbApp=initializeApp(firebaseConfig);
const secApp=initializeApp(firebaseConfig,"Secondary");
const auth=getAuth(fbApp);
const secAuth=getAuth(secApp);
const db=getFirestore(fbApp);
try{await enableMultiTabIndexedDbPersistence(db);}catch(e){}

const SA_UID="P9jl4qlk64gXXkk7tegabJpXwaB2";
const SYS_LOGO="vikobabrand-icon4.svg - Copy.png";
const PLAN_LIMITS={free:15,basic:50,pro:500,enterprise:999999};

/* ===== I18N ===== */
const i18n={en:{signIn:'Sign In',signUp:'Sign Up'},sw:{signIn:'Ingia',signUp:'Jisajili'}};
let curLang='en';
function t(k){return(i18n[curLang]&&i18n[curLang][k])||i18n.en[k]||k;}

/* ===== STATE ===== */
let CU=null,CG=null,CR='chair',CGI=null;
let MC=[],SC=[],SHC=[],LC=[],RC=[],WC=[],CC=[],PC=[],DC=[];
let currentTab='dashboard';
let unsubFns=[];
let SGroups=[],sTab='sa-dashboard';
let sysSet={branding:{logoUrl:SYS_LOGO,logoEnabled:true},languages:[{code:'en',name:'English',enabled:true},{code:'sw',name:'Kiswahili',enabled:true}]};

/* ===== UTILITIES ===== */
const $=id=>document.getElementById(id);
const uid=()=>`${Date.now().toString(36)}_${Math.random().toString(36).substr(2,5)}`;
const today=()=>new Date().toISOString().split('T')[0];
const fmt=n=>(n||0).toLocaleString();
const fD=d=>{if(!d)return'N/A';if(d instanceof Timestamp)return d.toDate().toLocaleDateString();if(d&&d.seconds)return new Date(d.seconds*1000).toLocaleDateString();try{return new Date(d).toLocaleDateString();}catch(e){return'N/A';}};
const sb=s=>{const m={active:'ok',trial:'info-b',PENDING:'warn',APPROVED:'info-b',REJECTED:'bad',DISBURSED:'ok',PAID:'ok',PARTIALLY_PAID:'warn',CANCELLED:'bad',free:'info-b',basic:'ok',pro:'warn',enterprise:'purple-b'};return`<span class="badge ${m[s]||'warn'}">${s||'N/A'}</span>`;};

function memberName(m){if(!m)return'Unknown';return`${m.firstName||''} ${m.middleName?' '+m.middleName+' ':''} ${m.lastName||''}`.trim();}
function generateMemberId(gname){const p=(gname||'GRP').substring(0,3).toUpperCase();return`${p}-M${String(MC.length+1).padStart(4,'0')}`;}
function generatePassword(){const c='ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789';let p='';for(let i=0;i<8;i++)p+=c[Math.floor(Math.random()*c.length)];return p;}

/* ===== CALCULATIONS ===== */
function memberSavings(mid){return SC.filter(s=>s.memberId===mid).reduce((a,s)=>a+(s.type==='DEPOSIT'?Number(s.amount||0):-(Number(s.amount||0))),0);}
function calcShares(mid){return SHC.filter(s=>s.memberId===mid&&(s.type||'BUY')!=='SELL').reduce((a,s)=>a+Number(s.amount||0),0)-SHC.filter(s=>s.memberId===mid&&(s.type||'BUY')==='SELL').reduce((a,s)=>a+Number(s.amount||0),0);}
function getLoanBalance(l){const tot=(Number(l.amount)||0)+(Number(l.interestAmount)||0);const rep=Number(l.repaid)||0;return Math.max(0,tot-rep);}
function getMemberOutstanding(mid){return LC.filter(l=>l.memberId===mid&&!['REJECTED','CANCELLED','PAID'].includes(l.status)).reduce((s,l)=>s+getLoanBalance(l),0);}
function getLoanLimit(mid){return memberSavings(mid)*(Number(CG?.maxLoanMultiplier||3)||3);}
function getAvailableCredit(mid){return Math.max(0,getLoanLimit(mid)-getMemberOutstanding(mid));}

/* ===== TRAFFIC LIGHT ===== */
function trafficStatus(member){
  const id=member.id;
  const loans=LC.filter(l=>l.memberId===id);
  if(!loans.length)return{key:'none',label:'No loan history',cls:''};
  const now=Date.now();
  let chronic=false,prevChronic=false,late=false,onTime=false;
  loans.forEach(l=>{
    const due=l.dueDate?new Date(l.dueDate).getTime():null;
    const bal=getLoanBalance(l);
    const paid=bal<=0;
    const age=due?Math.max(0,Math.floor((now-due)/86400000)):0;
    if(!paid&&due&&age>90)chronic=true;
    if(paid&&l.dueDate&&l.lastPaymentDate){
      const pd=new Date(l.lastPaymentDate).getTime();
      if(pd>due)late=true;else onTime=true;
      if(pd-due>90*86400000)prevChronic=true;
    }else if(!paid&&due&&age>0)late=true;
  });
  if(chronic)return{key:'red',label:'Chronic debtor',cls:'traffic-dot traffic-red'};
  if(prevChronic)return{key:'orange',label:'Previous chronic',cls:'traffic-dot traffic-orange'};
  if(late)return{key:'yellow',label:'Late payment',cls:'traffic-dot traffic-yellow'};
  if(onTime)return{key:'green',label:'Pays on time',cls:'traffic-dot traffic-green'};
  return{key:'none',label:'No classified history',cls:'traffic-dot'};
}

/* ===== SCREEN / SIDEBAR / MODAL ===== */
window.showScreen=id=>{
  ['landing','memberRegScreen','auth','app','super'].forEach(s=>{const e=$(s);if(e)e.classList.add('hidden');});
