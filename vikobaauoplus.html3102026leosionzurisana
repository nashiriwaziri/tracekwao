function rTraffic(){
  const tlC={green:0,yellow:0,orange:0,red:0,none:0};
  MC.forEach(m=>{const t=trafficStatus(m);if(tlC.hasOwnProperty(t.key))tlC[t.key]++;});
  const debtors=MC.filter(m=>getMemberOutstanding(m.id)>0).sort((a,b)=>{const o={red:0,orange:1,yellow:2,green:3,none:4};return(o[trafficStatus(a).key]||5)-(o[trafficStatus(b).key]||5);});
  const dRows=debtors.map(m=>{const d=getMemberOutstanding(m.id),tl=trafficStatus(m);const rep=RC.filter(r=>r.memberId===m.id).reduce((s,r)=>s+Number(r.amount||0),0);const loans=LC.filter(l=>l.memberId===m.id&&!['REJECTED','CANCELLED','PAID'].includes(l.status));return`<tr><td><span class="${tl.cls}"></span></td><td>${m.memberId||m.id.substring(0,10)}</td><td>${memberName(m)}</td><td>${m.nida||'N/A'}</td><td style="color:var(--red);font-weight:700">${fmt(d)}</td><td style="color:var(--p2)">${fmt(rep)}</td><td>${loans.length}</td><td><span class="tiny">${tl.label}</span></td></tr>`;}).join('');
  return`
  <div class="section-head"><h2><i class="fa-solid fa-traffic-light" style="color:var(--p2)"></i> Traffic Light Dashboard</h2><span class="small">Auto-updated from repayment records</span></div>
  <div class="tl-summary">
    <div class="tl-summary-card tl-green-card"><h3 style="color:#22c55e">${tlC.green}</h3><p>On Time</p></div>
    <div class="tl-summary-card tl-yellow-card"><h3 style="color:#eab308">${tlC.yellow}</h3><p>Late</p></div>
    <div class="tl-summary-card tl-orange-card"><h3 style="color:#f97316">${tlC.orange}</h3><p>Prev Chronic</p></div>
    <div class="tl-summary-card tl-red-card"><h3 style="color:#ef4444">${tlC.red}</h3><p>Chronic</p></div>
  </div>
  <div class="card"><div class="section-head"><h3>Wanaodaiwa (Debtors)</h3><span class="badge warn">${debtors.length} with debt</span></div>
  <div class="table-wrap"><table class="table"><thead><tr><th>Status</th><th>Member ID</th><th>Name</th><th>NIDA</th><th>Outstanding</th><th>Repaid</th><th>Loans</th><th>Classification</th></tr></thead><tbody>${dRows||'<tr><td colspan="8" style="text-align:center;color:var(--p2)">No debtors</td></tr>'}</tbody></table></div></div>
  <div class="card" style="margin-top:16px"><div class="flex gap-md" style="align-items:center"><i class="fa-solid fa-link" style="color:var(--p2)"></i><span>Repayments auto-reduce debt. <button class="btn outline btn-sm" onclick="switchTab('repayments',document.querySelector('[data-tab=repayments]'))">View Repayments</button></span></div></div>`;
}

