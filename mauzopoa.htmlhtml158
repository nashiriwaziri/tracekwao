<!-- ============================================ -->
<!-- ===== JAVASCRIPT - 100% MODULAR SDK ===== -->
<!-- ============================================ -->
<script type="module">

/* ===== FIREBASE MODULAR IMPORTS ===== */
import { initializeApp } from 'https://www.gstatic.com/firebasejs/12.12.0/firebase-app.js';

import {
    getAuth,
    onAuthStateChanged,
    signInWithEmailAndPassword,
    createUserWithEmailAndPassword,
    signOut,
    updatePassword,
    sendPasswordResetEmail
} from 'https://www.gstatic.com/firebasejs/12.12.0/firebase-auth.js';

import {
    getFirestore,
    collection,
    doc,
    getDoc,
    getDocs,
    addDoc,
    setDoc,
    updateDoc,
    deleteDoc,
    query,
    where,
    orderBy,
    limit,
    onSnapshot,
    serverTimestamp,
    writeBatch,
    runTransaction
} from 'https://www.gstatic.com/firebasejs/12.12.0/firebase-firestore.js';

import {
    getStorage,
    ref,
    uploadBytes,
    uploadBytesResumable,
    getDownloadURL,
    deleteObject
} from 'https://www.gstatic.com/firebasejs/12.12.0/firebase-storage.js';

/* ===== FIREBASE CONFIGURATION ===== */
const firebaseConfig = {
    apiKey: "AIzaSyDEXAMPLE-REPLACE-ME",
    authDomain: "your-project.firebaseapp.com",
    projectId: "your-project-id",
    storageBucket: "your-project-id.appspot.com",
    messagingSenderId: "123456789",
    appId: "1:123456789:web:abcdef123456"
};

/* ===== SINGLE AUTHORITATIVE INITIALIZATION ===== */
const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);
const storage = getStorage(app);

/* ===== GLOBAL STATE ===== */
let currentUser = null;
let currentUserData = null;
let businessId = null;
let businessData = null;
let products = [];
let suppliers = [];
let customers = [];
let receipts = [];
let debts = [];
let expenses = [];
let employees = [];
let cart = [];
let chatPartnerId = null;
let activeSection = 'dashboard';

/* ===== UNSUBSCRIBE HANDLES ===== */
let productsUnsubscribe = null;
let suppliersUnsubscribe = null;
let customersUnsubscribe = null;
let receiptsUnsubscribe = null;
let debtsUnsubscribe = null;
let expensesUnsubscribe = null;
let employeesUnsubscribe = null;

/* ===== CHART INSTANCES ===== */
let salesChart = null;
let categoriesChart = null;

/* ===== HELPER: requireId ===== */
function requireId(id, label) {
    if (!id || typeof id !== 'string' || id.trim() === '') {
        throw new Error(`${label || 'ID'} inahitajika na haipaswi kuwa tupu.`);
    }
    return id.trim();
}

/* ===== HELPER: safeDoc ===== */
function safeDoc(firestoreDb, collectionName, id) {
    const validId = requireId(id, `${collectionName} ID`);
    return doc(firestoreDb, collectionName, validId);
}

/* ===== HELPER: formatCurrency ===== */
function fmt(n) {
    return Number(n || 0).toLocaleString('sw-TZ');
}

/* ===== HELPER: formatDate ===== */
function fmtDate(d) {
    if (!d) return '-';
    const dt = d.toDate ? d.toDate() : new Date(d);
    return dt.toLocaleDateString('sw-TZ', { day: '2-digit', month: 'short', year: 'numeric' });
}

/* ===== HELPER: formatDateTime ===== */
function fmtDateTime(d) {
    if (!d) return '-';
    const dt = d.toDate ? d.toDate() : new Date(d);
    return dt.toLocaleDateString('sw-TZ', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
}

/* ===== TOAST SYSTEM ===== */
function toast(msg, type = 'i') {
    const c = document.getElementById('toastContainer');
    const t = document.createElement('div');
    t.className = `toast ${type}`;
    const icons = { s: 'fa-check-circle', e: 'fa-exclamation-circle', i: 'fa-info-circle', w: 'fa-exclamation-triangle' };
    t.innerHTML = `<i class="fas ${icons[type] || icons.i}"></i> ${msg}`;
    c.appendChild(t);
    setTimeout(() => { t.style.opacity = '0'; t.style.transform = 'translateX(100%)'; t.style.transition = '0.3s'; setTimeout(() => t.remove(), 300); }, 3500);
}

/* ===== CONFIRM DIALOG ===== */
function showConfirm(title, message, onConfirm, targetName) {
    const c = document.getElementById('confirmContainer');
    c.innerHTML = `
    <div class="confirm-modal" onclick="if(event.target===this)this.remove()">
        <div class="confirm-card">
            <div class="confirm-icon danger"><i class="fas fa-trash-alt"></i></div>
            <h3>${title}</h3>
            <p>${message}</p>
            ${targetName ? `<div class="user-target">${targetName}</div>` : ''}
            <div class="confirm-actions">
                <button class="btn btn-o" onclick="this.closest('.confirm-modal').remove()">Ghairi</button>
                <button class="btn btn-d" id="confirmActionBtn">Futa</button>
            </div>
        </div>
    </div>`;
    document.getElementById('confirmActionBtn').onclick = () => { c.innerHTML = ''; onConfirm(); };
}

/* ===== MODAL HELPERS ===== */
function openModal(id) { document.getElementById(id).classList.add('show'); }
function closeModal(id) { document.getElementById(id).classList.remove('show'); }

/* ===== SIDEBAR ===== */
function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('open');
    document.getElementById('sbBackdrop').classList.toggle('show');
}
function closeSidebar() {
    document.getElementById('sidebar').classList.remove('open');
    document.getElementById('sbBackdrop').classList.remove('show');
}

/* ===== USER DROPDOWN ===== */
function toggleUserDD() { document.getElementById('userDD').classList.toggle('show'); }
function closeUserDD() { document.getElementById('userDD').classList.remove('show'); }
document.addEventListener('click', (e) => {
    if (!e.target.closest('.u-chip')) closeUserDD();
});

/* ===== PASSWORD TOGGLE ===== */
function togglePw(id, icon) {
    const inp = document.getElementById(id);
    if (inp.type === 'password') { inp.type = 'text'; icon.classList.replace('fa-eye', 'fa-eye-slash'); }
    else { inp.type = 'password'; icon.classList.replace('fa-eye-slash', 'fa-eye'); }
}

/* ===== PASSWORD STRENGTH ===== */
function checkPwStr(pw) {
    let score = 0;
    if (pw.length >= 6) score++;
    if (pw.length >= 10) score++;
    if (/[A-Z]/.test(pw)) score++;
    if (/[0-9]/.test(pw)) score++;
    if (/[^A-Za-z0-9]/.test(pw)) score++;
    const bar = document.getElementById('regPwBar');
    const txt = document.getElementById('regPwText');
    const colors = ['#e74c3c', '#e74c3c', '#f39c12', '#f39c12', '#00b894', '#00b894'];
    const labels = ['', 'Nenosiri dhaifu', 'Nenosiri dhaifu', 'Nenosiri ya kawaida', 'Nenosiri nzuri', 'Nenosiri imara sana'];
    bar.style.width = `${Math.min(score, 5) * 20}%`;
    bar.style.background = colors[score] || colors[0];
    txt.textContent = labels[score] || '';
    txt.style.color = colors[score] || colors[0];
}

/* ===== REGISTRATION STEPS ===== */
function regNext(step) {
    document.querySelectorAll('.reg-form-step').forEach(s => s.classList.remove('active'));
    document.querySelectorAll('.reg-step-dot').forEach(d => { d.classList.remove('active', 'done'); });
    document.querySelectorAll('.reg-step-line').forEach(l => l.classList.remove('done'));
    for (let i = 1; i < step; i++) {
        document.getElementById(`regDot${i}`).classList.add('done');
        if (document.getElementById(`regLine${i}`)) document.getElementById(`regLine${i}`).classList.add('done');
    }
    document.getElementById(`regStep${step}`).classList.add('active');
    document.getElementById(`regDot${step}`).classList.add('active');
}

function showRegForm() {
    document.getElementById('loginForm').style.display = 'none';
    document.getElementById('regForm').style.display = 'block';
    regNext(1);
}
function showLoginForm() {
    document.getElementById('loginForm').style.display = 'block';
    document.getElementById('regForm').style.display = 'none';
}

/* ===== AUTH: LOGIN ===== */
async function handleLogin() {
    const email = document.getElementById('loginEmail').value.trim();
    const password = document.getElementById('loginPassword').value;
    document.getElementById('loginEmailErr').classList.remove('show');
    document.getElementById('loginPassErr').classList.remove('show');
    if (!email || !email.includes('@')) { document.getElementById('loginEmailErr').classList.add('show'); return; }
    if (!password || password.length < 6) { document.getElementById('loginPassErr').classList.add('show'); return; }
    const btn = document.getElementById('loginBtn');
    btn.disabled = true;
    btn.innerHTML = '<div class="spinner" style="width:20px;height:20px;border-width:2px"></div> Inaingia...';
    try {
        await signInWithEmailAndPassword(auth, email, password);
        toast('Umengia kwa mafanikio!', 's');
    } catch (err) {
        console.error('[AUTH] Login failed:', err);
        if (err.code === 'auth/user-not-found' || err.code === 'auth/wrong-password' || err.code === 'auth/invalid-credential') {
            document.getElementById('loginPassErr').textContent = 'Barua pepe au nenosiri sio sahihi';
            document.getElementById('loginPassErr').classList.add('show');
        } else if (err.code === 'auth/too-many-requests') {
            toast('Jaribu tena baada ya muda.', 'w');
        } else {
            toast('Hitilafu: ' + err.message, 'e');
        }
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-sign-in-alt"></i> Ingia kwenye Mfumo';
    }
}

/* ===== AUTH: REGISTER ===== */
async function handleRegister() {
    const fname = document.getElementById('regFname').value.trim();
    const lname = document.getElementById('regLname').value.trim();
    const email = document.getElementById('regEmail').value.trim();
    const phone = document.getElementById('regPhone').value.trim();
    const password = document.getElementById('regPass').value;
    const cpass = document.getElementById('regCpass').value;
    const bizName = document.getElementById('regBizName').value.trim();
    const agree = document.getElementById('regAgree').checked;
    document.getElementById('regEmailErr').classList.remove('show');
    document.getElementById('regPhoneErr').classList.remove('show');
    document.getElementById('regCpassErr').classList.remove('show');
    if (!fname || !lname) { toast('Jaza majina yako.', 'w'); regNext(1); return; }
    if (!email || !email.includes('@')) { document.getElementById('regEmailErr').classList.add('show'); regNext(1); return; }
    if (!bizName) { toast('Jaza jina la biashara.', 'w'); regNext(2); return; }
    if (password.length < 6) { toast('Nenosiri lazima iwe wa herufi 6 au zaidi.', 'w'); return; }
    if (password !== cpass) { document.getElementById('regCpassErr').classList.add('show'); return; }
    if (!agree) { toast('Lazima ukubali masharti.', 'w'); return; }
    const btn = document.getElementById('regBtn');
    btn.disabled = true;
    btn.innerHTML = '<div class="spinner" style="width:20px;height:20px;border-width:2px"></div> Inasajili...';
    try {
        const cred = await createUserWithEmailAndPassword(auth, email, password);
        const uid = cred.user.uid;
        const bizRef = doc(collection(db, 'businesses'));
        const bizId = bizRef.id;
        await setDoc(bizRef, {
            name: bizName,
            email: email,
            phone: phone,
            address: '',
            type: '',
            tin: '',
            logo: '',
            status: 'active',
            createdAt: serverTimestamp(),
            updatedAt: serverTimestamp()
        });
        await setDoc(doc(db, 'users', uid), {
            firstName: fname,
            lastName: lname,
            email: email,
            phone: phone,
            role: 'admin',
            businessId: bizId,
            status: 'active',
            createdAt: serverTimestamp(),
            updatedAt: serverTimestamp(),
            lastLogin: serverTimestamp()
        });
        toast('Akaunti imesajiliwa kwa mafanikio!', 's');
    } catch (err) {
        console.error('[AUTH] Registration failed:', err);
        if (err.code === 'auth/email-already-in-use') {
            document.getElementById('regEmailErr').textContent = 'Barua pepe tayari inatumika';
            document.getElementById('regEmailErr').classList.add('show');
            regNext(1);
        } else {
            toast('Hitilafu: ' + err.message, 'e');
        }
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-user-plus"></i> Jisajili Sasa';
    }
}

/* ===== AUTH: LOGOUT ===== */
async function handleLogout() {
    try {
        unsubscribeAll();
        await signOut(auth);
        currentUser = null;
        currentUserData = null;
        businessId = null;
        businessData = null;
        products = [];
        suppliers = [];
        customers = [];
        receipts = [];
        debts = [];
        expenses = [];
        employees = [];
        cart = [];
        document.getElementById('mainApp').classList.add('hidden');
        document.getElementById('loginPage').style.display = 'flex';
        closeSuperAdmin();
    } catch (err) {
        console.error('[AUTH] Logout failed:', err);
        toast('Hitilafu katika kutoka.', 'e');
    }
}

/* ===== UNSUBSCRIBE ALL LISTENERS ===== */
function unsubscribeAll() {
    if (productsUnsubscribe) { productsUnsubscribe(); productsUnsubscribe = null; }
    if (suppliersUnsubscribe) { suppliersUnsubscribe(); suppliersUnsubscribe = null; }
    if (customersUnsubscribe) { customersUnsubscribe(); customersUnsubscribe = null; }
    if (receiptsUnsubscribe) { receiptsUnsubscribe(); receiptsUnsubscribe = null; }
    if (debtsUnsubscribe) { debtsUnsubscribe(); debtsUnsubscribe = null; }
    if (expensesUnsubscribe) { expensesUnsubscribe(); expensesUnsubscribe = null; }
    if (employeesUnsubscribe) { employeesUnsubscribe(); employeesUnsubscribe = null; }
}

/* ===== AUTH STATE OBSERVER ===== */
onAuthStateChanged(auth, async (user) => {
    if (user) {
        currentUser = user;
        try {
            const userSnap = await getDoc(doc(db, 'users', user.uid));
            if (userSnap.exists()) {
                currentUserData = userSnap.data();
                businessId = currentUserData.businessId;
                await updateDoc(doc(db, 'users', user.uid), { lastLogin: serverTimestamp() });
                if (businessId) {
                    const bizSnap = await getDoc(doc(db, 'businesses', businessId));
                    if (bizSnap.exists()) {
                        businessData = bizSnap.data();
                    }
                }
                initApp();
            } else {
                toast('Profaili ya mtumiaji haipatikani.', 'e');
                await signOut(auth);
            }
        } catch (err) {
            console.error('[AUTH] State observer error:', err);
            toast('Hitilafu ya kupakia data.', 'e');
        }
    } else {
        currentUser = null;
        currentUserData = null;
        businessId = null;
        businessData = null;
    }
});

/* ===== INITIALIZE APPLICATION ===== */
function initApp() {
    document.getElementById('loginPage').style.display = 'none';
    document.getElementById('mainApp').classList.remove('hidden');
    const name = `${currentUserData.firstName || ''} ${currentUserData.lastName || ''}`.trim();
    document.getElementById('topName').textContent = name || 'Mtumiaji';
    document.getElementById('topAv').textContent = (name || 'U').charAt(0).toUpperCase();
    const roleMap = { admin: 'Msimamizi', manager: 'Meneja', cashier: 'Mpokeaji Pesa', employee: 'Mfanyakazi', super_admin: 'Super Admin' };
    document.getElementById('topRole').textContent = roleMap[currentUserData.role] || currentUserData.role || 'Mtumiaji';
    buildSidebar();
    subscribeAll();
    loadProfile();
    loadBusinessProfile();
    navTo('dashboard');
}

/* ===== BUILD SIDEBAR ===== */
function buildSidebar() {
    const nav = document.getElementById('sidebarNav');
    const isSuper = currentUserData.role === 'super_admin';
    let html = `<div class="sb-lbl">Kuu</div>`;
    html += `<div class="ni active" data-nav="dashboard" onclick="navTo('dashboard')"><i class="fas fa-chart-pie"></i> Dashibodi</div>`;
    html += `<div class="sb-lbl">Biashara</div>`;
    html += `<div class="dd-trigger" onclick="this.classList.toggle('open');this.nextElementSibling.classList.toggle('open')"><i class="fas fa-boxes-stacked"></i> Bidhaa <i class="fas fa-chevron-down dd-chev"></i></div>`;
    html += `<div class="dd-subs"><div class="dd-sub" data-nav="products" onclick="navTo('products')"><i class="fas fa-list"></i> Orodha ya Bidhaa</div><div class="dd-sub" data-nav="add-product" onclick="navTo('add-product')"><i class="fas fa-plus"></i> Ongeza Bidhaa</div></div>`;
    html += `<div class="ni" data-nav="sell-product" onclick="navTo('sell-product')"><i class="fas fa-cash-register"></i> Uza (POS)</div>`;
    html += `<div class="ni" data-nav="suppliers" onclick="navTo('suppliers')"><i class="fas fa-truck-field"></i> Wauzaji</div>`;
    html += `<div class="ni" data-nav="customers" onclick="navTo('customers')"><i class="fas fa-user-group"></i> Wateja</div>`;
    html += `<div class="sb-lbl">Fedha</div>`;
    html += `<div class="ni" data-nav="receipts" onclick="navTo('receipts')"><i class="fas fa-receipt"></i> Risiti</div>`;
    html += `<div class="ni" data-nav="debts" onclick="navTo('debts')"><i class="fas fa-hand-holding-dollar"></i> Madeni</div>`;
    html += `<div class="ni" data-nav="costs" onclick="navTo('costs')"><i class="fas fa-money-bill-trend-up"></i> Matumizi</div>`;
    html += `<div class="ni" data-nav="daily-report" onclick="navTo('daily-report')"><i class="fas fa-calendar-day"></i> Ripoti ya Siku</div>`;
    html += `<div class="sb-lbl">Mengineyo</div>`;
    html += `<div class="ni" data-nav="messages" onclick="navTo('messages')"><i class="fas fa-comments"></i> Ujumbe</div>`;
    html += `<div class="ni" data-nav="employees" onclick="navTo('employees')"><i class="fas fa-users"></i> Wafanyakazi</div>`;
    html += `<div class="ni" data-nav="price-calc" onclick="navTo('price-calc')"><i class="fas fa-calculator"></i> Kikokotoo cha Bei</div>`;
    html += `<div class="sb-lbl">Mipangilio</div>`;
    html += `<div class="ni" data-nav="profile" onclick="navTo('profile')"><i class="fas fa-user-circle"></i> Wasifu Wangu</div>`;
    html += `<div class="ni" data-nav="business-profile" onclick="navTo('business-profile')"><i class="fas fa-building"></i> Wasifu wa Biashara</div>`;
    html += `<div class="ni" data-nav="settings" onclick="navTo('settings')"><i class="fas fa-gear"></i> Mipangilio</div>`;
    if (isSuper) {
        html += `<div class="sb-lbl" style="color:var(--danger)">Msimamizi Mkuu</div>`;
        html += `<div class="ni" style="color:var(--danger)" onclick="openSuperAdmin()"><i class="fas fa-shield-halved" style="color:var(--danger)"></i> Super Admin</div>`;
    }
    nav.innerHTML = html;
}

/* ===== NAVIGATION ===== */
function navTo(section) {
    activeSection = section;
    document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
    const sec = document.getElementById(`sec-${section}`);
    if (sec) sec.classList.add('active');
    document.querySelectorAll('.ni,.dd-sub').forEach(n => n.classList.remove('active'));
    document.querySelectorAll(`[data-nav="${section}"]`).forEach(n => n.classList.add('active'));
    const titles = {
        'dashboard': 'Dashibodi', 'products': 'Bidhaa', 'add-product': 'Ongeza Bidhaa',
        'sell-product': 'Uza (POS)', 'suppliers': 'Wauzaji', 'customers': 'Wateja',
        'receipts': 'Risiti', 'debts': 'Madeni', 'costs': 'Matumizi',
        'daily-report': 'Ripoti ya Siku', 'messages': 'Ujumbe', 'employees': 'Wafanyakazi',
        'price-calc': 'Kikokotoo cha Bei', 'profile': 'Wasifu Wangu',
        'business-profile': 'Wasifu wa Biashara', 'settings': 'Mipangilio'
    };
    document.getElementById('topbarTitle').textContent = titles[section] || 'Dashibodi';
    if (section === 'dashboard') loadDashboard();
    if (section === 'daily-report') {
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('dailyReportDate').value = today;
        loadDailyReport();
    }
    closeSidebar();
}

/* ===== SUBSCRIBE TO ALL COLLECTIONS ===== */
function subscribeAll() {
    if (!businessId) return;
    const validBizId = requireId(businessId, 'Business ID');

    /* Products */
    if (productsUnsubscribe) productsUnsubscribe();
    const prodQ = query(collection(db, 'products'), where('businessId', '==', validBizId), orderBy('createdAt', 'desc'));
    productsUnsubscribe = onSnapshot(prodQ, snap => {
        products = snap.docs.map(d => ({ id: d.id, ...d.data() }));
        renderProducts();
        renderPosProducts();
    }, err => console.error('[PRODUCTS] onSnapshot error:', err));

    /* Suppliers */
    if (suppliersUnsubscribe) suppliersUnsubscribe();
    const supQ = query(collection(db, 'suppliers'), where('businessId', '==', validBizId), orderBy('createdAt', 'desc'));
    suppliersUnsubscribe = onSnapshot(supQ, snap => {
        suppliers = snap.docs.map(d => ({ id: d.id, ...d.data() }));
        renderSuppliers();
    }, err => console.error('[SUPPLIERS] onSnapshot error:', err));

    /* Customers */
    if (customersUnsubscribe) customersUnsubscribe();
    const custQ = query(collection(db, 'customers'), where('businessId', '==', validBizId), orderBy('createdAt', 'desc'));
    customersUnsubscribe = onSnapshot(custQ, snap => {
        customers = snap.docs.map(d => ({ id: d.id, ...d.data() }));
        renderCustomers();
        populateCustomerSelects();
    }, err => console.error('[CUSTOMERS] onSnapshot error:', err));

    /* Receipts / Sales */
    if (receiptsUnsubscribe) receiptsUnsubscribe();
    const recQ = query(collection(db, 'sales'), where('businessId', '==', validBizId), orderBy('createdAt', 'desc'));
    receiptsUnsubscribe = onSnapshot(recQ, snap => {
        receipts = snap.docs.map(d => ({ id: d.id, ...d.data() }));
        renderReceipts();
    }, err => console.error('[RECEIPTS] onSnapshot error:', err));

    /* Debts */
    if (debtsUnsubscribe) debtsUnsubscribe();
    const debtQ = query(collection(db, 'debts'), where('businessId', '==', validBizId), orderBy('createdAt', 'desc'));
    debtsUnsubscribe = onSnapshot(debtQ, snap => {
        debts = snap.docs.map(d => ({ id: d.id, ...d.data() }));
        renderDebts();
    }, err => console.error('[DEBTS] onSnapshot error:', err));

    /* Expenses */
    if (expensesUnsubscribe) expensesUnsubscribe();
    const expQ = query(collection(db, 'expenses'), where('businessId', '==', validBizId), orderBy('createdAt', 'desc'));
    expensesUnsubscribe = onSnapshot(expQ, snap => {
        expenses = snap.docs.map(d => ({ id: d.id, ...d.data() }));
        renderExpenses();
    }, err => console.error('[EXPENSES] onSnapshot error:', err));

    /* Employees */
    if (employeesUnsubscribe) employeesUnsubscribe();
    const empQ = query(collection(db, 'employees'), where('businessId', '==', validBizId), orderBy('createdAt', 'desc'));
    employeesUnsubscribe = onSnapshot(empQ, snap => {
        employees = snap.docs.map(d => ({ id: d.id, ...d.data() }));
        renderEmployees();
    }, err => console.error('[EMPLOYEES] onSnapshot error:', err));
}

/* ===== DASHBOARD ===== */
function loadDashboard() {
    const totalSales = receipts.reduce((s, r) => s + (r.total || 0), 0);
    const totalDebts = debts.reduce((s, d) => s + ((d.amount || 0) - (d.paid || 0)), 0);
    const totalExpenses = expenses.reduce((s, e) => s + (e.amount || 0), 0);
    const totalProducts = products.length;
    const totalCustomers = customers.length;
    const lowStock = products.filter(p => (p.stock || 0) <= 5).length;

    document.getElementById('dashMetrics').innerHTML = `
    <div class="mc g" onclick="navTo('receipts')"><div class="mc-icon"><i class="fas fa-money-bill-wave"></i></div><h3>${fmt(totalSales)}</h3><p>Jumla ya Mauzo</p></div>
    <div class="mc pu" onclick="navTo('products')"><div class="mc-icon"><i class="fas fa-boxes-stacked"></i></div><h3>${totalProducts}</h3><p>Bidhaa</p></div>
    <div class="mc a" onclick="navTo('customers')"><div class="mc-icon"><i class="fas fa-user-group"></i></div><h3>${totalCustomers}</h3><p>Wateja</p></div>
    <div class="mc r" onclick="navTo('debts')"><div class="mc-icon"><i class="fas fa-hand-holding-dollar"></i></div><h3>${fmt(totalDebts)}</h3><p>Madeni</p></div>
    <div class="mc b" onclick="navTo('costs')"><div class="mc-icon"><i class="fas fa-money-bill-trend-up"></i></div><h3>${fmt(totalExpenses)}</h3><p>Matumizi</p></div>
    <div class="mc r" onclick="navTo('products')"><div class="mc-icon"><i class="fas fa-exclamation-triangle"></i></div><h3>${lowStock}</h3><p>Bidhaa Chini ya Stock</p></div>`;

    /* Sales chart - weekly */
    const weekDays = ['Jumapili', 'Jumatatu', 'Jumanne', 'Jumatano', 'Alhamisi', 'Ijumaa', 'Jumamosi'];
    const now = new Date();
    const weekData = new Array(7).fill(0);
    receipts.forEach(r => {
        if (r.createdAt) {
            const d = r.createdAt.toDate ? r.createdAt.toDate() : new Date(r.createdAt);
            const diff = Math.floor((now - d) / 86400000);
            if (diff >= 0 && diff < 7) weekData[6 - diff] += (r.total || 0);
        }
    });

    if (salesChart) salesChart.destroy();
    salesChart = new Chart(document.getElementById('chartSales'), {
        type: 'line',
        data: {
            labels: weekDays,
            datasets: [{ label: 'Mauzo', data: weekData, borderColor: '#6c5ce7', backgroundColor: 'rgba(108,92,231,0.1)', fill: true, tension: 0.4, pointBackgroundColor: '#6c5ce7' }]
        },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { ticks: { color: '#5a5a72' }, grid: { color: 'rgba(255,255,255,0.04)' } }, y: { ticks: { color: '#5a5a72' }, grid: { color: 'rgba(255,255,255,0.04)' } } } }
    });

    /* Categories chart */
    const catMap = {};
    products.forEach(p => { catMap[p.category || 'Mengineyo'] = (catMap[p.category || 'Mengineyo'] || 0) + 1; });
    if (categoriesChart) categoriesChart.destroy();
    categoriesChart = new Chart(document.getElementById('chartCategories'), {
        type: 'doughnut',
        data: {
            labels: Object.keys(catMap),
            datasets: [{ data: Object.values(catMap), backgroundColor: ['#6c5ce7', '#00b894', '#e74c3c', '#f39c12', '#0984e3', '#a29bfe'] }]
        },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { color: '#9a9ab0', padding: 12 } } } }
    });

    /* Recent sales */
    const recent = receipts.slice(0, 5);
    const tbody = document.getElementById('dashRecentSales');
    if (recent.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="empty-s"><i class="fas fa-receipt"></i><p>Hakuna mauzo bado</p></td></tr>';
    } else {
        tbody.innerHTML = recent.map(r => `<tr><td>#${(r.receiptNumber || r.id).substring(0, 8)}</td><td>${r.customerName || 'Walk-in'}</td><td>${(r.items || []).length} bidhaa</td><td>${(r.items || []).reduce((s, i) => s + (i.qty || 0), 0)}</td><td style="color:var(--success);font-weight:600">${fmt(r.total)}</td><td>${fmtDate(r.createdAt)}</td></tr>`).join('');
    }
}

/* ===== RENDER PRODUCTS ===== */
function renderProducts() {
    const search = (document.getElementById('prodSearch')?.value || '').toLowerCase();
    const filtered = products.filter(p => (p.name || '').toLowerCase().includes(search) || (p.category || '').toLowerCase().includes(search));
    const tbody = document.getElementById('productsTable');
    if (filtered.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="empty-s"><i class="fas fa-box-open"></i><p>Hakuna bidhaa bado</p></td></tr>';
        return;
    }
    tbody.innerHTML = filtered.map(p => `<tr>
        <td><strong>${p.name}</strong>${p.sku ? `<br><span style="font-size:10px;color:var(--text3)">${p.sku}</span>` : ''}</td>
        <td><span style="background:var(--primary-bg);color:var(--primary2);padding:2px 8px;border-radius:12px;font-size:11px">${p.category || '-'}</span></td>
        <td>${fmt(p.costPrice)}</td>
        <td style="color:var(--success);font-weight:600">${fmt(p.sellPrice)}</td>
        <td><span style="color:${(p.stock || 0) <= 5 ? 'var(--danger)' : 'var(--text)'};font-weight:${(p.stock || 0) <= 5 ? '700' : '400'}">${p.stock || 0}</span></td>
        <td><div class="actions-cell">
            <button class="btn btn-i btn-xs" onclick="editProduct('${p.id}')" title="Hariri"><i class="fas fa-edit"></i></button>
            <button class="btn btn-d btn-xs" onclick="deleteProduct('${p.id}','${(p.name || '').replace(/'/g, "\\'")}')" title="Futa"><i class="fas fa-trash"></i></button>
        </div></td>
    </tr>`).join('');
}

/* ===== SAVE PRODUCT ===== */
async function saveProduct() {
    const name = document.getElementById('apName').value.trim();
    const category = document.getElementById('apCategory').value;
    const sku = document.getElementById('apSku').value.trim();
    const costPrice = parseFloat(document.getElementById('apCostPrice').value) || 0;
    const sellPrice = parseFloat(document.getElementById('apSellPrice').value) || 0;
    const stock = parseInt(document.getElementById('apStock').value) || 0;
    const desc = document.getElementById('apDesc').value.trim();
    if (!name) { toast('Jaza jina la bidhaa.', 'w'); return; }
    if (!category) { toast('Chagua aina ya bidhaa.', 'w'); return; }
    if (sellPrice <= 0) { toast('Bei ya kuuza lazima iwe kubwa kuliko 0.', 'w'); return; }
    const btn = document.getElementById('saveProductBtn');
    btn.disabled = true;
    btn.innerHTML = '<div class="spinner" style="width:16px;height:16px;border-width:2px"></div> Inahifadhi...';
    try {
        const validBizId = requireId(businessId, 'Business ID');
        await addDoc(collection(db, 'products'), {
            name, category, sku, costPrice, sellPrice, stock, description: desc,
            businessId: validBizId,
            createdAt: serverTimestamp(),
            updatedAt: serverTimestamp()
        });
        toast('Bidhaa imehifadhiwa!', 's');
        document.getElementById('apName').value = '';
        document.getElementById('apCategory').value = '';
        document.getElementById('apSku').value = '';
        document.getElementById('apCostPrice').value = '';
        document.getElementById('apSellPrice').value = '';
        document.getElementById('apStock').value = '';
        document.getElementById('apDesc').value = '';
        navTo('products');
    } catch (err) {
        console.error('[PRODUCTS] Save error:', err);
        toast('Hitilafu ya kuhifadhi bidhaa.', 'e');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-save"></i> Hifadhi Bidhaa';
    }
}

/* ===== EDIT PRODUCT ===== */
function editProduct(id) {
    const p = products.find(x => x.id === id);
    if (!p) return;
    document.getElementById('epEditId').value = id;
    document.getElementById('epName').value = p.name || '';
    document.getElementById('epCategory').value = p.category || '';
    document.getElementById('epSku').value = p.sku || '';
    document.getElementById('epCostPrice').value = p.costPrice || 0;
    document.getElementById('epSellPrice').value = p.sellPrice || 0;
    document.getElementById('epStock').value = p.stock || 0;
    document.getElementById('epDesc').value = p.description || '';
    openModal('editProductModal');
}

/* ===== UPDATE PRODUCT ===== */
async function updateProduct() {
    const id = document.getElementById('epEditId').value;
    if (!id) return;
    const name = document.getElementById('epName').value.trim();
    if (!name) { toast('Jaza jina la bidhaa.', 'w'); return; }
    try {
        const docRef = safeDoc(db, 'products', id);
        await updateDoc(docRef, {
            name: name,
            category: document.getElementById('epCategory').value,
            sku: document.getElementById('epSku').value.trim(),
            costPrice: parseFloat(document.getElementById('epCostPrice').value) || 0,
            sellPrice: parseFloat(document.getElementById('epSellPrice').value) || 0,
            stock: parseInt(document.getElementById('epStock').value) || 0,
            description: document.getElementById('epDesc').value.trim(),
            updatedAt: serverTimestamp()
        });
        toast('Bidhaa imesasishwa!', 's');
        closeModal('editProductModal');
    } catch (err) {
        console.error('[PRODUCTS] Update error:', err);
        toast('Hitilafu ya kusasisha bidhaa.', 'e');
    }
}

/* ===== DELETE PRODUCT ===== */
function deleteProduct(id, name) {
    showConfirm('Futa Bidhaa', 'Una uhakika unataka kufuta bidhaa hii?', async () => {
        try {
            await deleteDoc(safeDoc(db, 'products', id));
            toast('Bidhaa imefutwa.', 's');
        } catch (err) {
            console.error('[PRODUCTS] Delete error:', err);
            toast('Hitilafu ya kufuta bidhaa.', 'e');
        }
    }, name);
}

/* ===== EXPORT PRODUCTS ===== */
function exportProducts(format) {
    if (products.length === 0) { toast('Hakuna bidhaa kuexport.', 'w'); return; }
    const data = products.map(p => ({ 'Jina': p.name, 'Aina': p.category, 'SKU': p.sku || '', 'Bei ya Kununua': p.costPrice, 'Bei ya Kuuza': p.sellPrice, 'Stock': p.stock }));
    if (format === 'excel') {
        const ws = XLSX.utils.json_to_sheet(data);
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, 'Bidhaa');
        XLSX.writeFile(wb, 'bidhaa.xlsx');
        toast('Excel imechakatwa!', 's');
    } else {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();
        doc.setFontSize(16);
        doc.text('Orodha ya Bidhaa', 14, 20);
        doc.setFontSize(10);
        doc.text(`${businessData?.name || 'Biashara'} - ${new Date().toLocaleDateString('sw-TZ')}`, 14, 28);
        doc.autoTable({ startY: 34, head: [['Jina', 'Aina', 'SKU', 'Bei Kununua', 'Bei Kuuza', 'Stock']], body: data.map(r => Object.values(r)), styles: { fontSize: 8 } });
        doc.save('bidhaa.pdf');
        toast('PDF imechakatwa!', 's');
    }
}

/* ===== POS SYSTEM ===== */
function renderPosProducts() {
    const search = (document.getElementById('posSearch')?.value || '').toLowerCase();
    const available = products.filter(p => (p.stock || 0) > 0 && ((p.name || '').toLowerCase().includes(search) || (p.category || '').toLowerCase().includes(search)));
    const grid = document.getElementById('posProductsGrid');
    if (available.length === 0) {
        grid.innerHTML = '<div class="empty-s" style="grid-column:1/-1"><i class="fas fa-box-open"></i><p>Hakuna bidhaa</p></div>';
        return;
    }
    grid.innerHTML = available.map(p => `<div class="pos-p-card" onclick="addToCart('${p.id}')"><h5>${p.name}</h5><div class="pos-p-price">${fmt(p.sellPrice)}</div><div class="pos-p-stock">Stock: ${p.stock}</div></div>`).join('');
}

function addToCart(productId) {
    const p = products.find(x => x.id === productId);
    if (!p) return;
    const existing = cart.find(c => c.productId === productId);
    if (existing) {
        if (existing.qty >= p.stock) { toast('Hakuna stock enough.', 'w'); return; }
        existing.qty++;
    } else {
        cart.push({ productId: p.id, name: p.name, price: p.sellPrice, qty: 1, maxStock: p.stock });
    }
    renderCart();
}

function renderCart() {
    const body = document.getElementById('posCartBody');
    if (cart.length === 0) {
        body.innerHTML = '<div class="empty-s"><i class="fas fa-cart-shopping"></i><p>Gorofa ni tupu</p></div>';
        document.getElementById('posTotal').textContent = '0';
        return;
    }
    body.innerHTML = cart.map((c, i) => `<div class="cart-item">
        <div class="cart-item-info"><h6>${c.name}</h6><span>${fmt(c.price)} kila moja</span></div>
        <div class="cart-qty"><button onclick="changeCartQty(${i},-1)">-</button><span>${c.qty}</span><button onclick="changeCartQty(${i},1)">+</button></div>
        <div class="cart-item-price">${fmt(c.price * c.qty)}</div>
        <button class="cart-item-rm" onclick="removeFromCart(${i})"><i class="fas fa-times"></i></button>
    </div>`).join('');
    const total = cart.reduce((s, c) => s + c.price * c.qty, 0);
    document.getElementById('posTotal').textContent = fmt(total);
}

function changeCartQty(index, delta) {
    cart[index].qty += delta;
    if (cart[index].qty <= 0) cart.splice(index, 1);
    else if (cart[index].qty > cart[index].maxStock) { cart[index].qty = cart[index].maxStock; toast('Hakuna stock enough.', 'w'); }
    renderCart();
}

function removeFromCart(index) {
    cart.splice(index, 1);
    renderCart();
}

/* ===== CHECKOUT ===== */
function openCheckoutModal() {
    if (cart.length === 0) { toast('Gorofa ni tupu.', 'w'); return; }
    populateCustomerSelects();
    const sel = document.getElementById('checkoutCustomer');
    sel.innerHTML = '<option value="Walk-in">Walk-in</option>' + customers.map(c => `<option value="${c.id}">${c.name}</option>`).join('');
    const tbody = document.getElementById('checkoutItems');
    const total = cart.reduce((s, c) => s + c.price * c.qty, 0);
    tbody.innerHTML = cart.map(c => `<tr><td>${c.name}</td><td>${c.qty}</td><td>${fmt(c.price)}</td><td>${fmt(c.price * c.qty)}</td></tr>`).join('');
    document.getElementById('checkoutTotal').textContent = fmt(total);
    openModal('checkoutModal');
}

async function confirmCheckout() {
    const customerId = document.getElementById('checkoutCustomer').value;
    const paymentType = document.getElementById('checkoutPayment').value;
    const total = cart.reduce((s, c) => s + c.price * c.qty, 0);
    const custName = customerId === 'Walk-in' ? 'Walk-in' : (customers.find(c => c.id === customerId)?.name || 'Walk-in');
    const btn = document.getElementById('confirmCheckoutBtn');
    btn.disabled = true;
    btn.innerHTML = '<div class="spinner" style="width:16px;height:16px;border-width:2px"></div>';
    try {
        const validBizId = requireId(businessId, 'Business ID');
        const receiptNum = 'RCP-' + Date.now().toString(36).toUpperCase();
        const batch = writeBatch(db);

        /* Create sale record */
        const saleRef = doc(collection(db, 'sales'));
        batch.set(saleRef, {
            receiptNumber: receiptNum,
            customerId: customerId === 'Walk-in' ? null : customerId,
            customerName: custName,
            items: cart.map(c => ({ productId: c.productId, name: c.name, price: c.price, qty: c.qty, subtotal: c.price * c.qty })),
            total: total,
            paymentType: paymentType,
            status: paymentType === 'debt' ? 'unpaid' : 'paid',
            businessId: validBizId,
            createdBy: currentUser.uid,
            createdAt: serverTimestamp(),
            updatedAt: serverTimestamp()
        });

        /* Update stock for each product */
        for (const c of cart) {
            const pRef = safeDoc(db, 'products', c.productId);
            const pSnap = await getDoc(pRef);
            if (pSnap.exists()) {
                const newStock = Math.max(0, (pSnap.data().stock || 0) - c.qty);
                batch.update(pRef, { stock: newStock, updatedAt: serverTimestamp() });
            }
        }

        /* If debt, create debt record */
        if (paymentType === 'debt' && customerId !== 'Walk-in') {
            const debtRef = doc(collection(db, 'debts'));
            batch.set(debtRef, {
                customerId: customerId,
                customerName: custName,
                amount: total,
                paid: 0,
                remaining: total,
                saleId: saleRef.id,
                description: `Deni kutoka mauzo #${receiptNum}`,
                businessId: validBizId,
                status: 'unpaid',
                createdAt: serverTimestamp(),
                updatedAt: serverTimestamp()
            });
        }

        await batch.commit();
        cart = [];
        renderCart();
        closeModal('checkoutModal');
        toast('Mauzo yamekamilika!', 's');
        navTo('receipts');
    } catch (err) {
        console.error('[POS] Checkout error:', err);
        toast('Hitilafu ya kumaliza mauzo.', 'e');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-check-circle"></i> Thibitisha Mauzo';
    }
}

/* ===== RENDER SUPPLIERS ===== */
function renderSuppliers() {
    const search = (document.getElementById('supSearch')?.value || '').toLowerCase();
    const filtered = suppliers.filter(s => (s.name || '').toLowerCase().includes(search));
    const tbody = document.getElementById('suppliersTable');
    if (filtered.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="empty-s"><i class="fas fa-truck-field"></i><p>Hakuna wauzaji bado</p></td></tr>';
        return;
    }
    tbody.innerHTML = filtered.map(s => `<tr>
        <td><strong>${s.name}</strong></td><td>${s.phone || '-'}</td><td>${s.email || '-'}</td><td>${s.address || '-'}</td>
        <td><div class="actions-cell">
            <button class="btn btn-i btn-xs" onclick="editSupplier('${s.id}')" title="Hariri"><i class="fas fa-edit"></i></button>
