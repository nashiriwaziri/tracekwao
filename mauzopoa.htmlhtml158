/* ===== DAILY REPORT ===== */
function loadDailyReport() {
    const dateStr = document.getElementById('dailyReportDate').value;
    if (!dateStr) return;
    const start = new Date(dateStr + 'T00:00:00');
    const end = new Date(dateStr + 'T23:59:59');
    const dayReceipts = receipts.filter(r => {
        if (!r.createdAt) return false;
        const d = r.createdAt.toDate ? r.createdAt.toDate() : new Date(r.createdAt);
        return d >= start && d <= end;
    });
    const dayExpenses = expenses.filter(e => {
        const eDate = e.date ? new Date(e.date + 'T12:00:00') : (e.createdAt ? (e.createdAt.toDate ? e.createdAt.toDate() : new Date(e.createdAt)) : null);
        return eDate && eDate >= start && eDate <= end;
    });
    const totalSales = dayReceipts.reduce((s, r) => s + (r.total || 0), 0);
    const totalExp = dayExpenses.reduce((s, e) => s + (e.amount || 0), 0);
    const profit = totalSales - totalExp;
    document.getElementById('dailyReportSummary').innerHTML = `
        <div class="rs-card"><h4>Jumla ya Mauzo</h4><div class="rs-val" style="color:var(--success)">${fmt(totalSales)}</div></div>
        <div class="rs-card"><h4>Matumizi</h4><div class="rs-val" style="color:var(--danger)">${fmt(totalExp)}</div></div>
        <div class="rs-card"><h4>Faida</h4><div class="rs-val" style="color:${profit >= 0 ? 'var(--success)' : 'var(--danger)'}">${fmt(profit)}</div></div>
        <div class="rs-card"><h4>Idadi ya Mauzo</h4><div class="rs-val" style="color:var(--primary2)">${dayReceipts.length}</div></div>`;

    const tbody = document.getElementById('dailyReportTable');
    if (dayReceipts.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="empty-s"><i class="fas fa-calendar-day"></i><p>Hakuna mauzo siku hii</p></td></tr>';
    } else {
        tbody.innerHTML = dayReceipts.map(r => `<tr>
            <td>#${(r.receiptNumber || r.id).substring(0, 10)}</td>
            <td>${r.customerName || 'Walk-in'}</td>
            <td>${(r.items || []).map(i => i.name).join(', ')}</td>
            <td style="color:var(--success);font-weight:600">${fmt(r.total)}</td>
            <td>${fmtDateTime(r.createdAt)}</td></tr>`).join('');
    }
}

function exportDailyReport(format) {
    const dateStr = document.getElementById('dailyReportDate').value;
    if (!dateStr) { toast('Chagua tarehe kwanza.', 'w'); return; }
    const rows = document.querySelectorAll('#dailyReportTable tr');
    if (rows.length <= 1) { toast('Hakuna data kuexport.', 'w'); return; }
    const data = [];
    rows.forEach(r => {
        const cells = r.querySelectorAll('td');
        if (cells.length >= 5) data.push({ '#': cells[0].textContent, 'Mteja': cells[1].textContent, 'Bidhaa': cells[2].textContent, 'Jumla': cells[3].textContent, 'Tarehe': cells[4].textContent });
    });
    if (format === 'excel') {
        const ws = XLSX.utils.json_to_sheet(data);
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, 'Ripoti');
        XLSX.writeFile(wb, `ripoti-${dateStr}.xlsx`);
    } else {
        const { jsPDF } = window.jspdf;
        const pdf = new jsPDF();
        pdf.setFontSize(16);
        pdf.text(`Ripoti ya Siku - ${dateStr}`, 14, 20);
        pdf.setFontSize(10);
        pdf.text(`${businessData?.name || 'Biashara'}`, 14, 28);
        pdf.autoTable({ startY: 34, head: [['#', 'Mteja', 'Bidhaa', 'Jumla', 'Tarehe']], body: data.map(r => Object.values(r)), styles: { fontSize: 8 } });
        pdf.save(`ripoti-${dateStr}.pdf`);
    }
    toast('Ripoti imechakatwa!', 's');
}

/* ===== MESSAGES ===== */
function renderMessages() {
    const listBody = document.getElementById('msgListBody');
    /* For simplicity, show employees as chat partners */
    const partners = [...employees.map(e => ({ id: e.id, name: `${e.firstName || ''} ${e.lastName || ''}`.trim() }))];
    if (partners.length === 0) {
        listBody.innerHTML = '<div class="empty-s"><i class="fas fa-comments"></i><p>Hakuna mazungumzo</p></div>';
        return;
    }
    listBody.innerHTML = partners.map(p => `<div class="msg-item ${chatPartnerId === p.id ? 'active' : ''}" onclick="openChat('${p.id}','${(p.name || '').replace(/'/g, "\\'")}')">
        <div class="msg-av">${(p.name || 'U').charAt(0).toUpperCase()}</div>
        <div class="msg-info"><h5>${p.name}</h5><p>Bonyeza kuanza mazungumzo</p></div>
    </div>`).join('');
}

function openChat(partnerId, partnerName) {
    chatPartnerId = partnerId;
    document.getElementById('msgChatHead').innerHTML = `<div class="msg-av" style="width:28px;height:28px;font-size:11px">${partnerName.charAt(0).toUpperCase()}</div> ${partnerName}`;
    document.getElementById('msgChatBody').innerHTML = '<div class="empty-s"><i class="fas fa-comment-dots"></i><p>Andika ujumbe kuanza mazungumzo</p></div>';
    renderMessages();
}

async function sendMessage() {
    const input = document.getElementById('msgInput');
    const text = input.value.trim();
    if (!text || !chatPartnerId) return;
    input.value = '';
    const chatBody = document.getElementById('msgChatBody');
    if (chatBody.querySelector('.empty-s')) chatBody.innerHTML = '';
    chatBody.innerHTML += `<div class="msg-bubble msg-sent">${text}<div class="msg-time">${new Date().toLocaleTimeString('sw-TZ', { hour: '2-digit', minute: '2-digit' })}</div></div>`;
    chatBody.scrollTop = chatBody.scrollHeight;
    try {
        const validBizId = requireId(businessId, 'Business ID');
        await addDoc(collection(db, 'messages'), {
            fromId: currentUser.uid,
            toId: chatPartnerId,
            text,
            businessId: validBizId,
            createdAt: serverTimestamp(),
            read: false
        });
    } catch (err) {
        console.error('[MESSAGES] Send error:', err);
    }
}

/* ===== EMPLOYEES ===== */
function renderEmployees() {
    const search = (document.getElementById('empSearch')?.value || '').toLowerCase();
    const filtered = employees.filter(e => (`${e.firstName || ''} ${e.lastName || ''}`).toLowerCase().includes(search));
    const grid = document.getElementById('employeesGrid');
    if (filtered.length === 0) {
        grid.innerHTML = '<div class="empty-s" style="grid-column:1/-1"><i class="fas fa-users"></i><p>Hakuna wafanyakazi bado</p></div>';
        return;
    }
    const colors = ['#6c5ce7', '#00b894', '#e74c3c', '#f39c12', '#0984e3'];
    grid.innerHTML = filtered.map((e, i) => {
        const name = `${e.firstName || ''} ${e.lastName || ''}`.trim();
        return `<div class="emp-card">
            <div class="emp-card-head">
                <div class="emp-av" style="background:${colors[i % colors.length]}">${name.charAt(0).toUpperCase()}</div>
                <div><h4>${name}</h4><p>${e.email || e.phone || '-'}</p></div>
            </div>
            <div><span class="emp-tag role">${e.role || 'Mfanyakazi'}</span> <span class="emp-tag status">Active</span></div>
            ${e.salary ? `<p style="margin-top:8px;font-size:13px;color:var(--success);font-weight:600">Mshahara: ${fmt(e.salary)}</p>` : ''}
      <div class="actions-cell" style="margin-top:10px">
                <button class="btn btn-i btn-xs" onclick="editEmployee('${e.id}')" title="Hariri"><i class="fas fa-edit"></i></button>
                <button class="btn btn-d btn-xs" onclick="deleteEmployee('${e.id}','${name.replace(/'/g, "\\'")}')" title="Futa"><i class="fas fa-trash"></i></button>
            </div>
        </div>`;
    }).join('');
}

function openEmployeeModal() {
    document.getElementById('empEditId').value = '';
    document.getElementById('empFname').value = '';
    document.getElementById('empLname').value = '';
    document.getElementById('empEmail').value = '';
    document.getElementById('empPhone').value = '';
    document.getElementById('empRole').value = 'cashier';
    document.getElementById('empSalary').value = '';
    document.getElementById('employeeModalTitle').textContent = 'Ongeza Mfanyakazi';
    openModal('employeeModal');
}

function editEmployee(id) {
    const e = employees.find(x => x.id === id);
    if (!e) return;
    document.getElementById('empEditId').value = id;
    document.getElementById('empFname').value = e.firstName || '';
    document.getElementById('empLname').value = e.lastName || '';
    document.getElementById('empEmail').value = e.email || '';
    document.getElementById('empPhone').value = e.phone || '';
    document.getElementById('empRole').value = e.role || 'cashier';
    document.getElementById('empSalary').value = e.salary || '';
    document.getElementById('employeeModalTitle').textContent = 'Hariri Mfanyakazi';
    openModal('employeeModal');
}

async function saveEmployee() {
    const editId = document.getElementById('empEditId').value;
    const firstName = document.getElementById('empFname').value.trim();
    if (!firstName) { toast('Jaza jina la kwanza.', 'w'); return; }
    const data = {
        firstName,
        lastName: document.getElementById('empLname').value.trim(),
        email: document.getElementById('empEmail').value.trim(),
        phone: document.getElementById('empPhone').value.trim(),
        role: document.getElementById('empRole').value,
        salary: parseFloat(document.getElementById('empSalary').value) || 0,
        updatedAt: serverTimestamp()
    };
    try {
        const validBizId = requireId(businessId, 'Business ID');
        if (editId) {
            await updateDoc(safeDoc(db, 'employees', editId), data);
            toast('Mfanyakazi amesasishwa!', 's');
        } else {
            data.businessId = validBizId;
            data.createdAt = serverTimestamp();
            await addDoc(collection(db, 'employees'), data);
            toast('Mfanyakazi ameongezwa!', 's');
        }
        closeModal('employeeModal');
    } catch (err) {
        console.error('[EMPLOYEES] Save error:', err);
        toast('Hitilafu ya kuhifadhi mfanyakazi.', 'e');
    }
}

function deleteEmployee(id, name) {
    showConfirm('Futa Mfanyakazi', 'Una uhakika unataka kufuta mfanyakazi huu?', async () => {
        try {
            await deleteDoc(safeDoc(db, 'employees', id));
            toast('Mfanyakazi amefutwa.', 's');
        } catch (err) {
            console.error('[EMPLOYEES] Delete error:', err);
            toast('Hitilafu.', 'e');
        }
    }, name);
}

/* ===== PRICE CALCULATOR ===== */
function calcPrice() {
    const cost = parseFloat(document.getElementById('calcCost').value) || 0;
    const margin = parseFloat(document.getElementById('calcMargin').value) || 0;
    const sellPrice = cost + (cost * margin / 100);
    const profit = sellPrice - cost;
    document.getElementById('calcResult').textContent = fmt(Math.round(sellPrice));
    document.getElementById('calcProfit').textContent = fmt(Math.round(profit));
    document.getElementById('calcMarginResult').textContent = margin + '%';
}

/* ===== PROFILE ===== */
function loadProfile() {
    if (!currentUserData) return;
    document.getElementById('profFname').value = currentUserData.firstName || '';
    document.getElementById('profLname').value = currentUserData.lastName || '';
    document.getElementById('profEmail').value = currentUserData.email || '';
    document.getElementById('profPhone').value = currentUserData.phone || '';
    const roleMap = { admin: 'Msimamizi', manager: 'Meneja', cashier: 'Mpokeaji Pesa', employee: 'Mfanyakazi', super_admin: 'Super Admin' };
    document.getElementById('profRole').value = roleMap[currentUserData.role] || currentUserData.role || '-';
    document.getElementById('profCreated').value = fmtDateTime(currentUserData.createdAt);
    document.getElementById('profLastLogin').value = fmtDateTime(currentUserData.lastLogin);
}

async function saveProfile() {
    const firstName = document.getElementById('profFname').value.trim();
    const lastName = document.getElementById('profLname').value.trim();
    const phone = document.getElementById('profPhone').value.trim();
    if (!firstName) { toast('Jaza jina la kwanza.', 'w'); return; }
    try {
        await updateDoc(doc(db, 'users', currentUser.uid), {
            firstName, lastName, phone,
            updatedAt: serverTimestamp()
        });
        currentUserData.firstName = firstName;
        currentUserData.lastName = lastName;
        currentUserData.phone = phone;
        const name = `${firstName} ${lastName}`.trim();
        document.getElementById('topName').textContent = name || 'Mtumiaji';
        document.getElementById('topAv').textContent = (name || 'U').charAt(0).toUpperCase();
        toast('Wasifu umesasishwa!', 's');
    } catch (err) {
        console.error('[PROFILE] Save error:', err);
        toast('Hitilafu ya kusasisha wasifu.', 'e');
    }
}

/* ===== BUSINESS PROFILE ===== */
function loadBusinessProfile() {
    if (!businessData) return;
    document.getElementById('bizName').value = businessData.name || '';
    document.getElementById('bizEmail').value = businessData.email || '';
    document.getElementById('bizPhone').value = businessData.phone || '';
    document.getElementById('bizAddress').value = businessData.address || '';
    document.getElementById('bizType').value = businessData.type || '';
    document.getElementById('bizTin').value = businessData.tin || '';
    if (businessData.logo) {
        document.getElementById('logoPreview').innerHTML = `<img src="${businessData.logo}" alt="Logo">`;
    }
}

async function saveBusinessProfile() {
    const name = document.getElementById('bizName').value.trim();
    if (!name) { toast('Jaza jina la biashara.', 'w'); return; }
    try {
        const validBizId = requireId(businessId, 'Business ID');
        await updateDoc(doc(db, 'businesses', validBizId), {
            name,
            email: document.getElementById('bizEmail').value.trim(),
            phone: document.getElementById('bizPhone').value.trim(),
            address: document.getElementById('bizAddress').value.trim(),
            type: document.getElementById('bizType').value,
            tin: document.getElementById('bizTin').value.trim(),
            updatedAt: serverTimestamp()
        });
        businessData.name = name;
        toast('Wasifu wa biashara umesasishwa!', 's');
    } catch (err) {
        console.error('[BUSINESS] Save error:', err);
        toast('Hitilafu ya kusasisha wasifu.', 'e');
    }
}

/* ===== SETTINGS: CHANGE PASSWORD ===== */
async function changePassword() {
    const currPw = document.getElementById('settCurrPw').value;
    const newPw = document.getElementById('settNewPw').value;
    const confPw = document.getElementById('settConfPw').value;
    if (!currPw || !newPw) { toast('Jaza sehemu zote.', 'w'); return; }
    if (newPw.length < 6) { toast('Nenosiri jipya lazima iwe wa herufi 6 au zaidi.', 'w'); return; }
    if (newPw !== confPw) { toast('Nenosiri jipya hazilingani.', 'w'); return; }
    try {
        await updatePassword(currentUser, newPw);
        document.getElementById('settCurrPw').value = '';
        document.getElementById('settNewPw').value = '';
        document.getElementById('settConfPw').value = '';
        toast('Nenosiri limebadilishwa!', 's');
    } catch (err) {
        console.error('[SETTINGS] Password change error:', err);
        if (err.code === 'auth/requires-recent-login') {
            toast('Tafadhali ingia tena kabla ya kubadilisha nenosiri.', 'w');
        } else if (err.code === 'auth/weak-password') {
            toast('Nenosiri ni dhaifu sana.', 'w');
        } else {
            toast('Hitilafu: ' + err.message, 'e');
        }
    }
}

/* ===== SETTINGS: UPLOAD LOGO ===== */
async function uploadLogo(event) {
    const file = event.target.files[0];
    if (!file) return;
    if (!businessId) { toast('Biashara haijatambulishwa.', 'e'); return; }
    if (file.size > 2 * 1024 * 1024) { toast('Picha lazima iwe chini ya 2MB.', 'w'); return; }
    try {
        const validBizId = requireId(businessId, 'Business ID');
        const logoRef = ref(storage, `businesses/${validBizId}/logo`);
        await uploadBytes(logoRef, file);
        const url = await getDownloadURL(logoRef);
        await updateDoc(doc(db, 'businesses', validBizId), { logo: url, updatedAt: serverTimestamp() });
        businessData.logo = url;
        document.getElementById('logoPreview').innerHTML = `<img src="${url}" alt="Logo">`;
        toast('Alama imepakiwa!', 's');
    } catch (err) {
        console.error('[STORAGE] Upload logo error:', err);
        toast('Hitilafu ya kupaka alama.', 'e');
    }
}

/* ===== SUPER ADMIN ===== */
let superBusinesses = [];
let superUsers = [];

function openSuperAdmin() {
    document.getElementById('superOverlay').classList.add('show');
    loadSuperData();
}
function closeSuperAdmin() {
    document.getElementById('superOverlay').classList.remove('show');
}

async function loadSuperData() {
    try {
        /* Load all businesses */
        const bizSnap = await getDocs(collection(db, 'businesses'));
        superBusinesses = bizSnap.docs.map(d => ({ id: d.id, ...d.data() }));

        /* Load all users */
        const userSnap = await getDocs(collection(db, 'users'));
        superUsers = userSnap.docs.map(d => ({ id: d.id, ...d.data() }));

        const totalBiz = superBusinesses.length;
        const totalUsers = superUsers.length;
        const activeBiz = superBusinesses.filter(b => b.status === 'active').length;
        const suspendedBiz = superBusinesses.filter(b => b.status === 'suspended').length;

        document.getElementById('superMetrics').innerHTML = `
            <div class="sm-card"><h4>Biashara Zote</h4><div class="sm-val">${totalBiz}</div><div class="sm-sub">Zimesajiliwa</div></div>
            <div class="sm-card"><h4>Watumiaji Wote</h4><div class="sm-val">${totalUsers}</div><div class="sm-sub">Akaunti zote</div></div>
            <div class="sm-card"><h4>Biashara Hai</h4><div class="sm-val" style="color:var(--success)">${activeBiz}</div><div class="sm-sub">Zinafanya kazi</div></div>
            <div class="sm-card"><h4>Zimezimwa</h4><div class="sm-val" style="color:var(--danger)">${suspendedBiz}</div><div class="sm-sub">Zimesimamishwa</div></div>`;

        renderSuperBusinesses();
        renderSuperUsers();
    } catch (err) {
        console.error('[SUPER] Load data error:', err);
        toast('Hitilafu ya kupakia data ya super admin.', 'e');
    }
}

function renderSuperBusinesses() {
    const search = (document.getElementById('superBizSearch')?.value || '').toLowerCase();
    const filtered = superBusinesses.filter(b => (b.name || '').toLowerCase().includes(search));
    const tbody = document.getElementById('superBizTable');
    if (filtered.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="empty-s"><i class="fas fa-building"></i><p>Hakuna biashara</p></td></tr>';
        return;
    }
    tbody.innerHTML = filtered.map(b => `<tr>
        <td><strong>${b.name || '-'}</strong></td>
        <td>${b.type || '-'}</td>
        <td>${b.phone || '-'}</td>
        <td><span class="status-badge ${b.status === 'active' ? 'active' : b.status === 'suspended' ? 'suspended' : 'pending'}">${b.status === 'active' ? 'Hai' : b.status === 'suspended' ? 'Imezimwa' : 'Inasubiri'}</span></td>
        <td>${fmtDate(b.createdAt)}</td>
        <td><div class="actions-cell">
            <button class="btn btn-${b.status === 'active' ? 'w' : 's'} btn-xs" onclick="toggleBizStatus('${b.id}','${b.status}')" title="${b.status === 'active' ? 'Simamisha' : 'Washa'}"><i class="fas fa-${b.status === 'active' ? 'pause' : 'play'}"></i></button>
        </div></td></tr>`).join('');
}

async function toggleBizStatus(bizId, currentStatus) {
    const newStatus = currentStatus === 'active' ? 'suspended' : 'active';
    const action = newStatus === 'suspended' ? 'kusimamisha' : 'kuwasha';
    try {
        await updateDoc(doc(db, 'businesses', bizId), { status: newStatus, updatedAt: serverTimestamp() });
        toast(`Biashara ime${action}wa.`, 's');
        loadSuperData();
    } catch (err) {
        console.error('[SUPER] Toggle status error:', err);
        toast('Hitilafu.', 'e');
    }
}

function renderSuperUsers() {
    const search = (document.getElementById('superUserSearch')?.value || '').toLowerCase();
    const filtered = superUsers.filter(u => (`${u.firstName || ''} ${u.lastName || ''} ${u.email || ''}`).toLowerCase().includes(search));
    const tbody = document.getElementById('superUserTable');
    if (filtered.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="empty-s"><i class="fas fa-users"></i><p>Hakuna watumiaji</p></td></tr>';
        return;
    }
    const roleMap = { admin: 'Msimamizi', manager: 'Meneja', cashier: 'Mpokeaji', employee: 'Mfanyakazi', super_admin: 'Super Admin' };
    tbody.innerHTML = filtered.map(u => {
        const name = `${u.firstName || ''} ${u.lastName || ''}`.trim();
        const bizName = superBusinesses.find(b => b.id === u.businessId)?.name || '-';
        return `<tr>
            <td><strong>${name || '-'}</strong></td>
            <td>${u.email || '-'}</td>
            <td><span style="background:var(--primary-bg);color:var(--primary2);padding:2px 8px;border-radius:12px;font-size:11px">${roleMap[u.role] || u.role || '-'}</span></td>
            <td>${bizName}</td>
            <td><span class="status-badge ${u.status === 'active' ? 'active' : 'suspended'}">${u.status === 'active' ? 'Hai' : 'Imezimwa'}</span></td>
            <td><div class="actions-cell">
                <button class="btn btn-${u.status === 'active' ? 'w' : 's'} btn-xs" onclick="toggleUserStatus('${u.id}','${u.status}')" title="${u.status === 'active' ? 'Simamisha' : 'Washa'}"><i class="fas fa-${u.status === 'active' ? 'pause' : 'play'}"></i></button>
            </div></td></tr>`;
    }).join('');
}

async function toggleUserStatus(userId, currentStatus) {
    const newStatus = currentStatus === 'active' ? 'suspended' : 'active';
    try {
        await updateDoc(doc(db, 'users', userId), { status: newStatus, updatedAt: serverTimestamp() });
        toast(`Mtumiaji ame${newStatus === 'suspended' ? 'simamishwa' : 'washwa'}.`, 's');
        loadSuperData();
    } catch (err) {
        console.error('[SUPER] Toggle user status error:', err);
        toast('Hitilafu.', 'e');
    }
}

function switchSuperTab(tab, btn) {
    document.querySelectorAll('.super-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.super-section').forEach(s => s.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById(`super-sec-${tab}`).classList.add('active');
}

/* ===== ONLINE / OFFLINE DETECTION ===== */
function updateOnlineStatus() {
    if (navigator.onLine) {
        document.body.classList.remove('is-offline');
        document.getElementById('onlineDot').style.background = 'var(--success)';
        document.getElementById('onlineText').textContent = 'Wako mtandaoni';
    } else {
        document.body.classList.add('is-offline');
        document.getElementById('onlineDot').style.background = 'var(--danger)';
        document.getElementById('onlineText').textContent = 'Hako mtandaoni';
    }
}
window.addEventListener('online', updateOnlineStatus);
window.addEventListener('offline', updateOnlineStatus);
updateOnlineStatus();

