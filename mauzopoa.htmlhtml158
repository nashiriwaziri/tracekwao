window.deleteCustomer = deleteCustomer;
window.renderCustomers = renderCustomers;
window.viewReceipt = viewReceipt;
window.printReceipt = printReceipt;
window.renderReceipts = renderReceipts;
window.openDebtModal = openDebtModal;
window.saveDebt = saveDebt;
window.openPayDebt = openPayDebt;
window.confirmPayDebt = confirmPayDebt;
window.deleteDebt = deleteDebt;
window.renderDebts = renderDebts;
window.openExpenseModal = openExpenseModal;
window.editExpense = editExpense;
window.saveExpense = saveExpense;
window.deleteExpense = deleteExpense;
window.renderExpenses = renderExpenses;
window.loadDailyReport = loadDailyReport;
window.exportDailyReport = exportDailyReport;
window.openChat = openChat;
window.sendMessage = sendMessage;
window.openEmployeeModal = openEmployeeModal;
