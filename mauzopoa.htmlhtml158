/* ===== RENDER CUSTOMERS ===== */
function renderCustomers() {
    const search = (document.getElementById('custSearch')?.value || '').toLowerCase();
    const filtered = customers.filter(c => (c.name || '').toLowerCase().includes(search));
    const tbody = document.getElementById('customersTable');
    if (filtered.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="empty-s"><i class="fas fa-user-group"></i><p>Hakuna wateja bado</p></td></tr>';
        return;
    }
    const debtMap = {};
    debts.forEach(d => { if (d.customerId) debtMap[d.customerId] = (debtMap[d.customerId] || 0) + ((d.amount || 0) - (d.paid || 0)); });
    tbody.innerHTML = filtered.map(c => `<tr>
        <td><strong>${c.name}</strong></td><td>${c.phone || '-'}</td><td>${c.email || '-'}</td><td>${c.address || '-'}</td>
        <td style="color:${(debtMap[c.id] || 0) > 0 ? 'var(--danger)' : 'var(--success)'};font-weight:600">${fmt(debtMap[c.id] || 0)}</td>
        <td><div class="actions-cell">
            <button class="btn btn-i btn-xs" onclick="editCustomer('${c.id}')" title="Hariri"><i class="fas fa-edit"></i></button>
            <button class="btn btn-d btn-xs" onclick="deleteCustomer('${c.id}','${(c.name || '').replace(/'/g, "\\'")}')" title="Futa"><i class="fas fa-trash"></i></button>
        </div></td></tr>`).join('');
}

