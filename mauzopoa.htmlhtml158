/* ===== RENDER RECEIPTS ===== */
function renderReceipts() {
    const search = (document.getElementById('receiptSearch')?.value || '').toLowerCase();
    const filtered = receipts.filter(r => (r.receiptNumber || '').toLowerCase().includes(search) || (r.customerName || '').toLowerCase().includes(search));
    const tbody = document.getElementById('receiptsTable');
    if (filtered.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="empty-s"><i class="fas fa-receipt"></i><p>Hakuna risiti bado</p></td></tr>';
        return;
    }
    tbody.innerHTML = filtered.map(r => `<tr>
        <td><strong>#${(r.receiptNumber || r.id).substring(0, 10)}</strong></td>
        <td>${r.customerName || 'Walk-in'}</td>
        <td style="color:var(--success);font-weight:600">${fmt(r.total)}</td>
        <td><span class="status-badge ${r.status === 'paid' ? 'paid' : 'unpaid'}">${r.status === 'paid' ? 'Imelipwa' : 'Haijalipwa'}</span></td>
        <td>${fmtDateTime(r.createdAt)}</td>
        <td><div class="actions-cell">
            <button class="btn btn-i btn-xs" onclick="viewReceipt('${r.id}')" title="Tazama"><i class="fas fa-eye"></i></button>
        </div></td></tr>`).join('');
}

function viewReceipt(id) {
    const r = receipts.find(x => x.id === id);
    if (!r) return;
    const rc = document.getElementById('receiptContent');
    let itemsHtml = (r.items || []).map(i => `<div class="rc-line"><span>${i.name} x${i.qty}</span><span>${fmt(i.subtotal)}</span></div>`).join('');
    rc.innerHTML = `
        <h3>${businessData?.name || 'Biashara'}</h3>
        ${businessData?.phone ? `<p style="text-align:center;font-size:11px">${businessData.phone}</p>` : ''}
        <div class="rc-divider"></div>
        <div class="rc-line"><span>Risiti #</span><span>${r.receiptNumber || r.id.substring(0, 10)}</span></div>
        <div class="rc-line"><span>Mteja</span><span>${r.customerName || 'Walk-in'}</span></div>
        <div class="rc-line"><span>Tarehe</span><span>${fmtDateTime(r.createdAt)}</span></div>
        <div class="rc-divider"></div>
        ${itemsHtml}
        <div class="rc-divider"></div>
        <div class="rc-line rc-total"><span>JUMLA</span><span>${fmt(r.total)}</span></div>
        <div class="rc-line"><span>Aina ya Malipo</span><span>${r.paymentType === 'cash' ? 'Pesa Taslimu' : r.paymentType === 'card' ? 'Kadi' : 'Deni'}</span></div>
        <div class="rc-divider"></div>
        <p style="text-align:center;font-size:10px">Asante kwa kununua!</p>`;
    openModal('receiptViewModal');
}

function printReceipt() {
    const content = document.getElementById('receiptContent').innerHTML;
    const w = window.open('', '_blank');
    w.document.write(`<html><head><title>Risiti</title><style>body{font-family:'Courier New',monospace;padding:20px;font-size:12px}.rc-line{display:flex;justify-content:space-between;padding:2px 0}.rc-divider{border-top:1px dashed #000;margin:8px 0}.rc-total{font-weight:bold;font-size:14px}h3{text-align:center}p{text-align:center;font-size:10px}</style></head><body>${content}<script>window.print();window.close();<\/script></body></html>`);
    w.document.close();
}

/* ===== RENDER DEBTS ===== */
function renderDebts() {
    const search = (document.getElementById('debtSearch')?.value || '').toLowerCase();
    const filtered = debts.filter(d => (d.customerName || '').toLowerCase().includes(search));
    const tbody = document.getElementById('debtsTable');
    if (filtered.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="empty-s"><i class="fas fa-hand-holding-dollar"></i><p>Hakuna madeni bado</p></td></tr>';
        return;
    }
    tbody.innerHTML = filtered.map(d => {
        const remaining = (d.amount || 0) - (d.paid || 0);
        const isPaid = remaining <= 0;
        return `<tr>
            <td><strong>${d.customerName || '-'}</strong></td>
            <td>${fmt(d.amount)}</td><td>${fmt(d.paid)}</td>
            <td style="color:${isPaid ? 'var(--success)' : 'var(--danger)'};font-weight:600">${fmt(remaining)}</td>
            <td>${fmtDate(d.createdAt)}</td>
            <td><span class="status-badge ${isPaid ? 'paid' : 'unpaid'}">${isPaid ? 'Imelipwa' : 'Haijalipwa'}</span></td>
            <td><div class="actions-cell">
                ${!isPaid ? `<button class="btn btn-s btn-xs" onclick="openPayDebt('${d.id}')" title="Lipa"><i class="fas fa-money-bill"></i></button>` : ''}
                <button class="btn btn-d btn-xs" onclick="deleteDebt('${d.id}')" title="Futa"><i class="fas fa-trash"></i></button>
            </div></td></tr>`;
    }).join('');
}

function openDebtModal() {
    populateCustomerSelects();
    document.getElementById('debtEditId').value = '';
    document.getElementById('debtCustomer').value = '';
    document.getElementById('debtAmount').value = '';
    document.getElementById('debtPaid').value = '0';
    document.getElementById('debtDesc').value = '';
    document.getElementById('debtModalTitle').textContent = 'Ongeza Deni';
    openModal('debtModal');
}

async function saveDebt() {
    const customerId = document.getElementById('debtCustomer').value;
    const amount = parseFloat(document.getElementById('debtAmount').value) || 0;
    if (!customerId) { toast('Chagua mteja.', 'w'); return; }
    if (amount <= 0) { toast('Kiasi lazima kiwe kubwa kuliko 0.', 'w'); return; }
    const custName = customers.find(c => c.id === customerId)?.name || '-';
    const paid = parseFloat(document.getElementById('debtPaid').value) || 0;
    try {
        const validBizId = requireId(businessId, 'Business ID');
        await addDoc(collection(db, 'debts'), {
            customerId, customerName: custName,
            amount, paid, remaining: amount - paid,
            description: document.getElementById('debtDesc').value.trim(),
            businessId: validBizId,
            status: (amount - paid) <= 0 ? 'paid' : 'unpaid',
            createdAt: serverTimestamp(),
            updatedAt: serverTimestamp()
        });
        toast('Deni limeongezwa!', 's');
        closeModal('debtModal');
    } catch (err) {
        console.error('[DEBTS] Save error:', err);
        toast('Hitilafu ya kuhifadhi deni.', 'e');
    }
}

function openPayDebt(id) {
    const d = debts.find(x => x.id === id);
    if (!d) return;
    const remaining = (d.amount || 0) - (d.paid || 0);
    document.getElementById('payDebtId').value = id;
    document.getElementById('payDebtRemaining').textContent = fmt(remaining);
    document.getElementById('payDebtAmount').value = '';
    openModal('payDebtModal');
}

async function confirmPayDebt() {
    const id = document.getElementById('payDebtId').value;
    const payAmount = parseFloat(document.getElementById('payDebtAmount').value) || 0;
    if (payAmount <= 0) { toast('Kiasi cha kulipa lazima kiwe kubwa.', 'w'); return; }
    try {
        const docRef = safeDoc(db, 'debts', id);
        await runTransaction(db, async transaction => {
            const snap = await transaction.get(docRef);
            if (!snap.exists()) throw new Error('Deni halijapatikana.');
            const data = snap.data();
            const newPaid = (data.paid || 0) + payAmount;
            const newRemaining = (data.amount || 0) - newPaid;
            transaction.update(docRef, {
                paid: newPaid,
                remaining: Math.max(0, newRemaining),
                status: newRemaining <= 0 ? 'paid' : 'unpaid',
                updatedAt: serverTimestamp()
            });
        });
        toast('Malipo yamekamilika!', 's');
        closeModal('payDebtModal');
    } catch (err) {
        console.error('[DEBTS] Pay error:', err);
        toast('Hitilafu ya malipo.', 'e');
    }
}

async function deleteDebt(id) {
    showConfirm('Futa Deni', 'Una uhakika unataka kufuta deni hili?', async () => {
        try { await deleteDoc(safeDoc(db, 'debts', id)); toast('Deni limefutwa.', 's'); }
        catch (err) { console.error('[DEBTS] Delete error:', err); toast('Hitilafu.', 'e'); }
    });
}

