<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>CSCMS Pro V4 — Enterprise Full Control</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<style>
:root{--bg:#07111f;--panel:#0d1929;--panel2:#122238;--line:#21344d;--text:#e8f0f8;--muted:#8ea3b9;--p:#16a979;--p2:#35d39b;--p3:#0d8a63;--blue:#3b82f6;--red:#ef4444;--yellow:#f59e0b;--purple:#8b5cf6;--orange:#f97316;--radius:12px;--font:'Inter',system-ui,sans-serif}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:linear-gradient(135deg,#06101c,#0a1423);color:var(--text);font-family:var(--font);line-height:1.5;-webkit-font-smoothing:antialiased;overflow-x:hidden}
button,input,select,textarea{font:inherit}button{cursor:pointer;border:0;background:none}a{color:var(--p2);text-decoration:none}img,video{max-width:100%;display:block}
.hidden{display:none!important}
::-webkit-scrollbar{width:6px;height:6px}::-webkit-scrollbar-track{background:var(--panel)}::-webkit-scrollbar-thumb{background:var(--line);border-radius:3px}::-webkit-scrollbar-thumb:hover{background:var(--p3)}

.btn{border:0;border-radius:9px;padding:10px 16px;font-weight:600;font-size:12px;display:inline-flex;align-items:center;justify-content:center;gap:8px;transition:all .2s;white-space:nowrap}
.btn:hover{filter:brightness(1.1);transform:translateY(-1px)}.btn:active{transform:translateY(0)}.btn:disabled{opacity:.5;pointer-events:none}
.btn-sm{padding:6px 10px;font-size:11px;border-radius:6px}
.primary{background:var(--p);color:#fff}.outline{background:transparent;color:var(--p2);border:1px solid var(--p)}.danger{background:var(--red);color:#fff}.info{background:var(--blue);color:#fff}.warning{background:var(--yellow);color:#111}.purple{background:var(--purple);color:#fff}.orange{background:var(--orange);color:#fff}.mutedbtn{background:var(--panel2);color:var(--text);border:1px solid var(--line)}.ghost{background:transparent;color:var(--muted);padding:6px 8px}.ghost:hover{color:var(--p2);background:rgba(22,169,121,.06)}

.flex{display:flex}.flex-center{display:flex;align-items:center;justify-content:center}.flex-between{display:flex;align-items:center;justify-content:space-between}.gap-xs{gap:4px}.gap-sm{gap:8px}.gap-md{gap:12px}.gap-lg{gap:16px}.wrap{flex-wrap:wrap}.col{flex-direction:column}
.small{font-size:11px;color:var(--muted)}.tiny{font-size:10px;color:var(--muted)}.b{font-weight:700}.mono{font-family:'Courier New',monospace}

.container{max-width:1200px;margin:0 auto;padding:20px}
.row2{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.row3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.row4{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.auto-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px}
.metrics-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:18px}

.card{background:rgba(13,25,41,.96);border:1px solid var(--line);border-radius:var(--radius);padding:18px;transition:border-color .25s,box-shadow .25s}
.card:hover{border-color:rgba(22,169,121,.15);box-shadow:0 4px 20px rgba(0,0,0,.2)}
.metric-card{display:flex;align-items:center;gap:14px;padding:14px 18px}
.metric-icon{width:44px;height:44px;border-radius:10px;display:grid;place-items:center;font-size:18px;flex-shrink:0}
.metric-card h3{font-size:22px;margin:2px 0 0;line-height:1.2}.metric-card p{font-size:11px;color:var(--muted);margin:0}

.section-head{display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:16px}
.section-head h2,.section-head h3{margin:0}
.actions{display:flex;gap:6px;flex-wrap:wrap}

.field{margin:11px 0}.field label{display:block;font-size:11px;color:var(--muted);margin-bottom:5px;font-weight:600;text-transform:uppercase;letter-spacing:.5px}
.field input,.field select,.field textarea{width:100%;padding:11px 12px;border:1px solid var(--line);background:#091625;color:var(--text);border-radius:8px;outline:none;transition:border-color .2s;font-size:13px}
.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--p);box-shadow:0 0 0 3px rgba(22,169,121,.06)}

.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:10px;max-height:500px}
.table{width:100%;border-collapse:collapse;font-size:12px}
.table th,.table td{padding:9px 12px;border-bottom:1px solid var(--line);text-align:left;white-space:nowrap}
.table th{background:#101f33;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.6px;position:sticky;top:0;z-index:2}
.table tr:hover td{background:rgba(22,169,121,.03)}
.table .act-btns{display:flex;gap:4px}

.badge{padding:3px 9px;border-radius:20px;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;background:#18304a;color:var(--muted);display:inline-block}
.ok{background:#0b3a2c;color:#55e1ae}.warn{background:#3c2b08;color:#ffc857}.bad{background:#40151a;color:#ff7b85}.info-b{background:#0c2d4a;color:#60a5fa}

.modal{position:fixed;inset:0;background:rgba(0,0,0,.72);display:none;align-items:center;justify-content:center;z-index:100;padding:15px;backdrop-filter:blur(5px)}
.modal.show{display:flex}
.modal-card{width:min(740px,100%);max-height:90vh;overflow-y:auto;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:24px;animation:modalIn .22s ease}
@keyframes modalIn{from{opacity:0;transform:translateY(16px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}
.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}
.close{color:var(--muted);font-size:22px;transition:color .15s}.close:hover{color:var(--red)}

.toast-container{position:fixed;right:18px;bottom:18px;z-index:200;display:flex;flex-direction:column;gap:8px;max-width:360px}
.toast{background:#10243a;border:1px solid var(--p);padding:12px 18px;border-radius:9px;box-shadow:0 8px 24px rgba(0,0,0,.4);color:var(--text);font-size:13px;display:flex;align-items:center;gap:10px;animation:toastIn .3s ease}
.toast.error{border-color:var(--red)}.toast.success{border-color:var(--p)}.toast.warning{border-color:var(--yellow)}
@keyframes toastIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}

.landing{min-height:100vh}.hero{text-align:center;padding:65px 20px 30px}
.logo{width:72px;height:72px;border-radius:18px;background:linear-gradient(135deg,var(--p),#07563f);display:grid;place-items:center;margin:0 auto;font-size:30px;color:#fff;overflow:hidden}.logo img{width:100%;height:100%;object-fit:cover}
.brand{font-size:40px;font-weight:800;margin:12px 0 5px}.tag{color:var(--muted);font-size:14px}.hero-actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:25px}
.locale-bar{display:flex;gap:6px;justify-content:center;margin-top:14px;flex-wrap:wrap}
.locale-btn{padding:4px 12px;border-radius:16px;font-size:11px;font-weight:600;background:var(--panel2);color:var(--muted);border:1px solid var(--line);cursor:pointer;transition:all .2s}
.locale-btn:hover,.locale-btn.active{background:var(--p);color:#fff;border-color:var(--p)}

.auth{min-height:100vh;display:grid;place-items:center;padding:20px)}.auth-card{width:min(520px,100%);background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:28px}
.member-reg-screen{min-height:100vh;display:grid;place-items:center;padding:20px}.member-reg-card{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:30px;width:min(640px,100%);position:relative}.mr-back{position:absolute;top:15px;left:15px;color:var(--muted);font-size:16px;display:flex;align-items:center;gap:5px}.mr-back:hover{color:var(--p2)}

.app-layout{min-height:100vh;display:flex}
.sidebar{width:260px;min-height:100vh;background:#091625;border-right:1px solid var(--line);overflow-y:auto;position:fixed;left:0;top:0;bottom:0;z-index:20;transition:transform .3s}
.side-head{padding:16px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:10px}
.side-head h4{margin:0;font-size:14px}.side-head .role-tag{font-size:10px;padding:2px 8px;border-radius:12px;background:var(--p);color:#fff;font-weight:700}
.nav-section{padding:8px 12px}.nav-label{font-size:9px;color:#4a6580;text-transform:uppercase;margin:12px 6px 4px;font-weight:700;letter-spacing:1px}
.nav-btn{width:100%;text-align:left;color:var(--muted);padding:9px 12px;border-radius:7px;display:flex;align-items:center;gap:9px;font-size:12px;font-weight:500;transition:all .15s}
.nav-btn:hover{background:#10243a;color:var(--text)}.nav-btn.active{background:rgba(22,169,121,.1);color:var(--p2);font-weight:600}.nav-btn i{width:20px;text-align:center;font-size:13px}

.main-area{margin-left:260px;flex:1;min-height:100vh;display:flex;flex-direction:column}
.top-bar{height:58px;position:sticky;top:0;z-index:15;background:rgba(9,22,37,.95);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;padding:0 20px}
.content-area{padding:22px;flex:1}
.search-box{display:flex;align-items:center;gap:6px;background:var(--panel2);border:1px solid var(--line);border-radius:7px;padding:0 10px}.search-box input{background:transparent;border:0;color:var(--text);padding:7px;outline:none;font-size:12px;width:150px}

.super{min-height:100vh}.super-top{padding:16px 22px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;background:var(--panel)}
.super-body{display:flex;min-height:calc(100vh - 52px)}.super-nav{width:220px;background:#091625;border-right:1px solid var(--line);padding:12px 8px;overflow-y:auto}.super-content{flex:1;padding:22px;overflow-y:auto;max-height:calc(100vh - 52px)}
.snav-btn{width:100%;text-align:left;color:var(--muted);padding:9px 12px;border-radius:7px;display:flex;align-items:center;gap:8px;font-size:12px;transition:all .15s;font-weight:500}
.snav-btn:hover{background:#10243a;color:var(--text)}.snav-btn.active{background:rgba(239,68,68,.12);color:var(--red);font-weight:600}.snav-btn i{width:18px;text-align:center}

.chart-box{height:220px;position:relative}
.pricing-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;max-width:1000px;margin:0 auto}
.price-card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:30px 25px;text-align:left;transition:all .3s;position:relative}
.price-card:hover{transform:translateY(-5px);border-color:var(--p)}.price-amount{font-size:36px;font-weight:800;margin:10px 0}.price-amount span{font-size:14px;color:var(--muted);font-weight:400}
.id-reminder-card{width:min(480px,100%);text-align:center;padding:32px 28px!important}
.id-reminder-icon{width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,var(--p),#07563f);display:grid;place-items:center;margin:0 auto 18px;font-size:28px;color:#fff;box-shadow:0 6px 24px rgba(22,169,121,.3)}
.id-display-box{background:linear-gradient(135deg,#0a1e33,#0d2236);border:2px solid var(--p);border-radius:12px;padding:16px 20px;margin-bottom:22px}
.id-label{display:block;font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;font-weight:700;margin-bottom:6px}.id-value{display:block;font-size:20px;font-weight:800;color:var(--p2);letter-spacing:1.5px;word-break:break-all}

.toggle-switch{position:relative;width:40px;height:20px;background:var(--panel2);border-radius:20px;cursor:pointer;border:1px solid var(--line);transition:all .2s;flex-shrink:0}
.toggle-switch.active{background:var(--p);border-color:var(--p)}.toggle-switch::after{content:'';position:absolute;top:2px;left:2px;width:14px;height:14px;background:#fff;border-radius:50%;transition:transform .2s}.toggle-switch.active::after{transform:translateX(20px)}
.progress-bar{width:100%;height:6px;background:var(--panel2);border-radius:3px;overflow:hidden;margin-top:8px}.progress-fill{height:100%;background:var(--p);width:0%;transition:width 0.2s}
.divider{border:0;border-top:1px solid var(--line);margin:14px 0}

#networkBanner{position:fixed;top:0;left:0;right:0;z-index:300;padding:10px;text-align:center;font-size:12px;font-weight:700;display:none;transition:all .3s}
#networkBanner.offline{background:var(--red);color:#fff;display:block}#networkBanner.online{background:var(--p);color:#fff;display:block}

.su-field{margin:10px 0}.su-field label{display:block;font-size:11px;color:var(--muted);margin-bottom:5px;font-weight:600;text-transform:uppercase;letter-spacing:.5px}
.su-input-wrap{position:relative;display:flex;align-items:center}.su-input-wrap .su-input-icon{position:absolute;left:12px;color:var(--muted);font-size:13px;pointer-events:none;z-index:1}
.su-input-wrap input,.su-input-wrap select{width:100%;padding:11px 12px 11px 38px;border:1px solid var(--line);background:#091625;color:var(--text);border-radius:8px;outline:none;font-size:13px}.su-input-wrap input:focus,.su-input-wrap select:focus{border-color:var(--p)}
.su-row{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.su-row3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.su-submit{width:100%;margin-top:18px;padding:13px 16px;font-size:14px;font-weight:700;border-radius:10px;background:linear-gradient(135deg,var(--p),#0d8a63);color:#fff;border:0;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:10px;transition:all .25s;box-shadow:0 4px 16px rgba(22,169,121,.2)}.su-submit:hover{filter:brightness(1.12);transform:translateY(-2px)}.su-submit:disabled{opacity:.55;pointer-events:none;filter:none;transform:none}

@media(max-width:900px){.sidebar{transform:translateX(-100%)}.sidebar.open{transform:translateX(0)}.main-area{margin-left:0}.super-nav{width:180px}.row2,.row3,.row4,.su-row,.su-row3{grid-template-columns:1fr}.top-bar{padding:0 12px}.content-area{padding:14px}.brand{font-size:30px}.search-box input{width:100px}}
@media(max-width:600px){.hero-actions{flex-direction:column;align-items:center}.hero-actions .btn{width:100%;max-width:280px}.super-body{flex-direction:column}.super-nav{width:100%;border-right:0;border-bottom:1px solid var(--line);display:flex;flex-wrap:wrap;gap:4px;padding:8px}.snav-btn{width:auto;padding:6px 10px;font-size:11px}.super-content{max-height:none}}
</style>
</head>
<body>

<div id="networkBanner"><i class="fa-solid fa-wifi-slash"></i> <span data-t="offlineMode">Offline Mode</span></div>

<!-- LANDING -->
<div id="landing" class="landing">
<section class="hero">
  <div class="logo" id="systemLogoContainer"><i class="fa-solid fa-people-group" style="font-size:36px" id="defaultLogoIcon"></i></div>
  <div class="brand" data-t="brandName">CSCMS Pro V4</div>
  <div class="tag" data-t="tagline">Community Savings &bull; Microfinance &bull; Shares &bull; Loans &bull; Governance</div>
  <div class="locale-bar" id="localeBar"></div>
  <div class="hero-actions" style="margin-top:25px">
    <button class="btn primary" onclick="showScreen('auth')"><i class="fa-solid fa-right-to-bracket"></i> <span data-t="signIn">Sign In</span></button>
    <button class="btn outline" onclick="showScreen('memberRegScreen')"><i class="fa-solid fa-user-plus"></i> <span data-t="signUp">Sign Up</span></button>
    <button class="btn mutedbtn" onclick="openModal('superLoginModal')"><i class="fa-solid fa-shield-halved"></i> <span data-t="superAdmin">Super Admin</span></button>
  </div>
</section>
<div class="container"><div class="section-head"><h2 data-t="sysAnnounce">System Announcements</h2></div><div id="publicAds" class="auto-grid"></div></div>
<div style="padding:60px 20px 80px;text-align:center">
  <h2 data-t="plansPricing">Plans & Pricing</h2>
  <div class="pricing-grid">
    <div class="price-card"><h3>Free Trial</h3><div class="price-amount">$0<span>/mo</span></div><p class="small" data-t="planFreeDesc">1 Month Trial, Up to 15 Members</p><button class="btn outline" style="width:100%;justify-content:center;margin-top:15px" onclick="showScreen('memberRegScreen')">Get Started</button></div>
    <div class="price-card" style="border-color:var(--p)"><h3>Basic</h3><div class="price-amount">$29<span>/mo</span></div><p class="small" data-t="planBasicDesc">1 Group, Up to 50 Members</p><button class="btn primary" style="width:100%;justify-content:center;margin-top:15px" onclick="showScreen('memberRegScreen')">Choose Basic</button></div>
    <div class="price-card"><h3>Pro</h3><div class="price-amount">$79<span>/mo</span></div><p class="small" data-t="planProDesc">5 Groups, Up to 500 Members</p><button class="btn info" style="width:100%;justify-content:center;margin-top:15px" onclick="showScreen('memberRegScreen')">Choose Pro</button></div>
  </div>
</div>
</div>

<!-- SIGN UP -->
<div id="memberRegScreen" class="member-reg-screen hidden">
<div class="member-reg-card">
  <button class="mr-back" onclick="showScreen('landing')"><i class="fa-solid fa-arrow-left"></i> <span data-t="back">Back</span></button>
  <div style="text-align:center;margin-bottom:24px"><div class="logo" style="width:56px;height:56px;font-size:24px;margin-bottom:14px"><i class="fa-solid fa-user-plus"></i></div><h2 data-t="registerGroup">Register Group</h2><p class="small" data-t="offlineNote">Works Offline. Will sync when online.</p></div>
  <form id="signUpForm" autocomplete="off" novalidate>
    <div class="su-row3">
      <div class="su-field"><label data-t="firstName">First Name *</label><div class="su-input-wrap"><input id="suFname" required placeholder="First name"><i class="fa-solid fa-user su-input-icon"></i></div></div>
      <div class="su-field"><label data-t="middleName">Middle Name</label><div class="su-input-wrap"><input id="suMname" placeholder="Middle name"><i class="fa-solid fa-user su-input-icon"></i></div></div>
      <div class="su-field"><label data-t="lastName">Last Name *</label><div class="su-input-wrap"><input id="suLname" required placeholder="Last name"><i class="fa-solid fa-user su-input-icon"></i></div></div>
    </div>
    <div class="su-row">
      <div class="su-field"><label data-t="nationalId">National ID *</label><div class="su-input-wrap"><input id="suNida" required placeholder="e.g. 12345678"><i class="fa-solid fa-id-card su-input-icon"></i></div></div>
      <div class="su-field"><label data-t="phone">Phone *</label><div class="su-input-wrap"><input id="suPhone" type="tel" required placeholder="+255 700 000 000"><i class="fa-solid fa-phone su-input-icon"></i></div></div>
    </div>
    <div class="su-row">
      <div class="su-field"><label data-t="groupType">Group Type *</label><div class="su-input-wrap"><select id="suGroupType" required><option value="">Select...</option><option value="rosca">ROSCA</option><option value="asca">ASCA</option><option value="vsla">VSLA</option><option value="sacco">SACCO</option></select><i class="fa-solid fa-layer-group su-input-icon"></i></div></div>
      <div class="su-field"><label data-t="groupName">Group Name *</label><div class="su-input-wrap"><input id="suGroupName" required placeholder="Group name..."><i class="fa-solid fa-building su-input-icon"></i></div></div>
    </div>
    <div class="su-row">
      <div class="su-field"><label data-t="country">Country *</label><div class="su-input-wrap"><select id="suCountry" required><option value="">Select...</option><option>Tanzania</option><option>Kenya</option><option>Uganda</option></select><i class="fa-solid fa-globe su-input-icon"></i></div></div>
      <div class="su-field"><label data-t="password">Password *</label><div class="su-input-wrap"><input id="suPassword" type="password" minlength="6" required placeholder="Min 6 chars"><i class="fa-solid fa-lock su-input-icon"></i></div></div>
    </div>
    <button class="su-submit" type="submit" id="suSubmitBtn"><i class="fa-solid fa-user-plus"></i> <span data-t="signUp">Sign Up</span></button>
  </form>
</div>
</div>

<!-- ID REMINDER -->
<div id="idReminderModal" class="modal">
<div class="modal-card id-reminder-card">
  <div class="id-reminder-icon"><i class="fa-solid fa-check"></i></div>
  <h2 data-t="regSuccess">Registration Successful!</h2>
  <p class="small" style="margin-bottom:20px" data-t="copyIdNote">Please <strong>COPY</strong> your ID.</p>
  <div class="id-display-box"><span class="id-label" data-t="yourGroupId">Your Group ID</span><span class="id-value" id="displayedUserId">---</span></div>
  <button class="btn primary" style="width:100%" onclick="navigator.clipboard.writeText(document.getElementById('displayedUserId').innerText);showToast('ID Copied!','success')"><i class="fa-solid fa-copy"></i> <span data-t="copyId">COPY ID</span></button>
</div>
</div>

<!-- SIGN IN -->
<div id="auth" class="auth hidden">
<div class="auth-card">
  <div class="modal-head"><h2 data-t="signIn">Sign In</h2><button class="close" onclick="showScreen('landing')">&times;</button></div>
  <form id="signInForm">
    <div class="field"><label data-t="groupId">Group ID *</label><input id="loginGroupId" required></div>
    <div class="field"><label data-t="nationalId">National ID *</label><input id="loginNida" required></div>
    <div class="field"><label data-t="password">Password *</label><input id="loginPassword" type="password" required></div>
    <button class="btn primary" type="submit" style="width:100%;margin-top:12px" id="siSubmitBtn"><i class="fa-solid fa-right-to-bracket"></i> <span data-t="signIn">Sign In</span></button>
  </form>
</div>
</div>

<!-- SUPER ADMIN -->
<div id="super" class="super hidden">
<div class="super-top">
  <div class="flex gap-sm" style="align-items:center"><i class="fa-solid fa-shield-halved" style="color:var(--red);font-size:18px"></i><b style="font-size:15px">SUPER ADMIN</b><span class="badge bad">FULL CONTROL</span></div>
  <button class="btn outline btn-sm" onclick="logoutSuper()"><i class="fa-solid fa-right-from-bracket"></i> Logout</button>
</div>
<div class="super-body">
  <nav class="super-nav" id="superNav"></nav>
  <div class="super-content" id="superContent"></div>
</div>
</div>

<!-- MAIN APP -->
<div id="app" class="app-layout hidden">
<aside id="sidebar" class="sidebar">
  <div class="side-head">
    <i class="fa-solid fa-people-group" style="color:var(--p2);font-size:20px"></i>
    <div><h4 id="sideGroup">CSCMS</h4><span class="role-tag" id="sideRole">Chair</span></div>
  </div>
  <div id="navContainer" class="nav-section"></div>
</aside>
<main class="main-area">
  <header class="top-bar">
    <div class="flex gap-md" style="align-items:center">
      <button class="ghost" onclick="toggleSidebar()"><i class="fa-solid fa-bars" style="font-size:16px"></i></button>
      <b id="pageTitle">Dashboard</b>
    </div>
    <div class="flex gap-md" style="align-items:center">
      <span class="small" id="topUser"></span>
      <button class="btn outline btn-sm" onclick="logout()"><i class="fa-solid fa-right-from-bracket"></i></button>
    </div>
  </header>
  <div class="content-area" id="contentArea"></div>
</main>
</div>

<!-- MODALS -->
<div id="superLoginModal" class="modal"><div class="modal-card" style="width:min(400px,100%)"><div class="modal-head"><h3><i class="fa-solid fa-shield-halved" style="color:var(--red)"></i> Super Admin</h3><button class="close" onclick="closeModal('superLoginModal')">&times;</button></div><form id="superLoginForm"><div class="field"><label>Email</label><input id="superEmail" type="email" required></div><div class="field"><label>Password</label><input id="superPass" type="password" required></div><button class="btn danger" style="width:100%" type="submit"><i class="fa-solid fa-right-to-bracket"></i> Sign In</button></form></div></div>

<div id="formModal" class="modal"><div class="modal-card"><div class="modal-head"><h3 id="formModalTitle">Form</h3><button class="close" onclick="closeModal('formModal')">&times;</button></div><div id="formModalBody"></div></div></div>

<div id="shareModal" class="modal">
  <div class="modal-card" style="width:min(450px,100%);text-align:center">
    <div class="modal-head"><h3>Share Report</h3><button class="close" onclick="closeModal('shareModal')">&times;</button></div>
    <p class="small" id="shareStatus">Generating shareable link...</p>
    <div id="shareLinkBox" class="id-display-box" style="display:none;margin-top:15px">
      <span class="id-label">REPORT LINK</span>
      <span class="id-value" id="shareUrlValue" style="font-size:13px">---</span>
    </div>
    <div class="flex col gap-sm" style="margin-top:20px">
      <button class="btn primary" id="btnShareWhatsApp" disabled onclick="shareToWhatsApp()"><i class="fa-brands fa-whatsapp"></i> Share to WhatsApp</button>
      <button class="btn purple" id="btnShareInstagram" disabled onclick="shareToInstagram()"><i class="fa-brands fa-instagram"></i> Share to Instagram</button>
      <button class="btn outline" id="btnCopyLink" disabled onclick="copyShareLink()"><i class="fa-solid fa-copy"></i> Copy Link</button>
      <button class="btn info" id="btnNativeShare" style="display:none" onclick="nativeShare()"><i class="fa-solid fa-share-nodes"></i> More Apps</button>
    </div>
  </div>
</div>

<div id="toastContainer" class="toast-container"></div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
import { getAuth, createUserWithEmailAndPassword, signInWithEmailAndPassword, signOut } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";
import { getFirestore, enableMultiTabIndexedDbPersistence, collection, doc, setDoc, addDoc, getDoc, updateDoc, deleteDoc, onSnapshot, query, orderBy, serverTimestamp, Timestamp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";
import { getStorage, ref, uploadBytes, getDownloadURL } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-storage.js";

const firebaseConfig = {
  apiKey:"AIzaSyDSUs6uUjQTPQOkUPcIp2u8Rw9NJVnQOfo",
  authDomain:"ncrs2-f8da9.firebaseapp.com",
  projectId:"ncrs2-f8da9",
  storageBucket:"ncrs2-f8da9.firebasestorage.app",
  messagingSenderId:"436069918682",
  appId:"1:436069918682:web:70b56c627315bc782102e3"
};

const fbApp = initializeApp(firebaseConfig);
const auth = getAuth(fbApp);
const db = getFirestore(fbApp);
const storage = getStorage(fbApp);

try { await enableMultiTabIndexedDbPersistence(db); } catch(e) { console.log("Persistence:", e); }

let currentUser=null, currentGroup=null, currentRole='chair', currentGroupId=null;
const superAdminUid="P9jl4qlk64gXXkk7tegabJpXwaB2";
let membersCache=[], savingsCache=[], loansCache=[], cashCache=[], auditCache=[];
let superGroupsCache=[], superUsersCache=[], superAuditCache=[];
let superActiveTab='sg-groups', activeSection='dashboard', currentShareUrl = '';

let systemSettings = { branding:{logoUrl:null,logoEnabled:false} };
let currentLang='en';

const i18n={en:{brandName:"CSCMS Pro V4",tagline:"Community Savings &bull; Microfinance &bull; Shares &bull; Loans &bull; Governance",signIn:"Sign In",signUp:"Sign Up",superAdmin:"Super Admin",sysAnnounce:"System Announcements",plansPricing:"Plans & Pricing",offlineMode:"Offline Mode",back:"Back",registerGroup:"Register Group",offlineNote:"Works Offline. Will sync when online.",regSuccess:"Registration Successful!",copyIdNote:"Please <strong>COPY</strong> your ID.",yourGroupId:"Your Group ID",copyId:"COPY ID",logout:"Logout"},sw:{brandName:"CSCMS Pro V4",tagline:"Akiba za Jamii &bull; Mikopo Madogo &bull; Hisa &bull; Mikopo &bull; Utawala",signIn:"Ingia",signUp:"Jisajili",superAdmin:"Msimamizi Mkuu",sysAnnounce:"Matangazo ya Mfumo",plansPricing:"Mpango na Bei",offlineMode:"Hali ya Mtandao Kukatika",back:"Rudi",registerGroup:"Sajili Kikundi",offlineNote:"Hufanya kazi nje ya mtandao.",regSuccess:"Usajili Umefanikiwa!",copyIdNote:"Tafadhali <strong>COPY</strong> ID yako.",yourGroupId:"ID ya Kikundi Chako",copyId:"COPY ID",logout:"Toka"},fr:{brandName:"CSCMS Pro V4",tagline:"Épargne Communautaire &bull; Microfinance &bull; Actions &bull; Prêts &bull; Gouvernance",signIn:"Se Connecter",signUp:"S'inscrire",superAdmin:"Super Admin",sysAnnounce:"Annonces Système",plansPricing:"Forfaits et Tarifs",offlineMode:"Mode Hors Ligne",back:"Retour",registerGroup:"Enregistrer Groupe",offlineNote:"Fonctionne hors ligne.",regSuccess:"Inscription Réussie!",copyIdNote:"Veuillez <strong>COPIER</strong> votre ID.",yourGroupId:"Votre ID de Groupe",copyId:"COPIER ID",logout:"Déconnexion"}};

function applyTranslations(){const dict=i18n[currentLang]||i18n.en;document.querySelectorAll('[data-t]').forEach(el=>{const k=el.getAttribute('data-t');if(dict[k])el.innerHTML=dict[k];else if(i18n.en[k])el.innerHTML=i18n.en[k];});}

const $=id=>document.getElementById(id);const today=()=>new Date().toISOString().split('T')[0];const fmt=n=>(n||0).toLocaleString();
const fmtDate=d=>{if(!d)return'N/A';if(d instanceof Timestamp)return d.toDate().toLocaleDateString();if(d.seconds)return new Date(d.seconds*1000).toLocaleDateString();return new Date(d).toLocaleDateString();};
const fmtDateTime=d=>{if(!d)return'N/A';if(d instanceof Timestamp)return d.toDate().toLocaleString();if(d.seconds)return new Date(d.seconds*1000).toLocaleString();return new Date(d).toLocaleString();};
const statusBadge=(s)=>{const c={active:'ok',ACTIVE:'ok',trial:'info-b',COMPLETED:'ok',PENDING:'warn',APPROVED:'info-b',DISBURSED:'ok',PAID:'ok',default:'warn',suspended:'bad',expired:'bad',INACTIVE:'bad',SUSPENDED:'bad'};return`<span class="badge ${c[s]||c.default}">${s||'N/A'}</span>`;};

window.showScreen=(id)=>{document.querySelectorAll('.landing,.member-reg-screen,.auth,.app-layout,.super').forEach(e=>e.classList.add('hidden'));$(id).classList.remove('hidden');};
window.openModal=(id)=>$(id).classList.add('show');window.closeModal=(id)=>$(id).classList.remove('show');window.toggleSidebar=()=>$('sidebar').classList.toggle('open');

window.showToast=(msg,type='success')=>{const c=$('toastContainer'),t=document.createElement('div');t.className=`toast ${type}`;t.innerHTML=`<i class="fa-solid ${type==='error'?'fa-circle-exclamation':'fa-circle-check'}"></i> ${msg}`;c.appendChild(t);setTimeout(()=>{t.style.opacity='0';setTimeout(()=>t.remove(),300)},4000);};

function showConfirm(title,msg,onConfirm){const d=document.createElement('div');d.style.cssText='position:fixed;inset:0;background:rgba(0,0,0,.7);display:flex;align-items:center;justify-content:center;z-index:150;backdrop-filter:blur(3px)';d.innerHTML=`<div class="modal-card" style="width:min(400px,90%);text-align:center"><h3>${title}</h3><p class="small" style="margin:12px 0">${msg}</p><div class="flex gap-sm" style="justify-content:center"><button class="btn danger" id="cfYes">Confirm</button><button class="btn mutedbtn" id="cfNo">Cancel</button></div></div>`;document.body.appendChild(d);d.querySelector('#cfYes').onclick=()=>{d.remove();onConfirm()};d.querySelector('#cfNo').onclick=()=>d.remove();}

// PDF & Sharing
function generatePDF(title,headers,rows){const{jsPDF}=window.jspdf;const doc=new jsPDF();doc.setFontSize(16);doc.text(title,14,18);doc.setFontSize(10);doc.text(`Group: ${currentGroup?.name||'System'} | Date: ${new Date().toLocaleString()}`,14,26);doc.autoTable({startY:32,head:[headers],body:rows,styles:{fontSize:8,cellPadding:3},headStyles:{fillColor:[13,25,41],textColor:[232,240,248]}});return doc;}

window.pdfReport = (entity) => { let doc; if(entity==='members') doc=generatePDF('Members Report',['Name','NIDA','Status'],membersCache.map(m=>[m.name||`${m.firstName} ${m.lastName}`, m.nida, m.status||'ACTIVE'])); else if(entity==='savings') doc=generatePDF('Savings Report',['Member','Type','Amount'],savingsCache.map(s=>[s.memberName, s.type, fmt(s.amount)])); else if(entity==='loans') doc=generatePDF('Loans Report',['Member','Principal','Balance'],loansCache.map(l=>[l.memberName, fmt(l.principal), fmt(l.balance)])); else return; doc.save(`${entity}_${today()}.pdf`); showToast('PDF Downloaded!','success'); };

window.shareReport = async (entity) => {
  openModal('shareModal'); $('shareStatus').innerText = "Generating link..."; $('shareLinkBox').style.display='none'; $('btnShareWhatsApp').disabled=true; $('btnShareInstagram').disabled=true; $('btnCopyLink').disabled=true;
  let doc; if(entity==='members') doc=generatePDF('Members Report',['Name','NIDA','Status'],membersCache.map(m=>[m.name||`${m.firstName} ${m.lastName}`, m.nida, m.status||'ACTIVE'])); else if(entity==='savings') doc=generatePDF('Savings Report',['Member','Type','Amount'],savingsCache.map(s=>[s.memberName, s.type, fmt(s.amount)])); else if(entity==='loans') doc=generatePDF('Loans Report',['Member','Principal','Balance'],loansCache.map(l=>[l.memberName, fmt(l.principal), fmt(l.balance)])); else return;
  try {
    const blob = doc.output('blob'); const storageRef = ref(storage, `reports/${currentGroupId||'system'}/${entity}_${Date.now()}.pdf`);
    await uploadBytes(storageRef, blob); const url = await getDownloadURL(storageRef);
    currentShareUrl = url; $('shareStatus').innerText = "Link ready!"; $('shareLinkBox').style.display='block'; $('shareUrlValue').innerText = url;
    $('btnShareWhatsApp').disabled=false; $('btnShareInstagram').disabled=false; $('btnCopyLink').disabled=false;
    if(navigator.share) $('btnNativeShare').style.display='flex';
  } catch(e) { $('shareStatus').innerText = "Failed to generate link."; showToast("Share error", "error"); }
};
window.shareToWhatsApp = () => window.open(`https://api.whatsapp.com/send?text=Check%20out%20this%20report:%20${encodeURIComponent(currentShareUrl)}`, '_blank');
window.shareToInstagram = () => { navigator.clipboard.writeText(currentShareUrl); showToast("Link copied! Open Instagram and paste.", "success"); };
window.copyShareLink = () => { navigator.clipboard.writeText(currentShareUrl); showToast("Link copied to clipboard!", "success"); };
window.nativeShare = () => { if(navigator.share) navigator.share({ title: 'CSCMS Report', url: currentShareUrl }).catch(() => {}); };

// Offline Manager
const OfflineManager={queueKey:'cscms_offline_queue',getQueue(){return JSON.parse(localStorage.getItem(this.queueKey))||[];},saveQueue(q){localStorage.setItem(this.queueKey,JSON.stringify(q));},addToQueue(action,payload){const q=this.getQueue();q.push({id:Date.now(),action,payload});this.saveQueue(q);showToast("Saved Offline.","warning");},async processQueue(){let q=this.getQueue();if(q.length===0)return;showToast(`Syncing ${q.length} actions...`,"success");let s=0;for(let i=0;i<q.length;i++){const item=q[i];try{if(item.action==='SIGNUP'){await setDoc(doc(db,'groups',item.payload.groupId),item.payload.groupData);await setDoc(doc(db,'users',item.payload.userId),item.payload.userData);}s++;}catch(e){}}if(s>0){this.saveQueue([]);showToast(`${s} synced!`,"success");}}};
function updateNetworkUI(isOnline){const b=$('networkBanner');if(isOnline){b.className='online';b.innerHTML='<i class="fa-solid fa-wifi"></i> Back Online';setTimeout(()=>{b.style.display='none';},3000);OfflineManager.processQueue();}else{b.className='offline';b.innerHTML='<i class="fa-solid fa-wifi-slash"></i> Offline Mode';}}
window.addEventListener('online',()=>updateNetworkUI(true));window.addEventListener('offline',()=>updateNetworkUI(false));if(!navigator.onLine)updateNetworkUI(false);

// Branding
onSnapshot(doc(db,'systemSettings','branding'),(snap)=>{if(snap.exists())systemSettings.branding={...systemSettings.branding,...snap.data()};const lc=$('systemLogoContainer');if(systemSettings.branding.logoEnabled&&systemSettings.branding.logoUrl)lc.innerHTML=`<img src="${systemSettings.branding.logoUrl}" alt="Logo">`;else lc.innerHTML=`<i class="fa-solid fa-people-group" style="font-size:36px"></i>`;});
function renderLocaleBar(){const bar=$('localeBar');if(!bar)return;bar.innerHTML='';[{code:'en',name:'English'},{code:'sw',name:'Kiswahili'}].forEach(l=>{bar.innerHTML+=`<button class="locale-btn ${l.code===currentLang?'active':''}" onclick="switchLanguage('${l.code}')">${l.name}</button>`;});}
window.switchLanguage=(code)=>{currentLang=code;applyTranslations();renderLocaleBar();};

// Audit
async function addAudit(action,entity,details=''){try{if(currentGroupId) await addDoc(collection(db,'groups',currentGroupId,'audit'),{action,entity,details,user:`${currentUser?.firstName||''} ${currentUser?.lastName||''}`,role:currentRole,date:serverTimestamp()}); else await addDoc(collection(db,'auditLogs'),{action,entity,details,timestamp:serverTimestamp(),userId:auth.currentUser?.uid||'System'});}catch(e){}}

// Role Helpers
function isChair(){return currentRole==='chair'}function canEdit(){return isChair()}function canDelete(){return isChair()}function canAdd(){return isChair()}

// Auth
 $('signUpForm').addEventListener('submit',async e=>{e.preventDefault();const btn=$('suSubmitBtn');btn.disabled=true;btn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Processing...';try{const fname=$('suFname').value.trim(),lname=$('suLname').value.trim(),mname=$('suMname').value.trim(),nida=$('suNida').value.trim(),phone=$('suPhone').value.trim(),groupType=$('suGroupType').value,groupName=$('suGroupName').value.trim(),country=$('suCountry').value,password=$('suPassword').value;const groupId=doc(collection(db,'groups')).id;const expiry=new Date(Date.now()+30*24*60*60*1000);const groupData={name:groupName,type:groupType,country,plan:'free',status:'trial',expiryDate:expiry,createdAt:serverTimestamp(),currency:'TZS'};if(!navigator.onLine){const userData={firstName:fname,lastName:lname,middleName:mname,nida,phone,role:'chair',groupId,status:'ACTIVE'};OfflineManager.addToQueue('SIGNUP',{groupId,userId:'pending_'+nida,groupData,userData});$('displayedUserId').textContent=groupId;openModal('idReminderModal');}else{const pseudoEmail=`${nida}@cscms.app`;const cred=await createUserWithEmailAndPassword(auth,pseudoEmail,password);const userId=cred.user.uid;await setDoc(doc(db,'groups',groupId),{...groupData,chairpersonId:userId});await setDoc(doc(db,'users',userId),{firstName:fname,lastName:lname,middleName:mname,nida,phone,role:'chair',groupId,status:'ACTIVE',createdAt:serverTimestamp()});$('displayedUserId').textContent=groupId;openModal('idReminderModal');showToast("Registration successful!","success");addAudit('USER_SIGNUP','Auth',groupId);}}catch(err){if(err.code==='auth/email-already-in-use')showToast("ID already registered.","error");else showToast(err.message,"error");}finally{btn.disabled=false;btn.innerHTML='<i class="fa-solid fa-user-plus"></i> Sign Up';}});

 $('signInForm').addEventListener('submit',async e=>{e.preventDefault();if(!navigator.onLine)return showToast("Sign In requires internet.","error");const btn=$('siSubmitBtn');btn.disabled=true;btn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Signing In...';try{const groupId=$('loginGroupId').value.trim(),nida=$('loginNida').value.trim(),password=$('loginPassword').value;const pseudoEmail=`${nida}@cscms.app`;const cred=await signInWithEmailAndPassword(auth,pseudoEmail,password);const userId=cred.user.uid;const userDoc=await getDoc(doc(db,'users',userId));if(!userDoc.exists()||userDoc.data().groupId!==groupId){await signOut(auth);return showToast("Invalid Group ID.","error")}const userData=userDoc.data();if(userData.status==='SUSPENDED'){await signOut(auth);return showToast("Account suspended.","error")}const groupDoc=await getDoc(doc(db,'groups',groupId));const groupData=groupDoc.data();if(groupData.status==='suspended'){await signOut(auth);return showToast("Group suspended.","error")}currentUser={uid:userId,...userData};currentGroup={id:groupId,...groupData};currentGroupId=groupId;currentRole=userData.role||'member';showToast("Welcome!","success");initApp();}catch(err){showToast("Invalid credentials.","error");}finally{btn.disabled=false;btn.innerHTML='<i class="fa-solid fa-right-to-bracket"></i> Sign In';}});

window.logout=()=>signOut(auth).then(()=>{currentUser=null;currentGroup=null;showScreen('landing');showToast("Logged out","success")});
window.logoutSuper=()=>{signOut(auth);showScreen('landing')};

 $('superLoginForm').addEventListener('submit',async e=>{e.preventDefault();try{const res=await signInWithEmailAndPassword(auth,$('superEmail').value,$('superPass').value);if(res.user.uid===superAdminUid){closeModal('superLoginModal');showScreen('super');initSuperAdmin();showToast("Welcome Super Admin","success")}else{await signOut(auth);showToast("Not authorized.","error")}}catch(err){showToast(err.message,"error")}});

// App Init
function initApp(){showScreen('app');$('sideGroup').textContent=currentGroup.name;$('sideRole').textContent=isChair()?'Chairperson':'Member';$('topUser').textContent=`${currentUser.firstName} ${currentUser.lastName}`;buildNav();loadAllData();navigateTo('dashboard');}

const navItems=[{id:'dashboard',icon:'fa-gauge-high',label:'Dashboard'},{section:'Management'},{id:'members',icon:'fa-users',label:'Members'},{section:'Finance'},{id:'savings',icon:'fa-piggy-bank',label:'Savings'},{id:'loans',icon:'fa-hand-holding-dollar',label:'Loans'},{section:'Accounting'},{id:'expenses',icon:'fa-receipt',label:'Income & Expense'},{section:'System'},{id:'audit',icon:'fa-clipboard-list',label:'Audit Trail'}];
function buildNav(){
  const nav=$('navContainer');
  // Members only see sections relevant to their own account.
  const memberAllowed = new Set(['dashboard','members','savings','loans']);
  const visibleItems = isChair() ? navItems : navItems.filter(item => !item.id || memberAllowed.has(item.id));
  nav.innerHTML=visibleItems.map(item=>{
    if(item.section) return `<div class="nav-label">${item.section}</div>`;
    return `<button class="nav-btn" data-nav="${item.id}" onclick="navigateTo('${item.id}')"><i class="fa-solid ${item.icon}"></i> ${item.label}</button>`;
  }).join('');
}
window.navigateTo=(id)=>{
  const memberAllowed = new Set(['dashboard','members','savings','loans']);
  if(!isChair()&&!memberAllowed.has(id)){showToast('This section is available to the Chairperson only.','error');return;}
  activeSection=id;
  document.querySelectorAll('.nav-btn').forEach(b=>b.classList.toggle('active',b.dataset.nav===id));
  const item=navItems.find(n=>n.id===id);
  $('pageTitle').textContent=item?item.label:id;
  renderSection(id);
};

function col(name){return collection(db,'groups',currentGroupId,name)}
function isOwnMemberRecord(record){
  if(isChair()) return true;
  const nida=String(currentUser?.nida||'').trim();
  return !!nida && String(record?.nida||'').trim()===nida;
}
function isOwnTransaction(record){
  if(isChair()) return true;
  const nida=String(currentUser?.nida||'').trim();
  const ownMember=membersCache.find(m=>String(m.nida||'').trim()===nida);
  return !!ownMember && (record?.memberId===ownMember.id ||
    (record?.memberNida && String(record.memberNida).trim()===nida) ||
    (record?.nida && String(record.nida).trim()===nida));
}
function loadAllData(){
  onSnapshot(col('members'),s=>{
    const all=s.docs.map(d=>({id:d.id,...d.data()}));
    membersCache=isChair()?all:all.filter(isOwnMemberRecord);
    if(activeSection==='members'||activeSection==='dashboard')renderSection(activeSection);
  });
  onSnapshot(col('savings'),s=>{
    const all=s.docs.map(d=>({id:d.id,...d.data()}));
    savingsCache=isChair()?all:all.filter(isOwnTransaction);
    if(activeSection==='savings'||activeSection==='dashboard')renderSection(activeSection);
  });
  onSnapshot(col('loans'),s=>{
    const all=s.docs.map(d=>({id:d.id,...d.data()}));
    loansCache=isChair()?all:all.filter(isOwnTransaction);
    if(activeSection==='loans'||activeSection==='dashboard')renderSection(activeSection);
  });
  onSnapshot(col('cash'),s=>{
    const all=s.docs.map(d=>({id:d.id,...d.data()}));
    cashCache=isChair()?all:all.filter(isOwnTransaction);
    if(activeSection==='expenses')renderSection('expenses');
  });
  onSnapshot(col('audit'),s=>{
    auditCache=isChair()?s.docs.map(d=>({id:d.id,...d.data()})):[];
    if(activeSection==='audit'&&isChair())renderSection('audit');
  });
}

function renderSection(id){const C=$('contentArea');switch(id){case 'dashboard':C.innerHTML=renderDashboard();break;case 'members':C.innerHTML=renderMembers();break;case 'savings':C.innerHTML=renderSavings();break;case 'loans':C.innerHTML=renderLoans();break;case 'expenses':C.innerHTML=renderExpenses();break;case 'audit':C.innerHTML=renderAudit();break;}}

function renderDashboard(){const totalSavings=savingsCache.filter(s=>s.type==='DEPOSIT').reduce((a,s)=>a+(s.amount||0),0);const loanPortfolio=loansCache.filter(l=>l.status==='DISBURSED').reduce((a,l)=>a+(l.balance||0),0);return`<div class="metrics-grid"><div class="card metric-card"><div class="metric-icon" style="background:rgba(0,214,143,.12);color:var(--p)"><i class="fa-solid fa-users"></i></div><div><p>Members</p><h3>${membersCache.length}</h3></div></div><div class="card metric-card"><div class="metric-icon" style="background:rgba(59,130,246,.12);color:var(--blue)"><i class="fa-solid fa-piggy-bank"></i></div><div><p>Total Savings</p><h3>${fmt(totalSavings)}</h3></div></div><div class="card metric-card"><div class="metric-icon" style="background:rgba(249,115,22,.12);color:var(--orange)"><i class="fa-solid fa-hand-holding-dollar"></i></div><div><p>Loan Portfolio</p><h3>${fmt(loanPortfolio)}</h3></div></div></div>`;}

function renderEntityTable(title, entity, cache, headers, rowsFunc){const rows=rowsFunc(cache);const pdfAction=`pdfReport('${entity}')`;const shareAction=`shareReport('${entity}')`;const addAction=canAdd()?`<button class="btn primary btn-sm" onclick="openFormModal('${entity}')"><i class="fa-solid fa-plus"></i> Add</button>`:'';return`<div class="section-head"><h2>${title} <span class="small">(${cache.length})</span></h2><div class="actions"><button class="btn info btn-sm" onclick="${pdfAction}"><i class="fa-solid fa-file-pdf"></i> PDF</button><button class="btn purple btn-sm" onclick="${shareAction}"><i class="fa-solid fa-share-nodes"></i> Share</button>${addAction}</div></div><div class="table-wrap"><table class="table"><thead><tr>${headers.map(h=>`<th>${h}</th>`).join('')}</tr></thead><tbody>${rows}</tbody></table></div>`;}

function renderMembers(){return renderEntityTable('Members','members',membersCache,['Name','NIDA','Phone','Status','Actions'],(cache)=>cache.map(m=>`<tr><td><b>${m.name||`${m.firstName} ${m.lastName}`}</b></td><td class="mono">${m.nida||'-'}</td><td>${m.phone||'-'}</td><td>${statusBadge(m.status||'ACTIVE')}</td><td class="act-btns">${canEdit()?`<button class="btn warning btn-sm" onclick="openFormModal('members','${m.id}')"><i class="fa-solid fa-pen"></i></button>`:''} ${canEdit()&&m.status!=='SUSPENDED'?`<button class="btn info btn-sm" onclick="suspendEntity('members','${m.id}')"><i class="fa-solid fa-ban"></i></button>`:''} ${canEdit()&&m.status==='SUSPENDED'?`<button class="btn ok btn-sm" onclick="reactivateEntity('members','${m.id}')"><i class="fa-solid fa-check"></i></button>`:''} ${canDelete()?`<button class="btn danger btn-sm" onclick="deleteEntity('members','${m.id}','${m.name||m.firstName}')"><i class="fa-solid fa-trash"></i></button>`:''}</td></tr>`).join(''));}
function renderSavings(){return renderEntityTable('Savings','savings',savingsCache,['Member','Type','Amount','Date','Actions'],(cache)=>cache.map(s=>`<tr><td>${s.memberName||'-'}</td><td>${statusBadge(s.type)}</td><td class="b">${fmt(s.amount)}</td><td>${fmtDate(s.date)}</td><td class="act-btns">${canEdit()?`<button class="btn warning btn-sm" onclick="openFormModal('savings','${s.id}')"><i class="fa-solid fa-pen"></i></button>`:''} ${canDelete()?`<button class="btn danger btn-sm" onclick="deleteEntity('savings','${s.id}','Tx')"><i class="fa-solid fa-trash"></i></button>`:''}</td></tr>`).join(''));}
function renderLoans(){return renderEntityTable('Loans','loans',loansCache,['Member','Principal','Balance','Status','Actions'],(cache)=>cache.map(l=>`<tr><td>${l.memberName||'-'}</td><td>${fmt(l.principal)}</td><td>${fmt(l.balance||0)}</td><td>${statusBadge(l.status)}</td><td class="act-btns">${canEdit()?`<button class="btn warning btn-sm" onclick="openFormModal('loans','${l.id}')"><i class="fa-solid fa-pen"></i></button>`:''} ${canDelete()?`<button class="btn danger btn-sm" onclick="deleteEntity('loans','${l.id}','Loan')"><i class="fa-solid fa-trash"></i></button>`:''}</td></tr>`).join(''));}
function renderExpenses(){return renderEntityTable('Income & Expense','cash',cashCache,['Type','Category','Amount','Date','Actions'],(cache)=>cache.map(c=>`<tr><td>${statusBadge(c.type)}</td><td>${c.category||'-'}</td><td class="b">${fmt(c.amount)}</td><td>${fmtDate(c.date)}</td><td class="act-btns">${canEdit()?`<button class="btn warning btn-sm" onclick="openFormModal('cash','${c.id}')"><i class="fa-solid fa-pen"></i></button>`:''} ${canDelete()?`<button class="btn danger btn-sm" onclick="deleteEntity('cash','${c.id}','Tx')"><i class="fa-solid fa-trash"></i></button>`:''}</td></tr>`).join(''));}
function renderAudit(){return renderEntityTable('Audit Trail','audit',auditCache,['Date','User','Action','Entity'],(cache)=>cache.map(a=>`<tr><td>${fmtDateTime(a.date)}</td><td>${a.user||'-'}</td><td>${a.action||'-'}</td><td>${a.entity||'-'}</td></tr>`).join(''));}

// CRUD Modals
function getEntityFields(entity, data={}){if(entity==='members') return `<div class="row2"><div class="field"><label>Name *</label><input id="f_name" required value="${data.name||`${data.firstName||''} ${data.lastName||''}`.trim()}"></div><div class="field"><label>NIDA *</label><input id="f_nida" required value="${data.nida||''}"></div></div><div class="row2"><div class="field"><label>Phone</label><input id="f_phone" type="tel" value="${data.phone||''}"></div><div class="field"><label>Status</label><select id="f_status"><option value="ACTIVE" ${data.status==='ACTIVE'?'selected':''}>Active</option><option value="SUSPENDED" ${data.status==='SUSPENDED'?'selected':''}>Suspended</option></select></div></div>`;if(entity==='savings') return `<div class="row2"><div class="field"><label>Type *</label><select id="f_type" required><option value="DEPOSIT" ${data.type==='DEPOSIT'?'selected':''}>Deposit</option><option value="WITHDRAWAL" ${data.type==='WITHDRAWAL'?'selected':''}>Withdrawal</option></select></div><div class="field"><label>Amount *</label><input id="f_amount" type="number" required value="${data.amount||''}"></div></div><div class="field"><label>Member</label><select id="f_memberId">${membersCache.map(m=>`<option value="${m.id}" ${data.memberId===m.id?'selected':''}>${m.name||m.firstName}</option>`).join('')}</select></div><div class="field"><label>Date *</label><input id="f_date" type="date" required value="${data.date||today()}"></div>`;if(entity==='loans') return `<div class="row2"><div class="field"><label>Principal *</label><input id="f_principal" type="number" required value="${data.principal||''}"></div><div class="field"><label>Balance</label><input id="f_balance" type="number" required value="${data.balance||data.principal||''}"></div></div><div class="row2"><div class="field"><label>Status</label><select id="f_status"><option value="PENDING" ${data.status==='PENDING'?'selected':''}>Pending</option><option value="APPROVED" ${data.status==='APPROVED'?'selected':''}>Approved</option><option value="DISBURSED" ${data.status==='DISBURSED'?'selected':''}>Disbursed</option><option value="PAID" ${data.status==='PAID'?'selected':''}>Paid</option></select></div><div class="field"><label>Member</label><select id="f_memberId">${membersCache.map(m=>`<option value="${m.id}" ${data.memberId===m.id?'selected':''}>${m.name||m.firstName}</option>`).join('')}</select></div></div><div class="field"><label>Date *</label><input id="f_date" type="date" required value="${data.date||today()}"></div>`;if(entity==='cash') return `<div class="row2"><div class="field"><label>Type *</label><select id="f_type" required><option value="INCOME" ${data.type==='INCOME'?'selected':''}>Income</option><option value="EXPENSE" ${data.type==='EXPENSE'?'selected':''}>Expense</option></select></div><div class="field"><label>Amount *</label><input id="f_amount" type="number" required value="${data.amount||''}"></div></div><div class="field"><label>Category</label><input id="f_category" value="${data.category||''}"></div><div class="field"><label>Date *</label><input id="f_date" type="date" required value="${data.date||today()}"></div>`;}

window.openFormModal = (entity, id=null) => { const data = id ? { id, ...eval(`${entity}Cache`).find(i=>i.id===id) } : {}; $('formModalTitle').innerText = id ? `Edit ${entity.slice(0,-1)}` : `Add ${entity.slice(0,-1)}`; $('formModalBody').innerHTML = `<form id="entityForm"><input type="hidden" id="f_entity" value="${entity}"><input type="hidden" id="f_id" value="${id||''}">${getEntityFields(entity, data)}<button class="btn primary" type="submit" style="width:100%;margin-top:12px"><i class="fa-solid fa-floppy-disk"></i> Save</button></form>`; $('entityForm').onsubmit = async (e) => { e.preventDefault(); const eid = $('f_id').value; let payload = {}; if(entity==='members') payload = { name: $('f_name').value, nida: $('f_nida').value, phone: $('f_phone').value, status: $('f_status').value }; else if(entity==='savings') { const member = membersCache.find(m=>m.id===$('f_memberId').value); payload = { type: $('f_type').value, amount: parseFloat($('f_amount').value), memberId: $('f_memberId').value, memberName: member?.name||member?.firstName, date: $('f_date').value }; } else if(entity==='loans') { const member = membersCache.find(m=>m.id===$('f_memberId').value); payload = { principal: parseFloat($('f_principal').value), balance: parseFloat($('f_balance').value), status: $('f_status').value, memberId: $('f_memberId').value, memberName: member?.name||member?.firstName, date: $('f_date').value }; } else if(entity==='cash') { payload = { type: $('f_type').value, amount: parseFloat($('f_amount').value), category: $('f_category').value, date: $('f_date').value }; } try { if(eid) { await updateDoc(doc(col(entity), eid), payload); showToast('Updated!','success'); addAudit('UPDATE', entity, eid); } else { await addDoc(col(entity), {...payload, date: payload.date || serverTimestamp() }); showToast('Added!','success'); addAudit('CREATE', entity, ''); } closeModal('formModal'); } catch(err) { showToast(err.message,'error'); } }; openModal('formModal'); };

window.deleteEntity = (entity, id, name) => { showConfirm('Delete Record', `Are you sure you want to delete ${name}?`, async () => { try { await deleteDoc(doc(col(entity), id)); showToast('Deleted!','success'); addAudit('DELETE', entity, id); } catch(e) { showToast(e.message,'error'); } }); };
window.suspendEntity = async (entity, id) => { showConfirm('Suspend User', 'Are you sure you want to suspend this user?', async () => { try { await updateDoc(doc(col(entity), id), { status: 'SUSPENDED' }); showToast('User Suspended!','success'); addAudit('SUSPEND', entity, id); } catch(e) { showToast(e.message,'error'); } }); };
window.reactivateEntity = async (entity, id) => { try { await updateDoc(doc(col(entity), id), { status: 'ACTIVE' }); showToast('User Reactivated!','success'); addAudit('REACTIVATE', entity, id); } catch(e) { showToast(e.message,'error'); } };

// Super Admin Logic
function initSuperAdmin(){const nav=$('superNav');nav.innerHTML=`<button class="snav-btn active" onclick="switchSuperTab('sg-groups',this)"><i class="fa-solid fa-building"></i> Groups</button><button class="snav-btn" onclick="switchSuperTab('sg-users',this)"><i class="fa-solid fa-users"></i> Users</button><button class="snav-btn" onclick="switchSuperTab('sg-audit',this)"><i class="fa-solid fa-clipboard-list"></i> Audit</button>`;loadSuperData();switchSuperTab('sg-groups',nav.querySelector('.snav-btn'));}
window.switchSuperTab=(tab,btn)=>{superActiveTab=tab;document.querySelectorAll('.snav-btn').forEach(b=>b.classList.remove('active'));btn.classList.add('active');renderSuperContent();};
function loadSuperData(){onSnapshot(collection(db,'groups'),s=>{superGroupsCache=s.docs.map(d=>({id:d.id,...d.data()}));renderSuperContent();});onSnapshot(collection(db,'users'),s=>{superUsersCache=s.docs.map(d=>({id:d.id,...d.data()}));renderSuperContent();});onSnapshot(query(collection(db,'auditLogs'),orderBy('timestamp','desc')),s=>{superAuditCache=s.docs.map(d=>({id:d.id,...d.data()}));renderSuperContent();});}
function renderSuperContent(){const C=$('superContent');if(superActiveTab==='sg-groups')C.innerHTML=renderSuperGroups();else if(superActiveTab==='sg-users')C.innerHTML=renderSuperUsers();else if(superActiveTab==='sg-audit')C.innerHTML=renderSuperAudit();}
function renderSuperGroups(){return `<div class="section-head"><h2>Groups Management</h2></div><div class="table-wrap"><table class="table"><thead><tr><th>Name</th><th>Plan</th><th>Status</th><th>Actions</th></tr></thead><tbody>${superGroupsCache.map(g=>`<tr><td><b>${g.name}</b></td><td>${g.plan||'free'}</td><td>${statusBadge(g.status||'trial')}</td><td class="act-btns">${g.status!=='suspended'?`<button class="btn info btn-sm" onclick="superSuspendGroup('${g.id}')"><i class="fa-solid fa-ban"></i></button>`:`<button class="btn ok btn-sm" onclick="superActivateGroup('${g.id}')"><i class="fa-solid fa-check"></i></button>`} <button class="btn danger btn-sm" onclick="superDeleteGroup('${g.id}','${g.name}')"><i class="fa-solid fa-trash"></i></button></td></tr>`).join('')}</tbody></table></div>`;}
function renderSuperUsers(){return `<div class="section-head"><h2>All Users</h2></div><div class="table-wrap"><table class="table"><thead><tr><th>Name</th><th>Group</th><th>Role</th><th>Status</th><th>Actions</th></tr></thead><tbody>${superUsersCache.map(u=>{const grp=superGroupsCache.find(g=>g.id===u.groupId);return`<tr><td><b>${u.firstName} ${u.lastName}</b></td><td>${grp?.name||'N/A'}</td><td>${u.role}</td><td>${statusBadge(u.status||'ACTIVE')}</td><td class="act-btns">${u.status!=='SUSPENDED'?`<button class="btn info btn-sm" onclick="superSuspendUser('${u.id}')"><i class="fa-solid fa-ban"></i></button>`:`<button class="btn ok btn-sm" onclick="superActivateUser('${u.id}')"><i class="fa-solid fa-check"></i></button>`} <button class="btn danger btn-sm" onclick="superDeleteUser('${u.id}','${u.firstName}')"><i class="fa-solid fa-trash"></i></button></td></tr>`;}).join('')}</tbody></table></div>`;}
function renderSuperAudit(){return `<div class="section-head"><h2>System Audit</h2></div><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>User</th><th>Action</th><th>Entity</th></tr></thead><tbody>${superAuditCache.map(a=>`<tr><td>${fmtDateTime(a.timestamp)}</td><td>${a.userId||'System'}</td><td>${a.action||'-'}</td><td>${a.entity||'-'}</td></tr>`).join('')}</tbody></table></div>`;}

window.superSuspendGroup = async (id) => { showConfirm('Suspend Group', 'Suspend this group?', async()=>{ await updateDoc(doc(db,'groups',id),{status:'suspended'}); showToast('Group Suspended','success'); }); };
window.superActivateGroup = async (id) => { await updateDoc(doc(db,'groups',id),{status:'active'}); showToast('Group Activated','success'); };
window.superDeleteGroup = (id, name) => { showConfirm('Delete Group', `Delete ${name}?`, async()=>{ await deleteDoc(doc(db,'groups',id)); showToast('Group Deleted','success'); }); };
window.superSuspendUser = async (id) => { showConfirm('Suspend User', 'Suspend this user?', async()=>{ await updateDoc(doc(db,'users',id),{status:'SUSPENDED'}); showToast('User Suspended','success'); }); };
window.superActivateUser = async (id) => { await updateDoc(doc(db,'users',id),{status:'ACTIVE'}); showToast('User Activated','success'); };
window.superDeleteUser = (id, name) => { showConfirm('Delete User', `Delete ${name}?`, async()=>{ await deleteDoc(doc(db,'users',id)); showToast('User Deleted','success'); }); };

renderLocaleBar(); applyTranslations();
</script>
</body>
</html>
