<div id="superLoginModal" class="modal"><div class="modal-card" style="width:min(400px,100%)"><div class="modal-head"><h3 data-t="superAdmin">Super Admin</h3><button class="close" onclick="closeModal('superLoginModal')">&times;</button></div><form id="superLoginForm"><div class="field"><label data-t="email">Email</label><input id="superEmail" type="email" required></div><div class="field"><label data-t="password">Password</label><input id="superPass" type="password" required></div><button class="btn danger" style="width:100%" type="submit"><i class="fa-solid fa-right-to-bracket"></i> <span data-t="signIn">Sign In</span></button></form></div></div>

