<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>CSCMS Pro V4 — Enterprise International Control</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<style>
:root{--bg:#07111f;--panel:#0d1929;--panel2:#122238;--line:#21344d;--text:#e8f0f8;--muted:#8ea3b9;--p:#16a979;--p2:#35d39b;--blue:#3b82f6;--red:#ef4444;--yellow:#f59e0b;--purple:#8b5cf6;--radius:12px;--font:'Inter',system-ui,-apple-system,sans-serif}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{background:linear-gradient(135deg,#06101c,#0a1423);color:var(--text);font-family:var(--font);line-height:1.5;-webkit-font-smoothing:antialiased}
button,input,select,textarea{font:inherit}button{cursor:pointer;border:0;background:none}a{color:var(--p2);text-decoration:none}img,video{max-width:100%;display:block}
.hidden{display:none!important}
.btn{border:0;border-radius:9px;padding:10px 16px;font-weight:600;font-size:12px;display:inline-flex;align-items:center;justify-content:center;gap:8px;transition:all .2s ease;white-space:nowrap}
.btn:hover{filter:brightness(1.1);transform:translateY(-1px)}.btn:active{transform:translateY(0)}.btn:disabled{opacity:.5;pointer-events:none}
.primary{background:var(--p);color:#fff}.outline{background:transparent;color:var(--p2);border:1px solid var(--p)}.danger{background:var(--red);color:#fff}.info{background:var(--blue);color:#fff}.warning{background:var(--yellow);color:#111}.purple{background:var(--purple);color:#fff}.mutedbtn{background:var(--panel2);color:var(--text);border:1px solid var(--line)}
.container{max-width:1200px;margin:0 auto;padding:20px}.row{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.row3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.flex{display:flex}.flex-center{display:flex;align-items:center;justify-content:center}.flex-between{display:flex;align-items:center;justify-content:space-between}.gap-sm{gap:8px}.gap-md{gap:12px}.small{font-size:11px;color:var(--muted)}
.landing{min-height:100vh}.hero{text-align:center;padding:65px 20px 30px}
.logo{width:72px;height:72px;border-radius:18px;background:linear-gradient(135deg,var(--p),#07563f);display:grid;place-items:center;margin:0 auto;font-size:30px;color:#fff;overflow:hidden}.logo img{width:100%;height:100%;object-fit:cover}
.brand{font-size:40px;font-weight:800;margin:12px 0 5px}.tag{color:var(--muted);font-size:14px}.hero-actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:25px}
.public-grid,.metrics,.grid{display:grid;gap:14px}.public-grid{grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}.grid2{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}.grid3{grid-template-columns:repeat(auto-fit,minmax(320px,1fr))}.metrics{grid-template-columns:repeat(auto-fit,minmax(160px,1fr));margin-bottom:18px}
.card{background:rgba(13,25,41,.96);border:1px solid var(--line);border-radius:var(--radius);padding:18px;transition:border-color .2s}
.auth{min-height:100vh;display:grid;place-items:center;padding:20px}.auth-card{width:min(520px,100%);background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:28px}
.member-reg-screen{min-height:100vh;display:grid;place-items:center;padding:20px}.member-reg-card{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:30px;width:min(640px,100%);position:relative}.mr-back{position:absolute;top:15px;left:15px;color:var(--muted);font-size:16px;display:flex;align-items:center;gap:5px}.mr-back:hover{color:var(--p2)}
.field{margin:11px 0}.field label{display:block;font-size:11px;color:var(--muted);margin-bottom:5px;font-weight:600;text-transform:uppercase;letter-spacing:.5px}.field input,.field select,.field textarea{width:100%;padding:11px 12px;border:1px solid var(--line);background:#091625;color:var(--text);border-radius:8px;outline:none;transition:border-color .2s}.field input:focus,.field select:focus{border-color:var(--p)}
.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:10px;max-height:400px}.table{width:100%;border-collapse:collapse;font-size:12px}.table th,.table td{padding:10px 12px;border-bottom:1px solid var(--line);text-align:left;white-space:nowrap}.table th{background:#101f33;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.5px;position:sticky;top:0}.table tr:hover td{background:#10243a}
.badge{padding:4px 8px;border-radius:20px;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;background:#18304a;color:var(--muted)}.ok{background:#0b3a2c;color:#55e1ae}.warn{background:#3c2b08;color:#ffc857}.bad{background:#40151a;color:#ff7b85}.info-b{background:#0c2d4a;color:#60a5fa}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.7);display:none;align-items:center;justify-content:center;z-index:100;padding:15px;backdrop-filter:blur(4px)}.modal.show{display:flex}.modal-card{width:min(720px,100%);max-height:92vh;overflow-y:auto;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:24px;animation:modalIn .25s ease}@keyframes modalIn{from{opacity:0;transform:translateY(20px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.close{color:var(--muted);font-size:22px;transition:color .15s}.close:hover{color:var(--red)}
.toast-container{position:fixed;right:18px;bottom:18px;z-index:200;display:flex;flex-direction:column;gap:8px;max-width:360px}.toast{background:#10243a;border:1px solid var(--p);padding:12px 18px;border-radius:9px;box-shadow:0 8px 24px rgba(0,0,0,.4);color:var(--text);font-size:13px;display:flex;align-items:center;gap:10px;animation:toastIn .3s ease}.toast.error{border-color:var(--red)}.toast.success{border-color:var(--p)}.toast.warning{border-color:var(--yellow)}@keyframes toastIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.super{min-height:100vh;background:linear-gradient(135deg,#06101c,#0a1423)}.super-top{padding:16px 22px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;background:var(--panel)}.super-body{padding:22px;max-width:1400px;margin:0 auto}
.su-field{margin:10px 0}.su-field label{display:block;font-size:11px;color:var(--muted);margin-bottom:5px;font-weight:600;text-transform:uppercase;letter-spacing:.5px}.su-input-wrap{position:relative;display:flex;align-items:center}.su-input-wrap .su-input-icon{position:absolute;left:12px;color:var(--muted);font-size:13px;pointer-events:none;z-index:1}.su-input-wrap input,.su-input-wrap select{width:100%;padding:11px 12px 11px 38px;border:1px solid var(--line);background:#091625;color:var(--text);border-radius:8px;outline:none;font-size:13px}.su-input-wrap input:focus,.su-input-wrap select:focus{border-color:var(--p)}.su-row{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.su-row3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.su-submit{width:100%;margin-top:18px;padding:13px 16px;font-size:14px;font-weight:700;border-radius:10px;background:linear-gradient(135deg,var(--p),#0d8a63);color:#fff;border:0;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:10px;transition:all .25s ease;box-shadow:0 4px 16px rgba(22,169,121,.2)}.su-submit:hover{filter:brightness(1.12);transform:translateY(-2px)}.su-submit:disabled{opacity:.55;pointer-events:none;filter:none;transform:none}
.id-reminder-card{width:min(480px,100%);text-align:center;padding:32px 28px!important}.id-reminder-icon{width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,var(--p),#07563f);display:grid;place-items:center;margin:0 auto 18px;font-size:28px;color:#fff;box-shadow:0 6px 24px rgba(22,169,121,.3)}.id-display-box{background:linear-gradient(135deg,#0a1e33,#0d2236);border:2px solid var(--p);border-radius:12px;padding:16px 20px;margin-bottom:22px}.id-label{display:block;font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;font-weight:700;margin-bottom:6px}.id-value{display:block;font-size:20px;font-weight:800;color:var(--p2);letter-spacing:1.5px;word-break:break-all}
.modern-ad-card{border-radius:var(--radius);overflow:hidden;background:var(--panel);border:1px solid var(--line);transition:transform .3s ease, box-shadow .3s ease}.modern-ad-card:hover{transform:translateY(-5px);box-shadow:0 12px 24px rgba(0,0,0,.3)}.modern-ad-media{position:relative;height:240px;overflow:hidden;background:#000}.modern-ad-media img, .modern-ad-media video{width:100%;height:100%;object-fit:cover}.modern-ad-body{padding:18px}.modern-ad-date{font-size:10px;color:var(--muted);margin-bottom:6px;display:flex;align-items:center;gap:6px}.modern-ad-title{font-size:16px;font-weight:700;margin-bottom:8px}.modern-ad-desc{font-size:12px;color:var(--muted);line-height:1.5}
.pricing-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;max-width:1000px;margin:0 auto}.price-card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:30px 25px;text-align:left;transition:all .3s ease;position:relative}.price-card:hover{transform:translateY(-5px);border-color:var(--p)}.price-amount{font-size:36px;font-weight:800;margin:10px 0}.price-amount span{font-size:14px;color:var(--muted);font-weight:400}
.toggle-switch{position:relative;width:40px;height:20px;background:var(--panel2);border-radius:20px;cursor:pointer;border:1px solid var(--line);transition:all .2s;flex-shrink:0}.toggle-switch.active{background:var(--p);border-color:var(--p)}.toggle-switch::after{content:'';position:absolute;top:2px;left:2px;width:14px;height:14px;background:#fff;border-radius:50%;transition:transform .2s}.toggle-switch.active::after{transform:translateX(20px)}
.progress-bar{width:100%;height:6px;background:var(--panel2);border-radius:3px;overflow:hidden;margin-top:8px}.progress-fill{height:100%;background:var(--p);width:0%;transition:width 0.2s}
.tab-bar{display:flex;gap:4px;border-bottom:1px solid var(--line);margin-bottom:20px;overflow-x:auto}.tab-btn{padding:10px 16px;color:var(--muted);font-weight:600;font-size:12px;border-bottom:2px solid transparent;transition:all .2s}.tab-btn.active{color:var(--p2);border-bottom-color:var(--p)}.tab-content{display:none}.tab-content.active{display:block}
.upload-zone{border:2px dashed var(--line);border-radius:10px;padding:20px;text-align:center;cursor:pointer;transition:all .2s}.upload-zone:hover{border-color:var(--p);background:rgba(22,169,121,.04)}.upload-zone input[type=file]{display:none}.upload-preview{max-width:100%;max-height:150px;border-radius:8px;object-fit:cover;margin-top:10px}
#networkBanner{position:fixed;top:0;left:0;right:0;z-index:300;padding:10px;text-align:center;font-size:12px;font-weight:700;display:none;transition:all .3s}
#networkBanner.offline{background:var(--red);color:#fff;display:block}
#networkBanner.online{background:var(--p);color:#fff;display:block}
@media(max-width:850px){.row,.row3,.su-row,.su-row3{grid-template-columns:1fr}}
</style>
</head>
<body>

<div id="networkBanner"><i class="fa-solid fa-wifi-slash"></i> <span data-t="offlineMode">Offline Mode</span></div>

<!-- LANDING -->
<div id="landing" class="landing">
  <section class="hero">
    <div class="logo" id="systemLogoContainer"><i class="fa-solid fa-people-group" style="font-size:36px" id="defaultLogoIcon"></i></div>
    <div class="brand" data-t="brandName">CSCMS Pro V4</div>
    <div class="tag" data-t="tagline">Community Savings &bull; Microfinance &bull; Shares &bull; Loans &bull; Governance</div>
    <div class="locale-bar" id="localeBar"></div>
    <div class="hero-actions" style="margin-top:25px">
      <button class="btn primary" onclick="showScreen('auth')"><i class="fa-solid fa-right-to-bracket"></i> <span data-t="signIn">Sign In</span></button>
      <button class="btn outline" onclick="showScreen('memberRegScreen')"><i class="fa-solid fa-user-plus"></i> <span data-t="signUp">Sign Up</span></button>
      <button class="btn mutedbtn" onclick="openModal('superLoginModal')"><i class="fa-solid fa-shield-halved"></i> <span data-t="superAdmin">Super Admin</span></button>
    </div>
  </section>
  <div class="container"><div class="section-head"><h2 data-t="sysAnnounce">System Announcements</h2></div><div id="publicAds" class="public-grid"></div></div>
  <div style="padding:60px 20px 80px;text-align:center">
    <h2 data-t="plansPricing">Plans & Pricing</h2>
    <div class="pricing-grid">
      <div class="price-card"><h3>Free Trial</h3><div class="price-amount">$0<span>/mo</span></div><p class="small" data-t="planFreeDesc">1 Month Trial, Up to 15 Members</p><button class="btn outline" style="width:100%;justify-content:center;margin-top:15px" onclick="showScreen('memberRegScreen')" data-t="getStarted">Get Started</button></div>
      <div class="price-card" style="border-color:var(--p)"><h3>Basic</h3><div class="price-amount">$29<span>/mo</span></div><p class="small" data-t="planBasicDesc">1 Group, Up to 50 Members</p><button class="btn primary" style="width:100%;justify-content:center;margin-top:15px" onclick="showScreen('memberRegScreen')" data-t="choosePlan">Choose Basic</button></div>
      <div class="price-card"><h3>Pro</h3><div class="price-amount">$79<span>/mo</span></div><p class="small" data-t="planProDesc">5 Groups, Up to 500 Members</p><button class="btn info" style="width:100%;justify-content:center;margin-top:15px" onclick="showScreen('memberRegScreen')" data-t="choosePlan">Choose Pro</button></div>
      <div class="price-card"><h3>Enterprise</h3><div class="price-amount">$199<span>/mo</span></div><p class="small" data-t="planEntDesc">Unlimited Groups & Members</p><button class="btn warning" style="width:100%;justify-content:center;margin-top:15px" onclick="showScreen('memberRegScreen')" data-t="choosePlan">Choose Enterprise</button></div>
    </div>
  </div>
</div>

<!-- SIGN UP -->
<div id="memberRegScreen" class="member-reg-screen hidden">
  <div class="member-reg-card">
    <button class="mr-back" onclick="showScreen('landing')"><i class="fa-solid fa-arrow-left"></i> <span data-t="back">Back</span></button>
    <div style="text-align:center;margin-bottom:24px"><div class="logo" style="width:56px;height:56px;font-size:24px;margin-bottom:14px"><i class="fa-solid fa-user-plus"></i></div><h2 data-t="registerGroup">Register Group</h2><p class="small" data-t="offlineNote">Works Offline. Will sync when online.</p></div>
    <form id="signUpForm" autocomplete="off" novalidate>
      <div class="su-row3">
        <div class="su-field"><label data-t="firstName">First Name *</label><div class="su-input-wrap"><input id="suFname" required placeholder="First name"><i class="fa-solid fa-user su-input-icon"></i></div></div>
        <div class="su-field"><label data-t="middleName">Middle Name</label><div class="su-input-wrap"><input id="suMname" placeholder="Middle name"><i class="fa-solid fa-user su-input-icon"></i></div></div>
        <div class="su-field"><label data-t="lastName">Last Name *</label><div class="su-input-wrap"><input id="suLname" required placeholder="Last name"><i class="fa-solid fa-user su-input-icon"></i></div></div>
      </div>
      <div class="su-row">
        <div class="su-field"><label data-t="nationalId">National ID *</label><div class="su-input-wrap"><input id="suNida" required placeholder="e.g. 12345678"><i class="fa-solid fa-id-card su-input-icon"></i></div></div>
        <div class="su-field"><label data-t="phone">Phone *</label><div class="su-input-wrap"><input id="suPhone" type="tel" required placeholder="e.g. +255 700 000 000"><i class="fa-solid fa-phone su-input-icon"></i></div></div>
      </div>
      <div class="su-row">
        <div class="su-field"><label data-t="groupType">Group Type *</label><div class="su-input-wrap"><select id="suGroupType" required><option value="">Select...</option><option value="rosca">ROSCA</option><option value="asca">ASCA</option><option value="vsla">VSLA</option><option value="sacco">SACCO</option></select><i class="fa-solid fa-layer-group su-input-icon"></i></div></div>
        <div class="su-field"><label data-t="groupName">Group Name *</label><div class="su-input-wrap"><input id="suGroupName" required placeholder="Group name..."><i class="fa-solid fa-building su-input-icon"></i></div></div>
      </div>
      <div class="su-row">
        <div class="su-field"><label data-t="country">Country *</label><div class="su-input-wrap"><select id="suCountry" required><option value="">Select...</option><option>Tanzania</option><option>Kenya</option><option>Uganda</option></select><i class="fa-solid fa-globe su-input-icon"></i></div></div>
        <div class="su-field"><label data-t="password">Password *</label><div class="su-input-wrap"><input id="suPassword" type="password" minlength="6" required placeholder="Min 6 chars"><i class="fa-solid fa-lock su-input-icon"></i></div></div>
      </div>
      <button class="su-submit" type="submit" id="suSubmitBtn"><i class="fa-solid fa-user-plus"></i> <span data-t="signUp">Sign Up</span></button>
    </form>
  </div>
</div>

<!-- ID REMINDER -->
<div id="idReminderModal" class="modal">
  <div class="modal-card id-reminder-card">
    <div class="id-reminder-icon"><i class="fa-solid fa-check"></i></div>
    <h2 data-t="regSuccess">Registration Successful!</h2>
    <p class="small" style="margin-bottom:20px" data-t="copyIdNote">Please <strong>COPY</strong> your ID.</p>
    <div class="id-display-box"><span class="id-label" data-t="yourGroupId">Your Group ID</span><span class="id-value" id="displayedUserId">---</span></div>
    <button class="btn primary" style="width:100%" onclick="navigator.clipboard.writeText(document.getElementById('displayedUserId').innerText);showToast('ID Copied!','success')"><i class="fa-solid fa-copy"></i> <span data-t="copyId">COPY ID</span></button>
  </div>
</div>

<!-- SIGN IN -->
<div id="auth" class="auth hidden">
  <div class="auth-card">
    <div class="modal-head"><h2 data-t="signIn">Sign In</h2><button class="close" onclick="showScreen('landing')">&times;</button></div>
    <form id="signInForm">
      <div class="field"><label data-t="groupId">Group ID *</label><input id="loginGroupId" required></div>
      <div class="field"><label data-t="nationalId">National ID *</label><input id="loginNida" required></div>
      <div class="field"><label data-t="password">Password *</label><input id="loginPassword" type="password" required></div>
      <button class="btn primary" type="submit" style="width:100%;margin-top:12px" id="siSubmitBtn"><i class="fa-solid fa-right-to-bracket"></i> <span data-t="signIn">Sign In</span></button>
    </form>
  </div>
</div>

<!-- SUPER ADMIN -->
<div id="super" class="super hidden">
  <div class="super-top"><div class="flex gap-sm" style="align-items:center"><b><i class="fa-solid fa-shield-halved" style="color:var(--red)"></i> SUPER ADMIN</b></div><button class="btn outline" onclick="logoutSuper()"><span data-t="logout">Logout</span></button></div>
  <div class="super-body">
    <div class="tab-bar">
      <button class="tab-btn active" onclick="switchTab('tabDash', this)" data-t="dashboard">Dashboard</button>
      <button class="tab-btn" onclick="switchTab('tabSystem', this)" data-t="systemBranding">System & Branding</button>
      <button class="tab-btn" onclick="switchTab('tabAds', this)" data-t="advertisements">Advertisements</button>
      <button class="tab-btn" onclick="switchTab('tabPerm', this)" data-t="permissions">Permissions</button>
      <button class="tab-btn" onclick="switchTab('tabAudit', this)" data-t="auditLogs">Audit Logs</button>
    </div>

    <div id="tabDash" class="tab-content active">
      <div class="card" style="margin-bottom:20px"><div class="section-head"><h3 data-t="groupMgmt">Groups Management</h3></div><div class="table-wrap"><table class="table"><thead><tr><th>Name</th><th>Plan</th><th>Status</th><th>Expiry</th><th>Actions</th></tr></thead><tbody id="superGroupsBody"></tbody></table></div></div>
    </div>

    <div id="tabSystem" class="tab-content">
      <div class="grid grid2">
        <div class="card">
          <div class="section-head"><h3 data-t="systemBranding">System Branding</h3></div>
          <form id="brandingForm">
            <div class="field"><label data-t="uploadLogo">System Logo (Auto Optimized)</label><div class="upload-zone" onclick="document.getElementById('logoFileInput').click()"><input type="file" id="logoFileInput" accept="image/*"><i class="fa-solid fa-cloud-arrow-up" style="font-size:24px;color:var(--p);display:block;margin-bottom:8px"></i><span class="small" data-t="clickUpload">Click to upload or replace</span><img id="logoPreview" class="upload-preview" style="display:none"></div></div>
            <div class="field flex-between"><label data-t="showLogo">Show Logo to Users</label><div class="toggle-switch" id="toggleShowLogo" onclick="this.classList.toggle('active')"></div></div>
            <div class="progress-bar" id="logoProgress" style="display:none"><div class="progress-fill" id="logoProgressFill"></div></div>
            <button class="btn primary" type="submit" style="width:100%;margin-top:10px"><i class="fa-solid fa-floppy-disk"></i> <span data-t="saveBranding">Save Branding</span></button>
          </form>
        </div>
        <div class="card">
          <div class="section-head"><h3 data-t="langMgmt">Language Management</h3></div>
          <div id="langManagementGrid" style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:15px"></div>
          <div class="field"><label data-t="addLang">Add Custom Language</label><div class="flex gap-sm"><input id="newLangInput" placeholder="e.g. Italian"><button class="btn info" onclick="addLanguage()"><i class="fa-solid fa-plus"></i></button></div></div>
        </div>
      </div>
    </div>

    <div id="tabAds" class="tab-content">
      <div class="card" style="margin-bottom:20px"><div class="section-head"><h3 data-t="sysAds">System Ads</h3><button class="btn primary" onclick="openModal('superAdModal')"><i class="fa-solid fa-plus"></i> <span data-t="createAd">Create Ad</span></button></div><div id="superAdsList" class="public-grid"></div></div>
    </div>

    <div id="tabPerm" class="tab-content">
      <div class="card"><div class="section-head"><h3 data-t="adPermissions">Advertisement Permissions</h3></div>
        <div class="table-wrap"><table class="table"><thead><tr><th>Role</th><th>Create</th><th>Upload Img</th><th>Edit</th><th>Delete</th><th>Publish</th></tr></thead><tbody id="permTableBody"></tbody></table></div>
        <button class="btn primary" style="margin-top:15px" onclick="savePermissions()"><i class="fa-solid fa-floppy-disk"></i> <span data-t="savePerms">Save Permissions</span></button>
      </div>
    </div>

    <div id="tabAudit" class="tab-content">
      <div class="card"><div class="section-head"><h3 data-t="recentActions">Recent Actions</h3></div><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Action</th><th>Module</th><th>Details</th></tr></thead><tbody id="auditTableBody"></tbody></table></div></div>
    </div>
  </div>
</div>

