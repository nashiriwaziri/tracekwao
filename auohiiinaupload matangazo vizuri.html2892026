  <div class="progress-bar" id="adImgProgress" style="display:none"><div class="progress-fill" id="adImgProgressFill"></div></div>
  <div class="su-row"><div class="field"><label data-t="adVideoUrl">Video URL</label><input id="saVid" placeholder="https://...mp4"></div><div class="field"><label data-t="adDestUrl">Destination URL</label><input id="saDestUrl" placeholder="https://..."></div></div>
  <div class="su-row"><div class="field"><label data-t="adCta">Call To Action</label><input id="saCta" placeholder="Learn More"></div><div class="field"><label data-t="adStatus">Status</label><select id="saStatus"><option value="draft">Draft</option><option value="scheduled">Scheduled</option><option value="active">Active</option></select></div></div>
  <div class="su-row"><div class="field"><label data-t="adStartDate">Start Date</label><input id="saStartDate" type="date"></div><div class="field"><label data-t="adEndDate">End Date</label><input id="saEndDate" type="date"></div></div>
