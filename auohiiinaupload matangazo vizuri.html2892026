<div class="toast-container" id="toastContainer"></div>

<script type="module">
// ==========================================
// 1. FIREBASE MODULAR SDK v10.12.0
// ==========================================
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
import { getAuth, createUserWithEmailAndPassword, signInWithEmailAndPassword, signOut } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";
import { getFirestore, enableMultiTabIndexedDbPersistence, collection, doc, setDoc, addDoc, getDoc, updateDoc, deleteDoc, onSnapshot, query, orderBy, limit, serverTimestamp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";
import { getStorage, ref, uploadBytesResumable, getDownloadURL } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-storage.js";

const firebaseConfig = {
    apiKey: "AIzaSyDSUs6uUjQTPQOkUPcIp2u8Rw9NJVnQOfo",
    authDomain: "ncrs2-f8da9.firebaseapp.com",
    projectId: "ncrs2-f8da9",
    storageBucket: "ncrs2-f8da9.firebasestorage.app",
    messagingSenderId: "436069918682",
    appId: "1:436069918682:web:70b56c627315bc782102e3",
    measurementId: "G-2QCBEJSGKS"
  };

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);
const storage = getStorage(app);

try { await enableMultiTabIndexedDbPersistence(db); } catch (err) { console.log("Persistence Setup Info:", err); }

// ==========================================
// 2. GLOBAL STATE & i18n
// ==========================================
let systemSettings = {
    branding: { logoUrl: null, logoEnabled: false },
    languages: [{code:'en',name:'English',enabled:true,default:true}, {code:'sw',name:'Kiswahili',enabled:true,default:false}, {code:'fr',name:'Français',enabled:true,default:false}],
    permissions: {
        super: {canCreate:true,canUpload:true,canEdit:true,canDelete:true,canPublish:true},
        manager: {canCreate:true,canUpload:true,canEdit:true,canDelete:false,canPublish:true},
        member: {canCreate:false,canUpload:false,canEdit:false,canDelete:false,canPublish:false}
    }
};
let superAdminUid = "YOUR_SUPER_ADMIN_UID";
let currentLang = 'en';

const i18n = {
    en: { brandName: "CSCMS Pro V4", tagline: "Community Savings &bull; Microfinance &bull; Shares &bull; Loans &bull; Governance", signIn: "Sign In", signUp: "Sign Up", superAdmin: "Super Admin", sysAnnounce: "System Announcements", plansPricing: "Plans & Pricing", planFreeDesc: "1 Month Trial, Up to 15 Members", planBasicDesc: "1 Group, Up to 50 Members", planProDesc: "5 Groups, Up to 500 Members", planEntDesc: "Unlimited Groups & Members", getStarted: "Get Started", choosePlan: "Choose Plan", back: "Back", registerGroup: "Register Group", offlineNote: "Works Offline. Will sync when online.", firstName: "First Name *", middleName: "Middle Name", lastName: "Last Name *", nationalId: "National ID *", phone: "Phone *", groupType: "Group Type *", groupName: "Group Name *", country: "Country *", password: "Password *", regSuccess: "Registration Successful!", copyIdNote: "Please <strong>COPY</strong> your ID.", yourGroupId: "Your Group ID", copyId: "COPY ID", groupId: "Group ID *", logout: "Logout", dashboard: "Dashboard", systemBranding: "System & Branding", advertisements: "Advertisements", permissions: "Permissions", auditLogs: "Audit Logs", groupMgmt: "Groups Management", uploadLogo: "System Logo (Auto Optimized)", clickUpload: "Click to upload or replace", showLogo: "Show Logo to Users", saveBranding: "Save Branding", langMgmt: "Language Management", addLang: "Add Custom Language", sysAds: "System Ads", createAd: "Create Ad", adPermissions: "Advertisement Permissions", savePerms: "Save Permissions", recentActions: "Recent Actions", welcomeMsg: "Welcome to CSCMS Pro V4", dashLoading: "Dashboard Loading...", email: "Email", adTitle: "Title *", adAdvertiser: "Advertiser", adDesc: "Description *", adImage: "Image (Auto Optimized)", adVideoUrl: "Video URL", adDestUrl: "Destination URL", adCta: "Call To Action", adStatus: "Status", adStartDate: "Start Date", adEndDate: "End Date", saveAd: "Save Ad", assignPlan: "Assign Plan & Trial", plan: "Plan", duration: "Duration", confirm: "Confirm", offlineMode: "Offline Mode" },
    sw: { brandName: "CSCMS Pro V4", tagline: "Akiba za Jamii &bull; Mikopo Madogo &bull; Hisa &bull; Mikopo &bull; Utawala", signIn: "Ingia", signUp: "Jisajili", superAdmin: "Msimamizi Mkuu", sysAnnounce: "Matangazo ya Mfumo", plansPricing: "Mpango na Bei", planFreeDesc: "Majaribio Mwezi 1, Hadidi Wanachama 15", planBasicDesc: "Kikundi 1, Hadidi 50", planProDesc: "Makundi 5, Hadidi 500", planEntDesc: "Makundi na Wanachama Usiopimika", getStarted: "Anza Sasa", choosePlan: "Chagua Mpango", back: "Rudi", registerGroup: "Sajili Kikundi", offlineNote: "Hufanya kazi nje ya mtandao. Itasawazishwa mtandao ukirudi.", firstName: "Jina la Kwanza *", middleName: "Jina la Kati", lastName: "Jina la Mwisho *", nationalId: "Namba ya NIDA *", phone: "Simu *", groupType: "Aina ya Kikundi *", groupName: "Jina la Kikundi *", country: "Nchi *", password: "Nenosiri *", regSuccess: "Usajili Umefanikiwa!", copyIdNote: "Tafadhali <strong>COPY</strong> ID yako.", yourGroupId: "ID ya Kikundi Chako", copyId: "COPY ID", groupId: "ID ya Kikundi *", logout: "Toka", dashboard: "Dashibodi", systemBranding: "Mfumo & Chapa", advertisements: "Matangazo", permissions: "Ruhusa", auditLogs: "Kumbukumbu", groupMgmt: "Usimamizi wa Makundi", uploadLogo: "Nembo ya Mfumo", clickUpload: "Bonyeza kupakia au kubadilisha", showLogo: "Onyesha Nembo kwa Watumiaji", saveBranding: "Hifadhi Chapa", langMgmt: "Usimamizi wa Lugha", addLang: "Ongeza Lugha", sysAds: "Matangazo ya Mfumo", createAd: "Tengeneza Tangazo", adPermissions: "Ruhusa za Matangazo", savePerms: "Hifadhi Ruhusa", recentActions: "Matukio ya Karibu", welcomeMsg: "Karibu CSCMS Pro V4", dashLoading: "Dashibodi Inapakia...", email: "Barua Pepe", adTitle: "Kichwa *", adAdvertiser: "Mtangazaji", adDesc: "Maelezo *", adImage: "Picha (Inboreshwa Auto)", adVideoUrl: "URL ya Video", adDestUrl: "URL ya Lengo", adCta: "Wito wa Kitendo", adStatus: "Hali", adStartDate: "Tarehe ya Kuanza", adEndDate: "Tarehe ya Kuisha", saveAd: "Hifadhi Tangazo", assignPlan: "Kagua Mpango", plan: "Mpango", duration: "Muda", confirm: "Thibitisha", offlineMode: "Hali ya Mtandao Kukatika" },
    fr: { brandName: "CSCMS Pro V4", tagline: "Épargne Communautaire &bull; Microfinance &bull; Actions &bull; Prêts &bull; Gouvernance", signIn: "Se Connecter", signUp: "S'inscrire", superAdmin: "Super Admin", sysAnnounce: "Annonces Système", plansPricing: "Forfaits et Tarifs", planFreeDesc: "Essai 1 Mois, Jusqu'à 15 Membres", planBasicDesc: "1 Groupe, Jusqu'à 50", planProDesc: "5 Groupes, Jusqu'à 500", planEntDesc: "Groupes et Membres Illimités", getStarted: "Commencer", choosePlan: "Choisir", back: "Retour", registerGroup: "Enregistrer Groupe", offlineNote: "Fonctionne hors ligne. Synchronisation auto.", firstName: "Prénom *", middleName: "Deuxième Nom", lastName: "Nom de Famille *", nationalId: "Identité Nationale *", phone: "Téléphone *", groupType: "Type de Groupe *", groupName: "Nom du Groupe *", country: "Pays *", password: "Mot de passe *", regSuccess: "Inscription Réussie!", copyIdNote: "Veuillez <strong>COPIER</strong> votre ID.", yourGroupId: "Votre ID de Groupe", copyId: "COPIER ID", groupId: "ID de Groupe *", logout: "Déconnexion", dashboard: "Tableau de Bord", systemBranding: "Système & Image de Marque", advertisements: "Publicités", permissions: "Permissions", auditLogs: "Journaux d'Audit", groupMgmt: "Gestion des Groupes", uploadLogo: "Logo Système", clickUpload: "Cliquez pour télécharger", showLogo: "Afficher le Logo", saveBranding: "Sauvegarder", langMgmt: "Gestion des Langues", addLang: "Ajouter Langue", sysAds: "Annonces Système", createAd: "Créer Annonce", adPermissions: "Permissions Publicité", savePerms: "Sauvegarder Permissions", recentActions: "Actions Récentes", welcomeMsg: "Bienvenue sur CSCMS Pro V4", dashLoading: "Chargement...", email: "E-mail", adTitle: "Titre *", adAdvertiser: "Annonceur", adDesc: "Description *", adImage: "Image (Optimisée)", adVideoUrl: "URL Vidéo", adDestUrl: "URL Destination", adCta: "Appel à l'Action", adStatus: "Statut", adStartDate: "Date de Début", adEndDate: "Date de Fin", saveAd: "Sauvegarder Annonce", assignPlan: "Attribuer Forfait", plan: "Forfait", duration: "Durée", confirm: "Confirmer", offlineMode: "Mode Hors Ligne" }
};

function applyTranslations() {
    const dict = i18n[currentLang] || i18n.en;
    document.querySelectorAll('[data-t]').forEach(el => {
        const key = el.getAttribute('data-t');
        if (dict[key]) el.innerHTML = dict[key];
        else if (i18n.en[key]) el.innerHTML = i18n.en[key]; // Fallback to English
    });
}

// ==========================================
// 3. UTILITY FUNCTIONS
// ==========================================
window.showScreen = (id) => { document.querySelectorAll('.landing, .member-reg-screen, .auth, .app, .super').forEach(el => el.classList.add('hidden')); document.getElementById(id).classList.remove('hidden'); };
window.openModal = (id) => document.getElementById(id).classList.add('show');
window.closeModal = (id) => document.getElementById(id).classList.remove('show');
window.switchTab = (tabId, btn) => { document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active')); document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active')); document.getElementById(tabId).classList.add('active'); btn.classList.add('active'); };

window.showToast = (message, type = 'success') => { const c = document.getElementById('toastContainer'); const t = document.createElement('div'); t.className = `toast ${type}`; t.innerHTML = `<i class="fa-solid ${type === 'error' ? 'fa-circle-exclamation' : 'fa-circle-check'}"></i> ${message}`; c.appendChild(t); setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.remove(), 300); }, 4000); };

async function logAudit(action, module, details) {
    try { await addDoc(collection(db, 'auditLogs'), { action, module, details, timestamp: serverTimestamp(), userId: auth.currentUser?.uid || 'System' }); } catch(e) {}
}

// ==========================================
// 4. IMAGE PROCESSOR
// ==========================================
async function processImageFile(file, maxW = 1024, quality = 0.8) {
    return new Promise((resolve, reject) => {
        if (!file || !file.type.startsWith('image/')) return reject('Invalid image file');
        const reader = new FileReader();
        reader.onload = (e) => {
            const img = new Image();
            img.onload = () => {
                const canvas = document.createElement('canvas');
                let w = img.width, h = img.height;
                if (w > maxW) { h = Math.round(h * (maxW / w)); w = maxW; }
                canvas.width = w; canvas.height = h;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(img, 0, 0, w, h);
                canvas.toBlob((blob) => { if(blob) resolve(blob); else reject('Compression failed'); }, 'image/webp', quality);
            };
            img.onerror = () => reject('Image load error');
            img.src = e.target.result;
        };
        reader.readAsDataURL(file);
    });
}

function uploadFileToStorage(blob, path, progressCb) {
    return new Promise((resolve, reject) => {
        const storageRef = ref(storage, path);
        const uploadTask = uploadBytesResumable(storageRef, blob);
        uploadTask.on('state_changed', (snapshot) => { const progress = (snapshot.bytesTransferred / snapshot.totalBytes) * 100; if(progressCb) progressCb(progress); },
        (error) => reject(error), () => { getDownloadURL(uploadTask.snapshot.ref).then((downloadURL) => resolve(downloadURL)); });
    });
}

// ==========================================
// 5. OFFLINE MANAGER
// ==========================================
const OfflineManager = {
    queueKey: 'cscms_offline_queue',
    getQueue() { return JSON.parse(localStorage.getItem(this.queueKey)) || []; },
    saveQueue(queue) { localStorage.setItem(this.queueKey, JSON.stringify(queue)); },
    addToQueue(action, payload) { const queue = this.getQueue(); queue.push({ id: Date.now(), action, payload }); this.saveQueue(queue); showToast("Saved Offline. Will sync when online.", "warning"); },
    async processQueue() {
        let queue = this.getQueue(); if (queue.length === 0) return;
        showToast(`Syncing ${queue.length} actions...`, "success"); let successCount = 0;
        for (let i = 0; i < queue.length; i++) {
            const item = queue[i]; try {
                switch(item.action) {
                    case 'SIGNUP': await setDoc(doc(db, 'groups', item.payload.groupId), item.payload.groupData); await setDoc(doc(db, 'users', item.payload.userId), item.payload.userData); break;
                    case 'ADD_AD': await addDoc(collection(db, 'advertisements'), item.payload); break;
                    case 'ASSIGN_PLAN': await updateDoc(doc(db, 'groups', item.payload.groupId), item.payload.data); break;
                    case 'UPDATE_GROUP': await updateDoc(doc(db, 'groups', item.payload.groupId), item.payload.data); break;
                    case 'UPDATE_BRANDING': await setDoc(doc(db, 'systemSettings', 'branding'), item.payload.data, { merge: true }); break;
                } successCount++;
            } catch (e) { console.error("Sync fail:", e); }
        }
        if (successCount > 0) { this.saveQueue([]); showToast(`${successCount} actions synced!`, "success"); }
    }
};

function updateNetworkUI(isOnline) { const banner = document.getElementById('networkBanner'); if (isOnline) { banner.className = 'online'; banner.innerHTML = '<i class="fa-solid fa-wifi"></i> Back Online. Syncing...'; setTimeout(() => { banner.style.display = 'none'; }, 3000); OfflineManager.processQueue(); } else { banner.className = 'offline'; banner.innerHTML = '<i class="fa-solid fa-wifi-slash"></i> Offline Mode'; } }
window.addEventListener('online', () => updateNetworkUI(true));
window.addEventListener('offline', () => updateNetworkUI(false));
if (!navigator.onLine) updateNetworkUI(false);

// ==========================================
// 6. DYNAMIC BRANDING & LANGUAGE
// ==========================================
onSnapshot(doc(db, 'systemSettings', 'branding'), (snap) => {
    if (snap.exists()) { systemSettings.branding = { ...systemSettings.branding, ...snap.data() }; }
    const logoContainer = document.getElementById('systemLogoContainer');
    if (systemSettings.branding.logoEnabled && systemSettings.branding.logoUrl) {
        logoContainer.innerHTML = `<img src="${systemSettings.branding.logoUrl}" alt="System Logo">`;
    } else {
        logoContainer.innerHTML = `<i class="fa-solid fa-people-group" style="font-size:36px" id="defaultLogoIcon"></i>`;
    }
});

onSnapshot(doc(db, 'systemSettings', 'languages'), (snap) => {
    if (snap.exists()) { systemSettings.languages = snap.data().list || systemSettings.languages; }
    renderLocaleBar(); renderLangManagement();
});

function renderLocaleBar() {
    const bar = document.getElementById('localeBar'); bar.innerHTML = '';
    systemSettings.languages.filter(l => l.enabled).forEach(l => {
        bar.innerHTML += `<button class="locale-btn ${l.code === currentLang ? 'active' : ''}" onclick="switchLanguage('${l.code}')">${l.name}</button>`;
    });
}
window.switchLanguage = (code) => { currentLang = code; applyTranslations(); renderLocaleBar(); };

function renderLangManagement() {
    const grid = document.getElementById('langManagementGrid'); if(!grid) return; grid.innerHTML = '';
    systemSettings.languages.forEach((l, idx) => {
        grid.innerHTML += `<div class="card" style="padding:10px"><div class="flex-between"><b>${l.name}</b><div class="flex gap-sm"><div class="toggle-switch ${l.enabled?'active':''}" onclick="systemSettings.languages[${idx}].enabled=!systemSettings.languages[${idx}].enabled;renderLangManagement()"></div><div class="toggle-switch ${l.default?'active':''}" onclick="systemSettings.languages.forEach(i=>i.default=false);systemSettings.languages[${idx}].default=true;renderLangManagement()"></div></div></div><span class="small">${l.enabled?'Enabled':'Disabled'} ${l.default?'| Default':''}</span></div>`;
    });
}

window.addLanguage = () => {
    const inp = document.getElementById('newLangInput'); if(!inp.value) return;
    systemSettings.languages.push({ code: inp.value.substring(0,2).toLowerCase(), name: inp.value, enabled: true, default: false });
    setDoc(doc(db, 'systemSettings', 'languages'), { list: systemSettings.languages });
    renderLangManagement(); inp.value = ''; logAudit('LANG_ADDED', 'System', inp.value);
};

// ==========================================
// 7. ADVERTISEMENT SCHEDULER
// ==========================================
function updateAdStatuses(ads) {
    const now = new Date();
    ads.forEach(async (adDoc) => {
        const ad = adDoc.data(); const id = adDoc.id;
        if (ad.status === 'scheduled' && ad.startDate && ad.startDate.toDate() <= now) { await updateDoc(doc(db, 'advertisements', id), { status: 'active' }); }
        if (ad.status === 'active' && ad.endDate && ad.endDate.toDate() <= now) { await updateDoc(doc(db, 'advertisements', id), { status: 'expired' }); }
    });
}

// ==========================================
// 8. AUTH LOGIC
// ==========================================
document.getElementById('signUpForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const fname = document.getElementById('suFname').value.trim(); const lname = document.getElementById('suLname').value.trim();
    const nida = document.getElementById('suNida').value.trim(); const phone = document.getElementById('suPhone').value.trim();
    const groupType = document.getElementById('suGroupType').value; const groupName = document.getElementById('suGroupName').value.trim();
    const country = document.getElementById('suCountry').value; const password = document.getElementById('suPassword').value;
    const submitBtn = document.getElementById('suSubmitBtn'); submitBtn.disabled = true; submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Processing...';
    const groupId = doc(collection(db, 'groups')).id; 
    const groupData = { name: groupName, type: groupType, country: country, plan: 'free', status: 'trial', expiryDate: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000), createdAt: serverTimestamp() };
    try {
        if (!navigator.onLine) {
            const userData = { firstName: fname, lastName: lname, nida, phone, role: 'chair', groupId, createdAt: serverTimestamp() };
            OfflineManager.addToQueue('SIGNUP', { groupId, userId: 'pending_auth_' + nida, groupData, userData });
            document.getElementById('displayedUserId').textContent = groupId; openModal('idReminderModal');
        } else {
            const pseudoEmail = `${nida}@cscms.app`; const userCredential = await createUserWithEmailAndPassword(auth, pseudoEmail, password);
            const userId = userCredential.user.uid;
            await setDoc(doc(db, 'groups', groupId), { ...groupData, chairpersonId: userId });
            await setDoc(doc(db, 'users', userId), { firstName: fname, lastName: lname, nida, phone, role: 'chair', groupId });
            document.getElementById('displayedUserId').textContent = groupId; openModal('idReminderModal'); showToast("Registration successful!", "success");
            logAudit('USER_SIGNUP', 'Auth', groupId);
        }
    } catch (error) { if (error.code === 'auth/email-already-in-use') showToast("ID already registered.", "error"); else showToast(error.message, "error"); } 
    finally { submitBtn.disabled = false; submitBtn.innerHTML = '<i class="fa-solid fa-user-plus"></i> Sign Up'; }
});

document.getElementById('signInForm').addEventListener('submit', async (e) => {
    e.preventDefault(); if (!navigator.onLine) return showToast("Sign In requires internet.", "error");
    const groupId = document.getElementById('loginGroupId').value.trim(); const nida = document.getElementById('loginNida').value.trim();
    const password = document.getElementById('loginPassword').value; const pseudoEmail = `${nida}@cscms.app`;
    const submitBtn = document.getElementById('siSubmitBtn'); submitBtn.disabled = true; submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Signing In...';
    try {
        const userCredential = await signInWithEmailAndPassword(auth, pseudoEmail, password); const userId = userCredential.user.uid;
        const userDoc = await getDoc(doc(db, 'users', userId));
        if (userDoc.exists() && userDoc.data().groupId === groupId) {
            const groupDoc = await getDoc(doc(db, 'groups', groupId)); const groupData = groupDoc.data();
            if (groupData.status === 'suspended') { await signOut(auth); return showToast("Group suspended.", "error"); }
            if (groupData.expiryDate && groupData.expiryDate.toDate() < new Date()) { await updateDoc(doc(db, 'groups', groupId), { status: 'expired' }); await signOut(auth); return showToast("Plan expired.", "error"); }
            showToast("Sign In successful!", "success"); showScreen('app');
        } else { await signOut(auth); showToast("Invalid Group ID.", "error"); }
    } catch (error) { if (error.code === 'auth/user-not-found' || error.code === 'auth/wrong-password') showToast("Invalid ID or Password.", "error"); else showToast(error.message, "error"); } 
    finally { submitBtn.disabled = false; submitBtn.innerHTML = '<i class="fa-solid fa-right-to-bracket"></i> Sign In'; }
});

window.logout = () => signOut(auth).then(() => { showScreen('landing'); showToast("Logged out", "success"); });

// ==========================================
// 9. SUPER ADMIN LOGIC
// ==========================================
document.getElementById('superLoginForm').addEventListener('submit', async (e) => {
    e.preventDefault(); if (!navigator.onLine) return showToast("Admin login requires internet.", "error");
    try {
        const res = await signInWithEmailAndPassword(auth, document.getElementById('superEmail').value, document.getElementById('superPass').value);
        if (res.user.uid === superAdminUid) { closeModal('superLoginModal'); showScreen('super'); initSuperAdmin(); showToast("Welcome Super Admin", "success"); } 
        else { await signOut(auth); showToast("Not authorized.", "error"); }
    } catch (err) { showToast(err.message, "error"); }
});
window.logoutSuper = () => { signOut(auth); showScreen('landing'); };

function initSuperAdmin() {
    if (systemSettings.branding.logoUrl) { document.getElementById('logoPreview').src = systemSettings.branding.logoUrl; document.getElementById('logoPreview').style.display = 'block'; }
    if (systemSettings.branding.logoEnabled) document.getElementById('toggleShowLogo').classList.add('active');

    const permBody = document.getElementById('permTableBody'); permBody.innerHTML = '';
    Object.keys(systemSettings.permissions).forEach(role => {
        const p = systemSettings.permissions[role];
        permBody.innerHTML += `<tr><td><b>${role}</b></td><td><div class="toggle-switch ${p.canCreate?'active':''}" id="pc${role}" onclick="this.classList.toggle('active')"></div></td><td><div class="toggle-switch ${p.canUpload?'active':''}" id="pu${role}" onclick="this.classList.toggle('active')"></div></td><td><div class="toggle-switch ${p.canEdit?'active':''}" id="pe${role}" onclick="this.classList.toggle('active')"></div></td><td><div class="toggle-switch ${p.canDelete?'active':''}" id="pd${role}" onclick="this.classList.toggle('active')"></div></td><td><div class="toggle-switch ${p.canPublish?'active':''}" id="pp${role}" onclick="this.classList.toggle('active')"></div></td></tr>`;
    });

    onSnapshot(collection(db, 'groups'), (snap) => {
        const tbody = document.getElementById('superGroupsBody'); tbody.innerHTML = '';
        snap.forEach(d => { const id = d.id; const g = d.data(); const statusBadge = g.status === 'active' ? 'ok' : g.status === 'trial' ? 'info-b' : g.status === 'suspended' ? 'bad' : 'warn'; const expiry = g.expiryDate ? new Date(g.expiryDate.toDate()).toLocaleDateString() : 'N/A';
        tbody.innerHTML += `<tr><td><b>${g.name}</b><br><span class="small">${id}</span></td><td><span class="badge info-b">${g.plan||'free'}</span></td><td><span class="badge ${statusBadge}">${g.status||'trial'}</span></td><td>${expiry}</td><td><div class="flex gap-sm wrap"><button class="btn primary" onclick="openPlanModal('${id}')"><i class="fa-solid fa-check"></i></button>${g.status!=='suspended'?`<button class="btn warning" onclick="suspendGroup('${id}')"><i class="fa-solid fa-pause"></i></button>`:`<button class="btn info" onclick="activateGroup('${id}')"><i class="fa-solid fa-play"></i></button>`}<button class="btn danger" onclick="deleteGroup('${id}')"><i class="fa-solid fa-trash"></i></button></div></td></tr>`; });
    });

    onSnapshot(query(collection(db, 'advertisements'), orderBy('createdAt', 'desc')), (snap) => {
        updateAdStatuses(snap.docs);
        const adDiv = document.getElementById('superAdsList'); adDiv.innerHTML = '';
        snap.forEach(d => { const ad = d.data(); const id = d.id; const mediaHtml = ad.videoUrl ? `<video src="${ad.videoUrl}" muted loop></video>` : (ad.imageUrl ? `<img src="${ad.imageUrl}" alt="${ad.title}">` : `<div class="flex-center" style="height:100%;color:var(--muted)"><i class="fa-solid fa-photo-film" style="font-size:48px"></i></div>`);
        adDiv.innerHTML += `<div class="modern-ad-card"><div class="modern-ad-media">${mediaHtml}</div><div class="modern-ad-body"><div class="modern-ad-title">${ad.title}</div><div class="modern-ad-desc">${ad.description}</div><span class="badge ${ad.status==='active'?'ok':ad.status==='expired'?'bad':'warn'}" style="margin-top:8px">${ad.status}</span></div></div><button class="btn danger" style="margin-top:5px;width:100%" onclick="deleteAd('${id}')"><i class="fa-solid fa-trash"></i> Delete</button>`; });
    });

    onSnapshot(query(collection(db, 'auditLogs'), orderBy('timestamp', 'desc'), limit(50)), (snap) => {
        const tbody = document.getElementById('auditTableBody'); tbody.innerHTML = '';
        snap.forEach(d => { const l = d.data(); tbody.innerHTML += `<tr><td>${l.timestamp?.toDate().toLocaleString()||'N/A'}</td><td><span class="badge info-b">${l.action}</span></td><td>${l.module}</td><td class="small">${l.details||''}</td></tr>`; });
    });
}

// Branding Save
document.getElementById('brandingForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const fileInput = document.getElementById('logoFileInput').files[0];
    let logoUrl = systemSettings.branding.logoUrl;
    let logoStoragePath = systemSettings.branding.logoStoragePath;
    
    if (fileInput) {
        try {
            const blob = await processImageFile(fileInput, 200, 0.8);
            const path = `branding/logos/${Date.now()}.webp`;
            document.getElementById('logoProgress').style.display = 'block';
            logoUrl = await uploadFileToStorage(blob, path, (prog) => document.getElementById('logoProgressFill').style.width = prog+'%');
            logoStoragePath = path;
            document.getElementById('logoProgress').style.display = 'none';
        } catch(err) { showToast(err, 'error'); return; }
    }

    const data = { logoUrl, logoStoragePath, logoEnabled: document.getElementById('toggleShowLogo').classList.contains('active'), updatedAt: serverTimestamp(), updatedBy: auth.currentUser.uid };
    
    if (!navigator.onLine) { OfflineManager.addToQueue('UPDATE_BRANDING', { data }); return; }
    try { await setDoc(doc(db, 'systemSettings', 'branding'), data, { merge: true }); showToast("Branding Saved!", "success"); logAudit('BRANDING_SAVED', 'System', `Enabled: ${data.logoEnabled}`); } catch (err) { showToast(err.message, "error"); }
});

// Ad Creation
document.getElementById('saImgFile').addEventListener('change', (e) => {
    const file = e.target.files[0]; if(!file) return;
    const reader = new FileReader(); reader.onload = (ev) => { document.getElementById('saImgPreview').src = ev.target.result; document.getElementById('saImgPreview').style.display = 'block'; }; reader.readAsDataURL(file);
});

document.getElementById('superAdForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const file = document.getElementById('saImgFile').files[0];
    let imageUrl = null, imageStoragePath = null;

    if (file) {
        try {
            const blob = await processImageFile(file, 1024, 0.8);
            const path = `ads/images/${Date.now()}.webp`;
            document.getElementById('adImgProgress').style.display = 'block';
            imageUrl = await uploadFileToStorage(blob, path, (prog) => document.getElementById('adImgProgressFill').style.width = prog+'%');
            imageStoragePath = path;
            document.getElementById('adImgProgress').style.display = 'none';
        } catch(err) { showToast(err, 'error'); return; }
    }

    const adData = {
        title: document.getElementById('saTitle').value, advertiser: document.getElementById('saAdvertiser').value,
        description: document.getElementById('saDesc').value, imageUrl, imageStoragePath,
        videoUrl: document.getElementById('saVid').value, destinationUrl: document.getElementById('saDestUrl').value,
        cta: document.getElementById('saCta').value, status: document.getElementById('saStatus').value,
        startDate: document.getElementById('saStartDate').value ? new Date(document.getElementById('saStartDate').value) : null,
        endDate: document.getElementById('saEndDate').value ? new Date(document.getElementById('saEndDate').value) : null,
        createdBy: auth.currentUser.uid, createdAt: serverTimestamp(), updatedAt: serverTimestamp()
    };

    if (!navigator.onLine) { OfflineManager.addToQueue('ADD_AD', adData); } 
    else { try { await addDoc(collection(db, 'advertisements'), adData); showToast("Ad Created!", "success"); logAudit('AD_CREATED', 'Ads', adData.title); } catch (err) { showToast(err.message, "error"); } }
    document.getElementById('superAdForm').reset(); document.getElementById('saImgPreview').style.display = 'none'; closeModal('superAdModal');
});

// Permissions Save
window.savePermissions = async () => {
    const roles = Object.keys(systemSettings.permissions);
    roles.forEach(role => {
        systemSettings.permissions[role] = {
            canCreate: document.getElementById(`pc${role}`).classList.contains('active'),
            canUpload: document.getElementById(`pu${role}`).classList.contains('active'),
            canEdit: document.getElementById(`pe${role}`).classList.contains('active'),
            canDelete: document.getElementById(`pd${role}`).classList.contains('active'),
            canPublish: document.getElementById(`pp${role}`).classList.contains('active')
        };
    });
    try { await setDoc(doc(db, 'systemSettings', 'permissions'), systemSettings.permissions); showToast("Permissions Saved!", "success"); logAudit('PERM_SAVED', 'Permissions', 'Updated roles'); } catch(e) { showToast(e.message, 'error'); }
};

// Group Actions
window.openPlanModal = (id) => { document.getElementById('planGroupId').value = id; openModal('planModal'); };
document.getElementById('planForm').addEventListener('submit', async (e) => {
    e.preventDefault(); const groupId = document.getElementById('planGroupId').value;
    const data = { plan: document.getElementById('planSelect').value, status: 'active', expiryDate: new Date(Date.now() + parseInt(document.getElementById('planDuration').value) * 24 * 60 * 60 * 1000) };
    if (!navigator.onLine) { OfflineManager.addToQueue('ASSIGN_PLAN', { groupId, data }); } else { try { await updateDoc(doc(db, 'groups', groupId), data); showToast("Plan assigned!", "success"); logAudit('PLAN_ASSIGNED', 'Groups', groupId); } catch (err) { showToast(err.message, "error"); } }
    closeModal('planModal');
});
window.suspendGroup = async (id) => { if(!confirm("Suspend?")) return; try { await updateDoc(doc(db, 'groups', id), { status: 'suspended' }); showToast("Suspended", "warning"); logAudit('GROUP_SUSPENDED', 'Groups', id); } catch(e) { showToast(e.message, "error"); } };
window.activateGroup = async (id) => { try { await updateDoc(doc(db, 'groups', id), { status: 'active' }); showToast("Activated", "success"); logAudit('GROUP_ACTIVATED', 'Groups', id); } catch(e) { showToast(e.message, "error"); } };
window.deleteGroup = async (id) => { if(!confirm("DELETE?")) return; try { await deleteDoc(doc(db, 'groups', id)); showToast("Deleted", "error"); logAudit('GROUP_DELETED', 'Groups', id); } catch(e) { showToast(e.message, "error"); } };
window.deleteAd = async (id) => { if(!confirm("Delete Ad?")) return; try { await deleteDoc(doc(db, 'advertisements', id)); showToast("Ad Deleted", "error"); logAudit('AD_DELETED', 'Ads', id); } catch(e) { showToast(e.message, "error"); } };

// Public Ads
onSnapshot(query(collection(db, 'advertisements'), orderBy('createdAt', 'desc'), limit(4)), (snap) => {
    const publicDiv = document.getElementById('publicAds'); publicDiv.innerHTML = '';
    snap.forEach(d => { const ad = d.data(); if(ad.status !== 'active' && ad.status !== undefined) return; const mediaHtml = ad.videoUrl ? `<video src="${ad.videoUrl}" muted loop></video>` : (ad.imageUrl ? `<img src="${ad.imageUrl}" alt="${ad.title}">` : `<div class="flex-center" style="height:100%;color:var(--muted)"><i class="fa-solid fa-photo-film" style="font-size:48px"></i></div>`);
    publicDiv.innerHTML += `<div class="modern-ad-card"><div class="modern-ad-media">${mediaHtml}</div><div class="modern-ad-body"><div class="modern-ad-title">${ad.title}</div><div class="modern-ad-desc">${ad.description}</div></div></div>`; });
});

// Init i18n on load
applyTranslations();

</script>
</body>
</html>
