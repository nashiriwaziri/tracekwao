<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="International community savings, SACCO, microfinance, shares, loans, governance, payments, partners, reports and administration platform.">
  <title>CSCMS Pro V5 International — Savings, Microfinance, Payments & Governance</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>

  <style>
    /* =============================================
       1. DESIGN TOKENS
       ============================================= */
    :root {
      --bg: #07111f;
      --panel: #0d1929;
      --panel2: #122238;
      --line: #21344d;
      --text: #e8f0f8;
      --muted: #8ea3b9;
      --p: #16a979;
      --p2: #35d39b;
      --p3: #0d8a63;
      --blue: #3b82f6;
      --red: #ef4444;
      --yellow: #f59e0b;
      --purple: #8b5cf6;
      --orange: #f97316;
      --radius: 12px;
      --font: 'Inter', system-ui, sans-serif;
      --logo-bg: #1d4ed8;
      --logo-text: #fff;
      --hero-text: var(--text);
      --shadow: rgba(0, 0, 0, 0.22);
      --input-bg: #091625;
      --input-border: var(--line);
      --input-focus: var(--p);
    }

    /* =============================================
       2. RESET & BASE
       ============================================= */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: linear-gradient(135deg, var(--bg), var(--panel));
      color: var(--text);
      font-family: var(--font);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
      transition: background 0.3s, color 0.3s;
    }
    button, input, select, textarea { font: inherit; }
    button { cursor: pointer; border: 0; background: none; }
    a { color: var(--p2); text-decoration: none; }
    img, video { max-width: 100%; display: block; }
    .hidden { display: none !important; }

    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: var(--panel); }
    ::-webkit-scrollbar-thumb { background: var(--line); border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--p3); }

    /* =============================================
       3. TYPOGRAPHY & SPACING UTILITIES
       ============================================= */
    .small { font-size: 11px; color: var(--muted); }
    .tiny  { font-size: 10px; color: var(--muted); }
    .b     { font-weight: 700; }

    /* =============================================
       4. FLEX & GRID UTILITIES
       ============================================= */
    .flex         { display: flex; }
    .flex-center  { display: flex; align-items: center; justify-content: center; }
    .flex-between { display: flex; align-items: center; justify-content: space-between; }
    .gap-xs  { gap: 4px; }
    .gap-sm  { gap: 8px; }
    .gap-md  { gap: 12px; }
    .gap-lg  { gap: 16px; }
    .wrap    { flex-wrap: wrap; }
    .col     { flex-direction: column; }
    .container { max-width: 1200px; margin: 0 auto; padding: 20px; }

    .row2      { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .row3      { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
    .row4      { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
    .auto-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px; }
    .metrics-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin-bottom: 18px; }

    /* =============================================
       5. BUTTONS
       ============================================= */
    .btn {
      border: 0; border-radius: 9px; padding: 10px 16px;
      font-weight: 600; font-size: 12px;
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      transition: all 0.2s; white-space: nowrap;
    }
    .btn:hover { filter: brightness(1.1); transform: translateY(-1px); }
    .btn:active { transform: translateY(0); }
    .btn:disabled { opacity: 0.5; pointer-events: none; }
    .btn-sm { padding: 6px 10px; font-size: 11px; border-radius: 6px; }

    .primary   { background: var(--p);      color: #fff; }
    .outline   { background: transparent;   color: var(--p2); border: 1px solid var(--p); }
    .danger    { background: var(--red);    color: #fff; }
    .info      { background: var(--blue);   color: #fff; }
    .warning   { background: var(--yellow); color: #111; }
    .purple    { background: var(--purple); color: #fff; }
    .orange    { background: var(--orange); color: #fff; }
    .mutedbtn  { background: var(--panel2); color: var(--text); border: 1px solid var(--line); }
    .ghost     { background: transparent; color: var(--muted); padding: 6px 8px; }
    .ghost:hover { color: var(--p2); background: rgba(22,169,121,0.06); }

    .btn-member {
      background: linear-gradient(135deg, var(--blue), #1e40af); color: #fff;
      border: 0; border-radius: 9px; padding: 10px 16px;
      font-weight: 600; font-size: 12px;
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      transition: all 0.2s; cursor: pointer; white-space: nowrap;
    }
    .btn-member:hover { filter: brightness(1.15); transform: translateY(-1px); }

    .btn-full { width: 100%; justify-content: center; }

    /* =============================================
       6. CARDS
       ============================================= */
    .card {
      background: rgba(13,25,41,0.96);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 18px;
      transition: border-color 0.25s, box-shadow 0.25s;
    }
    .card:hover { border-color: rgba(22,169,121,0.15); box-shadow: 0 4px 20px rgba(0,0,0,0.2); }

    .metric-card { display: flex; align-items: center; gap: 14px; padding: 14px 18px; }
    .metric-icon { width: 44px; height: 44px; border-radius: 10px; display: grid; place-items: center; font-size: 18px; flex-shrink: 0; }
    .metric-card h3 { font-size: 22px; margin: 2px 0 0; line-height: 1.2; }
    .metric-card p  { font-size: 11px; color: var(--muted); margin: 0; }

    .section-head { display: flex; justify-content: space-between; gap: 10px; align-items: center; flex-wrap: wrap; margin-bottom: 16px; }
    .section-head h2, .section-head h3 { margin: 0; }
    .actions { display: flex; gap: 6px; flex-wrap: wrap; }

    /* =============================================
       7. FORMS (Shared base for .field and .su-field)
       ============================================= */
    .field, .su-field { margin: 11px 0; }
    .field label, .su-field label {
      display: block; font-size: 11px; color: var(--muted);
      margin-bottom: 5px; font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.5px;
    }
    .field input, .field select, .field textarea {
      width: 100%; padding: 11px 12px;
      border: 1px solid var(--input-border); background: var(--input-bg); color: var(--text);
      border-radius: 8px; outline: none; transition: border-color 0.2s; font-size: 13px;
    }
    .field input:focus, .field select:focus, .field textarea:focus {
      border-color: var(--input-focus); box-shadow: 0 0 0 3px rgba(22,169,121,0.06);
    }

    /* Sign-up form: icon-wrapped inputs */
    .su-field { margin: 10px 0; }
    .su-input-wrap { position: relative; display: flex; align-items: center; }
    .su-input-icon { position: absolute; left: 12px; color: var(--muted); font-size: 13px; pointer-events: none; z-index: 1; }
    .su-input-wrap input, .su-input-wrap select {
      width: 100%; padding: 11px 12px 11px 38px;
      border: 1px solid var(--input-border); background: var(--input-bg); color: var(--text);
      border-radius: 8px; outline: none; font-size: 13px;
    }
    .su-input-wrap input:focus, .su-input-wrap select:focus { border-color: var(--input-focus); }
    .su-row  { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .su-row3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
    .su-submit {
      width: 100%; margin-top: 18px; padding: 13px 16px;
      font-size: 14px; font-weight: 700; border-radius: 10px;
      background: linear-gradient(135deg, var(--p), #0d8a63);
      color: #fff; border: 0; cursor: pointer;
      display: flex; align-items: center; justify-content: center; gap: 10px;
      transition: all 0.25s; box-shadow: 0 4px 16px rgba(22,169,121,0.2);
    }
    .su-submit:hover { filter: brightness(1.12); transform: translateY(-2px); }
    .su-submit:disabled { opacity: 0.55; pointer-events: none; }

    /* =============================================
       8. TABLES
       ============================================= */
    .table-wrap { overflow: auto; border: 1px solid var(--line); border-radius: 10px; max-height: 500px; }
    .table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .table th, .table td { padding: 9px 12px; border-bottom: 1px solid var(--line); text-align: left; white-space: nowrap; }
    .table th { background: #101f33; color: var(--muted); font-size: 10px; text-transform: uppercase; letter-spacing: 0.6px; position: sticky; top: 0; z-index: 2; }
    .table tr:hover td { background: rgba(22,169,121,0.03); }

    /* =============================================
       9. BADGES
       ============================================= */
    .badge { padding: 3px 9px; border-radius: 20px; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; display: inline-block; }
    .badge-default { background: #18304a; color: var(--muted); }
    .ok       { background: #0b3a2c; color: #55e1ae; }
    .warn     { background: #3c2b08; color: #ffc857; }
    .bad      { background: #40151a; color: #ff7b85; }
    .info-b   { background: #0c2d4a; color: #60a5fa; }
    .purple-b { background: #2d1650; color: #c084fc; }

    /* =============================================
       10. MODALS
       ============================================= */
    .modal {
      position: fixed; inset: 0; background: rgba(0,0,0,0.72);
      display: none; align-items: center; justify-content: center;
      z-index: 100; padding: 15px; backdrop-filter: blur(5px);
    }
    .modal.show { display: flex; }
    .modal-card {
      width: min(740px, 100%); max-height: 90vh; overflow-y: auto;
      background: var(--panel); border: 1px solid var(--line);
      border-radius: 14px; padding: 24px;
      animation: modalIn 0.22s ease;
    }
    @keyframes modalIn { from { opacity: 0; transform: translateY(16px) scale(0.97); } to { opacity: 1; transform: none; } }
    .modal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
    .close { color: var(--muted); font-size: 22px; transition: color 0.15s; }
    .close:hover { color: var(--red); }

    /* =============================================
       11. TOASTS
       ============================================= */
    .toast-container {
      position: fixed; right: 18px; bottom: 18px; z-index: 200;
      display: flex; flex-direction: column; gap: 8px; max-width: 360px;
    }
    .toast {
      background: #10243a; border: 1px solid var(--p); padding: 12px 18px;
      border-radius: 9px; box-shadow: 0 8px 24px rgba(0,0,0,0.4);
      color: var(--text); font-size: 13px;
      display: flex; align-items: center; gap: 10px; animation: toastIn 0.3s ease;
    }
    .toast.error   { border-color: var(--red); }
    .toast.success { border-color: var(--p); }
    .toast.warning { border-color: var(--yellow); }
    @keyframes toastIn { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }

    /* =============================================
       12. LANDING / HERO
       ============================================= */
    .landing { min-height: 100vh; }
    .hero { text-align: center; padding: 65px 20px 30px; }
    .brand { font-size: 40px; font-weight: 800; margin: 12px 0 5px; }
    .tag { color: var(--muted); font-size: 14px; }
    .hero-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-top: 25px; }
    .locale-bar { display: flex; gap: 6px; justify-content: center; margin-top: 14px; flex-wrap: wrap; }
    .locale-btn {
      padding: 4px 12px; border-radius: 16px; font-size: 11px; font-weight: 600;
      background: var(--panel2); color: var(--muted); border: 1px solid var(--line);
      cursor: pointer; transition: all 0.2s;
    }
    .locale-btn:hover, .locale-btn.active { background: var(--p); color: #fff; border-color: var(--p); }
    .hero .brand, .hero h2, .hero h3 { color: var(--hero-text); }

    /* =============================================
       13. AUTH SCREENS
       ============================================= */
    .auth { min-height: 100vh; display: grid; place-items: center; padding: 20px; }
    .auth-card { width: min(520px, 100%); background: var(--panel); border: 1px solid var(--line); border-radius: 16px; padding: 28px; }
    .member-reg-screen { min-height: 100vh; display: grid; place-items: center; padding: 20px; }
    .member-reg-card { background: var(--panel); border: 1px solid var(--line); border-radius: 16px; padding: 30px; width: min(640px, 100%); position: relative; }
    .mr-back { position: absolute; top: 15px; left: 15px; color: var(--muted); font-size: 16px; display: flex; align-items: center; gap: 5px; }
    .mr-back:hover { color: var(--p2); }

    /* =============================================
       14. APP LAYOUT (Sidebar + Topbar)
       ============================================= */
    .app-layout { min-height: 100vh; display: flex; }
    .sidebar {
      width: 260px; min-height: 100vh; background: var(--input-bg);
      border-right: 1px solid var(--line); overflow-y: auto;
      position: fixed; left: 0; top: 0; bottom: 0; z-index: 20;
      transition: transform 0.3s;
    }
    .side-head { padding: 16px; border-bottom: 1px solid var(--line); display: flex; align-items: center; gap: 10px; }
    .side-head h4 { margin: 0; font-size: 14px; }
    .side-head .role-tag { font-size: 10px; padding: 2px 8px; border-radius: 12px; background: var(--p); color: #fff; font-weight: 700; }
    .nav-section { padding: 8px 12px; }
    .nav-label { font-size: 9px; color: #4a6580; text-transform: uppercase; margin: 12px 6px 4px; font-weight: 700; letter-spacing: 1px; }
    .nav-btn {
      width: 100%; text-align: left; color: var(--muted); padding: 9px 12px;
      border-radius: 7px; display: flex; align-items: center; gap: 9px;
      font-size: 12px; font-weight: 500; transition: all 0.15s;
    }
    .nav-btn:hover { background: #10243a; color: var(--text); }
    .nav-btn.active { background: rgba(22,169,121,0.1); color: var(--p2); font-weight: 600; }
    .nav-btn i { width: 20px; text-align: center; font-size: 13px; }
    .main-area { margin-left: 260px; flex: 1; min-height: 100vh; display: flex; flex-direction: column; }
    .top-bar {
      height: 58px; position: sticky; top: 0; z-index: 15;
      background: rgba(9,22,37,0.95); backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--line);
      display: flex; justify-content: space-between; align-items: center; padding: 0 20px;
    }
    .content-area { padding: 22px; flex: 1; }
    .search-box {
      display: flex; align-items: center; gap: 6px;
      background: var(--panel2); border: 1px solid var(--line);
      border-radius: 7px; padding: 0 10px;
    }
    .search-box input { background: transparent; border: 0; color: var(--text); padding: 7px; outline: none; font-size: 12px; width: 150px; }

    /* =============================================
       15. SUPER ADMIN LAYOUT
       ============================================= */
    .super { min-height: 100vh; }
    .super-top {
      padding: 16px 22px; border-bottom: 1px solid var(--line);
      display: flex; justify-content: space-between; align-items: center;
      background: linear-gradient(135deg, #0d1929, #0a1423);
    }
    .super-body { display: flex; min-height: calc(100vh - 58px); }
    .super-nav { width: 230px; background: var(--input-bg); border-right: 1px solid var(--line); padding: 16px 10px; overflow-y: auto; }
    .super-content { flex: 1; padding: 24px; overflow-y: auto; max-height: calc(100vh - 58px); }
    .snav-btn {
      width: 100%; text-align: left; color: var(--muted); padding: 10px 14px;
      border-radius: 8px; display: flex; align-items: center; gap: 10px;
      font-size: 12px; transition: all 0.15s; font-weight: 500; margin-bottom: 2px;
    }
    .snav-btn:hover { background: #10243a; color: var(--text); }
    .snav-btn.active { background: rgba(239,68,68,0.12); color: var(--red); font-weight: 600; }
    .snav-btn i { width: 18px; text-align: center; }
    .snav-section { font-size: 9px; color: #4a6580; text-transform: uppercase; margin: 16px 6px 6px; font-weight: 700; letter-spacing: 1px; padding-left: 14px; }

    /* SA Metrics */
    .sa-metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; margin-bottom: 24px; }
    .sa-metric {
      background: linear-gradient(135deg, rgba(13,25,41,0.96), rgba(18,34,56,0.7));
      border: 1px solid var(--line); border-radius: var(--radius);
      padding: 20px; display: flex; align-items: center; gap: 16px; transition: all 0.3s;
    }
    .sa-metric:hover { border-color: rgba(239,68,68,0.2); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.3); }
    .sa-metric-icon { width: 52px; height: 52px; border-radius: 12px; display: grid; place-items: center; font-size: 22px; flex-shrink: 0; }
    .sa-metric h3 { font-size: 26px; font-weight: 800; margin: 0; line-height: 1.1; }
    .sa-metric p  { font-size: 11px; color: var(--muted); margin: 2px 0 0; }
    .sa-metric .trend { font-size: 10px; font-weight: 700; display: inline-flex; align-items: center; gap: 3px; margin-top: 4px; }
    .trend-up   { color: #55e1ae; }
    .trend-down { color: #ff7b85; }

    /* SA Group Cards */
    .sa-group-card {
      background: var(--panel); border: 1px solid var(--line);
      border-radius: var(--radius); overflow: hidden; transition: all 0.3s;
    }
    .sa-group-card:hover { border-color: rgba(239,68,68,0.15); box-shadow: 0 6px 24px rgba(0,0,0,0.25); }
    .sa-group-header { padding: 16px 20px; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
    .sa-group-body { padding: 16px 20px; }
    .sa-group-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; padding: 0 20px 16px; }
    .sa-group-stat { text-align: center; padding: 10px 8px; background: var(--panel2); border-radius: 8px; border: 1px solid var(--line); }
    .sa-group-stat h4 { font-size: 18px; font-weight: 800; margin: 0; color: var(--p2); }
    .sa-group-stat p  { font-size: 9px; color: var(--muted); margin: 2px 0 0; text-transform: uppercase; letter-spacing: 0.5px; }
    .sa-group-actions { padding: 12px 20px; border-top: 1px solid var(--line); display: flex; gap: 6px; flex-wrap: wrap; background: rgba(9,22,37,0.5); }

    /* SA User Rows */
    .sa-user-row { display: flex; align-items: center; gap: 14px; padding: 14px 18px; border-bottom: 1px solid var(--line); transition: background 0.15s; }
    .sa-user-row:hover { background: rgba(239,68,68,0.03); }
    .sa-user-row:last-child { border-bottom: 0; }
    .sa-user-avatar { width: 38px; height: 38px; border-radius: 50%; background: var(--panel2); display: grid; place-items: center; font-size: 14px; color: var(--muted); flex-shrink: 0; border: 1px solid var(--line); }
    .sa-user-info { flex: 1; min-width: 0; }
    .sa-user-info h4 { font-size: 13px; font-weight: 600; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sa-user-info p  { font-size: 11px; color: var(--muted); margin: 1px 0 0; }

    /* SA Edit / Delete */
    .sa-edit-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .sa-edit-full { grid-column: 1 / -1; }
    .sa-delete-card { background: var(--panel); border: 2px solid var(--red); border-radius: 14px; padding: 28px; width: min(460px, 90%); text-align: center; }
    .sa-delete-icon { width: 64px; height: 64px; border-radius: 50%; background: rgba(239,68,68,0.12); display: grid; place-items: center; margin: 0 auto 16px; font-size: 28px; color: var(--red); }

    /* SA Filter Bar */
    .sa-filter-bar { display: flex; gap: 10px; align-items: center; margin-bottom: 18px; flex-wrap: wrap; }
    .sa-filter-bar input, .sa-filter-bar select { padding: 9px 14px; border: 1px solid var(--line); background: var(--input-bg); color: var(--text); border-radius: 8px; font-size: 12px; outline: none; }
    .sa-filter-bar input:focus, .sa-filter-bar select:focus { border-color: var(--red); }
    .sa-filter-bar input { flex: 1; min-width: 200px; }

    /* SA Charts & Activity */
    .sa-chart-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 24px; }
    .sa-chart-box { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px; }
    .sa-chart-box h3 { font-size: 13px; margin: 0 0 14px; font-weight: 600; }
    .chart-area { height: 220px; position: relative; }

    .sa-activity { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px; max-height: 360px; overflow-y: auto; }
    .sa-activity-item { display: flex; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 12px; }
    .sa-activity-item:last-child { border-bottom: 0; }
    .sa-activity-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; margin-top: 5px; }
    .sa-activity-time { font-size: 10px; color: var(--muted); margin-top: 2px; }

    /* =============================================
       16. PRICING
       ============================================= */
    .pricing-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; max-width: 1000px; margin: 0 auto; }
    .price-card {
      background: var(--panel); border: 1px solid var(--line);
      border-radius: var(--radius); padding: 30px 25px;
      text-align: left; transition: all 0.3s;
    }
    .price-card:hover { transform: translateY(-5px); border-color: var(--p); }
    .price-featured { border-color: var(--p); }
    .price-amount { font-size: 36px; font-weight: 800; margin: 10px 0; }
    .price-amount span { font-size: 14px; color: var(--muted); font-weight: 400; }

    /* =============================================
       17. ID / CREDENTIAL DISPLAY
       ============================================= */
    .id-reminder-card { width: min(480px, 100%); text-align: center; padding: 32px 28px !important; }
    .id-reminder-icon {
      width: 64px; height: 64px; border-radius: 50%;
      background: linear-gradient(135deg, var(--p), #07563f);
      display: grid; place-items: center; margin: 0 auto 18px;
      font-size: 28px; color: #fff; box-shadow: 0 6px 24px rgba(22,169,121,0.3);
    }
    .id-display-box {
      background: linear-gradient(135deg, #0a1e33, #0d2236);
      border: 2px solid var(--p); border-radius: 12px; padding: 16px 20px; margin-bottom: 22px;
    }
    .id-label { display: block; font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: 1px; font-weight: 700; margin-bottom: 6px; }
    .id-value { display: block; font-size: 20px; font-weight: 800; color: var(--p2); letter-spacing: 1.5px; word-break: break-all; }

    .member-created-icon {
      width: 64px; height: 64px; border-radius: 50%;
      background: linear-gradient(135deg, var(--blue), #1e40af);
      display: grid; place-items: center; margin: 0 auto 18px;
      font-size: 28px; color: #fff; box-shadow: 0 6px 24px rgba(59,130,246,0.3);
    }
    .cred-box {
      background: linear-gradient(135deg, #0a1e33, #0d2236);
      border: 2px solid var(--blue); border-radius: 12px;
      padding: 14px 18px; margin-bottom: 10px; text-align: left;
    }
    .cred-label { display: block; font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: 1px; font-weight: 700; margin-bottom: 4px; }
    .cred-value { display: block; font-size: 16px; font-weight: 700; color: #60a5fa; word-break: break-all; }

    /* =============================================
       18. TOGGLE / PROGRESS / UPLOAD
       ============================================= */
    .toggle-switch {
      position: relative; width: 40px; height: 20px;
      background: var(--panel2); border-radius: 20px;
      cursor: pointer; border: 1px solid var(--line);
      transition: all 0.2s; flex-shrink: 0;
    }
    .toggle-switch.active { background: var(--p); border-color: var(--p); }
    .toggle-switch::after {
      content: ''; position: absolute; top: 2px; left: 2px;
      width: 14px; height: 14px; background: #fff; border-radius: 50%;
      transition: transform 0.2s;
    }
    .toggle-switch.active::after { transform: translateX(20px); }

    .progress-bar { width: 100%; height: 6px; background: var(--panel2); border-radius: 3px; overflow: hidden; margin-top: 8px; }
    .progress-fill { height: 100%; background: var(--p); width: 0%; transition: width 0.2s; }

    .upload-zone {
      border: 2px dashed var(--line); border-radius: 10px;
      padding: 20px; text-align: center; cursor: pointer; transition: all 0.2s;
    }
    .upload-zone:hover { border-color: var(--p); background: rgba(22,169,121,0.04); }
    .upload-zone input[type="file"] { display: none; }
    .upload-preview { max-width: 100%; max-height: 150px; border-radius: 8px; object-fit: cover; margin-top: 10px; }

    .upload-zone-pro {
      border: 2px dashed var(--line); border-radius: 14px;
      padding: 22px; text-align: center; cursor: pointer;
      background: var(--panel2); transition: 0.2s;
    }
    .upload-zone-pro:hover { border-color: var(--blue); background: rgba(59,130,246,0.06); }
    .upload-zone-pro input { display: none; }
    .ad-preview { width: 100%; height: 180px; border-radius: 12px; object-fit: cover; background: var(--panel2); border: 1px solid var(--line); margin-top: 10px; }

    /* =============================================
       19. NETWORK BANNER
       ============================================= */
    #networkBanner {
      position: fixed; top: 0; left: 0; right: 0; z-index: 300;
      padding: 10px; text-align: center; font-size: 12px;
      font-weight: 700; display: none; transition: all 0.3s;
    }
    #networkBanner.offline { background: var(--red); color: #fff; display: block; }
    #networkBanner.online  { background: var(--p);  color: #fff; display: block; }

    /* =============================================
       20. SYSTEM LOGO
       ============================================= */
    .sys-logo {
      border-radius: 14px; overflow: hidden; flex-shrink: 0;
      background: var(--logo-bg); color: var(--logo-text);
      box-shadow: 0 6px 18px var(--shadow); display: grid; place-items: center;
    }
    .sys-logo img { width: 100%; height: 100%; object-fit: cover; background: var(--logo-bg); }
    .sys-logo-icon { color: var(--logo-text); font-size: 30px; }
    .sys-logo-sm .sys-logo-icon { font-size: 16px; }
    .sys-logo-xs .sys-logo-icon { font-size: 12px; }

    /* =============================================
       21. ADS / ANNOUNCEMENTS
       ============================================= */
    .ad-banner-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; max-width: 1200px; margin: 0 auto; }
    .ad-banner-card {
      border-radius: 16px; overflow: hidden; background: var(--panel);
      border: 1px solid var(--line); transition: all 0.35s;
    }
    .ad-banner-card:hover { transform: translateY(-6px); box-shadow: 0 16px 40px rgba(0,0,0,0.4); border-color: var(--p); }
    .ad-banner-img { width: 100%; height: 200px; object-fit: cover; background: var(--panel2); }
    .ad-banner-content { padding: 20px; }
    .ad-banner-title { font-size: 18px; font-weight: 700; margin-bottom: 8px; }
    .ad-banner-desc { font-size: 13px; color: var(--muted); line-height: 1.6; margin-bottom: 12px; }
    .ad-banner-cta {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 8px 16px; border-radius: 8px; background: var(--p);
      color: #fff; font-size: 12px; font-weight: 600;
      transition: all 0.2s; text-decoration: none;
    }
    .ad-banner-cta:hover { filter: brightness(1.15); }

    .ad-grid-pro { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px; }
    .ad-tile-pro {
      background: var(--panel); border: 1px solid var(--line);
      border-radius: 16px; overflow: hidden; display: flex;
      flex-direction: column; min-height: 100%; transition: 0.25s;
    }
    .ad-tile-pro:hover { transform: translateY(-4px); border-color: var(--blue); box-shadow: 0 12px 30px var(--shadow); }
    .ad-tile-media { width: 100%; height: 185px; background: var(--panel2); object-fit: cover; }
    .ad-tile-body { padding: 16px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
    .ad-tile-title { font-size: 15px; font-weight: 800; }
    .ad-tile-desc { font-size: 12px; color: var(--muted); line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .ad-tile-meta { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-top: auto; padding-top: 8px; }

    /* =============================================
       22. PAYMENTS
       ============================================= */
    .pay-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; }
    .pay-method {
      background: var(--panel2); border: 1px solid var(--line);
      border-radius: 12px; padding: 16px; cursor: pointer; transition: 0.2s;
    }
    .pay-method:hover, .pay-method.active { border-color: var(--p); transform: translateY(-2px); }
    .pay-icon { width: 42px; height: 42px; border-radius: 10px; display: grid; place-items: center; background: rgba(22,169,121,0.12); color: var(--p2); font-size: 18px; margin-bottom: 10px; }
    .payment-status { display: inline-flex; align-items: center; gap: 6px; padding: 4px 9px; border-radius: 20px; font-size: 10px; font-weight: 700; }
    .payment-pending { background: #3c2b08; color: #ffc857; }
    .payment-paid    { background: #0b3a2c; color: #55e1ae; }
    .payment-failed  { background: #40151a; color: #ff7b85; }

    /* =============================================
       23. TRAFFIC LIGHT
       ============================================= */
    .traffic-cell { display: flex; align-items: center; gap: 7px; min-width: 145px; }
    .traffic-dot  { width: 13px; height: 13px; border-radius: 50%; display: inline-block; flex: 0 0 auto; }
    .traffic-green  { background: #22c55e; box-shadow: 0 0 8px rgba(34,197,94,0.45); }
    .traffic-yellow { background: #eab308; box-shadow: 0 0 8px rgba(234,179,8,0.45); }
    .traffic-orange { background: #f97316; box-shadow: 0 0 8px rgba(249,115,22,0.45); }
    .traffic-red    { background: #ef4444; box-shadow: 0 0 8px rgba(239,68,68,0.45); animation: tlPulse 2s infinite; }
    @keyframes tlPulse { 0%,100% { box-shadow: 0 0 7px rgba(239,68,68,0.45); } 50% { box-shadow: 0 0 16px rgba(239,68,68,0.8); } }

    /* =============================================
       24. PARTNERS
       ============================================= */
    .partner-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 14px; }
    .partner-card {
      background: var(--panel); border: 1px solid var(--line);
      border-radius: 14px; padding: 18px; display: flex;
      gap: 14px; align-items: flex-start; transition: 0.2s;
    }
    .partner-card:hover { border-color: var(--p); transform: translateY(-2px); }
    .partner-logo {
      width: 54px; height: 54px; border-radius: 12px;
      background: var(--panel2); border: 1px solid var(--line);
      display: grid; place-items: center; overflow: hidden; flex: 0 0 auto;
    }
    .partner-logo img { width: 100%; height: 100%; object-fit: contain; }
    .plan-pill { display: inline-flex; align-items: center; gap: 5px; padding: 4px 9px; border-radius: 20px; background: rgba(59,130,246,0.12); color: #60a5fa; font-size: 10px; font-weight: 700; }
    .invoice-box { border: 1px dashed var(--line); border-radius: 12px; padding: 16px; background: rgba(18,34,56,0.45); }
    .provider-note { padding: 12px; border-radius: 9px; background: rgba(59,130,246,0.08); border: 1px solid rgba(59,130,246,0.2); font-size: 11px; color: var(--muted); }
    .kpi-mini { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin-bottom: 16px; }
    .kpi-mini .card { padding: 14px; }
    .app-badge { display: inline-flex; align-items: center; gap: 6px; padding: 5px 9px; border-radius: 999px; background: rgba(59,130,246,0.12); color: var(--blue); font-size: 9px; font-weight: 800; text-transform: uppercase; }

    /* =============================================
       25. THEME / CONTROL PANEL
       ============================================= */
    .theme-picker { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .theme-choice {
      border: 1px solid var(--line); border-radius: 12px; padding: 12px;
      background: var(--panel2); color: var(--text); text-align: left;
      cursor: pointer; transition: 0.2s;
    }
    .theme-choice:hover, .theme-choice.active { border-color: var(--blue); transform: translateY(-2px); box-shadow: 0 5px 18px var(--shadow); }
    .theme-swatch { height: 46px; border-radius: 9px; margin-bottom: 8px; border: 1px solid rgba(255,255,255,0.15); }
    .sw-black { background: #080808; }
    .sw-white { background: #f8fafc; }
    .sw-blue  { background: #0b2a52; }

    .control-panel { display: grid; grid-template-columns: repeat(auto-fit, minmax(145px, 1fr)); gap: 10px; margin: 0 0 18px; }
    .control-tile {
      background: var(--panel); border: 1px solid var(--line);
      border-radius: 12px; padding: 13px; text-align: left;
      cursor: pointer; transition: 0.2s; color: var(--text);
    }
    .control-tile:hover { border-color: var(--blue); transform: translateY(-2px); box-shadow: 0 8px 22px var(--shadow); }
    .control-tile i { font-size: 17px; color: var(--blue); margin-bottom: 8px; }
    .control-tile b { display: block; font-size: 12px; }
    .control-tile span { display: block; font-size: 10px; color: var(--muted); margin-top: 2px; }

    /* =============================================
       26. CONFIRM DIALOG
       ============================================= */
    .confirm-overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,0.7);
      display: flex; align-items: center; justify-content: center;
      z-index: 150; backdrop-filter: blur(3px);
    }
    .confirm-card {
      background: var(--panel); border: 1px solid var(--line);
      border-radius: 14px; padding: 24px; width: min(400px, 90%); text-align: center;
    }
    .confirm-card h3 { margin-bottom: 8px; }
    .confirm-card p  { color: var(--muted); font-size: 13px; margin-bottom: 20px; }

    /* =============================================
       27. GLOBAL THEME TRANSITIONS
       ============================================= */
    body, .card, .modal-card, .auth-card, .member-reg-card,
    .sidebar, .top-bar, .super-nav, .super-top, .super-content,
    .field input, .field select, .field textarea, .table th,
    .price-card, .partner-card, .ad-banner-card, .pay-method,
    .sa-metric, .sa-group-card, .sa-chart-box, .sa-activity,
    .sa-delete-card, .confirm-card, .search-box,
    .cred-box, .id-display-box {
      transition: background-color 0.25s, border-color 0.25s, color 0.25s, box-shadow 0.25s;
    }

    /* =============================================
       28. LANDING SECTIONS
       ============================================= */
    .section-announcements { padding: 40px 20px; background: linear-gradient(180deg, transparent, var(--panel)); }
    .section-featured { padding: 20px 20px 40px; }
    .section-partners { padding: 40px 20px; }
    .section-pricing { padding: 60px 20px 80px; text-align: center; }

    /* =============================================
       29. RESPONSIVE
       ============================================= */
    @media (max-width: 900px) {
      .sidebar { transform: translateX(-100%); }
      .sidebar.open { transform: translateX(0); }
      .main-area { margin-left: 0; }
      .super-nav { width: 180px; }
      .row2, .row3, .row4, .su-row, .su-row3, .sa-edit-grid, .sa-chart-grid { grid-template-columns: 1fr; }
      .top-bar { padding: 0 12px; }
      .content-area { padding: 14px; }
      .brand { font-size: 30px; }
      .search-box input { width: 100px; }
      .sa-metrics { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 600px) {
      .hero-actions { flex-direction: column; align-items: center; }
      .hero-actions .btn { width: 100%; max-width: 280px; }
      .super-body { flex-direction: column; }
      .super-nav {
        width: 100%; border-right: 0; border-bottom: 1px solid var(--line);
        display: flex; flex-wrap: wrap; gap: 4px; padding: 8px;
      }
      .snav-btn { width: auto; padding: 6px 10px; font-size: 11px; }
      .snav-section { display: none; }
      .super-content { max-height: none; }
      .ad-banner-grid, .ad-grid-pro { grid-template-columns: 1fr; }
      .sa-metrics { grid-template-columns: 1fr; }
      .sa-filter-bar { flex-direction: column; }
      .sa-filter-bar input { width: 100%; }
      .theme-picker { grid-template-columns: 1fr; }
      .control-panel { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</head>

<body>
  <!-- Network Banner -->
  <div id="networkBanner" role="alert" aria-live="polite">
    <i class="fa-solid fa-wifi"></i>
    <span>Offline Mode</span>
  </div>

  <!-- ==========================================
       LANDING PAGE
       ========================================== -->
  <div id="landing" class="landing">
    <section class="hero">
      <div class="sys-logo" id="heroLogo" style="width:72px;height:72px;margin:0 auto">
        <i class="fa-solid fa-vault sys-logo-icon"></i>
      </div>
      <h1 class="brand" id="heroBrand">CSCMS Pro V5</h1>
      <p class="tag">Community Savings &bull; Microfinance &bull; Shares &bull; Loans &bull; Governance</p>

      <div class="locale-bar" id="localeBar" role="group" aria-label="Language selection"></div>

      <div class="hero-actions">
        <button class="btn primary" onclick="showScreen('auth')" aria-label="Sign In">
          <i class="fa-solid fa-right-to-bracket"></i>
          <span data-i18n="Sign In">Sign In</span>
        </button>
        <button class="btn outline" onclick="showScreen('memberRegScreen')" aria-label="Sign Up">
          <i class="fa-solid fa-user-plus"></i>
          <span data-i18n="Sign Up">Sign Up</span>
        </button>
        <button class="btn mutedbtn" onclick="openModal('superLoginModal')" aria-label="Super Admin">
          <i class="fa-solid fa-shield-halved"></i>
          <span data-i18n="Super Admin">Super Admin</span>
        </button>
      </div>
    </section>

    <!-- Announcements -->
    <section class="section-announcements">
      <div class="container">
        <div class="section-head">
          <h2>
            <i class="fa-solid fa-bullhorn" style="color:var(--blue)"></i>
            <span data-i18n="System Announcements">System Announcements</span>
          </h2>
          <span class="small" data-i18n="Visible to all visitors and logged-in users">Visible to all visitors and logged-in users</span>
        </div>
        <div id="publicAds" class="ad-grid-pro"></div>
      </div>
    </section>

    <!-- Featured -->
    <section class="section-featured">
      <div class="container">
        <div class="section-head">
          <h2>
            <i class="fa-solid fa-star" style="color:var(--yellow)"></i>
            <span data-i18n="Featured">Featured</span>
          </h2>
        </div>
        <div id="landingAds" class="ad-banner-grid"></div>
      </div>
    </section>

    <!-- Partners -->
    <section class="section-partners">
      <div class="container">
        <div class="section-head">
          <h2>
            <i class="fa-solid fa-handshake" style="color:var(--p2)"></i>
            <span data-i18n="Partners">Partners</span>
          </h2>
          <span class="small" data-i18n="Connect directly to partner applications and services">Connect directly to partner applications and services</span>
        </div>
        <div id="publicPartners" class="partner-grid"></div>
      </div>
    </section>

    <!-- Pricing -->
    <section class="section-pricing">
      <h2 data-i18n="Plans & Pricing">Plans & Pricing</h2>
      <div class="pricing-grid">
        <div class="price-card">
          <h3 data-i18n="Free Trial">Free Trial</h3>
          <div class="price-amount">$0<span>/mo</span></div>
          <p class="small">1 Month, 15 Members</p>
          <button class="btn outline btn-full" style="margin-top:15px" onclick="showScreen('memberRegScreen')">
            <span data-i18n="Get Started">Get Started</span>
          </button>
        </div>
        <div class="price-card price-featured">
          <h3 data-i18n="Basic">Basic</h3>
          <div class="price-amount">$29<span>/mo</span></div>
          <p class="small">1 Group, 50 Members</p>
          <button class="btn primary btn-full" style="margin-top:15px" onclick="showScreen('memberRegScreen')">
            <span data-i18n="Choose Basic">Choose Basic</span>
          </button>
        </div>
        <div class="price-card">
          <h3 data-i18n="Pro">Pro</h3>
          <div class="price-amount">$79<span>/mo</span></div>
          <p class="small">5 Groups, 500 Members</p>
          <button class="btn info btn-full" style="margin-top:15px" onclick="showScreen('memberRegScreen')">
            <span data-i18n="Choose Pro">Choose Pro</span>
          </button>
        </div>
        <div class="price-card">
          <h3 data-i18n="Enterprise">Enterprise</h3>
          <div class="price-amount">$199<span>/mo</span></div>
          <p class="small">Unlimited</p>
          <button class="btn warning btn-full" style="margin-top:15px" onclick="showScreen('memberRegScreen')">
            <span data-i18n="Choose Enterprise">Choose Enterprise</span>
          </button>
        </div>
      </div>
    </section>
  </div>

  <!-- ==========================================
       SIGN UP
       ========================================== -->
  <div id="memberRegScreen" class="member-reg-screen hidden">
    <div class="member-reg-card">
      <button class="mr-back" onclick="showScreen('landing')" aria-label="Go back">
        <i class="fa-solid fa-arrow-left"></i>
        <span data-i18n="Back">Back</span>
      </button>

      <div style="text-align:center;margin-bottom:24px">
        <div class="sys-logo sys-logo-sm" id="signupLogo" style="width:56px;height:56px;margin:0 auto 14px">
          <i class="fa-solid fa-vault sys-logo-icon"></i>
        </div>
        <h2 data-i18n="Register Group">Register Group</h2>
        <p class="small" data-i18n="Works Offline. Syncs when online.">Works Offline. Syncs when online.</p>
      </div>

      <form id="signUpForm" autocomplete="off" novalidate>
        <!-- Name row -->
        <div class="su-row3">
          <div class="su-field">
            <label data-i18n="First Name *">First Name *</label>
            <div class="su-input-wrap">
              <i class="fa-solid fa-user su-input-icon"></i>
              <input id="suFname" required placeholder="First name" aria-required="true">
            </div>
          </div>
          <div class="su-field">
            <label data-i18n="Middle Name">Middle Name</label>
            <div class="su-input-wrap">
              <i class="fa-solid fa-user su-input-icon"></i>
              <input id="suMname" placeholder="Middle name">
            </div>
          </div>
          <div class="su-field">
            <label data-i18n="Last Name *">Last Name *</label>
            <div class="su-input-wrap">
              <i class="fa-solid fa-user su-input-icon"></i>
              <input id="suLname" required placeholder="Last name" aria-required="true">
            </div>
          </div>
        </div>

        <!-- ID & Phone -->
        <div class="su-row">
          <div class="su-field">
            <label data-i18n="National ID *">National ID *</label>
            <div class="su-input-wrap">
              <i class="fa-solid fa-id-card su-input-icon"></i>
              <input id="suNida" required placeholder="e.g. 12345678" aria-required="true">
            </div>
          </div>
          <div class="su-field">
            <label data-i18n="Phone *">Phone *</label>
            <div class="su-input-wrap">
              <i class="fa-solid fa-phone su-input-icon"></i>
              <input id="suPhone" type="tel" required placeholder="+255 700 000 000" aria-required="true">
            </div>
          </div>
        </div>

        <!-- Group Type & Name -->
        <div class="su-row">
          <div class="su-field">
            <label data-i18n="Group Type *">Group Type *</label>
            <div class="su-input-wrap">
              <i class="fa-solid fa-layer-group su-input-icon"></i>
              <select id="suGroupType" required aria-required="true">
                <option value="">Select...</option>
                <option value="rosca">ROSCA</option>
                <option value="asca">ASCA</option>
                <option value="vsla">VSLA</option>
                <option value="sacco">SACCO</option>
                <option value="welfare">Welfare</option>
                <option value="investment">Investment</option>
                <option value="chama">Chama</option>
                <option value="stokvel">Stokvel</option>
                <option value="tontine">Tontine</option>
              </select>
            </div>
          </div>
          <div class="su-field">
            <label data-i18n="Group Name *">Group Name *</label>
            <div class="su-input-wrap">
              <i class="fa-solid fa-building su-input-icon"></i>
              <input id="suGroupName" required placeholder="Group name" aria-required="true">
            </div>
          </div>
        </div>

        <!-- Country & Currency -->
        <div class="su-row">
          <div class="su-field">
            <label data-i18n="Country *">Country *</label>
            <div class="su-input-wrap">
              <i class="fa-solid fa-globe su-input-icon"></i>
              <select id="suCountry" required aria-required="true"></select>
            </div>
          </div>
          <div class="su-field">
            <label data-i18n="Currency">Currency</label>
            <div class="su-input-wrap">
              <i class="fa-solid fa-coins su-input-icon"></i>
              <select id="suCurrency" required></select>
            </div>
          </div>
        </div>

        <!-- Password & Language -->
        <div class="su-row">
          <div class="su-field">
            <label data-i18n="Password *">Password *</label>
            <div class="su-input-wrap">
              <i class="fa-solid fa-lock su-input-icon"></i>
              <input id="suPassword" type="password" minlength="6" required placeholder="Min 6 chars" aria-required="true">
            </div>
          </div>
          <div class="su-field">
            <label data-i18n="Language">Language</label>
            <div class="su-input-wrap">
              <i class="fa-solid fa-language su-input-icon"></i>
              <select id="suLang">
                <option value="en">English</option>
                <option value="sw">Kiswahili</option>
                <option value="fr">Français</option>
                <option value="ar">العربية</option>
                <option value="zh">中文</option>
                <option value="pt">Português</option>
                <option value="hi">हिन्दी</option>
              </select>
            </div>
          </div>
        </div>

        <button class="su-submit" type="submit" id="suSubmitBtn">
          <i class="fa-solid fa-user-plus"></i>
          <span data-i18n="Sign Up">Sign Up</span>
        </button>
      </form>
    </div>
  </div>

  <!-- ==========================================
       MODALS
       ========================================== -->

  <!-- Registration Success -->
  <div id="idReminderModal" class="modal" role="dialog" aria-labelledby="idReminderTitle">
    <div class="modal-card id-reminder-card">
      <div class="id-reminder-icon">
        <i class="fa-solid fa-check"></i>
      </div>
      <h2 id="idReminderTitle" data-i18n="Registration Successful!">Registration Successful!</h2>
      <p class="small" style="margin-bottom:20px">Please <strong>COPY</strong> your Group ID.</p>
      <div class="id-display-box">
        <span class="id-label">Your Group ID</span>
        <span class="id-value" id="displayedUserId">---</span>
      </div>
      <div style="display:flex;flex-direction:column;gap:8px">
        <button class="btn primary" onclick="copyGroupId()">
          <i class="fa-solid fa-copy"></i> COPY ID
        </button>
        <button class="btn outline" onclick="closeModal('idReminderModal');showScreen('auth')">
          Go to Sign In
        </button>
      </div>
    </div>
  </div>

  <!-- Member Created -->
  <div id="memberCreatedModal" class="modal" role="dialog" aria-labelledby="mcTitle">
    <div class="modal-card" style="width:min(520px,100%);text-align:center;padding:32px 28px">
      <div class="member-created-icon">
        <i class="fa-solid fa-user-check"></i>
      </div>
      <h2 id="mcTitle">Member Created!</h2>
      <p class="small" style="margin-bottom:18px">Share these credentials with the member so they can sign in.</p>
      <div id="mcCredentials"></div>
      <div style="display:flex;flex-direction:column;gap:8px;margin-top:18px">
        <button class="btn primary" onclick="copyMemberCredentials()">
          <i class="fa-solid fa-copy"></i> COPY CREDENTIALS
        </button>
        <button class="btn outline" onclick="closeModal('memberCreatedModal')">
          Close
        </button>
      </div>
    </div>
  </div>

  <!-- Super Admin Login Modal -->
  <div id="superLoginModal" class="modal" role="dialog" aria-labelledby="saLoginTitle">
    <div class="modal-card" style="width:min(420px,100%);text-align:center;padding:32px 28px">
      <div style="width:64px;height:64px;border-radius:50%;background:rgba(239,68,68,0.12);display:grid;place-items:center;margin:0 auto 18px;font-size:28px;color:var(--red)">
        <i class="fa-solid fa-shield-halved"></i>
      </div>
      <h2 id="saLoginTitle">Super Admin</h2>
      <p class="small" style="margin-bottom:18px">Enter your super admin credentials</p>
      <form id="superLoginForm" autocomplete="off">
        <div class="field">
          <label>Email</label>
          <input id="saEmail" type="email" required placeholder="admin@cscms.io">
        </div>
        <div class="field">
          <label>Password</label>
          <input id="saPassword" type="password" required placeholder="Password">
        </div>
        <button class="btn danger btn-full" type="submit" style="margin-top:12px">
          <i class="fa-solid fa-right-to-bracket"></i> Sign In
        </button>
      </form>
      <button class="btn ghost" style="margin-top:10px" onclick="closeModal('superLoginModal')">Cancel</button>
    </div>
  </div>

  <!-- ==========================================
       TOAST CONTAINER
       ========================================== -->
  <div class="toast-container" id="toastContainer"></div>

  <!-- ==========================================
       AUTH SCREEN (Sign In)
       ========================================== -->
  <div id="auth" class="auth hidden">
    <div class="auth-card">
      <div style="text-align:center;margin-bottom:24px">
        <div class="sys-logo sys-logo-sm" id="signinLogo" style="width:56px;height:56px;margin:0 auto 14px">
          <i class="fa-solid fa-vault sys-logo-icon"></i>
        </div>
        <h2 data-i18n="Sign In">Sign In</h2>
        <p class="small" data-i18n="Enter your Group ID and password">Enter your Group ID and password</p>
      </div>
      <form id="signInForm" autocomplete="off">
        <div class="field">
          <label data-i18n="Group ID">Group ID</label>
          <input id="siGroupId" required placeholder="e.g. GRP-ABC123" aria-required="true">
        </div>
        <div class="field">
          <label data-i18n="Password">Password</label>
          <input id="siPassword" type="password" required placeholder="Password" aria-required="true">
        </div>
        <button class="btn primary btn-full" type="submit" style="margin-top:12px">
          <i class="fa-solid fa-right-to-bracket"></i>
          <span data-i18n="Sign In">Sign In</span>
        </button>
      </form>
      <div style="text-align:center;margin-top:16px">
        <button class="btn ghost" onclick="showScreen('memberRegScreen')">
          <i class="fa-solid fa-user-plus"></i>
          <span data-i18n="Create Account">Create Account</span>
        </button>
      </div>
    </div>
  </div>

  <script>
    /* =============================================
       CORE APPLICATION STATE
       ============================================= */
    const APP = {
      currentScreen: 'landing',
      user: null,
      isSuperAdmin: false,
      locale: 'en',
      groups: JSON.parse(localStorage.getItem('cscms_groups') || '[]'),
      members: JSON.parse(localStorage.getItem('cscms_members') || '[]'),
      savings: JSON.parse(localStorage.getItem('cscms_savings') || '[]'),
      loans: JSON.parse(localStorage.getItem('cscms_loans') || '[]'),
      shares: JSON.parse(localStorage.getItem('cscms_shares') || '[]'),
      payments: JSON.parse(localStorage.getItem('cscms_payments') || '[]'),
      partners: JSON.parse(localStorage.getItem('cscms_partners') || '[]'),
      ads: JSON.parse(localStorage.getItem('cscms_ads') || '[]'),
      activity: JSON.parse(localStorage.getItem('cscms_activity') || '[]'),
    };

    /* =============================================
       PERSISTENCE
       ============================================= */
    function save(key, data) {
      localStorage.setItem('cscms_' + key, JSON.stringify(data));
    }

    function persistAll() {
      save('groups', APP.groups);
      save('members', APP.members);
      save('savings', APP.savings);
      save('loans', APP.loans);
      save('shares', APP.shares);
      save('payments', APP.payments);
      save('partners', APP.partners);
      save('ads', APP.ads);
      save('activity', APP.activity);
    }

    /* =============================================
       SCREEN NAVIGATION
       ============================================= */
    const SCREENS = ['landing', 'auth', 'memberRegScreen', 'appLayout', 'superAdmin'];

    function showScreen(id) {
      SCREENS.forEach(s => {
        const el = document.getElementById(s);
        if (el) el.classList.toggle('hidden', s !== id);
      });
      APP.currentScreen = id;
      window.scrollTo(0, 0);
    }

    /* =============================================
       MODAL HELPERS
       ============================================= */
    function openModal(id) {
      const m = document.getElementById(id);
      if (m) m.classList.add('show');
    }

    function closeModal(id) {
      const m = document.getElementById(id);
      if (m) m.classList.remove('show');
    }

    /* =============================================
       TOAST NOTIFICATIONS
       ============================================= */
    function toast(message, type = 'success') {
      const container = document.getElementById('toastContainer');
      const el = document.createElement('div');
      el.className = 'toast ' + type;
      const icons = { success: 'fa-check-circle', error: 'fa-times-circle', warning: 'fa-exclamation-triangle' };
      el.innerHTML = '<i class="fa-solid ' + (icons[type] || icons.success) + '"></i><span>' + message + '</span>';
      container.appendChild(el);
      setTimeout(() => { el.style.opacity = '0'; el.style.transform = 'translateY(10px)'; setTimeout(() => el.remove(), 300); }, 3500);
    }

    /* =============================================
       NETWORK STATUS
       ============================================= */
    function updateNetworkStatus() {
      const banner = document.getElementById('networkBanner');
      if (!navigator.onLine) {
        banner.className = 'offline';
        banner.querySelector('span').textContent = 'Offline Mode — Data saved locally';
      } else {
        banner.className = 'online';
        banner.querySelector('span').textContent = 'Back Online';
        setTimeout(() => { banner.className = ''; }, 2500);
      }
    }
    window.addEventListener('online', updateNetworkStatus);
    window.addEventListener('offline', updateNetworkStatus);

    /* =============================================
       UTILITY: ID GENERATOR
       ============================================= */
    function genId(prefix = 'GRP') {
      const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
      let id = prefix + '-';
      for (let i = 0; i < 6; i++) id += chars[Math.floor(Math.random() * chars.length)];
      return id;
    }

    /* =============================================
       SIGN UP HANDLER
       ============================================= */
    document.getElementById('signUpForm').addEventListener('submit', function(e) {
      e.preventDefault();
      const fname = document.getElementById('suFname').value.trim();
      const mname = document.getElementById('suMname').value.trim();
      const lname = document.getElementById('suLname').value.trim();
      const nida = document.getElementById('suNida').value.trim();
      const phone = document.getElementById('suPhone').value.trim();
      const groupType = document.getElementById('suGroupType').value;
      const groupName = document.getElementById('suGroupName').value.trim();
      const country = document.getElementById('suCountry').value;
      const currency = document.getElementById('suCurrency').value;
      const password = document.getElementById('suPassword').value;
      const lang = document.getElementById('suLang').value;

      if (!fname || !lname || !nida || !phone || !groupType || !groupName || !country || !password) {
        toast('Please fill in all required fields', 'error');
        return;
      }
      if (password.length < 6) {
        toast('Password must be at least 6 characters', 'error');
        return;
      }

      const groupId = genId('GRP');
      const group = {
        id: groupId, name: groupName, type: groupType,
        country, currency, lang,
        adminName: fname + (mname ? ' ' + mname : '') + ' ' + lname,
        adminNida: nida, adminPhone: phone,
        password, createdAt: new Date().toISOString(),
        memberCount: 1, status: 'active', plan: 'trial'
      };

      APP.groups.push(group);
      persistAll();

      document.getElementById('displayedUserId').textContent = groupId;
      openModal('idReminderModal');
      this.reset();
      toast('Group registered successfully!', 'success');
    });

    /* =============================================
       SIGN IN HANDLER
       ============================================= */
    document.getElementById('signInForm').addEventListener('submit', function(e) {
      e.preventDefault();
      const groupId = document.getElementById('siGroupId').value.trim();
      const password = document.getElementById('siPassword').value;
      const group = APP.groups.find(g => g.id === groupId && g.password === password);
      if (!group) {
        toast('Invalid Group ID or password', 'error');
        return;
      }
      APP.user = group;
      toast('Welcome back, ' + group.name, 'success');
      // Navigate to app dashboard (would be built out in full version)
    });

    /* =============================================
       SUPER ADMIN LOGIN
       ============================================= */
    document.getElementById('superLoginForm').addEventListener('submit', function(e) {
      e.preventDefault();
      const email = document.getElementById('saEmail').value.trim();
      const password = document.getElementById('saPassword').value;
      // Default super admin credentials for demo
      if (email === 'admin@cscms.io' && password === 'superadmin') {
        APP.isSuperAdmin = true;
        closeModal('superLoginModal');
        toast('Super Admin access granted', 'success');
        // Navigate to super admin dashboard (would be built out in full version)
      } else {
        toast('Invalid super admin credentials', 'error');
      }
    });

    /* =============================================
       COPY HELPERS
       ============================================= */
    function copyGroupId() {
      const id = document.getElementById('displayedUserId').textContent;
      navigator.clipboard.writeText(id).then(() => toast('Group ID copied!', 'success')).catch(() => toast('Copy failed — please copy manually', 'error'));
    }

    function copyMemberCredentials() {
      const el = document.getElementById('mcCredentials');
      if (el) navigator.clipboard.writeText(el.textContent).then(() => toast('Credentials copied!', 'success')).catch(() => toast('Copy failed', 'error'));
    }

    /* =============================================
       COUNTRY / CURRENCY POPULATION
       ============================================= */
    const COUNTRIES = [
      { code: 'KE', name: 'Kenya', currency: 'KES' },
      { code: 'TZ', name: 'Tanzania', currency: 'TZS' },
      { code: 'UG', name: 'Uganda', currency: 'UGX' },
      { code: 'RW', name: 'Rwanda', currency: 'RWF' },
      { code: 'NG', name: 'Nigeria', currency: 'NGN' },
      { code: 'GH', name: 'Ghana', currency: 'GHS' },
      { code: 'ZA', name: 'South Africa', currency: 'ZAR' },
      { code: 'US', name: 'United States', currency: 'USD' },
      { code: 'GB', name: 'United Kingdom', currency: 'GBP' },
      { code: 'IN', name: 'India', currency: 'INR' },
    ];

    const CURRENCIES = ['KES', 'TZS', 'UGX', 'RWF', 'NGN', 'GHS', 'ZAR', 'USD', 'GBP', 'EUR', 'INR'];

    function populateSelects() {
      const countrySel = document.getElementById('suCountry');
      const currencySel = document.getElementById('suCurrency');
      COUNTRIES.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.code; opt.textContent = c.name;
        countrySel.appendChild(opt);
      });
      CURRENCIES.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c; opt.textContent = c;
        currencySel.appendChild(opt);
      });
    }

    /* =============================================
       LOCALE BAR
       ============================================= */
    const LOCALES = [
      { code: 'en', label: 'English' },
      { code: 'sw', label: 'Kiswahili' },
      { code: 'fr', label: 'Français' },
      { code: 'ar', label: 'العربية' },
    ];

    function buildLocaleBar() {
      const bar = document.getElementById('localeBar');
      LOCALES.forEach(l => {
        const btn = document.createElement('button');
        btn.className = 'locale-btn' + (l.code === APP.locale ? ' active' : '');
        btn.textContent = l.label;
        btn.onclick = () => {
          APP.locale = l.code;
          bar.querySelectorAll('.locale-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
        };
        bar.appendChild(btn);
      });
    }

    /* =============================================
       INIT
       ============================================= */
    populateSelects();
    buildLocaleBar();
  </script>
</body>
</html>
