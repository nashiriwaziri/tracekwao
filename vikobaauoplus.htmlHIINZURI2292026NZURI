<!DOCTYPE html>
<html lang="sw">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>CSCMS Pro V3 — International Vikoba & Microfinance</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
:root{--bg:#07111f;--panel:#0d1929;--panel2:#122238;--line:#21344d;--text:#e8f0f8;--muted:#8ea3b9;--p:#16a979;--p2:#35d39b;--blue:#3b82f6;--red:#ef4444;--yellow:#f59e0b;--purple:#8b5cf6;--radius:12px}
*{box-sizing:border-box}body{margin:0;background:linear-gradient(135deg,#06101c,#0a1423);color:var(--text);font-family:Inter,Arial,sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer}.hidden{display:none!important}
.landing{min-height:100vh}.hero{text-align:center;padding:65px 20px 30px}
.logo{width:72px;height:72px;border-radius:18px;background:linear-gradient(135deg,var(--p),#07563f);display:grid;place-items:center;margin:auto;font-size:30px;color:#fff;overflow:hidden}
.brand{font-size:40px;font-weight:800;margin:12px 0 5px}.tag{color:var(--muted);font-size:14px}.hero-actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:25px}
.btn{border:0;border-radius:9px;padding:10px 15px;font-weight:600;font-size:12px;display:inline-flex;align-items:center;justify-content:center;gap:8px;transition:.2s}
.primary{background:var(--p);color:#fff}.outline{background:transparent;color:var(--p2);border:1px solid var(--p)}.danger{background:var(--red);color:#fff}.info{background:var(--blue);color:#fff}.warning{background:var(--yellow);color:#111}.purple{background:var(--purple);color:#fff}.mutedbtn{background:var(--panel2);color:var(--text);border:1px solid var(--line)}
.container{max-width:1200px;margin:auto;padding:20px}.public-grid,.metrics,.grid{display:grid;gap:14px}.public-grid{grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
.card{background:rgba(13,25,41,.96);border:1px solid var(--line);border-radius:var(--radius);padding:18px}.ad{min-height:150px}.ad img{max-width:100%;max-height:170px;border-radius:9px;object-fit:cover}
.auth{min-height:100vh;display:grid;place-items:center;padding:20px}.auth-card{width:min(520px,100%);background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:25px}
.tabs{display:flex;background:var(--panel2);padding:4px;border-radius:10px;margin-bottom:18px}.tab{flex:1;background:none;color:var(--muted);border:0;padding:10px;border-radius:7px}.tab.active{background:var(--p);color:#fff}
.field{margin:11px 0}.field label{display:block;font-size:11px;color:var(--muted);margin-bottom:5px;font-weight:600}.field input,.field select,.field textarea{width:100%;padding:11px;border:1px solid var(--line);background:#091625;color:var(--text);border-radius:8px;outline:none}.field input:focus{border-color:var(--p)}.row{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.small{font-size:11px;color:var(--muted)}

.member-reg-screen{min-height:100vh;display:grid;place-items:center;padding:20px;background:linear-gradient(135deg,#06101c,#0a1423)}.member-reg-card{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:30px;width:min(520px,100%);position:relative}.mr-back{position:absolute;top:15px;left:15px;background:none;border:0;color:var(--muted);font-size:16px;cursor:pointer;display:flex;align-items:center;gap:5px}.mr-back:hover{color:var(--p2)}

.app{min-height:100vh}.sidebar{position:fixed;left:0;top:0;bottom:0;width:270px;background:#091625;border-right:1px solid var(--line);overflow:auto;z-index:20;transition:.3s}.side-head{padding:18px;border-bottom:1px solid var(--line);font-weight:800;display:flex;align-items:center;gap:10px}
.nav{padding:10px}.nav-title{font-size:10px;color:#61758d;text-transform:uppercase;margin:14px 9px 5px;font-weight:700}.nav button{width:100%;text-align:left;background:none;color:var(--muted);border:0;padding:10px;border-radius:8px;display:flex;align-items:center;gap:10px;font-size:13px}.nav button:hover,.nav button.active{background:#10243a;color:var(--p2)}.nav i{width:22px}
.main{margin-left:270px;min-height:100vh}.top{height:62px;position:sticky;top:0;z-index:15;background:rgba(9,22,37,.96);border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;padding:0 20px}
.content{padding:22px;flex:1}.metrics{grid-template-columns:repeat(auto-fit,minmax(160px,1fr));margin-bottom:18px}.metric{display:flex;align-items:center;gap:15px}.metric .icon{width:40px;height:40px;border-radius:10px;display:grid;place-items:center;font-size:18px}.metric h3{font-size:24px;margin:5px 0}.metric p{font-size:11px;color:var(--muted);margin:0}
.grid2{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}.grid3{grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}
.section{display:none}.section.active{display:block}.section-head{display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:18px}.section-head h2{margin:0}.actions{display:flex;gap:7px;flex-wrap:wrap}
.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:10px}.table{width:100%;border-collapse:collapse;font-size:12px}.table th,.table td{padding:10px;border-bottom:1px solid var(--line);text-align:left;white-space:nowrap}.table th{background:#101f33;color:var(--muted);font-size:10px;text-transform:uppercase}
.badge{padding:4px 7px;border-radius:20px;font-size:9px;background:#18304a;font-weight:600}.ok{background:#0b3a2c;color:#55e1ae}.warn{background:#3c2b08;color:#ffc857}.bad{background:#40151a;color:#ff7b85}
.modal{position:fixed;inset:0;background:#000b;display:none;align-items:center;justify-content:center;z-index:100;padding:15px}.modal.show{display:flex}.modal-card{width:min(720px,100%);max-height:92vh;overflow:auto;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:20px}.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.close{background:none;border:0;color:var(--muted);font-size:20px}
.toast{position:fixed;right:18px;bottom:18px;z-index:200;background:#10243a;border:1px solid var(--p);padding:12px 15px;border-radius:9px;display:none;box-shadow:0 5px 15px rgba(0,0,0,.3);color:var(--text);font-size:13px}.toast.show{display:block;animation:fadeI .3s}@keyframes fadeI{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.super{min-height:100vh}.super-top{padding:16px 22px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;background:var(--panel)}.super-body{padding:22px;max-width:1400px;margin:auto}.chip{font-size:10px;color:var(--muted)}
.pricing{padding:60px 20px 80px;text-align:center}.pricing h2{font-size:32px;margin-bottom:10px;color:var(--text)}.pricing .sub{color:var(--muted);margin-bottom:40px;font-size:15px}.pricing-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px;max-width:1000px;margin:auto}
.price-card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:30px 25px;text-align:left;display:flex;flex-direction:column;transition:.3s;position:relative}.price-card:hover{transform:translateY(-5px);border-color:var(--p)}.price-card.featured{border-color:var(--p);box-shadow:0 10px 30px rgba(22,169,121,.15)}
.badge-pop{position:absolute;top:-12px;right:20px;background:var(--p);color:#fff;padding:5px 12px;border-radius:6px;font-size:11px;font-weight:700;text-transform:uppercase}
.price-header{margin-bottom:20px;border-bottom:1px solid var(--line);padding-bottom:20px}.price-header h3{font-size:20px;margin-bottom:10px;display:flex;align-items:center;gap:10px;color:var(--text)}.price-amount{font-size:36px;font-weight:800;color:var(--text)}.price-amount span{font-size:14px;color:var(--muted);font-weight:400}.price-trial{font-size:12px;color:var(--p2);margin-top:5px;font-weight:600}
.price-features{list-style:none;margin-bottom:30px;flex:1;padding:0}.price-features li{font-size:13px;padding:10px 0;border-bottom:1px solid rgba(33,52,77,.5);display:flex;justify-content:space-between;color:var(--muted)}.price-features li strong{color:var(--text);font-weight:600}
.alert-trial{background:var(--yellow);color:#111;padding:10px 20px;font-size:13px;font-weight:600;text-align:center;display:flex;justify-content:center;align-items:center;gap:10px;border-bottom:1px solid rgba(0,0,0,.1)}
.lc-row{display:flex;justify-content:space-between;padding:6px 0;font-size:13px;border-bottom:1px solid var(--line)}.lc-row:last-child{border-bottom:none}.lc-row .lc-l{color:var(--muted)}.lc-row .lc-v{font-weight:700}
.search-bar{display:flex;align-items:center;gap:8px;background:var(--panel2);border:1px solid var(--line);border-radius:9px;padding:0 12px;margin-right:10px}.search-bar input{background:transparent;border:0;color:var(--text);padding:8px;outline:none;font-size:12px;width:200px}
@media(max-width:850px){.sidebar{transform:translateX(-100%)}.sidebar.open{transform:translateX(0)}.main{margin-left:0}.row{grid-template-columns:1fr}.top{padding:0 12px}.content{padding:14px}.search-bar input{width:120px}}
</style>
</head>
<body>

<!-- LANDING PAGE -->
<div id="landing" class="landing">
  <section class="hero">
    <div class="logo"><i class="fa-solid fa-people-group" style="font-size:36px"></i></div>
    <div class="brand">CSCMS Pro</div>
    <div class="tag">Vikoba • Microfinance • Savings • Shares • Loans • Governance</div>
    <div class="hero-actions">
      <button class="btn primary" onclick="openAuth('member')"><i class="fa-solid fa-right-to-bracket"></i> Ingia Kikundi</button>
      <button class="btn outline" onclick="showMemberReg()"><i class="fa-solid fa-user-plus"></i> Jiunge Kikundi</button>
      <button class="btn outline" onclick="openAuth('chair')"><i class="fa-solid fa-user-tie"></i> Sajili Kikundi</button>
      <button class="btn mutedbtn" onclick="openSuper()"><i class="fa-solid fa-shield-halved"></i> Super Admin</button>
    </div>
  </section>
  <div class="container">
    <div class="section-head"><h2>Matangazo ya Mfumo</h2><span class="small">Yanaonekana kwa wageni na watumiaji wote</span></div>
    <div id="publicAds" class="public-grid"></div>
  </div>
  <div class="pricing">
    <h2>Plani na Bei</h2><div class="sub">Chagua mfumo unaofaa kwa kikundi chako</div>
    <div class="pricing-grid">
      <div class="price-card"><div class="price-header"><h3><i class="fa-solid fa-seedling"></i> Basic</h3><div class="price-amount">TZS 0<span>/mo</span></div><div class="price-trial">Free Forever</div></div><ul class="price-features"><li><strong>Members</strong> 50</li><li><strong>Loans</strong> Basic</li><li><strong>Support</strong> Community</li></ul><button class="btn outline" style="width:100%" onclick="selectPackage('basic')">Anza Basic</button></div>
      <div class="price-card featured"><div class="badge-pop">Popular</div><div class="price-header"><h3><i class="fa-solid fa-crown"></i> Standard</h3><div class="price-amount">TZS 1,500<span>/mo</span></div><div class="price-trial">14 Days Free Trial</div></div><ul class="price-features"><li><strong>Members</strong> Unlimited</li><li><strong>Loans & Shares</strong> Advanced</li><li><strong>Reports & Audit</strong> Full</li></ul><button class="btn primary" style="width:100%" onclick="selectPackage('standard')">Anza Standard</button></div>
      <div class="price-card"><div class="price-header"><h3><i class="fa-solid fa-building-columns"></i> Premium</h3><div class="price-amount">TZS 10,000<span>/mo</span></div><div class="price-trial">For Large SACCOs</div></div><ul class="price-features"><li><strong>Multi-Branch</strong> Yes</li><li><strong>Welfare & Dividends</strong> Yes</li><li><strong>API & Integrations</strong> Yes</li></ul><button class="btn outline" style="width:100%" onclick="selectPackage('premium')">Anza Premium</button></div>
    </div>
  </div>
</div>

<!-- MEMBER REGISTRATION -->
<div id="memberRegScreen" class="member-reg-screen hidden">
  <div class="member-reg-card">
    <button class="mr-back" onclick="backLanding()"><i class="fa-solid fa-arrow-left"></i> Rudi</button>
    <h2 style="margin-bottom:5px">Jiunge kama Mwanachama</h2>
    <div class="small" style="margin-bottom:20px">Jaza fomu hii kujiunga na kikundi la akiba na mikopo.</div>
    <form id="memberRegForm">
      <div class="row">
        <div class="field"><label>Jina la Kwanza *</label><input id="mrFname" required></div>
        <div class="field"><label>Jina la Mwisho *</label><input id="mrLname" required></div>
      </div>
      <div class="row">
        <div class="field"><label>Umri *</label><input id="mrAge" type="number" min="18" max="120" required></div>
        <div class="field"><label>Jinsia *</label><select id="mrGender" required><option value="">Chagua</option><option>Mme</option><option>Mke</option></select></div>
      </div>
      <div class="field"><label>Namba ya Simu *</label><input id="mrPhone" type="tel" required placeholder="07XXXXXXXX"></div>
      <div class="field"><label>Chagua Kikundi *</label><select id="mrGroup" required><option value="">Inapakia makundi...</option></select></div>
      <div class="field"><label>Neno la Siri *</label><input id="mrPass" type="password" minlength="6" required></div>
      <button class="btn primary" style="width:100%" type="submit"><i class="fa-solid fa-user-plus"></i> Jiunge Sasa</button>
      <div class="small" style="text-align:center; margin-top:12px">Tayari una akaunti? <a href="#" onclick="event.preventDefault();openAuth('member')" style="color:var(--p2);cursor:pointer">Ingia</a></div>
    </form>
  </div>
</div>

<!-- AUTH SCREEN -->
<div id="auth" class="auth hidden">
  <div class="auth-card">
    <div class="section-head"><div><h2 id="authTitle">Ingia Kikundi</h2><div class="small">Taarifa za kifedha zinaonekana ndani ya kikundi husika pekee.</div></div><button class="close" onclick="backLanding()">×</button></div>
    <div id="authMsg" class="small" style="color:var(--red)"></div>
    <div class="tabs"><button id="memberTab" class="tab active" onclick="authMode('member')">Mwanachama</button><button id="chairTab" class="tab" onclick="authMode('chair')">Chairperson</button></div>
    <form id="memberLogin">
      <div class="field"><label>Group Username</label><input id="loginGroupUsername" required placeholder="mfano: kikundichaamani"></div>
      <div class="field"><label>Namba ya Simu</label><input id="loginPhone" required placeholder="07XXXXXXXX"></div>
      <div id="recaptcha-container"></div>
      <button class="btn primary" style="width:100%" type="submit">Tuma OTP / Ingia</button>
    </form>
    <form id="chairLogin" class="hidden">
      <div class="field"><label>Email ya Chairperson</label><input id="chairEmail" type="email" required></div>
      <div class="field"><label>Password</label><input id="chairPassword" type="password" required></div>
      <button class="btn primary" style="width:100%">Ingia</button>
    </form>
    <hr style="border-color:var(--line);margin:22px 0">
    <form id="chairRegister" class="hidden">
      <h3>Sajili Kikundi Kipya</h3>
      <div class="row"><div class="field"><label>Jina la Kikundi</label><input id="regGroupName"></div><div class="field"><label>Group Username</label><input id="regGroupUsername"></div></div>
      <div class="row"><div class="field"><label>Jina la Chairperson</label><input id="regChairName"></div><div class="field"><label>Simu</label><input id="regChairPhone"></div></div>
      <div class="field"><label>Email</label><input id="regChairEmail" type="email"></div>
      <div class="field"><label>Password</label><input id="regChairPassword" type="password" minlength="8"></div>
      <button class="btn outline" type="submit">Sajili Kikundi</button>
    </form>
  </div>
</div>

<!-- SUPER ADMIN -->
<div id="super" class="super hidden">
  <div class="super-top"><div><b>CSCMS SUPER ADMIN</b><div class="small">Global system administration</div></div><button class="btn outline" onclick="superLogout()">Logout</button></div>
  <div class="super-body">
    <div class="metrics" id="superMetrics"></div>
    <div class="grid grid2">
      <div class="card"><div class="section-head"><h3>Vikundi Vilivyojiunga</h3><button class="btn primary" onclick="openModal('globalAdModal')">+ Global Ad</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Kikundi</th><th>Username</th><th>Status</th><th>Created</th></tr></thead><tbody id="superGroups"></tbody></table></div></div>
      <div class="card"><div class="section-head"><h3>Matangazo ya Mfumo</h3></div><div id="superAds"></div></div>
    </div>
  </div>
</div>

<!-- MAIN APPLICATION -->
<div id="app" class="app hidden">
  <aside id="sidebar" class="sidebar">
    <div class="side-head"><i class="fa-solid fa-people-group" style="color:var(--p2);font-size:24px"></i> <span id="sideGroup">CSCMS</span><div class="small" id="sideRole"></div></div>
    <nav class="nav" id="nav"></nav>
  </aside>
  <main class="main">
    <header class="top">
      <div style="display:flex;align-items:center;gap:12px"><button class="btn mutedbtn" onclick="toggleSidebar()">☰</button> <b id="pageTitle">Dashibodi</b></div>
      <div style="display:flex;align-items:center;gap:12px">
        <div class="search-bar"><i class="fa-solid fa-search" style="color:var(--muted)"></i><input type="text" placeholder="Tafuta..." id="globalSearch" onkeyup="handleSearch(event)"></div>
        <span class="small" id="topUser"></span> 
        <button class="btn outline" onclick="logout()" style="padding:4px 12px">Toka</button>
      </div>
    </header>
    <div id="trialAlert" class="alert-trial hidden"><i class="fa-solid fa-triangle-exclamation"></i> <span id="trialMsg">Your trial period will end soon</span></div>
    <div class="content">
      <!-- DASHBOARD -->
      <section id="dashboard" class="section active">
        <div class="section-head"><div><h2>Dashibodi ya Kikundi</h2><div class="small" id="dashboardScope"></div></div><div class="actions"><button class="btn info" onclick="printReceipt()"><i class="fa-solid fa-print"></i> PDF/Print</button></div></div>
        <div class="metrics" id="metrics"></div>
        <div class="grid grid2">
          <div class="card"><h3>Mgawanyo wa Mali</h3><div style="height:220px; position:relative;"><canvas id="dashChartPortfolio"></canvas></div></div>
          <div class="card"><h3>Ukuaji wa Akiba</h3><div style="height:220px; position:relative;"><canvas id="dashChartTrend"></canvas></div></div>
        </div>
        <div class="grid grid2" style="margin-top:14px">
          <div class="card"><h3>Muhtasari wa Fedha</h3><div id="financialSummary"></div></div>
          <div class="card"><h3>Matangazo & Taarifa</h3><div id="dashboardAds"></div></div>
        </div>
      </section>
      
      <!-- MEMBERS -->
      <section id="members" class="section"><div class="section-head"><div><h2>Wanachama</h2><div class="small">Wanachama wa kikundi hiki tu</div></div><div class="actions"><button class="btn primary chair-only" onclick="openModal('memberModal')">+ Ongeza</button></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Jina</th><th>Simu</th><th>Hisa</th><th>Akiba</th><th>Mkopo</th><th>Status</th><th>Actions</th></tr></thead><tbody id="membersBody"></tbody></table></div></section>
      
      <!-- BRANCHES -->
      <section id="branches" class="section"><div class="section-head"><div><h2>Tawi / Branches</h2></div><div class="actions"><button class="btn primary chair-only" onclick="openModal('modalBranch')">+ Add Branch</button></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Address</th></tr></thead><tbody id="branchesBody"></tbody></table></div></section>
      
      <!-- GROUP -->
      <section id="group" class="section"><div class="section-head"><div><h2>Kikundi & Sera</h2></div></div><div class="card"><form id="groupForm"><div class="row"><div class="field"><label>Jina</label><input id="gName"></div><div class="field"><label>Registration No</label><input id="gReg"></div></div><div class="row"><div class="field"><label>Bei ya Hisa</label><input id="gSharePrice" type="number" min="0"></div><div class="field"><label>Max Shares/Member</label><input id="gMaxShares" type="number" min="0"></div></div><div class="row"><div class="field"><label>Meeting Day</label><input id="gMeetingDay"></div><div class="field"><label>Default Loan Interest %</label><input id="gInterest" type="number" step="0.01"></div></div><div class="row"><div class="field"><label>Base Currency</label><select id="gCurrency"><option>TZS</option><option>USD</option><option>KES</option><option>UGX</option></select></div><div class="field"><label>Lock Accounting Period</label><input id="gLockDate" type="date"></div></div><button class="btn primary chair-only" type="submit">Hifadhi</button></form></div></section>
      
      <!-- ANNOUNCEMENTS -->
      <section id="announcements" class="section"><div class="section-head"><div><h2>Matangazo ya Kikundi</h2></div><button class="btn primary chair-only" onclick="openModal('groupAdModal')">+ Tangazo</button></div><div id="groupAds" class="public-grid"></div></section>
      
      <!-- MEETINGS -->
      <section id="meetings" class="section"><div class="section-head"><div><h2>Vikao & Dakika</h2></div><button class="btn primary chair-only" onclick="openModal('meetingModal')">+ Kikao</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Tarehe</th><th>Mada</th><th>Dakika</th><th>Faini Za Vikao</th></tr></thead><tbody id="meetingsBody"></tbody></table></div></section>
      
      <!-- SAVINGS -->
      <section id="savings" class="section"><div class="section-head"><div><h2>Akiba</h2></div><div class="actions"><button class="btn primary chair-only" onclick="openModal('transactionModal');setTx('DEPOSIT')">+ Weka</button><button class="btn warning chair-only" onclick="openModal('transactionModal');setTx('WITHDRAWAL')">- Toa</button></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Member</th><th>Type</th><th>Amount</th><th>Action</th></tr></thead><tbody id="savingsBody"></tbody></table></div></section>
      
      <!-- SHARES -->
      <section id="shares" class="section"><div class="section-head"><div><h2>Hisa</h2></div><div class="actions"><button class="btn primary" onclick="openModal('shareModal');setShareMode('BUY')">Nunua</button><button class="btn outline" onclick="openModal('shareModal');setShareMode('TRANSFER')">Hamisha</button></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Member</th><th>Action</th><th>Qty</th><th>Value</th></tr></thead><tbody id="sharesBody"></tbody></table></div></section>
      
      <!-- LOANS -->
