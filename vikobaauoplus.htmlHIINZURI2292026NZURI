<script>
// ======== CORE LOGIC & MOCK IMPLEMENTATION ========
// (Using mock data structure to ensure UI works without immediate Firebase connection errors for demonstration)

const $ = id => document.getElementById(id);
const money = n => new Intl.NumberFormat('en-TZ', {style:'currency', currency:'TZS', maximumFractionDigits:0}).format(Number(n||0));
let state = { groupId: 'demo_grp', role: 'CHAIRPERSON', user: {name: 'Admin'}, members: [], loans: [], section: 'dashboard' };

function toast(m){$('toast').textContent=m;$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),3500);}
window.openModal = id => $(id).classList.add('show');
window.closeModal = id => $(id).classList.remove('show');
window.toggleSidebar = () => $('sidebar').classList.toggle('open');
window.backLanding = () => { $('auth').classList.add('hidden'); $('landing').classList.remove('hidden'); $('memberRegScreen').classList.add('hidden'); };
window.openAuth = m => { $('landing').classList.add('hidden'); $('auth').classList.remove('hidden'); $('memberRegScreen').classList.add('hidden'); authMode(m==='chair'?'chair':'member'); };
window.authMode = m => { $('memberTab').classList.toggle('active',m==='member'); $('chairTab').classList.toggle('active',m==='chair'); $('memberLogin').classList.toggle('hidden',m!=='member'); $('chairLogin').classList.toggle('hidden',m!=='chair'); $('chairRegister').classList.toggle('hidden',m!=='chair'); };
window.selectPackage = pkg => { toast(`Package ${pkg} selected. Proceeding to register.`); openAuth('chair'); };
window.showMemberReg = () => { $('landing').classList.add('hidden'); $('auth').classList.add('hidden'); $('memberRegScreen').classList.remove('hidden'); };
window.superLogout = window.logout = () => toast('Logged out (Demo)');

// Navigation Builder
function nav(){
    const items=[['dashboard','Dashibodi','gauge-high'],['members','Wanachama','users'],['branches','Tawi','code-branch'],['group','Kikundi','sitemap'],['announcements','Matangazo','bullhorn'],['meetings','Vikao','calendar-check'],['savings','Akiba','piggy-bank'],['shares','Hisa','certificate'],['loans','Mikopo','hand-holding-dollar'],['repayments','Marejesho','money-bill-transfer'],['expenses','Mapato/Matumizi','wallet'],['cashbook','Cashbook','book'],['ledger','General Ledger','file-invoice-dollar'],['welfare','Welfare','hand-holding-heart'],['guarantors','Wadhamini','user-shield'],['dividends','Dividends','coins'],['collateral','Dhamana','building-shield'],['penalties','Penalties','exclamation-triangle'],['reschedule','Rescheduling','clock-rotate-left'],['kyc','KYC','id-card'],['reports','Ripoti','chart-pie'],['audit','Audit Trail','clipboard-check'],['control','Control Panel','sliders'],['profile','Profaili','user']];
    $('nav').innerHTML=`<div class="nav-title">Main Menu</div>` + items.map(x=>`<button data-sec="${x[0]}" onclick="showSection('${x[0]}',this)"><i class="fa-solid fa-${x[2]}"></i>${x[1]}</button>`).join('');
}

window.showSection = (id, el) => {
    document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
    $(id).classList.add('active');
    document.querySelectorAll('.nav button').forEach(b => b.classList.remove('active'));
    if(el) el.classList.add('active');
    else document.querySelector(`.nav button[data-sec="${id}"]`)?.classList.add('active');
    $('pageTitle').textContent = document.querySelector(`button[data-sec="${id}"]`)?.innerText || id;
    state.section = id;
    loadSection(id);
};

function loadSection(id) {
    if(id==='dashboard') loadDashboard();
    else if(id==='members') loadMembers();
    else if(id==='collateral') loadCollateral();
    else if(id==='penalties') loadPenalties();
    else if(id==='reschedule') loadReschedule();
    else if(id==='kyc') loadKYC();
    // Other sections can be loaded similarly
}

// ======= MOCK DATA & RENDERING =======
state.members = [
    {id:'m1', name:'Juma Mohamed', phone:'0712345678', shares:10, savings:500000, loanBalance:200000, status:'ACTIVE', kyc: 'VERIFIED'},
    {id:'m2', name:'Amina Salim', phone:'0787654321', shares:5, savings:200000, loanBalance:0, status:'ACTIVE', kyc: 'PENDING'}
];
state.loans = [
    {id:'l1', memberId:'m1', principal:500000, balance:200000, interest:10, status:'ACTIVE', term:12},
    {id:'l2', memberId:'m2', principal:100000, balance:100000, interest:15, status:'OVERDUE', term:6}
];

function populateSelects() {
    const opts = state.members.map(m => `<option value="${m.id}">${m.name}</option>`).join('');
    ['txMember','shareMember','loanMember','wMember','gMember','dMember','colMember','kycMember'].forEach(id => {
        if($(id)) $(id).innerHTML = opts;
    });
    const lOpts = state.loans.map(l => `<option value="${l.id}">${l.id} (${l.principal})</option>`).join('');
    ['repayLoan','gLoan','penLoan'].forEach(id => {
        if($(id)) $(id).innerHTML = lOpts;
    });
}

function loadDashboard() {
    const totalSav = state.members.reduce((a,b) => a + b.savings, 0);
    const totalLoans = state.loans.reduce((a,b) => a + b.balance, 0);
    $('metrics').innerHTML = `
        <div class="card metric"><div class="icon" style="background:rgba(22,169,121,.15);color:var(--p2)"><i class="fa-solid fa-users"></i></div><div><h3>${state.members.length}</h3><p>Wanachama</p></div></div>
        <div class="card metric"><div class="icon" style="background:rgba(59,130,246,.15);color:var(--blue)"><i class="fa-solid fa-piggy-bank"></i></div><div><h3>${money(totalSav)}</h3><p>Jumla Akiba</p></div></div>
        <div class="card metric"><div class="icon" style="background:rgba(239,68,68,.15);color:var(--red)"><i class="fa-solid fa-hand-holding-dollar"></i></div><div><h3>${money(totalLoans)}</h3><p>Mikopo Hai</p></div></div>
    `;
    $('financialSummary').innerHTML = `<div class="lc-row"><div class="lc-l">Total Savings</div><div class="lc-v">${money(totalSav)}</div></div><div class="lc-row"><div class="lc-l">Outstanding Loans</div><div class="lc-v" style="color:var(--red)">${money(totalLoans)}</div></div>`;
}

function loadMembers() {
    $('membersBody').innerHTML = state.members.map(m => `<tr><td>${m.name}</td><td>${m.phone}</td><td>${m.shares}</td><td>${money(m.savings)}</td><td>${money(m.loanBalance)}</td><td><span class="badge ${m.status==='ACTIVE'?'ok':'bad'}">${m.status}</span></td><td><button class="btn outline" onclick="viewMemberFinance('${m.id}')">View</button></td></tr>`).join('');
}

// --- NEW FEATURE LOGIC ---

// 1. Collateral / Dhamana
window.loadCollateral = () => {
    // Mock data
    const data = [{owner:'Juma Mohamed', type:'Land', value:2000000, loan:'l1', status:'ACTIVE'}];
    $('collateralBody').innerHTML = data.map(d => `<tr><td>${d.owner}</td><td>${d.type}</td><td>${money(d.value)}</td><td>${d.loan}</td><td><span class="badge ok">${d.status}</span></td></tr>`).join('');
};
 $('collateralForm')?.addEventListener('submit', e => { e.preventDefault(); toast('Dhamana imehifadhiwa'); closeModal('collateralModal'); });

// 2. Penalties & Fees
window.loadPenalties = () => {
    $('penaltyRateView').innerText = '5%'; $('gracePeriodView').innerText = '7';
    const data = [{date:'2024-05-20', loan:'l2', member:'Amina Salim', amount:5000}];
    $('penaltiesBody').innerHTML = data.map(d => `<tr><td>${d.date}</td><td>${d.loan}</td><td>${d.member}</td><td>${money(d.amount)}</td></tr>`).join('');
};
 $('penaltyForm')?.addEventListener('submit', e => { e.preventDefault(); toast('Penalty imewekwa'); closeModal('penaltyModal'); });

// 3. Loan Rescheduling
window.loadReschedule = () => {
    const overdueLoans = state.loans.filter(l => l.status === 'OVERDUE');
    $('rescheduleBody').innerHTML = overdueLoans.map(l => {
        const m = state.members.find(x => x.id === l.memberId);
        return `<tr><td>${l.id}</td><td>${m?.name||'-'}</td><td>${money(l.balance)}</td><td>${l.term} Months @ ${l.interest}%</td><td><button class="btn warning" onclick="openReschedule('${l.id}', ${l.interest})">Reschedule</button></td></tr>`;
    }).join('');
};
window.openReschedule = (loanId, currInterest) => {
    $('resLoanId').value = loanId; $('resInterest').value = currInterest;
    openModal('rescheduleModal');
};
 $('rescheduleForm')?.addEventListener('submit', e => { e.preventDefault(); toast('Mkopo umereschedulewa'); closeModal('rescheduleModal'); });

// 4. KYC / Uthibitishaji
window.loadKYC = () => {
    $('kycBody').innerHTML = state.members.map(m => `<tr><td>${m.name}</td><td>NIDA</td><td>-${m.id.slice(0,4)}</td><td><span class="badge ${m.kyc==='VERIFIED'?'ok':'warn'}">${m.kyc}</span></td><td><button class="btn outline" onclick="openKYCModal('${m.id}')">Verify</button></td></tr>`).join('');
};
window.openKYCModal = (memberId) => { $('kycMember').value = memberId; openModal('kycModal'); };
 $('kycForm')?.addEventListener('submit', e => { e.preventDefault(); toast('KYC Status Updated'); closeModal('kycModal'); });

// Transaction Reversal Mock
window.reverseTransaction = (txId) => {
    if(confirm('Una uhakika unataka kubadilisha muamala huu?')) toast(`Muamala ${txId} umebadilishwa (Reversed)`);
};

// Receipt Print Mock
window.printReceipt = () => window.print();

// Global Search Mock
window.handleSearch = (e) => {
    if(e.key === 'Enter') toast(`Inatafuta: ${e.target.value}`);
};

// Form Submissions Mocks
 $('memberForm')?.addEventListener('submit', e => { e.preventDefault(); state.members.push({id:'m'+Date.now(), name:$('mName').value, phone:$('mPhone').value, shares:Number($('mShares').value), savings:Number($('mSavings').value), loanBalance:0, status:'ACTIVE', kyc:'PENDING'}); toast('Mwanachama ameongezwa'); closeModal('memberModal'); loadMembers(); });
 $('loanForm')?.addEventListener('submit', e => { e.preventDefault(); toast('Ombi la mkopo limewasilishwa'); closeModal('loanModal'); });
 $('txForm')?.addEventListener('submit', e => { e.preventDefault(); toast('Muamala umekamilika'); closeModal('transactionModal'); });

// Init Boot
function bootApp() {
    $('landing').classList.add('hidden'); $('auth').classList.add('hidden'); $('app').classList.remove('hidden');
    $('sideGroup').textContent = 'Demo Vikoba'; $('sideRole').textContent = 'CHAIRPERSON'; $('topUser').textContent = 'Admin • CHAIR';
    nav(); loadMembers(); showSection('dashboard');
    document.querySelectorAll('.chair-only').forEach(x => x.style.display = '');
}

// Auto-boot for demonstration purposes
setTimeout(bootApp, 500);

</script>
