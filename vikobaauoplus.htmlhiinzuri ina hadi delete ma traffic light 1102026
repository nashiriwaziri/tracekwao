          <div><b style="color:#ef4444">NYEKUNDU - Mdaiwa Sugu wa Sasa</b><p class="small" style="margin-top:4px">Ana deni lililochelewa kwa muda mrefu (${thresholds.chronicDays}+ siku). ${thresholds.loanBlockEnabled?'MKOPO UMESITISHWA mpaka Kikao kitoa idhini.':'Mkopo haujasitishwa (imezimwa).'}</p></div>
        </div>
      </div>
    </div>
  `;
}

window.saveThresholds=async()=>{
  const newThresholds={
    lateDays:parseInt($('thLateDays').value)||7,
    chronicDays:parseInt($('thChronicDays').value)||60,
    chronicAmount:parseInt($('thChronicAmount').value)||0,
    yellowMaxLate:parseInt($('thYellowMax').value)||2,
    recoveryMonths:parseInt($('thRecovery').value)||6,
    loanBlockEnabled:$('thLoanBlock').classList.contains('active')
  };
  try{
    await updateDoc(doc(db,'groups',CGI),{thresholds:newThresholds});
    thresholds=newThresholds;
    showToast('Vigezo vimehifadhiwa','success');
    audit('THRESHOLDS_UPDATE','System',JSON.stringify(newThresholds));
    renderSec('thresholds');
  }catch(e){showToast('Imeshindwa: '+e.message,'error');}
};

/* ===== GENERIC SECTION RENDERER ===== */
function renderFinSection(colName,title,items,fields,headers,canAdd){
  return `
    <div class="section-head"><h2>${title}</h2><div class="actions">${canAdd?`<button class="btn primary btn-sm" onclick="openFinForm('${colName}')"><i class="fa-solid fa-plus"></i> Ongeza</button>`:''}</div></div>
    <div class="table-wrap"><table class="table"><thead><tr>${headers.map(h=>`<th>${h}</th>`).join('')}<th>Vitendo</th></tr></thead>
    <tbody>${items.map(item=>`<tr>${fields.map(f=>{const v=item[f];if(f==='amount')return`<td style="color:var(--p2)">${fmt(v)}</td>`;if(f==='status'||f==='type')return`<td>${sb(v)}</td>`;return`<td>${v||'N/A'}</td>`;}).join('')}<td><div class="actions">${canAdd?`<button class="btn ghost btn-sm" onclick="delFinItem('${colName}','${item.id}')"><i class="fa-solid fa-trash" style="color:var(--red)"></i></button>`:''}</div></td></tr>`).join('')}</tbody></table></div>
  `;
}

/* ===== PENDING & AUDIT ===== */
function renderPending(){
  const pending=LC.filter(l=>l.status==='PENDING');
  return`<div class="section-head"><h2>Maombi Yanayosubiri</h2></div>${pending.length?pending.map(l=>`<div class="card" style="margin-bottom:10px;border-left:4px solid var(--yellow)"><div class="flex-between"><b>${l.memberName||'N/A'}</b>${sb('PENDING')}</div><div class="small" style="margin-top:6px">Kiasi: ${fmt(l.amount)} | Muda: ${l.term||12} miezi | Riba: ${l.interestRate||10}%</div>${l.loanOverride?`<div class="small" style="margin-top:4px;color:var(--orange)"><i class="fa-solid fa-gavel"></i> Idhini ya Kikao: ${l.loanOverride.comment||''}</div>`:''}<div class="actions" style="margin-top:8px"><button class="btn primary btn-sm" onclick="updateLoanStatus('${l.id}','APPROVED')"><i class="fa-solid fa-check"></i> Kubali</button><button class="btn danger btn-sm" onclick="updateLoanStatus('${l.id}','REJECTED')"><i class="fa-solid fa-xmark"></i> Kataa</button></div></div>`).join(''):'<div class="card" style="text-align:center;padding:40px"><p class="small">Hakuna maombi yanayosubiri</p></div>'}`;
}

function renderAudit(){
  return`<div class="section-head"><h2>Historia ya Ukaguzi</h2></div><div class="table-wrap" style="max-height:500px"><table class="table"><thead><tr><th>Kitendo</th><th>Kipengele</th><th>Maelezo</th><th>Mtumiaji</th><th>Tarehe</th></tr></thead><tbody>${AUC.slice().reverse().map(a=>`<tr><td>${a.action||'N/A'}</td><td>${a.entity||'N/A'}</td><td class="small">${a.details||''}</td><td>${a.user||'System'}</td><td>${fDT(a.date)}</td></tr>`).join('')}</tbody></table></div>`;
}

/* ===== CRUD ===== */
window.updateLoanStatus=async(id,status)=>{try{const l=LC.find(x=>x.id===id);const upd={status};if(status==='DISBURSED')upd.disbursementDate=serverTimestamp();await updateDoc(dcol('loans',id),upd);showToast(`Mkopo ${status==='APPROVED'?'umekubaliwa':status==='REJECTED'?'umekataliwa':'umetolewa'}`,'success');audit('LOAN_'+status,'Loans',id);}catch(e){showToast(e.message,'error');}};

window.openFinForm=(colName)=>{
  $('formModalTitle').textContent='Ongeza';
  $('formModalBody').innerHTML=`<form id="finForm"><div class="field"><label>Mwanachama</label><select id="finMember" required>${MC.map(m=>`<option>${m.firstName} ${m.lastName}</option>`).join('')}</select></div>${colName==='savings'||colName==='welfare'?`<div class="field"><label>Aina</label><select id="finType"><option>DEPOSIT</option><option>WITHDRAWAL</option></select></div>`:''}${colName==='cashbook'?`<div class="field"><label>Aina</label><select id="finType"><option>INCOME</option><option>EXPENSE</option></select></div><div class="field"><label>Kategoria</label><input id="finCategory" required></div>`:''}<div class="field"><label>Kiasi</label><input id="finAmount" type="number" required></div><div class="field"><label>Tarehe</label><input id="finDate" type="date" value="${today()}" required></div><button class="btn primary" type="submit"><i class="fa-solid fa-check"></i> Hifadhi</button></form>`;
  openModal('formModal');
  $('finForm').addEventListener('submit',async e=>{e.preventDefault();const data={memberName:$('finMember').value,amount:parseFloat($('finAmount').value),date:$('finDate').value};if($('finType'))data.type=$('finType').value;if($('finCategory'))data.category=$('finCategory').value;try{await addDoc(col(colName),data);showToast('Imehifadhiwa','success');closeModal('formModal');audit('ADD',colName);}catch(e){showToast(e.message,'error');}});
};

window.openMemberForm=()=>{
  $('formModalTitle').textContent='Ongeza Mwanachama';
  $('formModalBody').innerHTML=`<form id="memberForm"><div class="su-row3"><div class="field"><label>Jina la Kwanza</label><input id="mfFname" required></div><div class="field"><label>Jina la Kati</label><input id="mfMname"></div><div class="field"><label>Jina la Mwisho</label><input id="mfLname" required></div></div><div class="su-row"><div class="field"><label>NIDA</label><input id="mfNida" required></div><div class="field"><label>Simu</label><input id="mfPhone" type="tel"></div></div><button class="btn primary" type="submit"><i class="fa-solid fa-user-plus"></i> Ongeza</button></form>`;
  openModal('formModal');
  $('memberForm').addEventListener('submit',async e=>{e.preventDefault();const data={firstName:$('mfFname').value.trim(),middleName:$('mfMname').value.trim(),lastName:$('mfLname').value.trim(),nida:$('mfNida').value.trim(),phone:$('mfPhone').value.trim(),role:'member',groupId:CGI,createdAt:serverTimestamp()};try{await addDoc(col('members'),data);showToast('Mwanachama ameongezwa','success');closeModal('formModal');audit('MEMBER_ADD','Members',data.firstName);}catch(e){showToast(e.message,'error');}});
};

window.editMember=(id)=>{const m=MC.find(x=>x.id===id);if(!m)return;$('formModalTitle').textContent='Hariri Mwanachama';$('formModalBody').innerHTML=`<form id="editMemForm"><div class="su-row3"><div class="field"><label>Jina la Kwanza</label><input id="emFname" value="${m.firstName||''}" required></div><div class="field"><label>Jina la Kati</label><input id="emMname" value="${m.middleName||''}"></div><div class="field"><label>Jina la Mwisho</label><input id="emLname" value="${m.lastName||''}" required></div></div><div class="su-row"><div class="field"><label>NIDA</label><input id="emNida" value="${m.nida||''}" required></div><div class="field"><label>Simu</label><input id="emPhone" value="${m.phone||''}" type="tel"></div></div><button class="btn primary" type="submit"><i class="fa-solid fa-check"></i> Sasisha</button></form>`;openModal('formModal');$('editMemForm').addEventListener('submit',async e=>{e.preventDefault();const data={firstName:$('emFname').value.trim(),middleName:$('emMname').value.trim(),lastName:$('emLname').value.trim(),nida:$('emNida').value.trim(),phone:$('emPhone').value.trim()};try{await updateDoc(dcol('members',id),data);showToast('Imesasishwa','success');closeModal('formModal');}catch(e){showToast(e.message,'error');}});};

window.delMember=(id)=>{showConfirm('Futa Mwanachama','Mwanachama atafutwa kabisa.',async()=>{try{await deleteDoc(dcol('members',id));showToast('Amefutwa','success');}catch(e){showToast(e.message,'error');}});};
window.delFinItem=(cn,id)=>{showConfirm('Futa','Rekodi itafutwa?',async()=>{try{await deleteDoc(dcol(cn,id));showToast('Imefutwa','success');}catch(e){showToast(e.message,'error');}});};

/* =================================================================
   SUPER ADMIN
   ================================================================= */
const saNavSections=[{section:'Overview'},{id:'sa-dashboard',icon:'fa-gauge-high',label:'Dashboard'},{section:'Management'},{id:'sa-groups',icon:'fa-building',label:'All Groups'},{id:'sa-users',icon:'fa-users',label:'All Users'},{section:'System'},{id:'sa-settings',icon:'fa-gear',label:'Settings'}];

async function initSA(){renderSANav();saNavigate('sa-dashboard');await loadSAData();}
function renderSANav(){const nav=$('superNav');nav.innerHTML=saNavSections.map(i=>i.section?`<div class="snav-section">${i.section}</div>`:`<button class="snav-btn ${i.id===sTab?'active':''}" data-stab="${i.id}" onclick="saNavigate('${i.id}')"><i class="fa-solid ${i.icon}"></i> ${i.label}</button>`).join('');}
window.saNavigate=id=>{sTab=id;document.querySelectorAll('.snav-btn').forEach(b=>b.classList.toggle('active',b.dataset.stab===id));renderSAContent();};

async function loadSAData(){try{const gSnap=await getDocs(collection(db,'groups'));SGroups=gSnap.docs.map(d=>({id:d.id,...d.data()}));const uSnap=await getDocs(collection(db,'users'));SUsers=uSnap.docs.map(d=>({id:d.id,...d.data()}));SUserCounts={};SUsers.forEach(u=>{if(u.groupId)SUserCounts[u.groupId]=(SUserCounts[u.groupId]||0)+1;});renderSAContent();}catch(e){showToast('Load failed','error');}}

function renderSAContent(){const el=$('superContent');if(!el)return;switch(sTab){case 'sa-dashboard':el.innerHTML=renderSADashboard();break;case 'sa-groups':el.innerHTML=renderSAGroups();break;case 'sa-users':el.innerHTML=renderSAUsers();break;case 'sa-settings':el.innerHTML=renderSASettings();break;default:el.innerHTML='<p>Unknown</p>';}}

function renderSADashboard(){const tg=SGroups.length,ta=SGroups.filter(g=>g.status==='active'||g.status==='trial').length,tu=SUsers.length,mr=SGroups.reduce((s,g)=>s+(PLAN_PRICES[g.plan||'free']||0),0);return`<div class="section-head"><h2>System Dashboard</h2><button class="btn danger btn-sm" onclick="loadSAData()"><i class="fa-solid fa-arrows-rotate"></i></button></div><div class="sa-metrics"><div class="sa-metric"><div class="sa-metric-icon" style="background:rgba(239,68,68,.12);color:var(--red)"><i class="fa-solid fa-building"></i></div><div><h3>${fmt(tg)}</h3><p>Total Groups</p></div></div><div class="sa-metric"><div class="sa-metric-icon" style="background:rgba(59,130,246,.12);color:var(--blue)"><i class="fa-solid fa-users"></i></div><div><h3>${fmt(tu)}</h3><p>Total Users</p></div></div><div class="sa-metric"><div class="sa-metric-icon" style="background:rgba(22,169,121,.12);color:var(--p2)"><i class="fa-solid fa-dollar-sign"></i></div><div><h3>$${fmt(mr)}</h3><p>Monthly Revenue</p></div></div><div class="sa-metric"><div class="sa-metric-icon" style="background:rgba(245,158,11,.12);color:var(--yellow)"><i class="fa-solid fa-check-circle"></i></div><div><h3>${fmt(ta)}</h3><p>Active Groups</p></div></div></div><div class="card"><div class="section-head"><h3>Groups</h3></div><div class="table-wrap" style="max-height:400px"><table class="table"><thead><tr><th>Name</th><th>Plan</th><th>Status</th><th>Users</th><th>Actions</th></tr></thead><tbody>${SGroups.map(g=>`<tr><td><b>${g.name||'N/A'}</b><br><span class="tiny">${g.id}</span></td><td>${sb(g.plan||'free')}</td><td>${sb(g.status||'trial')}</td><td><b style="color:var(--p2)">${SUserCounts[g.id]||0}</b></td><td><button class="btn outline btn-sm" onclick="saEditGroup('${g.id}')"><i class="fa-solid fa-pen"></i></button> <button class="btn danger btn-sm" onclick="saDeleteGroup('${g.id}')"><i class="fa-solid fa-trash"></i></button></td></tr>`).join('')}</tbody></table></div></div>`;}

function renderSAGroups(){return`<div class="section-head"><h2>All Groups (${fmt(SGroups.length)})</h2></div><div class="auto-grid">${SGroups.map(g=>{const uc=SUserCounts[g.id]||0;const pl=PLAN_LIMITS[g.plan||'free']||15;const pct=Math.min(100,Math.round((uc/pl)*100));return`<div class="card"><div class="flex-between" style="margin-bottom:10px"><div><h4 style="margin:0;font-size:14px">${g.name||'N/A'}</h4><span class="tiny">${g.id}</span></div><div class="flex gap-xs">${sb(g.plan||'free')}${sb(g.status||'trial')}</div></div><div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:10px"><div style="text-align:center;padding:8px;background:var(--panel2);border-radius:6px"><div style="font-size:18px;font-weight:800;color:var(--p2)">${uc}</div><div style="font-size:9px;color:var(--muted)">USERS</div></div><div style="text-align:center;padding:8px;background:var(--panel2);border-radius:6px"><div style="font-size:18px;font-weight:800">${pl>=999999?'∞':pl}</div><div style="font-size:9px;color:var(--muted)">LIMIT</div></div><div style="text-align:center;padding:8px;background:var(--panel2);border-radius:6px"><div style="font-size:18px;font-weight:800;color:${pct>80?'var(--red)':'var(--p2)'}">${pct}%</div><div style="font-size:9px;color:var(--muted)">USAGE</div></div></div><div class="actions"><button class="btn outline btn-sm" onclick="saEditGroup('${g.id}')"><i class="fa-solid fa-pen"></i> Edit</button><button class="btn danger btn-sm" onclick="saDeleteGroup('${g.id}')"><i class="fa-solid fa-trash"></i> Delete</button></div></div>`;}).join('')}</div>`;}

function renderSAUsers(){return`<div class="section-head"><h2>All Users (${fmt(SUsers.length)})</h2></div><div class="table-wrap" style="max-height:calc(100vh - 200px)"><table class="table"><thead><tr><th>Name</th><th>NIDA</th><th>Role</th><th>Group</th><th>Users in Group</th><th>Actions</th></tr></thead><tbody>${SUsers.map(u=>{const g=SGroups.find(x=>x.id===u.groupId);return`<tr><td>${u.firstName||''} ${u.lastName||''}</td><td>${u.nida||'N/A'}</td><td>${u.role==='chair'?'<span class="badge ok">CHAIR</span>':'<span class="badge info-b">MEMBER</span>'}</td><td>${g?g.name:'Orphaned'}<br><span class="tiny">${u.groupId||''}</span></td><td><b style="color:var(--p2)">${SUserCounts[u.groupId]||0}</b></td><td><button class="btn outline btn-sm" onclick="saEditUser('${u.id}')"><i class="fa-solid fa-pen"></i></button> <button class="btn danger btn-sm" onclick="saDeleteUser('${u.id}')"><i class="fa-solid fa-trash"></i></button></td></tr>`;}).join('')}</tbody></table></div>`;}

function renderSASettings(){return`<div class="section-head"><h2>System Settings</h2></div><div class="card"><h3 style="margin-bottom:14px">Branding</h3><div class="field"><label>Logo URL</label><input id="saLogoUrl" value="${sysSet.branding.logoUrl||''}"></div><div class="flex gap-sm" style="align-items:center;margin:12px 0"><span class="small">Logo Enabled</span><div class="toggle-switch ${sysSet.branding.logoEnabled?'active':''}" id="saLogoToggle" onclick="this.classList.toggle('active')"></div></div><button class="btn primary btn-sm" onclick="saveSASettings()"><i class="fa-solid fa-check"></i> Save</button></div>`;}

window.saEditGroup=async(gid)=>{const g=SGroups.find(x=>x.id===gid);if(!g)return;$('saEditTitle').innerHTML='<i class="fa-solid fa-pen-to-square" style="color:var(--red)"></i> Edit Group';$('saEditBody').innerHTML=`<form id="saEditGForm"><input type="hidden" value="${g.id}"><div class="row2"><div class="field"><label>Name</label><input id="segName" value="${g.name||''}" required></div><div class="field"><label>Type</label><select id="segType">${['rosca','asca','vsla','sacco','welfare','investment'].map(t=>`<option value="${t}" ${g.type===t?'selected':''}>${t}</option>`).join('')}</select></div><div class="field"><label>Country</label><input id="segCountry" value="${g.country||''}"></div><div class="field"><label>Currency</label><input id="segCur" value="${g.currency||'TZS'}"></div><div class="field"><label>Plan</label><select id="segPlan">${['free','basic','pro','enterprise'].map(p=>`<option value="${p}" ${g.plan===p?'selected':''}>${p}</option>`).join('')}</select></div><div class="field"><label>Status</label><select id="segStatus">${['active','trial','suspended','expired'].map(s=>`<option value="${s}" ${g.status===s?'selected':''}>${s}</option>`).join('')}</select></div></div><div style="margin:10px 0;padding:10px;background:var(--panel2);border-radius:8px"><span class="small"><i class="fa-solid fa-users"></i> <b style="color:var(--p2);font-size:16px">${SUserCounts[g.id]||0}</b> users in this group</span></div><button class="btn primary" type="submit"><i class="fa-solid fa-check"></i> Save</button></form>`;openModal('saEditModal');$('saEditGForm').addEventListener('submit',async e=>{e.preventDefault();try{await updateDoc(doc(db,'groups',g.id),{name:$('segName').value.trim(),type:$('segType').value,country:$('segCountry').value.trim(),currency:$('segCur').value.trim(),plan:$('segPlan').value,status:$('segStatus').value});showToast('Updated','success');closeModal('saEditModal');await loadSAData();}catch(e){showToast(e.message,'error');}});};

window.saEditUser=async(uid)=>{const u=SUsers.find(x=>x.id===uid);if(!u)return;$('saEditTitle').innerHTML='<i class="fa-solid fa-user-pen" style="color:var(--red)"></i> Edit User';$('saEditBody').innerHTML=`<form id="saEditUForm"><div class="row2"><div class="field"><label>First Name</label><input id="seuFn" value="${u.firstName||''}" required></div><div class="field"><label>Last Name</label><input id="seuLn" value="${u.lastName||''}" required></div><div class="field"><label>Role</label><select id="seuRole"><option value="chair" ${u.role==='chair'?'selected':''}>Chair</option><option value="member" ${u.role==='member'?'selected':''}>Member</option></select></div><div class="field"><label>Group ID</label><input id="seuGid" value="${u.groupId||''}" required></div></div><button class="btn primary" type="submit"><i class="fa-solid fa-check"></i> Save</button></form>`;openModal('saEditModal');$('saEditUForm').addEventListener('submit',async e=>{e.preventDefault();try{await updateDoc(doc(db,'users',u.id),{firstName:$('seuFn').value.trim(),lastName:$('seuLn').value.trim(),role:$('seuRole').value,groupId:$('seuGid').value.trim()});showToast('Updated','success');closeModal('saEditModal');await loadSAData();}catch(e){showToast(e.message,'error');}});};

window.saDeleteGroup=(gid)=>{const g=SGroups.find(x=>x.id===gid);if(!g)return;$('saDeleteTitle').textContent=`Delete: ${g.name||gid}`;$('saDeleteMsg').innerHTML=`<b>${SUserCounts[gid]||0}</b> user(s) will be orphaned. Type <code style="color:var(--red)">${gid}</code> to confirm.`;$('saDeleteConfirm').value='';$('saDeleteBtn').disabled=true;$('saDeleteConfirm').oninput=()=>{$('saDeleteBtn').disabled=$('saDeleteConfirm').value.trim()!==gid;};$('saDeleteBtn').onclick=async()=>{$('saDeleteBtn').disabled=true;try{const batch=writeBatch(db);batch.delete(doc(db,'groups',gid));SUsers.filter(u=>u.groupId===gid).forEach(u=>batch.delete(doc(db,'users',u.id)));await batch.commit();showToast('Deleted','success');closeModal('saDeleteModal');await loadSAData();}catch(e){showToast(e.message,'error');}};openModal('saDeleteModal');};

window.saDeleteUser=(uid)=>{const u=SUsers.find(x=>x.id===uid);if(!u)return;showConfirm('Delete User',`Delete ${u.firstName} ${u.lastName}?`,async()=>{try{await deleteDoc(doc(db,'users',uid));showToast('Deleted','success');await loadSAData();}catch(e){showToast(e.message,'error');}});};

window.saveSASettings=async()=>{try{const logoEnabled=$('saLogoToggle').classList.contains('active');const logoUrl=$('saLogoUrl').value.trim();await setDoc(doc(db,'systemSettings','branding'),{logoUrl,logoEnabled},{merge:true});sysSet.branding={logoUrl,logoEnabled};paintAllLogos();showToast('Saved','success');}catch(e){showToast(e.message,'error');}};

/* ===== INIT ===== */
paintAllLogos();
</script>
</body>
</html>
