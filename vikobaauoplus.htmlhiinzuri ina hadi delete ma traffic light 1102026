  const name=m.firstName+' '+m.lastName;
  const cur=CG?.currency||'TZS';

  $('mpTitle').innerHTML=`<i class="fa-solid fa-user-circle"></i> ${name}`;
  $('mpBody').innerHTML=`
    <!-- Basic Info -->
    <div class="row2" style="margin-bottom:18px">
      <div class="card">
        <h3 style="margin-bottom:12px"><i class="fa-solid fa-id-card" style="color:var(--blue)"></i> Taarifa za Kimsingi</h3>
        <div style="display:flex;flex-direction:column;gap:6px;font-size:12px">
          <div class="flex-between"><span class="small">Jina Kamili</span><span>${m.firstName||''} ${m.middleName||''} ${m.lastName||''}</span></div>
          <div class="flex-between"><span class="small">NIDA</span><span>${m.nida||'N/A'}</span></div>
          <div class="flex-between"><span class="small">Simu</span><span>${m.phone||'N/A'}</span></div>
          <div class="flex-between"><span class="small">Daraja</span><span>${m.role==='chair'?'Mwenyekiti':'Mwanachama'}</span></div>
          <div class="flex-between"><span class="small">Akiba</span><span style="color:var(--p2)">${cur} ${fmt(memberSavings(name))}</span></div>
          <div class="flex-between"><span class="small">Hisa</span><span style="color:var(--purple)">${cur} ${fmt(memberShares(name))}</span></div>
        </div>
      </div>
      <div class="card">
        <h3 style="margin-bottom:12px"><i class="fa-solid fa-chart-line" style="color:var(--p2)"></i> Muhtasari wa Mikopo</h3>
        <div style="display:flex;flex-direction:column;gap:6px;font-size:12px">
          ${LC.filter(l=>l.memberName===name).map(l=>`<div class="flex-between" style="padding:6px 0;border-bottom:1px solid var(--line)"><span>Mkopo wa ${fmt(l.amount)}</span>${sb(l.status)}<span style="color:var(--p2)">Salio: ${fmt(loanBalance(l))}</span></div>`).join('')||'<p class="small">Hakuna mikopo</p>'}
        </div>
      </div>
    </div>

    <!-- PAYMENT BEHAVIOUR - Traffic Light -->
    <div style="margin-bottom:18px">
      <h3 style="margin-bottom:12px"><i class="fa-solid fa-traffic-light" style="color:var(--yellow)"></i> Tabia ya Malipo</h3>
      ${renderPaymentBehaviourCard(name)}
    </div>

    <!-- PAYMENT HISTORY TABLE -->
    <div class="card">
      <div class="section-head"><h3><i class="fa-solid fa-clock-rotate-left"></i> Historia ya Malipo</h3></div>
      <div class="table-wrap" style="max-height:300px">
        <table class="table">
          <thead><tr><th>Hali</th><th>Tarehe</th><th>Mkopo ID</th><th>Kiasi</th><th>Aina</th></tr></thead>
          <tbody>
            ${RC.filter(r=>r.memberName===name).sort((a,b)=>{
              const da=a.date instanceof Timestamp?a.date.toMillis():new Date(a.date||0).getTime();
              const db=b.date instanceof Timestamp?b.date.toMillis():new Date(b.date||0).getTime();
              return db-da;
            }).map(r=>{
              /* Determine if this repayment was on time */
              const loan=LC.find(l=>l.id===r.loanId);
              let wasOnTime=true;
              if(loan){
                const rd=r.date instanceof Timestamp?r.date.toDate():new Date(r.date);
                let disbursementDate=loan.date instanceof Timestamp?loan.date.toDate():new Date(loan.date||loan.createdAt||0);
                if(!(disbursementDate instanceof Date&&!isNaN(disbursementDate)))disbursementDate=new Date();
                const monthsSinceDisbursement=Math.max(0,daysBetween(disbursementDate,rd)/30);
                const expectedMonths=Math.ceil(monthsSinceDisbursement);
                const expectedEnd=new Date(disbursementDate);
                expectedEnd.setMonth(expectedEnd.getMonth()+expectedMonths);
                wasOnTime=rd<=expectedEnd;
              }
              const dotClass=wasOnTime?'green':'yellow';
              return`<tr><td>${tlDot(dotClass)}</td><td>${fD(r.date)}</td><td class="tiny">${r.loanId||'N/A'}</td><td style="color:var(--p2)">${fmt(r.amount)}</td><td>${wasOnTime?'<span class="badge ok">WAKATI</span>':'<span class="badge warn">CHELEWA</span>'}</td></tr>`;
            }).join('')||'<tr><td colspan="5" style="text-align:center;color:var(--muted);padding:20px">Hakuna historia ya malipo</td></tr>'}
          </tbody>
        </table>
      </div>
    </div>
  `;
  openModal('memberProfileModal');
};

