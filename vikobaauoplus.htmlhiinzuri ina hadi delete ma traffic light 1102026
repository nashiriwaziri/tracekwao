window.openLoanForm=()=>{
  $('formModalTitle').textContent='Omba Mkopo';
  $('formModalBody').innerHTML=`
    <form id="loanForm">
      <div class="field"><label>Mwanachama *</label><select id="lfMember" required onchange="checkLoanBlock(this.value)">${MC.map(m=>`<option value="${m.firstName+' '+m.lastName}">${m.firstName} ${m.middleName||''} ${m.lastName}</option>`).join('')}</select></div>
      <div id="loanBlockWarning"></div>
      <div class="su-row">
        <div class="field"><label>Kiasi *</label><input id="lfAmount" type="number" required></div>
        <div class="field"><label>Muda (Miezi) *</label><input id="lfTerm" type="number" value="12" required></div>
      </div>
      <div class="su-row">
        <div class="field"><label>Riba (%) *</label><input id="lfRate" type="number" step="0.1" value="${CG?.interestRate||10}" required></div>
        <div class="field"><label>Tarehe *</label><input id="lfDate" type="date" value="${today()}" required></div>
      </div>
      <button class="btn primary" type="submit" id="lfSubmitBtn"><i class="fa-solid fa-check"></i> Wasilisha Ombi</button>
    </form>
  `;
  openModal('formModal');

  /* Check block on first load */
  const firstMember=$('lfMember').value;
  if(firstMember)checkLoanBlock(firstMember);

  $('loanForm').addEventListener('submit',async e=>{
    e.preventDefault();
    const memberName=$('lfMember').value;

    /* BLOCK CHECK */
    if(isLoanBlocked(memberName)){
      showToast('Mkopo umesitishwa! Mwanachama ni mdaiwa sugu. Kikao cha Kikundi kinahitaji kutoa idhini.','error');
      /* Open override modal instead */
      closeModal('formModal');
      openLoanOverride(memberName);
      return;
    }

    const data={memberName,amount:parseFloat($('lfAmount').value),term:parseInt($('lfTerm').value),interestRate:parseFloat($('lfRate').value),date:$('lfDate').value,status:'PENDING',createdAt:serverTimestamp()};
    try{await addDoc(col('loans'),data);showToast('Ombi la mkopo limewasilishwa','success');closeModal('formModal');audit('LOAN_APPLY','Loans',`${memberName} - ${fmt(data.amount)}`);}catch(e){showToast(e.message,'error');}
  });
};

/* Check if member is blocked and show warning */
window.checkLoanBlock=(memberName)=>{
  const el=$('loanBlockWarning');if(!el)return;
  if(isLoanBlocked(memberName)){
    const pb=calcPaymentBehaviour(memberName);
    el.innerHTML=`
      <div class="loan-blocked" style="margin-bottom:12px">
        <div class="loan-blocked-icon"><i class="fa-solid fa-ban"></i></div>
        <h3 style="color:var(--red);margin-bottom:6px">MKOPO UMESITISHWA</h3>
        <p class="small" style="color:#ff7b85">Mwanachama huyu ni <b>Mdaiwa Sugu</b>. Deni lililochelewa: <b>${fmt(pb.currentOverdue)}</b> | Siku: <b>${pb.maxDaysOverdue}</b></p>
        <p class="tiny" style="margin-top:8px">Kikao cha Kikundi kinaweza kutoa idhini maalum kwa kutoa comment.</p>
      </div>
    `;
    const btn=$('lfSubmitBtn');if(btn){btn.disabled=true;btn.textContent='MKOPO UMESITISHWA';}
  }else{
    const pb=calcPaymentBehaviour(memberName);
    if(pb.status==='orange'){
      el.innerHTML=`<div style="padding:10px;background:rgba(249,115,22,.08);border:1px solid rgba(249,115,22,.2);border-radius:8px;margin-bottom:12px"><span class="badge orange-b">TAHADHARI</span> <span class="small">Aliwahi kuwa mdaiwa sugu - anaweza kupata mkopo kwa masharti</span></div>`;
    }else if(pb.status==='yellow'){
      el.innerHTML=`<div style="padding:10px;background:rgba(234,179,8,.08);border:1px solid rgba(234,179,8,.2);border-radius:8px;margin-bottom:12px"><span class="badge warn">TAHADHARI</span> <span class="small">Mcheleweshaji - malipo ${pb.onTimePct}% wakati</span></div>`;
    }else{
      el.innerHTML='';
    }
    const btn=$('lfSubmitBtn');if(btn){btn.disabled=false;btn.innerHTML='<i class="fa-solid fa-check"></i> Wasilisha Ombi';}
  }
};

