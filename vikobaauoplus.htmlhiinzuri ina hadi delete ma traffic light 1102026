          <div class="pb-stat"><h4 style="color:${pb.latePayments>0?'var(--red)':'var(--p2)'}">${pb.latePayments}</h4><p>Late Payments</p></div>
          <div class="pb-stat"><h4 style="color:${pb.currentOverdue>0?'var(--red)':'var(--p2)'}">${cur} ${fmt(pb.currentOverdue)}</h4><p>Current Overdue</p></div>
          <div class="pb-stat"><h4 style="color:${pb.maxDaysOverdue>0?'var(--red)':'var(--p2)'}">${pb.maxDaysOverdue}</h4><p>Max Days Overdue</p></div>
          <div class="pb-stat"><h4>${pb.activeLoans}</h4><p>Active Loans</p></div>
        </div>
        ${pb.status==='red'?`<div style="margin-top:12px;padding:10px;background:rgba(239,68,68,.1);border-radius:8px;border:1px solid rgba(239,68,68,.2)"><div class="small" style="color:#ff7b85"><i class="fa-solid fa-triangle-exclamation"></i> <b>Mkopo umesitishwa:</b> Mdaiwa sugu hawezi kupata mkopo mpya mpaka Kikao cha Kikundi kitoe idhini maalum.</div></div>`:''}
        ${pb.status==='orange'?`<div style="margin-top:12px;padding:10px;background:rgba(249,115,22,.1);border-radius:8px;border:1px solid rgba(249,115,22,.2)"><div class="small" style="color:#ffb060"><i class="fa-solid fa-info-circle"></i> Aliwahi kuwa mdaiwa sugu lakini amelirekebisha. Anaweza kupata mkopo kwa masharti.</div></div>`:''}
        ${pb.wasChronic&&pb.status!=='orange'&&pb.status!=='red'?`<div style="margin-top:10px"><span class="badge orange-b">PAST CHRONIC DEBTOR</span> <span class="tiny">- Recovered</span></div>`:''}
      </div>
    </div>
  `;
}

/* Check if member is blocked from loans */
function isLoanBlocked(memberName){
  if(!thresholds.loanBlockEnabled)return false;
  const pb=calcPaymentBehaviour(memberName);
  return pb.status==='red';
}

