<script type="module">
import{initializeApp}from"https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
import{getAuth,createUserWithEmailAndPassword,signInWithEmailAndPassword,signOut}from"https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";
import{getFirestore,enableMultiTabIndexedDbPersistence,collection,doc,setDoc,addDoc,getDoc,getDocs,updateDoc,deleteDoc,onSnapshot,query,orderBy,limit,serverTimestamp,Timestamp,writeBatch}from"https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";
import{getStorage,ref,uploadBytesResumable,getDownloadURL}from"https://www.gstatic.com/firebasejs/10.12.0/firebase-storage.js";

const firebaseConfig={apiKey:"AIzaSyDSUs6uUjQTPQOkUPcIp2u8Rw9NJVnQOfo",authDomain:"ncrs2-f8da9.firebaseapp.com",projectId:"ncrs2-f8da9",storageBucket:"ncrs2-f8da9.firebasestorage.app",messagingSenderId:"436069918682",appId:"1:436069918682:web:70b56c627315bc782102e3"};
const fbApp=initializeApp(firebaseConfig);const secApp=initializeApp(firebaseConfig,"Secondary");
const auth=getAuth(fbApp);const db=getFirestore(fbApp);const storage=getStorage(fbApp);
try{await enableMultiTabIndexedDbPersistence(db);}catch(e){}

/* ===== CONSTANTS ===== */
const SYS_LOGO_FILE="vikobabrand-icon4.svg - Copy.png";
const SA_UID="P9jl4qlk64gXXkk7tegabJpXwaB2";
const PLAN_PRICES={free:0,basic:29,pro:79,enterprise:199};
const PLAN_LIMITS={free:15,basic:50,pro:500,enterprise:999999};

/* ===== STATE ===== */
let CU=null,CG=null,CR='chair',CGI=null;
let MC=[],SC=[],SHC=[],LC=[],RC=[],WC=[],MTC=[],BRC=[],CC=[],DC=[],PC=[],KYC=[],GC=[],CLC=[],AC=[],LPC=[],AUC=[];
let SGroups=[],SUsers=[],SUserCounts={};
let sTab='sa-dashboard',sSearchTerm='',sFilterPlan='all',sFilterStatus='all';
let aSec='dashboard',charts={},saCharts={};

/* Payment Behaviour Thresholds - Configurable by Chairperson */
let thresholds={
  lateDays:7,           /* Days after which a payment is "late" */
  chronicDays:60,       /* Days overdue to be "chronic defaulter" */
  chronicAmount:0,      /* Min overdue amount to be chronic (0 = any amount) */
  yellowMaxLate:2,      /* Max late payments before YELLOW */
  recoveryMonths:6,     /* Months of good behaviour to recover from ORANGE */
  loanBlockEnabled:true /* Block loans for RED status */
};

let sysSet={branding:{logoUrl:SYS_LOGO_FILE,logoEnabled:true},languages:[{code:'en',name:'English',enabled:true},{code:'sw',name:'Kiswahili',enabled:true}]};
let curLang='en';

/* ===== UTILITIES ===== */
const $=id=>document.getElementById(id);
const uid=()=>`${Date.now().toString(36)}_${Math.random().toString(36).substr(2,5)}`;
const today=()=>new Date().toISOString().split('T')[0];
const fmt=n=>(n||0).toLocaleString();
const daysBetween=(a,b)=>Math.floor((b-a)/86400000);
const fD=d=>{if(!d)return'N/A';if(d instanceof Timestamp)return d.toDate().toLocaleDateString();if(d?.seconds)return new Date(d.seconds*1000).toLocaleDateString();try{return new Date(d).toLocaleDateString();}catch(e){return'N/A';}};
const fDT=d=>{if(!d)return'N/A';if(d instanceof Timestamp)return d.toDate().toLocaleString();if(d?.seconds)return new Date(d.seconds*1000).toLocaleString();try{return new Date(d).toLocaleString();}catch(e){return'N/A';}};

const sb=s=>{const m={active:'ok',trial:'info-b',COMPLETED:'ok',PENDING:'warn',APPROVED:'info-b',REJECTED:'bad',DISBURSED:'ok',PAID:'ok',suspended:'bad',expired:'bad',free:'info-b',basic:'ok',pro:'warn',enterprise:'purple-b'};return`<span class="badge ${m[s]||'warn'}">${s||'N/A'}</span>`;};

/* ===== SCREEN / MODAL / TOAST ===== */
window.showScreen=id=>{['landing','memberRegScreen','auth','app','super'].forEach(s=>{const e=$(s);if(e)e.classList.add('hidden');});const e=$(id);if(e)e.classList.remove('hidden');paintAllLogos();};
window.openModal=id=>{const e=$(id);if(e)e.classList.add('show');};
window.closeModal=id=>{const e=$(id);if(e)e.classList.remove('show');};
window.toggleSidebar=()=>{const s=$('sidebar');if(s)s.classList.toggle('open');};
window.showToast=(msg,type='success')=>{const c=$('toastContainer'),t=document.createElement('div');t.className=`toast ${type}`;const ic={success:'fa-circle-check',error:'fa-circle-exclamation',warning:'fa-triangle-exclamation'};t.innerHTML=`<i class="fa-solid ${ic[type]||ic.success}"></i> ${msg}`;c.appendChild(t);setTimeout(()=>{t.style.opacity='0';setTimeout(()=>t.remove(),300)},4000);};
function showConfirm(ti,msg,fn){const d=document.createElement('div');d.className='confirm-overlay';d.innerHTML=`<div class="confirm-card"><h3>${ti}</h3><p>${msg}</p><div class="flex gap-sm" style="justify-content:center"><button class="btn danger" id="cfY">Confirm</button><button class="btn mutedbtn" id="cfN">Cancel</button></div></div>`;document.body.appendChild(d);d.querySelector('#cfY').onclick=()=>{d.remove();fn()};d.querySelector('#cfN').onclick=()=>d.remove();}

/* ===== LOGO ===== */
function getLogoUrl(){return(sysSet.branding.logoEnabled&&sysSet.branding.logoUrl)?sysSet.branding.logoUrl:SYS_LOGO_FILE;}
function renderLogoImg(url,size){return`<img src="${url||SYS_LOGO_FILE}" alt="Logo" style="width:${size}px;height:${size}px;object-fit:cover;border-radius:inherit">`;}
function paintAllLogos(){const url=getLogoUrl();[{id:'heroLogo',size:72},{id:'signupLogo',size:56},{id:'signinLogo',size:56},{id:'sideLogo',size:40},{id:'topLogo',size:28},{id:'superLogo',size:36}].forEach(t=>{const el=$(t.id);if(el)el.innerHTML=renderLogoImg(url,t.size);});}

/* ===== OFFLINE ===== */
const OM={qk:'cscms_oq',gq(){return JSON.parse(localStorage.getItem(this.qk))||[];},sq(q){localStorage.setItem(this.qk,JSON.stringify(q));},add(a,p){const q=this.gq();q.push({id:Date.now(),action:a,payload:p});this.sq(q);showToast("Saved offline","warning");},async proc(){let q=this.gq();if(!q.length)return;showToast(`Syncing ${q.length}...`,"success");let s=0;for(const i of q){try{switch(i.action){case'SIGNUP':await setDoc(doc(db,'groups',i.payload.gid),i.payload.gd);await setDoc(doc(db,'users',i.payload.uid),i.payload.ud);break;case'ADD':await addDoc(collection(db,...i.payload.p),i.payload.d);break;case'UPD':await updateDoc(doc(db,...i.payload.p),i.payload.d);break;case'DEL':await deleteDoc(doc(db,...i.payload.p));break;}s++;}catch(e){}}if(s){this.sq([]);showToast(`${s} synced!`,"success");}}};
function netUI(on){const b=$('networkBanner');if(on){b.className='online';b.innerHTML='<i class="fa-solid fa-wifi"></i> Back Online';setTimeout(()=>b.style.display='none',3000);OM.proc();}else{b.className='offline';b.innerHTML='<i class="fa-solid fa-wifi"></i> Offline';}}
window.addEventListener('online',()=>netUI(true));window.addEventListener('offline',()=>netUI(false));if(!navigator.onLine)netUI(false);

/* ===== BRANDING ===== */
try{onSnapshot(doc(db,'systemSettings','branding'),s=>{if(s.exists()){const d=s.data();sysSet.branding={logoUrl:d.logoUrl||SYS_LOGO_FILE,logoEnabled:d.logoEnabled!==false};}paintAllLogos();});}catch(e){}
try{onSnapshot(doc(db,'systemSettings','languages'),s=>{if(s.exists())sysSet.languages=s.data().list||sysSet.languages;});}catch(e){}
try{onSnapshot(query(collection(db,'advertisements'),orderBy('createdAt','desc'),limit(10)),snap=>{const ads=snap.docs.map(d=>({id:d.id,...d.data()})).filter(a=>a.status==='active');const ban=$('landingAds');if(ban)ban.innerHTML=ads.slice(0,3).map(a=>`<div class="ad-banner-card">${a.imageUrl?`<img class="ad-banner-img" src="${a.imageUrl}" alt="${a.title}">`:''}<div class="ad-banner-content"><div class="ad-banner-title">${a.title}</div><div class="ad-banner-desc">${(a.description||'').substring(0,150)}</div></div></div>`).join('')||'';});}catch(e){}

/* ===== AUDIT ===== */
async function audit(a,e,d=''){try{if(CGI)await addDoc(collection(db,'groups',CGI,'audit'),{action:a,entity:e,details:d,user:`${CU?.firstName||''} ${CU?.lastName||''}`,role:CR,date:serverTimestamp()});}catch(e){}}

/* ===== LOAN CALCULATIONS ===== */
function loanTotalDue(l){const p=l.amount||0,r=l.interestRate||0,t=l.term||12;return p+(p*r/100*t/12);}
function loanTotalRepaid(lid){return RC.filter(r=>r.loanId===lid).reduce((a,r)=>a+(r.amount||0),0);}
function loanBalance(l){if(!l)return 0;return Math.max(0,loanTotalDue(l)-loanTotalRepaid(l.id));}
function memberSavings(name){return SC.filter(s=>s.memberName===name&&s.type==='DEPOSIT').reduce((a,s)=>a+(s.amount||0),0)-SC.filter(s=>s.memberName===name&&s.type==='WITHDRAWAL').reduce((a,s)=>a+(s.amount||0),0);}
function memberShares(name){return SHC.filter(s=>s.memberName===name).reduce((a,s)=>a+(s.amount||0),0);}

/* =================================================================
   TRAFFIC LIGHT PAYMENT BEHAVIOUR ENGINE
   ================================================================= */

/* Calculate payment behaviour for a member */
function calcPaymentBehaviour(memberName){
  const memberLoans=LC.filter(l=>l.memberName===memberName);
  if(!memberLoans.length)return{status:'none',label:'Hakuna Mkopo',color:'none',onTimePct:0,totalPayments:0,latePayments:0,currentOverdue:0,maxDaysOverdue:0,wasChronic:false,activeLoans:0,completedLoans:0};

  let totalPayments=0,latePayments=0,currentOverdue=0,maxDaysOverdue=0;
  let wasChronic=false,activeLoans=0,completedLoans=0;
  const now=new Date();

  memberLoans.forEach(loan=>{
    const isDisbursed=loan.status==='DISBURSED';
    const isCompleted=loan.status==='PAID'||loan.status==='COMPLETED';
    if(isDisbursed)activeLoans++;
    if(isCompleted)completedLoans++;

    /* Calculate overdue for active disbursed loans */
    if(isDisbursed){
      const balance=loanBalance(loan);
      if(balance>0){
        /* Expected end date: disbursement date + term months */
        let disbursementDate=null;
        if(loan.disbursementDate)disbursementDate=loan.disbursementDate instanceof Timestamp?loan.disbursementDate.toDate():new Date(loan.disbursementDate);
        else if(loan.date)disbursementDate=loan.date instanceof Timestamp?loan.date.toDate():new Date(loan.date);
        else if(loan.createdAt)disbursementDate=loan.createdAt instanceof Timestamp?loan.createdAt.toDate():new Date(loan.createdAt);

        if(disbursementDate){
          const expectedEnd=new Date(disbursementDate);
          expectedEnd.setMonth(expectedEnd.getMonth()+(loan.term||12));
          const daysOver=Math.max(0,daysBetween(expectedEnd,now));

          /* Check each month installment */
          const term=loan.term||12;
          const monthlyDue=loanTotalDue(loan)/term;
          const monthsElapsed=Math.min(term,Math.max(0,daysBetween(disbursementDate,now)/30));

          /* Get repayments for this loan sorted by date */
          const loanRepayments=RC.filter(r=>r.loanId===loan.id)
            .sort((a,b)=>{
              const da=a.date instanceof Timestamp?a.date.toMillis():(a.date?new Date(a.date).getTime():0);
              const db=b.date instanceof Timestamp?b.date.toMillis():(b.date?new Date(b.date).getTime():0);
              return da-db;
            });

          let cumulativeRepaid=0;
          for(let m=1;m<=Math.ceil(monthsElapsed);m++){
            totalPayments++;
            /* Expected amount by month m */
            const expectedByMonth=m*monthlyDue;
            /* Repayments up to month m */
            const monthDeadline=new Date(disbursementDate);
            monthDeadline.setMonth(monthDeadline.getMonth()+m);
            const repaidByMonth=loanRepayments.filter(r=>{
              const rd=r.date instanceof Timestamp?r.date.toDate():new Date(r.date);
              return rd<=monthDeadline;
            }).reduce((a,r)=>a+(r.amount||0),0);

            if(repaidByMonth<expectedByMonth-monthlyDue*0.1)latePayments++;
          }

          if(daysOver>0){
            currentOverdue+=balance;
            maxDaysOverdue=Math.max(maxDaysOverdue,daysOver);
          }
        }
      }
    }

    /* Check if completed loans were chronically overdue */
    if(isCompleted){
      const loanRepayments=RC.filter(r=>r.loanId===loan.id);
      if(loanRepayments.length>0){
        const lastRepayment=loanRepayments.reduce((latest,r)=>{
          const rd=r.date instanceof Timestamp?r.date.toDate():new Date(r.date||0);
          return rd>latest?rd:latest;
        },new Date(0));
        let disbursementDate=loan.date instanceof Timestamp?loan.date.toDate():new Date(loan.date||loan.createdAt||0);
        if(!(disbursementDate instanceof Date&&!isNaN(disbursementDate)))disbursementDate=new Date();
        const expectedEnd=new Date(disbursementDate);
        expectedEnd.setMonth(expectedEnd.getMonth()+(loan.term||12));
        const daysOver=daysBetween(expectedEnd,lastRepayment);
        if(daysOver>=thresholds.chronicDays)wasChronic=true;
      }
    }
  });

  const onTimePct=totalPayments>0?Math.round(((totalPayments-latePayments)/totalPayments)*100):100;

  /* Determine Traffic Light Status */
  /* RED: Current chronic defaulter */
  if(maxDaysOverdue>=thresholds.chronicDays&&(thresholds.chronicAmount===0||currentOverdue>=thresholds.chronicAmount)){
    return{status:'red',label:'Mdaiwa Sugu wa Sasa',color:'#ef4444',onTimePct,totalPayments,latePayments,currentOverdue,maxDaysOverdue,wasChronic:true,activeLoans,completedLoans};
  }

  /* ORANGE: Former chronic debtor who recovered */
  if(wasChronic&&currentOverdue===0){
    return{status:'orange',label:'Aliyewahi Kuwa Mdaiwa Sugu',color:'#f97316',onTimePct,totalPayments,latePayments,currentOverdue:0,maxDaysOverdue:0,wasChronic:true,activeLoans,completedLoans};
  }

  /* YELLOW: Occasional late payer */
  if(latePayments>thresholds.yellowMaxLate||currentOverdue>0){
    return{status:'yellow',label:'Mcheleweshaji',color:'#eab308',onTimePct,totalPayments,latePayments,currentOverdue,maxDaysOverdue,wasChronic:false,activeLoans,completedLoans};
  }

  /* GREEN: On-time payer */
  return{status:'green',label:'Mlipaji wa Wakati',color:'#22c55e',onTimePct,totalPayments,latePayments,currentOverdue,maxDaysOverdue,wasChronic:false,activeLoans,completedLoans};
}

/* Render traffic light dot */
function tlDot(status){return`<span class="tl-dot ${status}"></span>`;}

/* Render traffic light badge */
function tlBadge(status,label){
  if(!label){const m={green:'Mlipaji wa Wakati',yellow:'Mcheleweshaji',orange:'Aliyewahi Kuwa Mdaiwa Sugu',red:'Mdaiwa Sugu',none:'Hakuna Mkopo'};label=m[status]||'N/A';}
  return`<span class="tl-badge tl-${status}">${tlDot(status)} ${label}</span>`;
}

/* Render full traffic light visual (3 bulbs) */
function tlVisual(status){
  const g=status==='green'?'active':'';
  const y=(status==='yellow'||status==='orange')?'active':'';
  const r=status==='red'?'active':'';
  return`<div class="tl-traffic-light"><div class="tl-bulb b-red ${r}"></div><div class="tl-bulb b-yellow ${y}"></div><div class="tl-bulb b-green ${g}"></div></div>`;
}

