<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>CSCMS Pro V4</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<style>
:root{--bg:#07111f;--panel:#0d1929;--panel2:#122238;--line:#21344d;--text:#e8f0f8;--muted:#8ea3b9;--p:#16a979;--p2:#35d39b;--p3:#0d8a63;--blue:#3b82f6;--red:#ef4444;--yellow:#f59e0b;--purple:#8b5cf6;--orange:#f97316;--radius:12px;--font:'Inter',system-ui,sans-serif;--green-glow:#22c55e;--yellow-glow:#eab308;--orange-glow:#f97316;--red-glow:#ef4444}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:linear-gradient(135deg,#06101c,#0a1423);color:var(--text);font-family:var(--font);line-height:1.5;-webkit-font-smoothing:antialiased;overflow-x:hidden}
button,input,select,textarea{font:inherit}button{cursor:pointer;border:0;background:none}a{color:var(--p2);text-decoration:none}img,video{max-width:100%;display:block}
.hidden{display:none!important}
::-webkit-scrollbar{width:6px;height:6px}::-webkit-scrollbar-track{background:var(--panel)}::-webkit-scrollbar-thumb{background:var(--line);border-radius:3px}::-webkit-scrollbar-thumb:hover{background:var(--p3)}
.btn{border:0;border-radius:9px;padding:10px 16px;font-weight:600;font-size:12px;display:inline-flex;align-items:center;justify-content:center;gap:8px;transition:all .2s;white-space:nowrap}
.btn:hover{filter:brightness(1.1);transform:translateY(-1px)}.btn:active{transform:translateY(0)}.btn:disabled{opacity:.5;pointer-events:none}
.btn-sm{padding:6px 10px;font-size:11px;border-radius:6px}
.btn-xs{padding:4px 8px;font-size:10px;border-radius:5px}
.primary{background:var(--p);color:#fff}.outline{background:transparent;color:var(--p2);border:1px solid var(--p)}.danger{background:var(--red);color:#fff}.info{background:var(--blue);color:#fff}.warning{background:var(--yellow);color:#111}.purple{background:var(--purple);color:#fff}.orange{background:var(--orange);color:#fff}.mutedbtn{background:var(--panel2);color:var(--text);border:1px solid var(--line)}.ghost{background:transparent;color:var(--muted);padding:6px 8px}.ghost:hover{color:var(--p2);background:rgba(22,169,121,.06)}
.flex{display:flex}.flex-center{display:flex;align-items:center;justify-content:center}.flex-between{display:flex;align-items:center;justify-content:space-between}.gap-xs{gap:4px}.gap-sm{gap:8px}.gap-md{gap:12px}.gap-lg{gap:16px}.wrap{flex-wrap:wrap}.col{flex-direction:column}
.small{font-size:11px;color:var(--muted)}.tiny{font-size:10px;color:var(--muted)}.b{font-weight:700}
.container{max-width:1200px;margin:0 auto;padding:20px}
.row2{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.row3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.row4{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.auto-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px}
.metrics-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:18px}
.card{background:rgba(13,25,41,.96);border:1px solid var(--line);border-radius:var(--radius);padding:18px;transition:border-color .25s,box-shadow .25s}
.card:hover{border-color:rgba(22,169,121,.15);box-shadow:0 4px 20px rgba(0,0,0,.2)}
.metric-card{display:flex;align-items:center;gap:14px;padding:14px 18px}
.metric-icon{width:44px;height:44px;border-radius:10px;display:grid;place-items:center;font-size:18px;flex-shrink:0}
.metric-card h3{font-size:22px;margin:2px 0 0;line-height:1.2}.metric-card p{font-size:11px;color:var(--muted);margin:0}
.section-head{display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:16px}
.section-head h2,.section-head h3{margin:0}
.actions{display:flex;gap:6px;flex-wrap:wrap}
.field{margin:11px 0}.field label{display:block;font-size:11px;color:var(--muted);margin-bottom:5px;font-weight:600;text-transform:uppercase;letter-spacing:.5px}
.field input,.field select,.field textarea{width:100%;padding:11px 12px;border:1px solid var(--line);background:#091625;color:var(--text);border-radius:8px;outline:none;transition:border-color .2s;font-size:13px}
.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--p);box-shadow:0 0 0 3px rgba(22,169,121,.06)}
.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:10px;max-height:500px}
.table{width:100%;border-collapse:collapse;font-size:12px}
.table th,.table td{padding:9px 12px;border-bottom:1px solid var(--line);text-align:left;white-space:nowrap}
.table th{background:#101f33;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.6px;position:sticky;top:0;z-index:2}
.table tr:hover td{background:rgba(22,169,121,.03)}
.badge{padding:3px 9px;border-radius:20px;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;background:#18304a;color:var(--muted);display:inline-block}
.ok{background:#0b3a2c;color:#55e1ae}.warn{background:#3c2b08;color:#ffc857}.bad{background:#40151a;color:#ff7b85}.info-b{background:#0c2d4a;color:#60a5fa}.purple-b{background:#2d1650;color:#c084fc}.orange-b{background:#3c1f08;color:#ffb060}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.72);display:none;align-items:center;justify-content:center;z-index:100;padding:15px;backdrop-filter:blur(5px)}
.modal.show{display:flex}
.modal-card{width:min(740px,100%);max-height:90vh;overflow-y:auto;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:24px;animation:modalIn .22s ease}
@keyframes modalIn{from{opacity:0;transform:translateY(16px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}
.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}
.close{color:var(--muted);font-size:22px;transition:color .15s}.close:hover{color:var(--red)}
.toast-container{position:fixed;right:18px;bottom:18px;z-index:200;display:flex;flex-direction:column;gap:8px;max-width:360px}
.toast{background:#10243a;border:1px solid var(--p);padding:12px 18px;border-radius:9px;box-shadow:0 8px 24px rgba(0,0,0,.4);color:var(--text);font-size:13px;display:flex;align-items:center;gap:10px;animation:toastIn .3s ease}
.toast.error{border-color:var(--red)}.toast.success{border-color:var(--p)}.toast.warning{border-color:var(--yellow)}
@keyframes toastIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}

/* ===== TRAFFIC LIGHT SYSTEM ===== */
.tl-dot{width:14px;height:14px;border-radius:50%;display:inline-block;flex-shrink:0;position:relative}
.tl-dot.green{background:#22c55e;box-shadow:0 0 8px rgba(34,197,94,.5)}
.tl-dot.yellow{background:#eab308;box-shadow:0 0 8px rgba(234,179,8,.5)}
.tl-dot.orange{background:#f97316;box-shadow:0 0 8px rgba(249,115,22,.5)}
.tl-dot.red{background:#ef4444;box-shadow:0 0 8px rgba(239,68,68,.5);animation:tlPulse 2s infinite}
.tl-dot.none{background:var(--line);box-shadow:none}
@keyframes tlPulse{0%,100%{box-shadow:0 0 8px rgba(239,68,68,.5)}50%{box-shadow:0 0 18px rgba(239,68,68,.8)}}

.tl-badge{display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:20px;font-size:10px;font-weight:700;letter-spacing:.5px}
.tl-badge.tl-green{background:#0b3a2c;color:#55e1ae;border:1px solid rgba(34,197,94,.3)}
.tl-badge.tl-yellow{background:#3c2b08;color:#ffc857;border:1px solid rgba(234,179,8,.3)}
.tl-badge.tl-orange{background:#3c1f08;color:#ffb060;border:1px solid rgba(249,115,22,.3)}
.tl-badge.tl-red{background:#40151a;color:#ff7b85;border:1px solid rgba(239,68,68,.3);animation:tlPulse 2s infinite}
.tl-badge.tl-none{background:var(--panel2);color:var(--muted);border:1px solid var(--line)}

/* Traffic Light Large Display */
.tl-display{border-radius:var(--radius);padding:20px;position:relative;overflow:hidden}
.tl-display.tl-green-bg{background:linear-gradient(135deg,#052e16,#0a3a1e);border:1px solid rgba(34,197,94,.25)}
.tl-display.tl-yellow-bg{background:linear-gradient(135deg,#322a08,#3c3010);border:1px solid rgba(234,179,8,.25)}
.tl-display.tl-orange-bg{background:linear-gradient(135deg,#3c1f08,#4a2510);border:1px solid rgba(249,115,22,.25)}
.tl-display.tl-red-bg{background:linear-gradient(135deg,#401015,#4a1018);border:1px solid rgba(239,68,68,.25)}
.tl-display.tl-none-bg{background:var(--panel);border:1px solid var(--line)}

.tl-traffic-light{display:flex;flex-direction:column;align-items:center;gap:4px;padding:10px;background:#0a0a0a;border-radius:12px;width:42px}
.tl-bulb{width:22px;height:22px;border-radius:50%;opacity:.2;transition:all .3s}
.tl-bulb.active{opacity:1}
.tl-bulb.b-green{background:#22c55e}.tl-bulb.b-yellow{background:#eab308}.tl-bulb.b-red{background:#ef4444}
.tl-bulb.b-green.active{box-shadow:0 0 12px rgba(34,197,94,.8)}
.tl-bulb.b-yellow.active{box-shadow:0 0 12px rgba(234,179,8,.8)}
.tl-bulb.b-red.active{box-shadow:0 0 12px rgba(239,68,68,.8)}

/* Payment Behaviour Card */
.pb-card{border-radius:var(--radius);padding:22px;display:flex;gap:20px;align-items:flex-start}
.pb-traffic{flex-shrink:0}
.pb-details{flex:1;min-width:0}
.pb-title{font-size:14px;font-weight:700;margin-bottom:4px}
.pb-subtitle{font-size:11px;color:var(--muted);margin-bottom:12px}
.pb-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px}
.pb-stat{background:rgba(0,0,0,.25);padding:10px 12px;border-radius:8px}
.pb-stat h4{font-size:18px;font-weight:800;margin:0;line-height:1.1}
.pb-stat p{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin:2px 0 0}

/* Defaulter Card */
.defaulter-card{background:var(--panel);border:1px solid rgba(239,68,68,.2);border-radius:var(--radius);padding:18px;transition:all .3s}
.defaulter-card:hover{border-color:rgba(239,68,68,.4);box-shadow:0 4px 20px rgba(239,68,68,.1)}
.defaulter-header{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:12px}
.defaulter-body{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px}
.defaulter-stat{text-align:center;padding:8px;background:rgba(239,68,68,.06);border-radius:6px}
.defaulter-stat h4{font-size:16px;font-weight:800;margin:0;color:var(--red)}
.defaulter-stat p{font-size:9px;color:var(--muted);margin:1px 0 0;text-transform:uppercase}

/* Loan Block Overlay */
.loan-blocked{background:linear-gradient(135deg,#401015,#3a0d12);border:2px solid var(--red);border-radius:var(--radius);padding:24px;text-align:center}
.loan-blocked-icon{width:64px;height:64px;border-radius:50%;background:rgba(239,68,68,.12);display:grid;place-items:center;margin:0 auto 14px;font-size:28px;color:var(--red)}
.loan-override{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:16px;margin-top:14px;text-align:left}

/* Threshold Config */
.threshold-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
.threshold-item{background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:14px}
.threshold-item label{display:block;font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;font-weight:700;margin-bottom:6px}
.threshold-item input{width:100%;padding:8px 10px;border:1px solid var(--line);background:#091625;color:var(--text);border-radius:6px;font-size:13px}
.threshold-item .unit{font-size:10px;color:var(--muted);margin-top:4px}

.landing{min-height:100vh}.hero{text-align:center;padding:65px 20px 30px}
.brand{font-size:40px;font-weight:800;margin:12px 0 5px}.tag{color:var(--muted);font-size:14px}.hero-actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:25px}
.locale-bar{display:flex;gap:6px;justify-content:center;margin-top:14px;flex-wrap:wrap}
.locale-btn{padding:4px 12px;border-radius:16px;font-size:11px;font-weight:600;background:var(--panel2);color:var(--muted);border:1px solid var(--line);cursor:pointer;transition:all .2s}
.locale-btn:hover,.locale-btn.active{background:var(--p);color:#fff;border-color:var(--p)}
.auth{min-height:100vh;display:grid;place-items:center;padding:20px}.auth-card{width:min(520px,100%);background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:28px}
.member-reg-screen{min-height:100vh;display:grid;place-items:center;padding:20px}.member-reg-card{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:30px;width:min(640px,100%);position:relative}.mr-back{position:absolute;top:15px;left:15px;color:var(--muted);font-size:16px;display:flex;align-items:center;gap:5px}.mr-back:hover{color:var(--p2)}
.app-layout{min-height:100vh;display:flex}
.sidebar{width:260px;min-height:100vh;background:#091625;border-right:1px solid var(--line);overflow-y:auto;position:fixed;left:0;top:0;bottom:0;z-index:20;transition:transform .3s}
.side-head{padding:16px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:10px}
.side-head h4{margin:0;font-size:14px}.side-head .role-tag{font-size:10px;padding:2px 8px;border-radius:12px;background:var(--p);color:#fff;font-weight:700}
.nav-section{padding:8px 12px}
.nav-label{font-size:9px;color:#4a6580;text-transform:uppercase;margin:12px 6px 4px;font-weight:700;letter-spacing:1px}
.nav-btn{width:100%;text-align:left;color:var(--muted);padding:9px 12px;border-radius:7px;display:flex;align-items:center;gap:9px;font-size:12px;font-weight:500;transition:all .15s}
.nav-btn:hover{background:#10243a;color:var(--text)}.nav-btn.active{background:rgba(22,169,121,.1);color:var(--p2);font-weight:600}
.nav-btn i{width:20px;text-align:center;font-size:13px}
.main-area{margin-left:260px;flex:1;min-height:100vh;display:flex;flex-direction:column}
.top-bar{height:58px;position:sticky;top:0;z-index:15;background:rgba(9,22,37,.95);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;padding:0 20px}
.content-area{padding:22px;flex:1}
.search-box{display:flex;align-items:center;gap:6px;background:var(--panel2);border:1px solid var(--line);border-radius:7px;padding:0 10px}
.search-box input{background:transparent;border:0;color:var(--text);padding:7px;outline:none;font-size:12px;width:150px}
.super{min-height:100vh}.super-top{padding:16px 22px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;background:linear-gradient(135deg,#0d1929,#0a1423)}.super-body{display:flex;min-height:calc(100vh - 58px)}.super-nav{width:230px;background:#091625;border-right:1px solid var(--line);padding:16px 10px;overflow-y:auto}.super-content{flex:1;padding:24px;overflow-y:auto;max-height:calc(100vh - 58px)}
.snav-btn{width:100%;text-align:left;color:var(--muted);padding:10px 14px;border-radius:8px;display:flex;align-items:center;gap:10px;font-size:12px;transition:all .15s;font-weight:500;margin-bottom:2px}.snav-btn:hover{background:#10243a;color:var(--text)}.snav-btn.active{background:rgba(239,68,68,.12);color:var(--red);font-weight:600}.snav-btn i{width:18px;text-align:center}
.snav-section{font-size:9px;color:#4a6580;text-transform:uppercase;margin:16px 6px 6px;font-weight:700;letter-spacing:1px;padding-left:14px}
.sa-metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;margin-bottom:24px}
.sa-metric{background:linear-gradient(135deg,rgba(13,25,41,.96),rgba(18,34,56,.7));border:1px solid var(--line);border-radius:var(--radius);padding:20px;display:flex;align-items:center;gap:16px;transition:all .3s}.sa-metric:hover{border-color:rgba(239,68,68,.2);transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.3)}
.sa-metric-icon{width:52px;height:52px;border-radius:12px;display:grid;place-items:center;font-size:22px;flex-shrink:0}
.sa-metric h3{font-size:26px;font-weight:800;margin:0;line-height:1.1}.sa-metric p{font-size:11px;color:var(--muted);margin:2px 0 0}
.chart-box{height:220px;position:relative}
.pricing-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;max-width:1000px;margin:0 auto}
.price-card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:30px 25px;text-align:left;transition:all .3s}.price-card:hover{transform:translateY(-5px);border-color:var(--p)}
.price-amount{font-size:36px;font-weight:800;margin:10px 0}.price-amount span{font-size:14px;color:var(--muted);font-weight:400}
.id-reminder-card{width:min(480px,100%);text-align:center;padding:32px 28px!important}
.id-reminder-icon{width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,var(--p),#07563f);display:grid;place-items:center;margin:0 auto 18px;font-size:28px;color:#fff;box-shadow:0 6px 24px rgba(22,169,121,.3)}
.id-display-box{background:linear-gradient(135deg,#0a1e33,#0d2236);border:2px solid var(--p);border-radius:12px;padding:16px 20px;margin-bottom:22px}
.id-label{display:block;font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;font-weight:700;margin-bottom:6px}
.id-value{display:block;font-size:20px;font-weight:800;color:var(--p2);letter-spacing:1.5px;word-break:break-all}
.toggle-switch{position:relative;width:40px;height:20px;background:var(--panel2);border-radius:20px;cursor:pointer;border:1px solid var(--line);transition:all .2s;flex-shrink:0}.toggle-switch.active{background:var(--p);border-color:var(--p)}.toggle-switch::after{content:'';position:absolute;top:2px;left:2px;width:14px;height:14px;background:#fff;border-radius:50%;transition:transform .2s}.toggle-switch.active::after{transform:translateX(20px)}
.progress-bar{width:100%;height:6px;background:var(--panel2);border-radius:3px;overflow:hidden;margin-top:8px}.progress-fill{height:100%;border-radius:3px;transition:width .3s}
.confirm-overlay{position:fixed;inset:0;background:rgba(0,0,0,.7);display:flex;align-items:center;justify-content:center;z-index:150;backdrop-filter:blur(3px)}
.confirm-card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:24px;width:min(400px,90%);text-align:center}.confirm-card h3{margin-bottom:8px}.confirm-card p{color:var(--muted);font-size:13px;margin-bottom:20px}
#networkBanner{position:fixed;top:0;left:0;right:0;z-index:300;padding:10px;text-align:center;font-size:12px;font-weight:700;display:none;transition:all .3s}
#networkBanner.offline{background:var(--red);color:#fff;display:block}#networkBanner.online{background:var(--p);color:#fff;display:block}
.su-field{margin:10px 0}.su-field label{display:block;font-size:11px;color:var(--muted);margin-bottom:5px;font-weight:600;text-transform:uppercase;letter-spacing:.5px}
.su-input-wrap{position:relative;display:flex;align-items:center}.su-input-wrap .su-input-icon{position:absolute;left:12px;color:var(--muted);font-size:13px;pointer-events:none;z-index:1}
.su-input-wrap input,.su-input-wrap select{width:100%;padding:11px 12px 11px 38px;border:1px solid var(--line);background:#091625;color:var(--text);border-radius:8px;outline:none;font-size:13px}.su-input-wrap input:focus,.su-input-wrap select:focus{border-color:var(--p)}
.su-row{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.su-row3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.su-submit{width:100%;margin-top:18px;padding:13px 16px;font-size:14px;font-weight:700;border-radius:10px;background:linear-gradient(135deg,var(--p),#0d8a63);color:#fff;border:0;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:10px;transition:all .25s;box-shadow:0 4px 16px rgba(22,169,121,.2)}.su-submit:hover{filter:brightness(1.12);transform:translateY(-2px)}.su-submit:disabled{opacity:.55;pointer-events:none}
.ad-banner-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px;max-width:1200px;margin:0 auto}
.ad-banner-card{border-radius:16px;overflow:hidden;background:var(--panel);border:1px solid var(--line);transition:all .35s}.ad-banner-card:hover{transform:translateY(-6px);box-shadow:0 16px 40px rgba(0,0,0,.4);border-color:var(--p)}
.ad-banner-img{width:100%;height:200px;object-fit:cover;background:var(--panel2)}
