function renderDashboard(){
  const m=getData('members'),s=getData('transactions'),l=getData('loans'),r=getData('repayments'),w=getData('welfare'),c=getData('cash');
  const totalS=s.filter(t=>t.type==='DEPOSIT').reduce((a,t)=>a+Number(t.amount),0)-s.filter(t=>t.type==='WITHDRAWAL').reduce((a,t)=>a+Number(t.amount),0);
  const totalL=l.filter(x=>x.status==='APPROVED'||x.status==='DISBURSED').reduce((a,x)=>a+Number(x.balance||x.principal),0);
  const totalR=r.reduce((a,x)=>a+Number(x.amount),0);
  const totalW=w.filter(x=>x.type==='CONTRIBUTION').reduce((a,x)=>a+Number(x.amount),0);
  const income=c.filter(x=>x.type==='INCOME').reduce((a,x)=>a+Number(x.amount),0);
  const expense=c.filter(x=>x.type==='EXPENSE').reduce((a,x)=>a+Number(x.amount),0);
  $('metrics').innerHTML=[
    {icon:'fa-users',color:'var(--blue)',val:m.length,label:'Members'},
    {icon:'fa-piggy-bank',color:'var(--p)',val:fmt(totalS),label:'Total Savings'},
    {icon:'fa-hand-holding-dollar',color:'var(--yellow)',val:fmt(totalL),label:'Loans Outstanding'},
    {icon:'fa-money-bill-transfer',color:'var(--p2)',val:fmt(totalR),label:'Repayments'},
    {icon:'fa-heart',color:'var(--red)',val:fmt(totalW),label:'Welfare Fund'},
    {icon:'fa-coins',color:'var(--purple)',val:fmt(income-expense),label:'Net Income'}
  ].map(x=>`<div class="card metric"><div class="icon" style="background:${x.color}20;color:${x.color}"><i class="fa-solid ${x.icon}"></i></div><div><h3>${x.val}</h3><p>${x.label}</p></div></div>`).join('');
  // Financial Summary
  $('financialSummary').innerHTML=[
    {l:'Total Deposits',v:fmt(s.filter(t=>t.type==='DEPOSIT').reduce((a,t)=>a+Number(t.amount),0))},
    {l:'Total Withdrawals',v:fmt(s.filter(t=>t.type==='WITHDRAWAL').reduce((a,t)=>a+Number(t.amount),0))},
    {l:'Net Savings',v:fmt(totalS)},
    {l:'Loan Portfolio',v:fmt(totalL)},
    {l:'Total Repayments',v:fmt(totalR)},
    {l:'Income',v:fmt(income)},
    {l:'Expenses',v:fmt(expense)},
    {l:'Net Position',v:fmt(totalS+income-expense+totalW-totalL)}
  ].map(x=>`<div class="lc-row"><span class="lc-l">${x.l}</span><span class="lc-v">${x.v}</span></div>`).join('');
  // Charts
  renderDashCharts(l,s,m);
  // System Ads
  const ads=getData('groupAds');
  $('dashSystemAds').innerHTML=ads.length?ads.slice(0,3).map(a=>`<div class="lc-row"><span class="lc-l">${a.title}</span><span class="lc-v">${a.description?.substring(0,40)||''}</span></div>`).join(''):'<div class="small">No announcements</div>';
}

let chartPortfolio=null,chartTrend=null;
function renderDashCharts(loans,txns,members){
  const approved=loans.filter(l=>l.status==='APPROVED'||l.status==='DISBURSED').length;
  const pending=loans.filter(l=>l.status==='PENDING').length;
  const rejected=loans.filter(l=>l.status==='REJECTED').length;
  const settled=loans.filter(l=>l.status==='SETTLED').length;
  if(chartPortfolio)chartPortfolio.destroy();
  chartPortfolio=new Chart($('dashChartPortfolio'),{type:'doughnut',data:{labels:['Active','Pending','Rejected','Settled'],datasets:[{data:[approved,pending,rejected,settled],backgroundColor:['#16a979','#f59e0b','#ef4444','#3b82f6']}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{color:'#8ea3b9'}}}}});
  // Savings Trend — last 6 months
  const months=[];
  for(let i=5;i>=0;i--){const d=new Date();d.setMonth(d.getMonth()-i);months.push(d.toLocaleDateString('en',{month:'short'}))}
  const depositsByMonth=months.map((_,i)=>{const d=new Date();d.setMonth(d.getMonth()-(5-i));d.setDate(1);const next=new Date(d);next.setMonth(next.getMonth()+1);return txns.filter(t=>t.type==='DEPOSIT'&&new Date(t.date)>=d&&new Date(t.date)<next).reduce((a,t)=>a+Number(t.amount),0)});
  if(chartTrend)chartTrend.destroy();
  chartTrend=new Chart($('dashChartTrend'),{type:'line',data:{labels:months,datasets:[{label:'Deposits',data:depositsByMonth,borderColor:'#16a979',backgroundColor:'rgba(22,169,121,0.1)',fill:true,tension:0.4}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{color:'#8ea3b9'}}},scales:{x:{ticks:{color:'#8ea3b9'},grid:{color:'#21344d'}},y:{ticks:{color:'#8ea3b9'},grid:{color:'#21344d'}}}}});
}

