/* ======== RENDER: REPORTS ======== */
function renderReports(){
  const m=getData('members'),l=getData('loans'),s=getData('transactions'),r=getData('repayments');
  const totalS=s.filter(t=>t.type==='DEPOSIT').reduce((a,t)=>a+Number(t.amount),0)-s.filter(t=>t.type==='WITHDRAWAL').reduce((a,t)=>a+Number(t.amount),0);
