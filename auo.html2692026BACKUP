    messagingSenderId: "436069918682",
    appId: "1:436069918682:web:70b56c627315bc782102e3",
    measurementId: "G-2QCBEJSGKS"
  };

  try {
    // Initialize Firebase
    const app = initializeApp(firebaseConfig);
    const analytics = getAnalytics(app);
    const db = getFirestore(app);

    // Weka Firestore DB kwenye global scope kwa Store kutumia
    window._db = db;
    window._fsReady = true;

    console.log('Firebase Firestore connected successfully');

    // On connection, update sync status
    if (typeof updateSyncStatus === 'function') {
      updateSyncStatus('online');
    }

    // Import Firestore functions kwa dynamic usage
    const { doc, setDoc, getDoc, deleteDoc, collection, getDocs, onSnapshot } = await import('https://www.gstatic.com/firebasejs/12.19.0/firebase-firestore.js');

    // Real-time listener kwa system_ads — kusikiliza mabadiliko ya Firestore
    try {
      const sysAdsRef = doc(db, 'cscms_data', 'system_ads');
      onSnapshot(sysAdsRef, (snap) => {
        if (snap.exists()) {
          const remoteData = snap.data().value;
          if (remoteData) {
            // Update LocalStorage na data mpya kutoka Firestore
            try {
              localStorage.setItem('system_ads', JSON.stringify(remoteData));
              // Update UI kama super admin page iko wazi
              if (typeof renderSuperAds === 'function') renderSuperAds();
            } catch (e) {
              console.warn('LS write fail in onSnapshot:', e);
            }
          }
        }
      });
    } catch (e) {
      console.warn('Real-time listener setup failed:', e);
    }

    // Background sync: Push LocalStorage data to Firestore
    // Hii inafanya kazi kila mara data ikibadilika
    const originalSetItem = localStorage.setItem.bind(localStorage);
    localStorage.setItem = function(key, value) {
      originalSetItem(key, value);
      // Push to Firestore (non-blocking)
      if (window._db && key.startsWith('cscms_data_') || key.startsWith('system_ads') || key.startsWith('group_') || key.includes('_members') || key.includes('_transactions') || key.includes('_loans') || key.includes('_repayments') || key.includes('_shares') || key.includes('_welfare') || key.includes('_meetings') || key.includes('_groupAds') || key.includes('_guarantors') || key.includes('_collateral') || key.includes('_cash') || key.includes('_dividends') || key.includes('_penalties') || key.includes('_kyc') || key.includes('_reschedule') || key.includes('_loanProducts') || key.includes('_audit') || key.includes('_branches')) {
        try {
          const parsedVal = JSON.parse(value);
          const ref = doc(db, 'cscms_data', key);
          setDoc(ref, { value: parsedVal, updated: Date.now() }, { merge: true })
            .then(() => {
              if (typeof updateSyncStatus === 'function') updateSyncStatus('online');
            })
            .catch(err => {
              console.warn('Firestore write error:', err);
              if (typeof updateSyncStatus === 'function') updateSyncStatus('offline');
            });
        } catch (e) {}
      }
    };

  } catch (error) {
    console.warn('Firebase initialization failed. Running in LocalStorage-only mode:', error);
    window._fsReady = false;
    window._db = null;
    if (typeof updateSyncStatus === 'function') updateSyncStatus('offline');
  }
</script>

