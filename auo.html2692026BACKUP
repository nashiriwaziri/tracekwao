/* ======== RENDER: CASHBOOK ======== */
function renderCashbook(){
  const c=getData('cash'),t=getData('transactions'),r=getData('repayments');
  let entries=[];
  c.forEach(x=>entries.push({date:x.date,ref:x.description,debit:x.type==='INCOME'?x.amount:0,credit:x.type==='EXPENSE'?x.amount:0}));
  t.forEach(x=>entries.push({date:x.date,ref:x.type+' - '+x.memberId,debit:x.type==='DEPOSIT'?x.amount:0,credit:x.type==='WITHDRAWAL'?x.amount:0}));
  r.forEach(x=>entries.push({date:x.date,ref:'Repayment - '+x.loanId,debit:x.amount,credit:0}));
  entries.sort((a,b)=>a.date.localeCompare(b.date));
  let bal=0;
  const income=entries.reduce((a,e)=>a+e.debit,0);
  const expense=entries.reduce((a,e)=>a+e.credit,0);
  $('cashbookMetrics').innerHTML=[
    {icon:'fa-arrow-down',color:'var(--p)',val:fmt(income),label:'Total Debits'},
    {icon:'fa-arrow-up',color:'var(--red)',val:fmt(expense),label:'Total Credits'},
    {icon:'fa-scale-balanced',color:'var(--blue)',val:fmt(income-expense),label:'Balance'}
  ].map(x=>`<div class="card metric"><div class="icon" style="background:${x.color}20;color:${x.color}"><i class="fa-solid ${x.icon}"></i></div><div><h3>${x.val}</h3><p>${x.label}</p></div></div>`).join('');
  $('cashbookBody').innerHTML=entries.map(e=>{bal+=e.debit-e.credit;return`<tr><td>${e.date}</td><td>${e.ref}</td><td>${e.debit?fmt(e.debit):'-'}</td><td>${e.credit?fmt(e.credit):'-'}</td><td>${fmt(bal)}</td></tr>`}).join('')||'<tr><td colspan="5" style="text-align:center;color:var(--muted)">No entries</td></tr>';
}

