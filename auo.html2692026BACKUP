/* ======== DUAL STORAGE ENGINE ======== */
// Hifadhi data kwa LocalStorage NA Firestore pamoja
const Store={
  /* LocalStorage operations */
  _lsGet(key){try{return JSON.parse(localStorage.getItem(key))}catch(e){return null}},
  _lsSet(key,val){try{localStorage.setItem(key,JSON.stringify(val))}catch(e){console.warn('LS write fail:',e)}},
  _lsDel(key){try{localStorage.removeItem(key)}catch(e){}},

  /* Pata data — LocalStorage kwanza, kisha Firestore */
  async get(key){
    const local=this._lsGet(key);
    // Kama Firestore iko tayari, jaribu kusoma kutoka Firestore
    if(window._fsReady && window._db){
      try{
        const{doc,getDoc}=await import('https://www.gstatic.com/firebasejs/12.19.0/firebase-firestore.js');
        const ref=doc(window._db,'cscms_data',key);
        const snap=await getDoc(ref);
        if(snap.exists()){
          const remote=snap.data().value;
          // Merge: Firestore ni source of truth online
          if(remote) this._lsSet(key,remote);
          return remote;
        }
      }catch(e){console.warn('FS read fail for',key,e)}
    }
    return local;
  },

  /* Hifadhi data — LocalStorage NA Firestore */
  async set(key,val){
    this._lsSet(key,val); // Hifadhi LocalStorage mara moja
    // Jaribu Firestore
    if(window._fsReady && window._db){
      try{
        const{doc,setDoc}=await import('https://www.gstatic.com/firebasejs/12.19.0/firebase-firestore.js');
        const ref=doc(window._db,'cscms_data',key);
        await setDoc(ref,{value:val,updated:Date.now()},{merge:true});
        updateSyncStatus('online');
      }catch(e){
        console.warn('FS write fail for',key,e);
        updateSyncStatus('offline');
      }
    }else{
      updateSyncStatus('offline');
    }
  },

  /* Futa data — LocalStorage NA Firestore */
  async del(key){
    this._lsDel(key);
    if(window._fsReady && window._db){
      try{
        const{doc,deleteDoc}=await import('https://www.gstatic.com/firebasejs/12.19.0/firebase-firestore.js');
        const ref=doc(window._db,'cscms_data',key);
        await deleteDoc(ref);
      }catch(e){console.warn('FS delete fail:',e)}
    }
  },

  /* Synchronize collection item (add/update/delete within array) */
  async saveCollection(collectionKey, items){
    await this.set(collectionKey, items);
  },

  /* Pull all data from Firestore to LocalStorage (initial sync) */
  async pullAll(keys){
    if(!window._fsReady||!window._db) return 0;
    let synced=0;
    try{
      const{doc,getDoc}=await import('https://www.gstatic.com/firebasejs/12.19.0/firebase-firestore.js');
      for(const key of keys){
        try{
          const ref=doc(window._db,'cscms_data',key);
          const snap=await getDoc(ref);
          if(snap.exists()){
            const remote=snap.data().value;
            const local=this._lsGet(key);
            // Kama hakija LocalStorage au Firestore ni mpya zaidi
            if(remote){
              const remoteTime=snap.data().updated||0;
              if(!local||remoteTime>(local._ts||0)){
                this._lsSet(key,remote);
                synced++;
              }
            }
          }
        }catch(e){}
      }
    }catch(e){console.warn('PullAll failed:',e)}
    return synced;
  }
};

/* ======== SYNC STATUS UI ======== */
function updateSyncStatus(status){
  const el=$('syncStatus');
  if(!el)return;
  if(status==='online') el.className='sync-indicator online', el.innerHTML='<i class="fa-solid fa-cloud"></i> Synced';
  else if(status==='syncing') el.className='sync-indicator syncing', el.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Syncing';
  else el.className='sync-indicator offline', el.innerHTML='<i class="fa-solid fa-hard-drive"></i> Local';
}

