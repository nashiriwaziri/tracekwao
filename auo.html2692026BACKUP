/* ======== SEARCH ======== */
function handleSearch(e){
  const q=e.target.value.toLowerCase();
  if(!q){renderSection(document.querySelector('.section.active')?.id?.replace('sec-','')||'dashboard');return}
  // Filter visible table rows
  document.querySelectorAll('.table tbody tr').forEach(tr=>{
    tr.style.display=tr.textContent.toLowerCase().includes(q)?'':'none';
  });
}

/* ======== PDF GENERATION ======== */
function generatePDF(section){
  const{jsPDF}=window.jspdf;
  const doc=new jsPDF();
  doc.setFontSize(16);doc.text('CSCMS Pro V4 — '+section.toUpperCase(),14,20);
  doc.setFontSize(10);doc.text('Generated: '+new Date().toLocaleString(),14,28);
  const table=document.querySelector('#sec-'+section+' .table');
  if(table){
    doc.autoTable({html:table,startY:36,theme:'grid',styles:{fontSize:8},headStyles:{fillColor:[22,169,121]}});
  }
  doc.save('CSCMS_'+section+'_'+today()+'.pdf');
  toast('PDF generated');
}

