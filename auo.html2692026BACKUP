 $('shareForm').onsubmit=function(e){
  e.preventDefault();
  const editId=$('shareEditId').value,mode=$('shareMode').value,qty=Number($('shQty').value),memberId=$('shMember').value;
  const arr=getData('shares');
  const obj={id:editId||uid(),action:mode,memberId,qty,value:qty*G.sharePrice,date:today()};
  if(editId){const i=arr.findIndex(x=>x.id===editId);if(i>=0)arr[i]=obj;addAudit('EDIT','Share: '+mode)}
  else{arr.push(obj);addAudit('ADD','Share: '+mode+' x'+qty)}
  // Update member shares
  const members=getData('members');
  const mi=members.findIndex(x=>x.id===memberId);
  if(mi>=0){if(mode==='BUY')members[mi].shares=(members[mi].shares||0)+qty;else if(mode==='TRANSFER')members[mi].shares=Math.max(0,(members[mi].shares||0)-qty);setData('members',members)}
  setData('shares',arr);closeModal('shareModal');renderShares();toast(editId?'Share updated':'Share recorded');
};
