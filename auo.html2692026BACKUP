<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>CSCMS Pro V4 — International Community Savings & Microfinance</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<style>
:root{--bg:#07111f;--panel:#0d1929;--panel2:#122238;--line:#21344d;--text:#e8f0f8;--muted:#8ea3b9;--p:#16a979;--p2:#35d39b;--blue:#3b82f6;--red:#ef4444;--yellow:#f59e0b;--purple:#8b5cf6;--radius:12px;--font:'Inter',system-ui,-apple-system,sans-serif}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{background:linear-gradient(135deg,#06101c,#0a1423);color:var(--text);font-family:var(--font);line-height:1.5;-webkit-font-smoothing:antialiased}
button,input,select,textarea{font:inherit}button{cursor:pointer;border:0;background:none}a{color:var(--p2);text-decoration:none}img{max-width:100%;display:block}
.hidden{display:none!important}
.btn{border:0;border-radius:9px;padding:10px 16px;font-weight:600;font-size:12px;display:inline-flex;align-items:center;justify-content:center;gap:8px;transition:all .2s ease;white-space:nowrap}
.btn:hover{filter:brightness(1.1);transform:translateY(-1px)}.btn:active{transform:translateY(0)}.btn:disabled{opacity:.5;pointer-events:none}
.primary{background:var(--p);color:#fff}.outline{background:transparent;color:var(--p2);border:1px solid var(--p)}.danger{background:var(--red);color:#fff}.info{background:var(--blue);color:#fff}.warning{background:var(--yellow);color:#111}.purple{background:var(--purple);color:#fff}.mutedbtn{background:var(--panel2);color:var(--text);border:1px solid var(--line)}
.container{max-width:1200px;margin:0 auto;padding:20px}.row{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.row3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.flex{display:flex}.flex-center{display:flex;align-items:center;justify-content:center}.flex-between{display:flex;align-items:center;justify-content:space-between}.gap-sm{gap:8px}.gap-md{gap:12px}.gap-lg{gap:16px}.wrap{flex-wrap:wrap}.small{font-size:11px;color:var(--muted)}
.landing{min-height:100vh}.hero{text-align:center;padding:65px 20px 30px}
.logo{width:72px;height:72px;border-radius:18px;background:linear-gradient(135deg,var(--p),#07563f);display:grid;place-items:center;margin:0 auto;font-size:30px;color:#fff}
.brand{font-size:40px;font-weight:800;margin:12px 0 5px}.tag{color:var(--muted);font-size:14px}.hero-actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:25px}
.public-grid,.metrics,.grid{display:grid;gap:14px}.public-grid{grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}.grid2{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}.grid3{grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}.metrics{grid-template-columns:repeat(auto-fit,minmax(160px,1fr));margin-bottom:18px}
.card{background:rgba(13,25,41,.96);border:1px solid var(--line);border-radius:var(--radius);padding:18px;transition:border-color .2s}.card:hover{border-color:rgba(22,169,121,.2)}
.metric{display:flex;align-items:center;gap:15px}.metric .icon{width:42px;height:42px;border-radius:10px;display:grid;place-items:center;font-size:18px;flex-shrink:0}.metric h3{font-size:24px;margin:4px 0}.metric p{font-size:11px;color:var(--muted);margin:0}
.auth{min-height:100vh;display:grid;place-items:center;padding:20px}.auth-card{width:min(520px,100%);background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:28px}
.member-reg-screen{min-height:100vh;display:grid;place-items:center;padding:20px;background:linear-gradient(135deg,#06101c,#0a1423)}.member-reg-card{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:30px;width:min(640px,100%);position:relative}.mr-back{position:absolute;top:15px;left:15px;color:var(--muted);font-size:16px;display:flex;align-items:center;gap:5px}.mr-back:hover{color:var(--p2)}
.field{margin:11px 0}.field label{display:block;font-size:11px;color:var(--muted);margin-bottom:5px;font-weight:600;text-transform:uppercase;letter-spacing:.5px}.field input,.field select,.field textarea{width:100%;padding:11px 12px;border:1px solid var(--line);background:#091625;color:var(--text);border-radius:8px;outline:none;transition:border-color .2s}.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--p)}
.locale-bar{display:flex;justify-content:center;gap:8px;margin-top:18px;flex-wrap:wrap}.locale-btn{padding:6px 14px;border-radius:20px;font-size:11px;font-weight:600;border:1px solid var(--line);background:var(--panel);color:var(--muted);transition:all .2s}.locale-btn.active{background:var(--p);color:#fff;border-color:var(--p)}.locale-btn:hover:not(.active){border-color:var(--p2);color:var(--p2)}
.app{min-height:100vh}.sidebar{position:fixed;left:0;top:0;bottom:0;width:270px;background:#091625;border-right:1px solid var(--line);overflow-y:auto;z-index:20;transition:transform .3s ease}.side-head{padding:18px;border-bottom:1px solid var(--line);font-weight:800;display:flex;align-items:center;gap:10px}
.nav{padding:10px}.nav-title{font-size:10px;color:#61758d;text-transform:uppercase;margin:14px 9px 5px;font-weight:700;letter-spacing:.8px}.nav button{width:100%;text-align:left;color:var(--muted);padding:10px;border-radius:8px;display:flex;align-items:center;gap:10px;font-size:13px;transition:all .15s}.nav button:hover,.nav button.active{background:#10243a;color:var(--p2)}.nav i{width:22px;text-align:center}
.main{margin-left:270px;min-height:100vh}.top{height:62px;position:sticky;top:0;z-index:15;background:rgba(9,22,37,.96);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;padding:0 20px}.content{padding:22px;flex:1}
.section{display:none}.section.active{display:block}.section-head{display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:18px}.section-head h2{margin:0}.actions{display:flex;gap:7px;flex-wrap:wrap}
.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:10px}.table{width:100%;border-collapse:collapse;font-size:12px}.table th,.table td{padding:10px 12px;border-bottom:1px solid var(--line);text-align:left;white-space:nowrap}.table th{background:#101f33;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.5px;position:sticky;top:0}.table tr:hover td{background:rgba(22,169,121,.04)}
.badge{padding:4px 8px;border-radius:20px;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;background:#18304a}.ok{background:#0b3a2c;color:#55e1ae}.warn{background:#3c2b08;color:#ffc857}.bad{background:#40151a;color:#ff7b85}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.7);display:none;align-items:center;justify-content:center;z-index:100;padding:15px;backdrop-filter:blur(4px)}.modal.show{display:flex}.modal-card{width:min(720px,100%);max-height:92vh;overflow-y:auto;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:24px;animation:modalIn .25s ease}@keyframes modalIn{from{opacity:0;transform:translateY(20px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.close{color:var(--muted);font-size:22px;transition:color .15s}.close:hover{color:var(--red)}
.toast-container{position:fixed;right:18px;bottom:18px;z-index:200;display:flex;flex-direction:column;gap:8px;max-width:360px}.toast{background:#10243a;border:1px solid var(--p);padding:12px 18px;border-radius:9px;box-shadow:0 8px 24px rgba(0,0,0,.4);color:var(--text);font-size:13px;display:flex;align-items:center;gap:10px;animation:toastIn .3s ease}.toast.error{border-color:var(--red)}.toast.success{border-color:var(--p)}@keyframes toastIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.super{min-height:100vh;background:linear-gradient(135deg,#06101c,#0a1423)}.super-top{padding:16px 22px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;background:var(--panel)}.super-body{padding:22px;max-width:1200px;margin:0 auto}
.pricing{padding:60px 20px 80px;text-align:center}.pricing h2{font-size:32px;margin-bottom:10px}.pricing .sub{color:var(--muted);margin-bottom:40px;font-size:15px}.pricing-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;max-width:1000px;margin:0 auto}.price-card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:30px 25px;text-align:left;display:flex;flex-direction:column;transition:all .3s ease;position:relative}.price-card:hover{transform:translateY(-5px);border-color:var(--p)}.price-card.featured{border-color:var(--p);box-shadow:0 10px 30px rgba(22,169,121,.15)}.badge-pop{position:absolute;top:-12px;right:20px;background:var(--p);color:#fff;padding:5px 12px;border-radius:6px;font-size:11px;font-weight:700;text-transform:uppercase}.price-header{margin-bottom:20px;border-bottom:1px solid var(--line);padding-bottom:20px}.price-header h3{font-size:20px;margin-bottom:10px;display:flex;align-items:center;gap:10px}.price-amount{font-size:36px;font-weight:800}.price-amount span{font-size:14px;color:var(--muted);font-weight:400}.price-features{list-style:none;margin-bottom:30px;flex:1;padding:0}.price-features li{font-size:13px;padding:10px 0;border-bottom:1px solid rgba(33,52,77,.5);display:flex;justify-content:space-between;color:var(--muted)}.price-features li strong{color:var(--text);font-weight:600}
.lc-row{display:flex;justify-content:space-between;padding:8px 0;font-size:13px;border-bottom:1px solid var(--line)}.lc-row:last-child{border-bottom:none}.lc-row .lc-l{color:var(--muted)}.lc-row .lc-v{font-weight:700}
.chair-only{display:none}.divider{border:0;border-top:1px solid var(--line);margin:16px 0}
.search-bar{display:flex;align-items:center;gap:8px;background:var(--panel2);border:1px solid var(--line);border-radius:9px;padding:0 12px}.search-bar input{background:transparent;border:0;color:var(--text);padding:8px;outline:none;font-size:12px;width:180px}
.alert-trial{background:var(--yellow);color:#111;padding:10px 20px;font-size:13px;font-weight:600;text-align:center;display:flex;justify-content:center;align-items:center;gap:10px;border-bottom:1px solid rgba(0,0,0,.1)}
.chart-box{height:220px;position:relative}
.act-btns{display:flex;gap:4px}
.img-drop{border:2px dashed var(--line);border-radius:10px;padding:30px 20px;text-align:center;cursor:pointer;transition:all .2s;position:relative;overflow:hidden}.img-drop:hover{border-color:var(--p);background:rgba(22,169,121,.04)}.img-drop input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer}.img-drop .preview{max-width:100%;max-height:200px;border-radius:8px;object-fit:cover;margin-top:10px}.img-drop .drop-text{color:var(--muted);font-size:13px}
.ad-card{position:relative}.ad-card img{max-height:200px;border-radius:9px;object-fit:cover;margin-bottom:10px}.ad-card h4{margin:0 0 6px;font-size:14px}.ad-card p{font-size:12px;color:var(--muted);margin:0 0 8px}
.sync-indicator{display:inline-flex;align-items:center;gap:5px;font-size:10px;padding:3px 8px;border-radius:12px;font-weight:600}.sync-indicator.online{background:#0b3a2c;color:#55e1ae}.sync-indicator.offline{background:#40151a;color:#ff7b85}.sync-indicator.syncing{background:#3c2b08;color:#ffc857}
@media(max-width:850px){.sidebar{transform:translateX(-100%)}.sidebar.open{transform:translateX(0)}.main{margin-left:0}.row,.row3{grid-template-columns:1fr}.top{padding:0 12px}.content{padding:14px}.brand{font-size:28px}.pricing h2{font-size:24px}.price-amount{font-size:28px}.search-bar input{width:100px}}
@media(max-width:480px){.hero-actions{flex-direction:column;align-items:center}.hero-actions .btn{width:100%;max-width:280px}}
</style>
</head>
<body>

<!-- LANDING PAGE -->
<div id="landing" class="landing">
  <section class="hero">
    <div class="logo"><i class="fa-solid fa-people-group" style="font-size:36px"></i></div>
    <div class="brand">CSCMS Pro V4</div>
    <div class="tag">Community Savings &bull; Microfinance &bull; Shares &bull; Loans &bull; Governance</div>
    <div class="locale-bar">
      <button class="locale-btn active" onclick="setLang('en')">English</button>
      <button class="locale-btn" onclick="setLang('sw')">Kiswahili</button>
      <button class="locale-btn" onclick="setLang('fr')">Fran&ccedil;ais</button>
    </div>
    <div class="hero-actions">
      <button class="btn primary" onclick="showScreen('auth')"><i class="fa-solid fa-right-to-bracket"></i> Sign In</button>
      <button class="btn outline" onclick="showScreen('memberRegScreen')"><i class="fa-solid fa-user-plus"></i> Sign Up</button>
      <button class="btn mutedbtn" onclick="openModal('superLoginModal')"><i class="fa-solid fa-shield-halved"></i> Super Admin</button>
    </div>
  </section>
  <div class="container">
    <div class="section-head"><h2>System Announcements</h2></div>
    <div id="publicAds" class="public-grid"></div>
  </div>
  <div class="pricing">
    <h2>Plans & Pricing</h2>
    <div class="sub">Choose the right plan for your group</div>
    <div class="pricing-grid" id="pricingGrid"></div>
  </div>
</div>

<!-- SIGN UP SCREEN -->
<div id="memberRegScreen" class="member-reg-screen hidden">
  <div class="member-reg-card">
    <button class="mr-back" onclick="showScreen('landing')"><i class="fa-solid fa-arrow-left"></i> Back</button>
    <h2 style="margin-bottom:5px;text-align:center">Register Group</h2>
    <form id="signUpForm">
      <h3 style="font-size:14px;color:var(--p2);margin:12px 0"><i class="fa-solid fa-user-tie"></i> Chairperson Information</h3>
      <div class="row3"><div class="field"><label>First Name *</label><input id="suFname" required></div><div class="field"><label>Middle Name</label><input id="suMname"></div><div class="field"><label>Last Name *</label><input id="suLname" required></div></div>
      <div class="row"><div class="field"><label><i class="fa-solid fa-id-card"></i> National ID *</label><input id="suNida" required></div><div class="field"><label><i class="fa-solid fa-phone"></i> Phone *</label><input id="suPhone" type="tel" required></div></div>
      <hr class="divider">
      <h3 style="font-size:14px;color:var(--p2);margin:12px 0"><i class="fa-solid fa-sitemap"></i> Group Information</h3>
      <div class="row"><div class="field"><label>Group Type *</label><select id="suGroupType" required><option value="">--</option><option value="rosca">ROSCA</option><option value="asca">ASCA</option><option value="vsla">VSLA</option><option value="sacco">SACCO</option><option value="welfare">Welfare</option><option value="investment">Investment</option></select></div><div class="field"><label>Group Name *</label><input id="suGroupName" required></div></div>
      <div class="row"><div class="field"><label>Country *</label><select id="suCountry" required></select></div><div class="field"><label>Currency</label><select id="suCurrency"></select></div></div>
      <hr class="divider">
      <h3 style="font-size:14px;color:var(--p2);margin:12px 0"><i class="fa-solid fa-lock"></i> Security</h3>
      <div class="row"><div class="field"><label>Password *</label><input id="suPassword" type="password" minlength="6" required></div><div class="field"><label>Confirm Password *</label><input id="suConfirmPassword" type="password" minlength="6" required></div></div>
      <button class="btn primary" type="submit" style="width:100%;margin-top:16px"><i class="fa-solid fa-user-plus"></i> Sign Up</button>
    </form>
  </div>
</div>

<!-- SIGN IN SCREEN -->
<div id="auth" class="auth hidden">
  <div class="auth-card">
    <div class="section-head"><h2>Sign In</h2><button class="close" onclick="showScreen('landing')">&times;</button></div>
    <form id="signInForm">
      <div class="field"><label>Group ID *</label><input id="loginGroupId" required></div>
      <div class="field"><label>National ID or Phone *</label><input id="loginNida" required></div>
      <div class="field"><label>Password *</label><input id="loginPassword" type="password" required></div>
      <button class="btn primary" type="submit" style="width:100%;margin-top:12px"><i class="fa-solid fa-right-to-bracket"></i> Sign In</button>
    </form>
  </div>
</div>

<!-- SUPER ADMIN -->
<div id="super" class="super hidden">
  <div class="super-top"><div class="flex gap-sm" style="align-items:center"><b><i class="fa-solid fa-shield-halved" style="color:var(--red)"></i> SUPER ADMIN</b></div><button class="btn outline" onclick="logoutSuper()">Logout</button></div>
  <div class="super-body"><div class="metrics" id="superMetrics" style="margin-bottom:20px"></div><div class="grid grid2"><div class="card"><div class="section-head"><h3>Groups</h3></div><div class="table-wrap"><table class="table"><thead><tr><th>Name</th><th>Type</th><th>Country</th><th>ID</th><th>Actions</th></tr></thead><tbody id="superGroupsBody"></tbody></table></div></div><div class="card"><div class="section-head"><h3>System Ads</h3><button class="btn primary" onclick="openSuperAdModal()"><i class="fa-solid fa-plus"></i> Add</button></div><div id="superAdsList" class="public-grid"></div></div></div></div>
</div>

<!-- MAIN APP -->
<div id="app" class="app hidden">
  <aside id="sidebar" class="sidebar">
    <div class="side-head"><i class="fa-solid fa-people-group" style="color:var(--p2);font-size:24px"></i><span id="sideGroup">CSCMS</span><div class="small" id="sideRole"></div></div>
    <nav class="nav" id="navContainer"></nav>
  </aside>
  <main class="main">
    <header class="top">
      <div class="flex gap-md" style="align-items:center"><button class="btn mutedbtn" onclick="toggleSidebar()">&#9776;</button><b id="pageTitle">Dashboard</b><span id="syncStatus" class="sync-indicator offline"><i class="fa-solid fa-cloud"></i> Local</span></div>
      <div class="flex gap-md" style="align-items:center">
        <div class="search-bar"><i class="fa-solid fa-search" style="color:var(--muted)"></i><input type="text" placeholder="Search..." id="globalSearch" onkeyup="handleSearch(event)"></div>
        <select id="roleSwitch" onchange="switchRole(this.value)" style="background:var(--panel2);color:var(--text);border:1px solid var(--line);padding:5px 8px;border-radius:6px;font-size:11px"><option value="chair">Chairperson</option><option value="member">Member</option></select>
        <span class="small" id="topUser"></span>
        <button class="btn outline" onclick="logout()" style="padding:4px 12px">Logout</button>
      </div>
    </header>
    <div class="content">

      <section id="sec-dashboard" class="section active"><div class="section-head"><h2>Dashboard</h2><div class="actions"><button class="btn info" onclick="generatePDF('dashboard')"><i class="fa-solid fa-file-pdf"></i> PDF</button></div></div><div class="metrics" id="metrics"></div><div class="grid grid2"><div class="card"><h3>Portfolio Distribution</h3><div class="chart-box"><canvas id="dashChartPortfolio"></canvas></div></div><div class="card"><h3>Savings Trend</h3><div class="chart-box"><canvas id="dashChartTrend"></canvas></div></div></div><div class="grid grid2" style="margin-top:14px"><div class="card"><h3>Financial Summary</h3><div id="financialSummary"></div></div><div class="card"><h3>Alerts & Announcements</h3><div id="dashSystemAds"></div></div></div></section>

      <section id="sec-members" class="section"><div class="section-head"><h2>Members</h2><div class="actions"><button class="btn info" onclick="generatePDF('members')"><i class="fa-solid fa-file-pdf"></i> PDF</button><button class="btn primary chair-only" onclick="openMemberModal()"><i class="fa-solid fa-plus"></i> Add</button></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Name</th><th>NIDA</th><th>Phone</th><th>Shares</th><th>Savings</th><th>Loan Bal</th><th>Status</th><th>Actions</th></tr></thead><tbody id="membersBody"></tbody></table></div></section>

      <section id="sec-branches" class="section"><div class="section-head"><h2>Branches</h2><div class="actions"><button class="btn info" onclick="generatePDF('branches')"><i class="fa-solid fa-file-pdf"></i> PDF</button><button class="btn primary chair-only" onclick="openBranchModal()"><i class="fa-solid fa-plus"></i> Add</button></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Address</th><th>Actions</th></tr></thead><tbody id="branchesBody"></tbody></table></div></section>

