  $('reportPortfolio').innerHTML=[
    {l:'Members',v:m.length},{l:'Savings',v:fmt(totalS)},{l:'Loans Outstanding',v:fmt(totalL)},{l:'Repayments',v:fmt(r.reduce((a,x)=>a+Number(x.amount),0))}
  ].map(x=>`<div class="lc-row"><span class="lc-l">${x.l}</span><span class="lc-v">${x.v}</span></div>`).join('');
  // PAR
  const now=new Date();const days30=30*86400000;
  const par30=l.filter(x=>x.status==='APPROVED'&&now-new Date(x.date)>days30).length;
  $('reportPAR').innerHTML=`<div class="lc-row"><span class="lc-l">Active Loans</span><span class="lc-v">${l.filter(x=>x.status==='APPROVED'||x.status==='DISBURSED').length}</span></div><div class="lc-row"><span class="lc-l">PAR > 30 days</span><span class="lc-v">${par30}</span></div>`;
  // Member balances
  $('reportMembers').innerHTML=m.slice(0,8).map(mb=>{
    const sav=s.filter(t=>t.memberId===mb.id&&t.type==='DEPOSIT').reduce((a,t)=>a+Number(t.amount),0)-s.filter(t=>t.memberId===mb.id&&t.type==='WITHDRAWAL').reduce((a,t)=>a+Number(t.amount),0);
    return`<div class="lc-row"><span class="lc-l">${mb.name}</span><span class="lc-v">${fmt(sav)}</span></div>`;
  }).join('');
}

