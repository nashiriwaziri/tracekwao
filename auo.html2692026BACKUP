  h+=`<button class="btn primary" style="padding:4px 10px;font-size:10px" onclick="openLoanModal('${id}')" title="Edit"><i class="fa-solid fa-pen"></i></button>`;
  if(loan&&loan.status==='PENDING') h+=`<button class="btn info" style="padding:4px 10px;font-size:10px" onclick="approveLoan('${id}')" title="Approve"><i class="fa-solid fa-check"></i></button>`;
  if(loan&&loan.status==='APPROVED') h+=`<button class="btn warning" style="padding:4px 10px;font-size:10px" onclick="disburseLoan('${id}')" title="Disburse"><i class="fa-solid fa-money-bill-wave"></i></button>`;
  if(loan&&(loan.status==='APPROVED'||loan.status==='DISBURSED')) h+=`<button class="btn purple" style="padding:4px 10px;font-size:10px" onclick="openRescheduleModal('${id}')" title="Reschedule"><i class="fa-solid fa-clock-rotate-left"></i></button>`;
  h+=`<button class="btn danger" style="padding:4px 10px;font-size:10px" onclick="deleteLoan('${id}')" title="Delete"><i class="fa-solid fa-trash"></i></button>`;
  h+='</div>';
  return h;
}
// Patch renderLoans to use loanActBtns
const _origRenderLoans=renderLoans;
renderLoans=function(){
  const l=getData('loans'),m=getData('members');
  $('loansBody').innerHTML=l.map(x=>{
    const mb=m.find(z=>z.id===x.memberId);
    const stCls=x.status==='APPROVED'||x.status==='DISBURSED'?'ok':x.status==='PENDING'?'warn':x.status==='SETTLED'?'ok':'bad';
    return`<tr><td>${mb?.name||'Unknown'}</td><td>${fmt(x.principal)}</td><td>${fmt(x.balance||x.principal)}</td><td>${x.interest}%</td><td><span class="badge ${stCls}">${x.status}</span></td><td>${loanActBtns(x.id)}</td></tr>`;
  }).join('')||'<tr><td colspan="6" style="text-align:center;color:var(--muted)">No loans</td></tr>';
};
function approveLoan(id){
  const loans=getData('loans');const l=loans.find(x=>x.id===id);
  if(l){l.status='APPROVED';setData('loans',loans);addAudit('APPROVE','Loan: '+id);renderLoans();toast('Loan approved')}
}
function disburseLoan(id){
  const loans=getData('loans');const l=loans.find(x=>x.id===id);
  if(l){l.status='DISBURSED';setData('loans',loans);addAudit('DISBURSE','Loan: '+id);renderLoans();toast('Loan disbursed')}
}

