function renderLedger(){
  const c=getData('cash'),t=getData('transactions'),r=getData('repayments'),w=getData('welfare');
  let entries=[];
  c.forEach(x=>entries.push({date:x.date,desc:x.type+': '+x.description,debit:x.type==='INCOME'?x.amount:0,credit:x.type==='EXPENSE'?x.amount:0}));
