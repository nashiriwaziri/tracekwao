   ========================================================= */
onAuthStateChanged(auth, async (user) => {
  if (!user) {
    State.currentUser = null;
    State.currentUserDoc = null;
    State.currentBizId = null;
    State.currentBizDoc = null;
    State.currentRole = null;
    showScreen("landingPage");
    renderPublicShowcase();
    return;
  }
  State.currentUser = user;
  try {
    const userDoc = await FS.getUser(user.uid);
    State.currentUserDoc = userDoc;
    if (!userDoc) {
      showScreen("authScreen");
      switchAuthTab("login");
      return;
    }
    const role = normalizeRole(userDoc.role);
    if (role === "super_admin") {
      showSuperPanel();
      return;
    }
    State.currentBizId = userDoc.businessId;
    if (!State.currentBizId) {
      showRoleScreen();
      return;
    }
    const biz = await FS.getBusiness(State.currentBizId);
    State.currentBizDoc = biz;
    if (!biz || biz.status === "suspended") {
      toast("Biashara yako imefungwa", "e");
      showScreen("authScreen");
      return;
    }
    if (userDoc.currentRole && PERMS[userDoc.currentRole]) {
      State.currentRole = userDoc.currentRole;
      showScreen("appScreen");
      applyRolePermissions();
      const firstSection = hasPermission("dashboard") ? "secDashboard" :
        hasPermission("pos") ? "secPOS" :
        hasPermission("products") ? "secProducts" : "secProfile";
      showSection(firstSection);
      loadCurrentSection(firstSection);
      updateTopbarUI();
    } else {
      showRoleScreen();
    }
  } catch (err) {
    console.error("[FIREBASE ERROR]", err);
    showScreen("authScreen");
  }
});

function normalizeRole(r) {
  if (!r) return "staff";
  const lower = r.toLowerCase().replace(/[\s_-]/g, "");
  if (lower === "superadmin" || lower === "superadministrator") return "super_admin";
  if (["owner", "manager", "staff", "seller", "cashier", "storekeeper"].includes(lower)) return lower;
  return "staff";
}

