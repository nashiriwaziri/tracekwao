  if (pw.length >= 6) s++;
  if (pw.length >= 10) s++;
  if (/[A-Z]/.test(pw)) s++;
  if (/[0-9]/.test(pw)) s++;
  if (/[^A-Za-z0-9]/.test(pw)) s++;
  const colors = ["#e74c3c", "#e74c3c", "#f39c12", "#f39c12", "#00b894", "#00b894"];
  const bar = document.getElementById("pwStrBar");
  bar.style.width = (s * 20) + "%";
