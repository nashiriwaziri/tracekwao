window.calcPrice = function() {
  const cost = parseFloat(document.getElementById("cost").value) || 0;
  const oh = parseFloat(document.getElementById("overhead").value) || 0;
  const mg = parseFloat(document.getElementById("margin").value) || 0;
  const price = cost * (1 + oh / 100) * (1 + mg / 100);
  document.getElementById("price").textContent = fmt(Math.round(price));
};

