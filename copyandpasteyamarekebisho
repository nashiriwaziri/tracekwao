function renderDashChart(sales, expenses) {
  const ctx = document.getElementById("dashSalesChart");
  if (!ctx) return;
  if (State.charts.dashSales) State.charts.dashSales.destroy();
  const last7 = [];
  for (let i = 6; i >= 0; i--) {
    const d = new Date(); d.setDate(d.getDate() - i);
    const key = d.toISOString().split("T")[0];
    const daySales = sales.filter(s => {
      if (!s.createdAt) return false;
      const sd = s.createdAt.toDate ? s.createdAt.toDate() : new Date(s.createdAt);
      return sd.toISOString().split("T")[0] === key;
    }).reduce((sum, s) => sum + (s.total || 0), 0);
    const dayExp = expenses.filter(ex => {
      if (!ex.createdAt) return false;
      const ed = ex.createdAt.toDate ? ex.createdAt.toDate() : new Date(ex.createdAt);
      return ed.toISOString().split("T")[0] === key;
    }).reduce((sum, ex) => sum + (ex.amount || 0), 0);
    last7.push({ label: d.toLocaleDateString("sw", { weekday: "short" }), sales: daySales, expenses: dayExp });
  }
  State.charts.dashSales = new Chart(ctx, {
    type: "bar", data: {
      labels: last7.map(d => d.label),
      datasets: [
        { label: "Mauzo", data: last7.map(d => d.sales), backgroundColor: "rgba(108,92,231,.7)" },
        { label: "Matumizi", data: last7.map(d => d.expenses), backgroundColor: "rgba(231,76,60,.5)" }
      ]
    }, options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true } }, plugins: { legend: { labels: { color: "#9a9ab0" } } } }
  });
}

