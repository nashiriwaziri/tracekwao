window.exportTablePDF = function(title, headers, rows) {
  try {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF();
    doc.setFontSize(16);
    doc.text(title, 14, 20);
    doc.setFontSize(10);
    doc.text(`Iliyotolewa: ${new Date().toLocaleString("sw-TZ")}`, 14, 28);
