const PERMS = {
  owner: ["dashboard","finance","pos","products","sales","purchases","suppliers","customers","debts","expenses","employees","notifications","profile","users"],
  manager: ["dashboard","finance","pos","products","sales","purchases","suppliers","customers","debts","expenses","employees","notifications","profile","users"],
  staff: ["dashboard","pos","products","sales","customers","notifications","profile"],
  seller: ["dashboard","pos","products","sales","customers","notifications","profile"],
  cashier: ["pos","sales","notifications","profile"],
  storekeeper: ["products","purchases","suppliers","notifications","profile"]
};

function hasPermission(section) {
  if (!State.currentRole) return false;
  const p = PERMS[State.currentRole] || [];
  return p.includes(section);
}

function applyRolePermissions() {
  const map = {
    "navDashboard": "dashboard", "navFinance": "finance", "navPOS": "pos",
    "navProducts": "products", "navSales": "sales", "navPurchases": "purchases",
    "navSuppliers": "suppliers", "navCustomers": "customers", "navDebts": "debts",
    "navExpenses": "expenses", "navEmployees": "employees",
    "navNotifications": "notifications", "navProfile": "profile", "navUsers": "users"
  };
  Object.entries(map).forEach(([navId, perm]) => {
    const el = document.getElementById(navId);
    if (el) el.style.display = hasPermission(perm) ? "flex" : "none";
  });
}

