window.openPublishModal = function() {
  document.getElementById("pubProdName").value = "";
  document.getElementById("pubProdDesc").value = "";
  document.getElementById("pubProdPrice").value = "";
  document.getElementById("pubProdShop").value = State.currentBizDoc?.name || "";
  document.getElementById("pubProdPhone").value = State.currentBizDoc?.phone || "";
  document.getElementById("pubProdImage").value = "";
  document.getElementById("pubProdPreview").innerHTML = '<i class="fa-solid fa-camera" style="font-size:24px;color:var(--text3)"></i>';
  openModal("publishModal");
};

window.previewPubImage = function(input) {
  if (input.files && input.files[0]) {
    const reader = new FileReader();
    reader.onload = (e) => { document.getElementById("pubProdPreview").innerHTML = `<img src="${e.target.result}" style="width:100%;height:100%;object-fit:cover"/>`; };
    reader.readAsDataURL(input.files[0]);
  }
};

window.publishProduct = async function(e) {
  e.preventDefault();
  if (State.submitting) return;
  const btn = e.target.querySelector("button[type=submit]");
  btnLoading(btn, true); State.submitting = true;
  try {
    const data = {
      name: document.getElementById("pubProdName").value.trim(),
      description: document.getElementById("pubProdDesc").value.trim(),
      price: parseFloat(document.getElementById("pubProdPrice").value) || 0,
      shop: document.getElementById("pubProdShop").value.trim(),
      phone: document.getElementById("pubProdPhone").value.trim(),
      businessId: State.currentBizId,
      ownerId: State.currentUser.uid,
      status: "published"
    };
    if (!data.name || !data.price) { toast("Jina na bei vinahitajika", "e"); btnLoading(btn, false); State.submitting = false; return; }
    const fileInput = document.getElementById("pubProdImage");
    if (fileInput.files.length > 0) {
      const path = `globalProducts/${State.currentBizId}/${Date.now()}.jpg`;
      data.imageUrl = await uploadImage(fileInput.files[0], path);
    }
    await FS.add("globalProducts", data);
    toast("Bidhaa imechapishwa hadharani", "s");
    closeModal("publishModal");
  } catch (err) {
    console.error("[FIREBASE ERROR]", err);
    toast("Imeshindikana kuchapisha", "e");
  } finally {
    btnLoading(btn, false); State.submitting = false;
  }
};

