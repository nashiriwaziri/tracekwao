window.handleLogin = async function(e) {
  e.preventDefault();
  if (State.submitting) return;
  const btn = e.target.querySelector("button[type=submit]");
  btnLoading(btn, true);
  State.submitting = true;
  try {
    const email = document.getElementById("loginEmail").value.trim();
    const pw = document.getElementById("loginPass").value;
    await signInWithEmailAndPassword(auth, email, pw);
  } catch (err) {
    console.error("[FIREBASE ERROR]", err);
    const msgs = {
      "auth/user-not-found": "Akaunti haipo",
      "auth/wrong-password": "Password si sahihi",
      "auth/invalid-email": "Email si sahihi",
      "auth/invalid-credential": "Email au password si sahihi",
      "auth/too-many-requests": "Jaribu tena baada ya muda"
    };
    showAuthErr(msgs[err.code] || "Imeshindikana kuingia");
  } finally {
    btnLoading(btn, false);
    State.submitting = false;
  }
};

window.handleSignup = async function(e) {
  e.preventDefault();
  if (State.submitting) return;
  const btn = e.target.querySelector("button[type=submit]");
  btnLoading(btn, true);
  State.submitting = true;
  try {
    const name = document.getElementById("signupName").value.trim();
    const email = document.getElementById("signupEmail").value.trim();
    const pw = document.getElementById("signupPass").value;
    const bizName = document.getElementById("signupBiz").value.trim();
    const bizCat = document.getElementById("signupCat").value;
    const phone = document.getElementById("signupPhone").value.trim();
    const addr = document.getElementById("signupAddr").value.trim();
    if (!bizName || !bizCat) { showAuthErr("Jina la biashara na aina zinahitajika"); btnLoading(btn, false); State.submitting = false; return; }
    const cred = await createUserWithEmailAndPassword(auth, email, pw);
    await updateProfile(cred.user, { displayName: name });
    const bizRef = doc(collection(db, "businesses"));
    const bizId = bizRef.id;
    await setDoc(bizRef, {
      name: bizName, category: bizCat, phone, address: addr,
      ownerId: cred.user.uid, status: "active",
      createdAt: serverTimestamp(), updatedAt: serverTimestamp()
    });
    await setDoc(doc(db, "users", cred.user.uid), {
      uid: cred.user.uid, name, email, role: "owner",
      businessId: bizId, status: "active",
      createdAt: serverTimestamp(), updatedAt: serverTimestamp()
    });
  } catch (err) {
    console.error("[FIREBASE ERROR]", err);
    const msgs = {
      "auth/email-already-in-use": "Email tayari inatumika",
      "auth/weak-password": "Password ni dhaifu",
      "auth/invalid-email": "Email si sahihi"
    };
    showAuthErr(msgs[err.code] || "Imeshindikana kusajili");
  } finally {
    btnLoading(btn, false);
    State.submitting = false;
  }
};

window.handlePasswordReset = async function() {
  const email = document.getElementById("loginEmail").value.trim();
  if (!email) return showAuthErr("Weka email kwanza");
  try {
    await sendPasswordResetEmail(auth, email);
    toast("Link ya kubadilisha password imetumwa", "s");
  } catch (err) {
    console.error("[FIREBASE ERROR]", err);
    showAuthErr("Imeshindikana kutuma link");
  }
};

