/* =========================================================
   FIRESTORE DATA LAYER (FS)
   ========================================================= */
const FS = {
  async getUser(uid) {
    if (!uid) return null;
    const snap = await getDoc(doc(db, "users", uid));
    return snap.exists() ? { id: snap.id, ...snap.data() } : null;
  },
  async getBusiness(businessId) {
    if (!businessId) return null;
    const snap = await getDoc(doc(db, "businesses", businessId));
    return snap.exists() ? { id: snap.id, ...snap.data() } : null;
  },
  async getCollection(name, businessId, orderField, orderDir) {
    const constraints = [where("businessId", "==", businessId)];
    if (orderField) constraints.push(orderBy(orderField, orderDir || "desc"));
    const q = query(collection(db, name), ...constraints);
    const snap = await getDocs(q);
    return snap.docs.map(d => ({ id: d.id, ...d.data() }));
  },
  async getDocById(name, id) {
    const snap = await getDoc(doc(db, name, id));
    return snap.exists() ? { id: snap.id, ...snap.data() } : null;
  },
  async add(name, data) {
    const refDoc = await addDoc(collection(db, name), {
      ...data, createdAt: serverTimestamp(), updatedAt: serverTimestamp()
    });
    return refDoc.id;
  },
  async set(name, id, data, merge) {
    await setDoc(doc(db, name, id), {
      ...data, updatedAt: serverTimestamp(), createdAt: data.createdAt || serverTimestamp()
    }, { merge: merge !== false });
  },
  async update(name, id, data) {
    await updateDoc(doc(db, name, id), { ...data, updatedAt: serverTimestamp() });
  },
  async remove(name, id) {
    await deleteDoc(doc(db, name, id));
  },
  async queryCollection(name, constraints) {
    const q = query(collection(db, name), ...constraints);
    const snap = await getDocs(q);
    return snap.docs.map(d => ({ id: d.id, ...d.data() }));
  },
  listenCollection(name, constraints, callback, errCallback) {
    const q = query(collection(db, name), ...constraints);
    const unsub = onSnapshot(q, callback, errCallback || (e => console.error("[FIREBASE ERROR]", e)));
    State.unsubscribers.push(unsub);
    return unsub;
  }
};

/* =========================================================
   IMAGE COMPRESSION
   ========================================================= */
function compressImage(file, maxKB = 500, maxDim = 1200) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onerror = () => reject(new Error("Fail kuusoma picha"));
    reader.onload = (e) => {
      const img = new Image();
      img.onerror = () => reject(new Error("Picha si sahihi"));
      img.onload = () => {
        let w = img.width, h = img.height;
        if (w > maxDim || h > maxDim) {
          if (w > h) { h = Math.round(h * maxDim / w); w = maxDim; }
          else { w = Math.round(w * maxDim / h); h = maxDim; }
        }
        let quality = 0.8;
        const canvas = document.createElement("canvas");
        canvas.width = w; canvas.height = h;
        canvas.getContext("2d").drawImage(img, 0, 0, w, h);
        const tryCompress = () => {
          canvas.toBlob(blob => {
            if (!blob) { reject(new Error("Compression failed")); return; }
            if (blob.size / 1024 <= maxKB || quality <= 0.1) {
              resolve(blob);
            } else {
              quality -= 0.1;
              tryCompress();
            }
          }, "image/jpeg", quality);
        };
        tryCompress();
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  });
}

async function uploadImage(file, path) {
  const compressed = await compressImage(file);
  const storageRef = ref(storage, path);
  await uploadBytes(storageRef, compressed);
  return await getDownloadURL(storageRef);
}

