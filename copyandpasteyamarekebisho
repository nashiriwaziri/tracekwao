function renderSuperCharts(users, businesses) {
  // Users trend
  const ctx1 = document.getElementById("superUsersTrend");
  if (ctx1) {
    if (State.charts.suTrend) State.charts.suTrend.destroy();
    const months = [];
    for (let i = 11; i >= 0; i--) {
      const d = new Date(); d.setMonth(d.getMonth() - i);
      const key = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`;
      const count = users.filter(u => { if (!u.createdAt) return false; const ud = u.createdAt.toDate ? u.createdAt.toDate() : new Date(u.createdAt); return `${ud.getFullYear()}-${String(ud.getMonth()+1).padStart(2,'0')}` === key; }).length;
      months.push({ label: d.toLocaleDateString("sw", { month: "short" }), count });
