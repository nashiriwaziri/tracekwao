  try {
    const adsSnap = await getDocs(query(collection(db, "globalAds"), orderBy("createdAt", "desc"), limit(20)));
    const adsGrid = document.getElementById("publicAdsGrid");
    if (adsSnap.empty) {
      adsGrid.innerHTML = '<div class="empty-s"><i class="fa-solid fa-bullhorn"></i><p>Hakuna matangazo bado</p></div>';
    } else {
      adsGrid.innerHTML = adsSnap.docs.map(d => {
        const a = d.data();
        return `<div class="pub-ad-card">${a.imageUrl ? `<img src="${a.imageUrl}" style="width:100%;height:160px;object-fit:cover"/>` : '<div class="pub-ad-img-placeholder"><i class="fa-solid fa-image"></i></div>'}<div class="pub-ad-body"><h4>${a.title || ''}</h4><p>${a.description || ''}</p>${a.link ? `<a class="pub-ad-link" href="${a.link}" target="_blank"><i class="fa-solid fa-external-link"></i> Angalia</a>` : ''}</div></div>`;
      }).join("");
    }
    const prodSnap = await getDocs(query(collection(db, "globalProducts"), where("status", "==", "published"), orderBy("createdAt", "desc"), limit(30)));
    const prodGrid = document.getElementById("publicProductsGrid");
    if (prodSnap.empty) {
      prodGrid.innerHTML = '<div class="empty-s"><i class="fa-solid fa-box-open"></i><p>Hakuna bidhaa za hadharani bado</p></div>';
    } else {
      prodGrid.innerHTML = prodSnap.docs.map(d => {
        const p = d.data();
        return `<div class="pub-prod-card">${p.imageUrl ? `<img src="${p.imageUrl}" style="width:100%;height:140px;object-fit:cover"/>` : '<div class="pub-prod-img-placeholder"><i class="fa-solid fa-image"></i></div>'}<div class="pub-prod-body"><h4>${p.name || ''}</h4><p>${p.description || ''}</p><div class="pub-prod-price">TZS ${fmt(p.price)}</div><div class="pub-prod-seller">${p.shop || ''} &bull; ${p.phone || ''}</div></div></div>`;
