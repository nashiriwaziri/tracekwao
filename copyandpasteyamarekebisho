function toast(msg, type = "i") {
  const c = document.getElementById("toastContainer");
  const t = document.createElement("div");
  const icons = { s: "fa-check-circle", e: "fa-circle-exclamation", i: "fa-circle-info", w: "fa-triangle-exclamation" };
  t.className = `toast ${type}`;
  t.innerHTML = `<i class="fa-solid ${icons[type] || icons.i}"></i> ${msg}`;
  c.appendChild(t);
  setTimeout(() => { t.style.opacity = "0"; setTimeout(() => t.remove(), 300); }, 3500);
}

function fmt(n) {
  if (n == null) return "0";
  return Number(n).toLocaleString("en-US");
}

function fmtDate(ts) {
  if (!ts) return "-";
  const d = ts.toDate ? ts.toDate() : new Date(ts);
  return d.toLocaleDateString("sw-TZ", { day: "2-digit", month: "short", year: "numeric" });
}

function statusBadge(status) {
  const cls = { active: "active", suspended: "suspended", pending: "pending", paid: "paid", unpaid: "unpaid" };
  return `<span class="status-badge ${cls[status] || 'pending'}">${status || 'pending'}</span>`;
}

