window.addToCart = function(productId) {
  const p = posProducts.find(x => x.id === productId);
  if (!p) return;
  const existing = State.cart.find(x => x.productId === productId);
  if (existing) {
    if (existing.qty >= p.stock) { toast("Hakuna stock enough", "w"); return; }
    existing.qty++;
    existing.total = existing.qty * existing.price;
  } else {
    State.cart.push({ productId: p.id, name: p.name, price: p.sellPrice, qty: 1, total: p.sellPrice });
  }
  renderCart();
};

window.removeFromCart = function(idx) {
  State.cart.splice(idx, 1);
  renderCart();
};

window.changeCartQty = function(idx, delta) {
  const item = State.cart[idx];
  if (!item) return;
  const p = posProducts.find(x => x.id === item.productId);
  const newQty = item.qty + delta;
  if (newQty <= 0) { removeFromCart(idx); return; }
  if (p && newQty > p.stock) { toast("Hakuna stock enough", "w"); return; }
  item.qty = newQty;
  item.total = item.qty * item.price;
  renderCart();
};

function renderCart() {
  const el = document.getElementById("cartItems");
  if (!State.cart.length) { el.innerHTML = '<div class="empty-s" style="padding:20px"><p>Gari ni tupu</p></div>'; }
  else {
    el.innerHTML = State.cart.map((item, i) => `
      <div class="cart-item">
        <div class="cart-item-info"><h6>${item.name}</h6><span>TZS ${fmt(item.price)}</span></div>
        <div class="cart-qty"><button onclick="changeCartQty(${i},-1)">-</button><span>${item.qty}</span><button onclick="changeCartQty(${i},1)">+</button></div>
        <div class="cart-item-price">TZS ${fmt(item.total)}</div>
        <button class="cart-item-rm" onclick="removeFromCart(${i})"><i class="fa-solid fa-times"></i></button>
      </div>
    `).join("");
  }
  const total = State.cart.reduce((s, x) => s + x.total, 0);
  document.getElementById("cartTotal").textContent = `TZS ${fmt(total)}`;
}

window.completePOSSale = async function() {
  if (!State.cart.length) { toast("Gari ni tupu", "w"); return; }
  if (State.submitting) return;
  State.submitting = true;
  try {
    const total = State.cart.reduce((s, x) => s + x.total, 0);
    const saleData = {
      businessId: State.currentBizId, userId: State.currentUser.uid,
      customerName: "Walk-in", items: [...State.cart], total,
      invoiceNo: "POS-" + Date.now().toString(36).toUpperCase(),
      status: "paid", paymentMethod: "cash"
    };
    await FS.add("sales", saleData);
    const batch = writeBatch(db);
    State.cart.forEach(item => {
      batch.update(doc(db, "products", item.productId), { stock: increment(-item.qty) });
    });
    await batch.commit();
    toast("Mnada umefanikiwa", "s");
    State.cart = [];
    await loadPOS();
  } catch (err) {
    console.error("[FIREBASE ERROR]", err);
    toast("Imeshindikana kumaliza mnada", "e");
  } finally {
    State.submitting = false;
  }
};

