/* ============================================================
   PRICE CALCULATOR
   ============================================================ */
function calcPrice() {
  const c = parseFloat($('cost').value) || 0;
  const o = parseFloat($('overhead').value) || 0;
  const m = parseFloat($('margin').value) || 0;
  const total = c + (c * o / 100) + (c * m / 100);
  $('price').textContent = fmt(Math.round(total));
}
