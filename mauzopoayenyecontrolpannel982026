}
/* Verify ownership server-side by checking the document */
async function verifyBizOwnership(docPath, bizIdField) {
  if (!checkAuth()) return false;
  try {
    const doc = await db.doc(docPath).get();
    if (!doc.exists) { toast('Hatua hii haipo.', 'e'); return false; }
    const data = doc.data();
    if (data[bizIdField || 'bizId'] !== currentBizId) { toast('Huruhsa: Biashara hii sio yako.', 'e'); return false; }
    return true;
  } catch (err) { toast('Hitilafu ya kuthibitisha: ' + err.message, 'e'); return false; }
}
/* Verify manager relationship */
async function verifyManagerRelation(employeeUid) {
  if (!checkAuth()) return false;
  if (currentRole === 'owner') return true; /* Owner sees all */
  if (currentRole !== 'manager') return false;
  try {
    const doc = await db.collection('users').doc(employeeUid).get();
    if (!doc.exists) return false;
    return doc.data().managerId === currentUser.uid;
  } catch (err) { return false; }
}

