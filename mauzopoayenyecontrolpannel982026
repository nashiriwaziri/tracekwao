/* ============================================================
   AUTH: SIGNUP
   ============================================================ */
async function handleSignup(e) {
  e.preventDefault();
  hideAuthErr();
  const name = $('signupName').value.trim();
  const email = $('signupEmail').value.trim();
  const phone = $('signupPhone').value.trim();
  const pass = $('signupPass').value;
  const passC = $('signupPassC').value;
  const bizName = $('signupBiz').value.trim();
  const bizCat = $('signupCat').value;
  const bizLoc = $('signupLoc').value.trim();
  if (!name || !email || !pass || !bizName) { showAuthErr('Tafadhali jaza sehemu zote zinazohitajika.'); return; }
  if (pass !== passC) { showAuthErr('Password hailingani.'); return; }
  if (pass.length < 6) { showAuthErr('Password lazima iwe na angalau herufi 6.'); return; }
  try {
    const cred = await auth.createUserWithEmailAndPassword(email, pass);
    const bizId = genId();
    await db.collection('businesses').doc(bizId).set({
      name: bizName, category: bizCat, location: bizLoc, ownerId: cred.user.uid,
      phone: phone, logo: '', status: 'active', createdAt: firebase.firestore.FieldValue.serverTimestamp()
    });
    await db.collection('users').doc(cred.user.uid).set({
      uid: cred.user.uid, name: name, email: email, phone: phone,
      role: 'owner', bizId: bizId, ownerId: cred.user.uid,
      status: 'active', createdAt: firebase.firestore.FieldValue.serverTimestamp()
    });
    toast('Akaunti imeundwa kwa mafanikio!', 's');
  } catch (err) {
    showAuthErr(err.message);
  }
}

