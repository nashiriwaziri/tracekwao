  return true;
}
function checkRole(roles) {
  if (!Array.isArray(roles)) roles = [roles];
  if (!roles.includes(currentRole)) { toast('Huna ruhusa ya kufanya hili.', 'e'); return false; }
  return true;
}
function checkBizId(bizId) {
  if (currentBizId !== bizId) { toast('Huruhsa: Biashara hii sio yako.', 'e'); return false; }
