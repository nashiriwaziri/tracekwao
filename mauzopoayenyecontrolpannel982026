/* ============================================================
   AUTH STATE OBSERVER — ROLE-BASED ROUTING
   ============================================================ */
auth.onAuthStateChanged(async (user) => {
  if (!user) {
    currentUser = null;
    currentUserDoc = null;
    return;
  }
  currentUser = user;
  try {
    const doc = await db.collection('users').doc(user.uid).get();
    if (!doc.exists) {
      /* Check if super user */
      const superDoc = await db.collection('superUsers').doc(user.uid).get();
      if (superDoc.exists) {
        currentUserDoc = { uid: user.uid, role: 'superuser', ...superDoc.data() };
        currentRole = 'superuser';
        showSuperAdmin();
        $('superLoginBox').classList.add('hidden');
        $('superPanel').classList.remove('hidden');
        initSuperPanel();
        return;
      }
      showAuth();
      showAuthErr('Akaunti yako haiko. Tafadhali wasiliana na admin.');
      return;
    }
    currentUserDoc = { uid: user.uid, ...doc.data() };
    currentRole = currentUserDoc.role;
    currentBizId = currentUserDoc.bizId;

    /* Route based on role */
    if (currentRole === 'superuser') {
      showSuperAdmin();
      $('superLoginBox').classList.add('hidden');
      $('superPanel').classList.remove('hidden');
      initSuperPanel();
    } else if (currentRole === 'owner') {
      /* Owner goes directly to Owner Control Panel */
      showDashboard();
    } else if (currentRole === 'manager') {
      /* Manager goes directly to Manager Control Panel */
      showDashboard();
    } else if (['cashier', 'seller', 'storekeeper'].includes(currentRole)) {
      /* Staff go to their authorized dashboard */
      showDashboard();
    } else {
      /* Unknown role — show role selection */
      showRoleScreen();
    }
  } catch (err) {
    console.error('Auth state error:', err);
    showAuth();
  }
});

