/* ============================================================
   IMAGE PROCESSING MODULE
   ============================================================ */
const ImageProcessor = {
  /* Max dimensions per context */
  MAX_DIM: {
    ad: { width: 1200, height: 800 },
    product: { width: 800, height: 800 },
    logo: { width: 400, height: 400 },
    general: { width: 1000, height: 1000 }
  },
  QUALITY: { ad: 0.82, product: 0.85, logo: 0.9, general: 0.85 },
  ABSOLUTE_MAX: 8000, /* Pixels — beyond this, refuse to process */

  /* Validate file is actually an image */
  async validate(file) {
    if (!file) throw new Error('Hakuna faili iliyochaguliwa.');
    /* Check MIME type */
    const validMimes = ['image/jpeg', 'image/png', 'image/webp', 'image/gif', 'image/bmp'];
    /* Also check extension for browsers that might not set MIME correctly */
    const extMatch = file.name.toLowerCase().match(/\.(jpg|jpeg|png|webp|gif|bmp|tiff?)$/);
    if (!validMimes.includes(file.type) && !extMatch) {
      throw new Error('Format hii haiwezi kutambulika kama picha. Tumia JPG, PNG, WEBP, GIF, au BMP.');
    }
    /* Try to actually decode it */
    return new Promise((resolve, reject) => {
      const img = new Image();
      const url = URL.createObjectURL(file);
      const cleanup = () => { try { URL.revokeObjectURL(url); } catch(e){} };
      img.onload = () => {
        cleanup();
        if (img.naturalWidth > this.ABSOLUTE_MAX || img.naturalHeight > this.ABSOLUTE_MAX) {
          reject(new Error('Picha ni kubwa sana (' + img.naturalWidth + 'x' + img.naturalHeight + '). Tafadhali punguza ukubwa kwanza.'));
          return;
        }
        resolve({ width: img.naturalWidth, height: img.naturalHeight, type: file.type || 'image/jpeg' });
      };
      img.onerror = () => { cleanup(); reject(new Error('Faili hii sio picha halisi au imeharibika.')); };
      img.src = url;
    });
  },

  /* Process: resize proportionally, compress, convert to WebP (except GIF) */
  async process(file, context) {
    const info = await this.validate(file);
    const maxDim = this.MAX_DIM[context] || this.MAX_DIM.general;
    const quality = this.QUALITY[context] || this.QUALITY.general;
    const isGif = info.type === 'image/gif';

    return new Promise((resolve, reject) => {
      const img = new Image();
      const url = URL.createObjectURL(file);
      const cleanup = () => { try { URL.revokeObjectURL(url); } catch(e){} };

      img.onload = () => {
        cleanup();
        let w = img.naturalWidth;
        let h = img.naturalHeight;
        const aspect = w / h;

        /* Scale down if exceeds max dimensions */
        if (w > maxDim.width) { w = maxDim.width; h = Math.round(w / aspect); }
        if (h > maxDim.height) { h = maxDim.height; w = Math.round(h * aspect); }
        w = Math.max(1, Math.round(w));
        h = Math.max(1, Math.round(h));

        /* If GIF, don't convert — just resize */
        const outputType = isGif ? 'image/gif' : 'image/webp';

        const canvas = document.createElement('canvas');
        canvas.width = w;
        canvas.height = h;
        const ctx = canvas.getContext('2d');
        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = 'high';
        ctx.drawImage(img, 0, 0, w, h);

        canvas.toBlob((blob) => {
          if (!blob) { reject(new Error('Usindikaji wa picha umeshindikana.')); return; }
          resolve({
            blob: blob,
            width: w,
            height: h,
            size: blob.size,
            type: outputType,
            originalWidth: img.naturalWidth,
            originalHeight: img.naturalHeight,
            originalSize: file.size,
            fileName: file.name
          });
        }, outputType, quality);
      };
      img.onerror = () => { cleanup(); reject(new Error('Picha haiwezi kusomwa.')); };
      img.src = url;
    });
  }
};

/* ============================================================
   IMAGE PREVIEW & UPLOAD FLOW
   ============================================================ */
async function handleImageSelection(file, context, callback, fileInputId) {
  if (!file) return;

  /* Show preview modal */
  $('imgPreviewModal').style.display = 'flex';
  $('imgProcessingText').style.display = 'block';
  $('imgProgressBar').style.display = 'block';
  $('imgProgressFill').style.width = '0%';
  $('imgPreviewImg').src = '';
  $('imgUploadBtn').disabled = true;
  $('imgInfoGrid').style.display = 'none';
  $('imgOptBadge').style.display = 'none';

  pendingImageFileInput = fileInputId;
  pendingImageContext = context;
  pendingImageCallback = callback;

  try {
    /* Simulate progress */
    $('imgProgressFill').style.width = '30%';

    /* Show original preview first */
    const origUrl = URL.createObjectURL(file);
    $('imgPreviewImg').src = origUrl;

    $('imgProgressFill').style.width = '50%';

    /* Process the image */
    const result = await ImageProcessor.process(file, context);

    $('imgProgressFill').style.width = '80%';

    /* Show optimized preview */
    const optUrl = URL.createObjectURL(result.blob);
    $('imgPreviewImg').src = optUrl;
    try { URL.revokeObjectURL(origUrl); } catch(e){}

    /* Store processed blob */
    pendingImageBlob = result;

    /* Show info */
    $('imgInfoGrid').style.display = 'grid';
    $('imgInfoName').textContent = result.fileName;
    $('imgInfoOrigSize').textContent = formatBytes(result.originalSize);
    $('imgInfoOrigDim').textContent = result.originalWidth + ' x ' + result.originalHeight + ' px';
    $('imgInfoOptDim').textContent = result.width + ' x ' + result.height + ' px';
    $('imgInfoOptSize').textContent = formatBytes(result.size);
    const savings = result.originalSize > 0 ? Math.round((1 - result.size / result.originalSize) * 100) : 0;
    $('imgInfoSavings').textContent = savings > 0 ? savings + '% smaller' : 'Same size';
    if (savings > 0) $('imgOptBadge').style.display = 'inline-block';

    $('imgProgressFill').style.width = '100%';
    $('imgProcessingText').style.display = 'none';
    $('imgProgressBar').style.display = 'none';
    $('imgUploadBtn').disabled = false;

  } catch (err) {
    $('imgProcessingText').style.display = 'none';
    $('imgProgressBar').style.display = 'none';
    toast(err.message, 'e');
    cancelImagePreview();
  }
}
function cancelImagePreview() {
  $('imgPreviewModal').style.display = 'none';
  pendingImageBlob = null;
  pendingImageContext = null;
  pendingImageCallback = null;
  pendingImageFileInput = null;
}
function replaceImage() {
  cancelImagePreview();
  if (pendingImageFileInput) {
    const inp = $(pendingImageFileInput);
    if (inp) { inp.value = ''; inp.click(); }
  }
}
async function confirmImageUpload() {
  if (!pendingImageBlob || !pendingImageCallback) return;
  const btn = $('imgUploadBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Inapakia...';
  try {
    /* Upload to Firebase Storage */
    const path = pendingImageContext + '/' + genId() + '.' + (pendingImageBlob.type === 'image/gif' ? 'gif' : 'webp');
    const ref = storage.ref().child(path);
    const snapshot = await ref.put(pendingImageBlob);
    const url = await snapshot.ref.getDownloadURL();
    pendingImageCallback(url, pendingImageBlob);
    toast('Picha imepakiwa kwa mafanikio!', 's');
    cancelImagePreview();
  } catch (err) {
    toast('Hitilafu ya kupakia: ' + err.message, 'e');
    btn.disabled = false;
    btn.innerHTML = '<i class="fa-solid fa-cloud-upload-alt"></i> Upload';
  }
}

